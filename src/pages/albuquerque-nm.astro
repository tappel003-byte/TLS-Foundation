    }
    100% {
      transform: scale(1.03) translate(-1%, 0.5%);
    }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 34, 56, 0.88) 0%, rgba(13, 34, 56, 0.45) 45%, rgba(13, 34, 56, 0.1) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 80px 80px;
  }
  .hero-city {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    display: block;
    margin-bottom: 10px;
    opacity: 0;
    animation: fadeUp 0.6s ease forwards 0.2s;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.6s ease forwards 0.4s;
  }
  .hero-h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(52px, 8vw, 108px);
    font-weight: 700;
    color: var(--white);
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 28px;
  }
  .hero-h1 .w1,
  .hero-h1 .w2 {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.55s ease forwards;
  }
  .hero-h1 .w1 {
    animation-delay: 0.55s;
  }
  .hero-h1 .w2 {
    animation-delay: 0.72s;
    margin-left: 0.22em;
  }
  .hero-h1 .w3 {
    display: block;
    font-style: italic;
    color: var(--gold);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.55s ease forwards 0.9s;
  }
  .hero-content .hero-sub {
    display: inline-block;
    font-size: clamp(18px, 1.9vw, 22px);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9), 0 2px 14px rgba(0, 0, 0, 0.6);
    background: rgba(13, 34, 56, 0.55);
    max-width: 540px;
    line-height: 1.65;
    margin-bottom: 44px;
    opacity: 0;
    animation: fadeUp 0.65s ease forwards 1.1s;
    border-left: 2px solid rgba(184, 134, 11, 0.5);
    padding: 20px 28px 20px 24px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 36px;
    opacity: 0;
    animation: fadeUp 0.65s ease forwards 1.4s;
  }
  .hero-phone {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400;
    color: var(--white);
    text-decoration: none;
    border-bottom: 1px solid rgba(184, 134, 11, 0.6);
    padding-bottom: 4px;
    transition: color 0.2s, border-color 0.2s;
  }
  .hero-phone:hover {
    color: var(--gold);
    border-color: var(--gold);
  }
  .hero-note {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-top: 8px;
  }
  .hero-sep {
    width: 1px;
    height: 44px;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }
  .hero-content .hero-aside {
    font-size: 17px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85), 0 2px 10px rgba(0, 0, 0, 0.5);
    max-width: 200px;
    line-height: 1.6;
  }
  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .gold-rule {
    height: 3px;
    background: linear-gradient(to right, var(--gold), rgba(184, 134, 11, 0.1));
  }

  /* ── STATEMENT BAND ── */
  .statement-band {
    background: var(--cream);
    padding: 48px 80px;
    border-bottom: 1px solid var(--stone);
    border-left: 4px solid var(--gold);
  }
  .statement-band-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .statement-band-line1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.05;
    letter-spacing: -1.5px;
    display: block;
  }
  .statement-band-line2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    font-style: italic;
    color: var(--gold);
    line-height: 1.05;
    letter-spacing: -1.5px;
    display: block;
    margin-bottom: 20px;
  }
  .statement-band-secondary {
    font-family: 'Playfair Display', serif;
    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 400;
    font-style: italic;
    color: var(--slate);
    line-height: 1.65;
    max-width: 680px;
  }
  @media (max-width: 760px) {
    .statement-band {
      padding: 36px 24px;
    }
  }

  /* ── PAGE LAYOUT ── */
  .page-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    position: relative;
  }
  .page-layout::before {
    content: '';
    position: absolute;
    left: 280px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--stone);
    pointer-events: none;
    z-index: 0;
  }

  /* ── LEFT NAV ── */
  .left-nav {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 56px 0 56px 48px;
    background: var(--cream);
    z-index: 10;
  }
  .nav-progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--stone);
  }
  .nav-progress-fill {
    width: 100%;
    background: var(--gold);
    height: 0%;
    transition: height 0.15s linear;
  }
  .nav-brand {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 44px;
    opacity: 0.6;
  }
  .nav-links {
    list-style: none;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Source Serif 4', serif;
    font-size: 17px;
    font-weight: 400;
    color: var(--muted);
    text-decoration: none;
    padding: 14px 0 14px 16px;
    margin-left: -18px;
    border-left: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    line-height: 1.3;
  }
  .nav-links a .nav-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.3;
    flex-shrink: 0;
    transition: opacity 0.2s, transform 0.2s, background 0.2s;
  }
  .nav-links a:hover {
    color: var(--navy);
  }
  .nav-links a.active {
    color: var(--navy);
    border-left-color: var(--gold);
    font-weight: 600;
  }
  .nav-links a.active .nav-dot {
    opacity: 1;
    transform: scale(1.6);
    background: var(--gold);
  }
  .nav-contact {
    margin-top: auto;
    padding-top: 32px;
    border-top: 1px solid var(--stone);
  }
  .nav-contact-label {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 12px;
  }
  .nav-contact a {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--navy);
    text-decoration: none;
    display: block;
    transition: color 0.2s;
    line-height: 1.3;
  }
  .nav-contact a:hover {
    color: var(--gold);
  }
  .nav-contact-sub {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-top: 6px;
  }

  /* ── SECTIONS ── */
  .content-area {
    min-width: 0;
  }
  .section {
    padding: 120px 96px 100px;
    border-bottom: 1px solid var(--stone);
    position: relative;
  }
  .section:nth-child(odd) {
    background: var(--white);
  }
  .section:nth-child(even) {
    background: var(--cream);
  }
  .section:last-child {
    border-bottom: none;
  }
  .section-num {
    position: absolute;
    top: 40px;
    right: 80px;
    font-family: 'Playfair Display', serif;
    font-size: 160px;
    font-weight: 700;
    color: var(--navy);
    opacity: 0.03;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .section-inner {
    position: relative;
    z-index: 1;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .section-label-bar {
    width: 40px;
    height: 2px;
    background: var(--gold);
    flex-shrink: 0;
  }
  .section-label-text {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.18;
    letter-spacing: -0.5px;
    margin-bottom: 56px;
    max-width: 680px;
  }
  .section-heading em {
    font-style: italic;
    color: var(--gold);
  }
  .abq-page p {
    font-size: 18px;
    font-weight: 400;
    color: var(--slate);
    line-height: 2.05;
    margin-bottom: 36px;
    max-width: 560px;
  }
  .abq-page p:last-child {
    margin-bottom: 0;
  }
  .abq-page h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    font-weight: 400;
    font-style: italic;
    color: var(--blue);
    margin: 48px 0 20px;
    line-height: 1.3;
  }
  .lede {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 400;
    font-style: italic;
    color: var(--navy);
    line-height: 1.55;
    max-width: 620px;
    margin-bottom: 56px;
    padding-left: 32px;
    border-left: 3px solid var(--gold);
  }
  .pull {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.3vw, 26px);
    font-weight: 400;
    font-style: italic;
    color: var(--navy);
    line-height: 1.65;
    margin: 56px 0;
    max-width: 480px;
    padding-left: 32px;
    border-left: 2px solid rgba(184, 134, 11, 0.45);
  }
  .abq-page mark.key {
    background: none;
    color: var(--gold);
    font-weight: 700;
    font-style: normal;
  }
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 96px;
  }
  .two-col-wide {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 96px;
  }

  /* ── FACT BOX ── */
  .fact-box {
    background: var(--navy);
    padding: 48px 52px;
    margin: 48px 0;
  }
  .fact-box p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 17px;
    line-height: 1.9;
    margin-bottom: 16px;
    max-width: none;
  }
  .fact-box p:last-child {
    margin-bottom: 0;
  }
  .fact-box-label {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 16px;
  }

  .basin-stat {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1fr;
    gap: 0;
    margin: 64px 0;
    align-items: start;
  }
  .basin-stat-item {
    padding: 0 48px;
  }
  .basin-stat-item:first-child {
    padding-left: 0;
  }
  .basin-stat-item:last-child {
    padding-right: 0;
  }
  .basin-stat-num {
    font-family: 'Playfair Display', serif;
    font-size: clamp(44px, 5.5vw, 68px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
    letter-spacing: -2px;
    display: block;
  }
  .basin-stat-num span {
    color: var(--gold);
  }
  .basin-stat-label {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-top: 10px;
  }
  .basin-stat-desc {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.7;
    margin-top: 8px;
    max-width: none;
  }
  .basin-stat-divider {
    width: 1px;
    background: var(--stone);
    align-self: stretch;
  }

  /* ── ZONE SECTIONS ── */
  .zone-strip {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0 -96px 56px;
    border-top: 1px solid var(--stone);
    border-bottom: 1px solid var(--stone);
  }
  .zone-strip-num {
    background: var(--navy);
    padding: 28px 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .zone-strip-num span {
    font-family: 'Playfair Display', serif;
    font-size: 52px;
    font-weight: 700;
    color: rgba(184, 134, 11, 0.3);
    line-height: 1;
  }
  .zone-strip-content {
    padding: 24px 40px;
    display: flex;
    align-items: center;
    gap: 40px;
    flex: 1;
  }
  .zone-strip-title {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.2;
  }
  .zone-strip-tag {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-left: auto;
    flex-shrink: 0;
  }

  .zone-warnings {
    margin-top: 48px;
  }
  .zone-warning-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
    display: block;
  }
  .warning-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--stone);
  }
  .warning-item {
    border-bottom: 1px solid var(--stone);
    overflow: hidden;
  }
  .warning-trigger {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    gap: 16px;
    text-align: left;
  }
  .warning-trigger-text {
    font-family: 'Source Serif 4', serif;
    font-size: 17px;
    font-weight: 400;
    color: var(--navy);
    line-height: 1.4;
    flex: 1;
  }
  .warning-trigger-text::before {
    content: '— ';
    color: var(--gold);
    font-family: 'DM Mono', monospace;
    font-size: 12px;
  }
  .warning-trigger-icon {
    font-family: 'DM Mono', monospace;
    font-size: 18px;
    color: var(--gold);
    flex-shrink: 0;
    transition: transform 0.3s;
  }
  .warning-item.open .warning-trigger-icon {
    transform: rotate(45deg);
  }
  .warning-drawer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .warning-drawer-inner {
    padding: 0 0 24px 20px;
    font-size: 16px;
    color: var(--slate);
    line-height: 1.85;
    border-left: 2px solid rgba(184, 134, 11, 0.3);
    margin-left: 4px;
  }

  /* ── WEST MESA ── */
  .west-mesa-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 64px;
    align-items: start;
  }
  .west-mesa-callout {
    background: var(--navy);
    padding: 36px 32px;
    position: sticky;
    top: 80px;
  }
  .west-mesa-callout-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 16px;
  }
  .west-mesa-callout-stat {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
    display: block;
    margin-bottom: 8px;
  }
  .west-mesa-callout p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  /* ── NORTH VALLEY ── */
  .nv-timeline {
    position: relative;
    padding-left: 32px;
    margin-top: 48px;
  }
  .nv-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--stone);
  }
  .nv-event {
    position: relative;
    margin-bottom: 48px;
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .nv-event.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .nv-event::before {
    content: '';
    position: absolute;
    left: -38px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--stone);
    transition: border-color 0.3s, background 0.3s;
  }
  .nv-event.visible::before {
    border-color: var(--gold);
    background: var(--gold);
  }
  .nv-event-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 8px;
  }
  .nv-event h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .nv-event p {
    font-size: 16px;
    color: var(--slate);
    line-height: 1.8;
    margin: 0;
    max-width: none;
  }

  /* ── EAST SIDE ── */
  .east-side-intro {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.15;
    letter-spacing: -1px;
    margin-bottom: 48px;
    max-width: 720px;
  }
  .east-side-intro em {
    font-style: italic;
    color: var(--gold);
  }
  .east-side-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--stone);
    margin-top: 56px;
  }
  .east-side-cell {
    background: var(--white);
    padding: 36px 32px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .east-side-cell.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .east-side-cell-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    display: block;
    margin-bottom: 12px;
  }
  .east-side-cell h4 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .east-side-cell p {
    font-size: 15px;
    color: var(--slate);
    line-height: 1.8;
    margin: 0;
    max-width: none;
  }

  /* ── HEIGHTS ── */
  .heights-cycle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--stone);
    margin: 48px 0;
  }
  .heights-phase {
    padding: 48px 40px;
  }
  .heights-phase.wet {
    background: var(--navy);
  }
  .heights-phase.dry {
    background: var(--sand);
  }
  .heights-phase-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 16px;
    display: block;
  }
  .heights-phase.wet .heights-phase-label,
  .heights-phase.dry .heights-phase-label {
    color: var(--gold);
  }
  .heights-phase-title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .heights-phase.wet .heights-phase-title {
    color: var(--white);
  }
