---
// Las Cruces city page — Valley Transect magazine layout.
// Organizing principle: irrigation history → ground history (Mesilla Valley
// as irrigated landscape that became residential). Signature: horizontal
// east–west Valley Transect with River / La Mesa band-select. Former
// Farmland is its own nav chapter (content + ledger, no overlay gimmick).
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Las Cruces, NM | TLS Foundations';
const description =
  'Foundation repair in Las Cruces, NM. River-valley clay, La Mesa terrace collapsible soil, and differential movement on former agricultural land -- TLS Foundations investigates before recommending.';
const summary =
  "Las Cruces sits on three different grounds, not one -- fine clay and silt near the Rio Grande, collapsible alluvium on the La Mesa terrace, and former agricultural land now carrying decades of uneven moisture and fill history. We've seen differential movement on converted farmland directly, and it's well-documented wherever irrigated land becomes a subdivision, which is exactly why a proper investigation matters more than assuming which ground a given house has.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        datePublished: '2026-11-19',
        dateModified: '2026-11-19',
        headline: 'Foundation Repair in Las Cruces, NM',
        description,
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Las Cruces, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/las-cruces-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [
          { '@type': 'City', name: 'Las Cruces', addressRegion: 'NM' },
          { '@type': 'City', name: 'Mesilla', addressRegion: 'NM' },
        ],
        description:
          'Foundation repair contractor serving Las Cruces and the Mesilla Valley, NM. Slab repair, foundation inspection, settlement, heave, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Las Cruces, NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Las Cruces sits on three different grounds, not one. Depending on the specific lot, the cause can be expansive clay and silt near the Rio Grande, collapsible alluvium on the La Mesa terrace, or differential movement on land that used to be irrigated farmland. The mix varies by address, not by a single town-wide soil type.",
            },
          },
          {
            '@type': 'Question',
            name: 'Does land that used to be farmland have different soil?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "It can. Much of the Mesilla Valley's newer growth sits on former chile, pecan, or onion fields -- flood-irrigated for generations before being leveled and subdivided. Old field boundaries, filled-in irrigation ditches, and decades of uneven moisture conditioning can leave inconsistent bearing ground beneath what looks like one uniform lot, which can show up as differential movement.",
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in Las Cruces?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. A drainage correction and a pier system differ by an order of magnitude, and both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies more than the house.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers or push piers used for foundation repair in Las Cruces?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Both get used in this area, and the choice depends on what's actually under a given slab -- the depth and consistency of bearing material, and whether the mechanism is heave, collapsible settlement, or differential movement from former farmland. Piers installed for the wrong mechanism don't fix the problem, and in some configurations make it worse.",
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Las Cruces, NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves Las Cruces and the Mesilla Valley with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with SandiaGEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 -- you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'Southern New Mexico', item: 'https://www.tlsfoundations.com/southern-new-mexico' },
          { '@type': 'ListItem', position: 3, name: 'Las Cruces, NM', item: 'https://www.tlsfoundations.com/las-cruces-nm' },
        ],
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  ogImage="/images/southern-new-mexico-hero.webp"
  summary={summary}
  pageName="Las Cruces"
  nextPage={{ path: '/southern-new-mexico', name: 'Southern New Mexico' }}
>
  <div class="lc-page">
    <div class="hero">
      <div class="hero-content">
        <span class="hero-city">Las Cruces, New Mexico</span>
        <span class="hero-eyebrow">Foundation Repair</span>
        <h1 class="hero-h1">
          <span class="w1">Deep</span><span class="w2">roots.</span>
          <span class="w3">Straight answers.</span>
        </h1>
        <p class="hero-sub">The Mesilla Valley's irrigation history is still under the slab — river clay, terrace collapse, and former farmland that became streets.</p>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="statement-band">
      <div class="statement-band-inner">
        <span class="statement-band-line1">Foundation Repair</span>
        <span class="statement-band-line2">Las Cruces, New Mexico.</span>
        <p class="statement-band-secondary">A century and a half of irrigation built this valley's reputation. It also built some of what's sitting under your slab.</p>
      </div>
    </div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Mesilla Valley</span>
        <ul class="nav-links">
          <li><a href="#the-valley"><span class="nav-dot"></span>The Valley</a></li>
          <li><a href="#river-corridor"><span class="nav-dot"></span>River Corridor</a></li>
          <li><a href="#la-mesa-terrace"><span class="nav-dot"></span>La Mesa Terrace</a></li>
          <li><a href="#former-farmland"><span class="nav-dot"></span>Former Farmland</a></li>
          <li><a href="#what-we-check"><span class="nav-dot"></span>What We Check Here</a></li>
          <li><a href="#before-you-sign"><span class="nav-dot"></span>Before You Sign</a></li>
          <li><a href="#questions"><span class="nav-dot"></span>Questions</a></li>
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s), or voicemail and a callback</span>
        </div>
      </nav>

      <div class="content-area">
        <!-- 01 THE VALLEY -->
        <section class="section" id="the-valley">
          <span class="section-num">01</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">The Valley · West to East</span></div>
            <h2 class="section-heading reveal">Three ground histories. <em>One irrigated valley.</em></h2>
            <p class="lede reveal">Las Cruces sits in the Mesilla Valley, in the Chihuahuan Desert, with the Organ Mountains east and the Rio Grande west. Desert, river, and mountain close together — which is part of why the ground here isn't one simple story.</p>
            <p class="reveal"><mark class="key">The ground under a Las Cruces home depends on which history it sits on — river-valley clay and silt, the La Mesa terrace's collapsible alluvium, or former agricultural land with its own uneven moisture and fill history.</mark> None of them announce themselves from the street.</p>

            <!-- SIGNATURE: Valley Transect (River / La Mesa band-select) -->
            <div class="transect reveal" id="transect">
              <div class="transect-toolbar">
                <span class="transect-label">Valley Transect · Mesilla Valley</span>
              </div>

              <div class="transect-stage" id="transectStage">
                <div class="transect-bands">
                  <button type="button" class="t-band t-river" data-band="river" aria-pressed="false">
                    <span class="t-band-name">River Corridor</span>
                    <span class="t-band-sub">Rio Grande · Mesilla · fine sediment</span>
                  </button>
                  <button type="button" class="t-band t-mesa" data-band="mesa" aria-pressed="false">
                    <span class="t-band-name">La Mesa Terrace</span>
                    <span class="t-band-sub">Collapsible alluvium · first wetting</span>
                  </button>
                  <div class="t-edge" aria-hidden="true">
                    <span class="t-band-name">Organs</span>
                    <span class="t-band-sub">edge atmosphere</span>
                  </div>
                </div>
              </div>

              <div class="transect-panels">
                <div class="t-panel" data-panel="river" hidden>
                  <span class="t-panel-tag">West · river corridor</span>
                  <h3>Fine clay and silt near the Rio Grande</h3>
                  <p>Ground closest to the river and historic Mesilla carries fine river and lake sediment deposited over thousands of years of flooding. Where that clay is present, it's genuinely expansive. Old Mesilla sits right in this corridor — some of the oldest continuously settled ground in the valley.</p>
                </div>
                <div class="t-panel t-panel-mesa" data-panel="mesa" hidden>
                  <span class="t-panel-tag">East of the river · terrace</span>
                  <h3>La Mesa collapsible alluvium</h3>
                  <p>Older, dry-deposited alluvium that stayed stable for thousands of years because it stayed dry. Irrigation and urban moisture have triggered first-wetting collapse in mid-century foundations: the soil holds its shape until water reaches it, then loses volume rapidly — sometimes decades after a house was built.</p>
                </div>
              </div>
            </div>

            <p class="atm reveal"><span class="atm-label">Atmosphere</span> NMSU traces to an 1888 adobe college; Fabián García's New Mexico No. 9 chile (1921) helped found the commercial industry. Chile and pecans need irrigation. Foundations need to know where that water history actually went.</p>
          </div>
        </section>

        <!-- 02 RIVER CORRIDOR -->
        <section class="section" id="river-corridor">
          <span class="section-num">02</span>
          <div class="valley-band valley-west reveal">
            <span class="valley-band-dir">West ← Rio Grande</span>
            <h3 class="valley-band-title">River Corridor</h3>
            <span class="valley-band-tag">Fine sediment · Expansive clay · Old Mesilla</span>
          </div>
          <div class="section-inner">
            <h2 class="section-heading reveal">River corridor — <em>expansive clay on the valley floor</em></h2>
            <div class="folio-spread reveal">
              <div class="folio-num" aria-hidden="true">W</div>
              <div class="folio-main">
                <p>Ground closest to the Rio Grande and historic Mesilla carries fine river and lake sediment — clay and silt deposited long before the valley was leveed and irrigated on a schedule. Where that clay is present, it swells when wet and shrinks when dry, and it can heave a foundation built on it.</p>
                <p>This is also the valley's oldest settled ground. Age alone isn't a verdict, but proximity to the river corridor is a reason to look closely at which mechanism is actually present.</p>
              </div>
              <div class="warn-stack">
                <span class="warn-stack-label">Warning signs · river corridor</span>
                <details>
                  <summary>Cracking that tracks wet and dry seasons</summary>
                  <p>Expansive clay responds to moisture on a seasonal cycle. Damage that tracks wet and dry years, rather than appearing once and staying put, points toward heave rather than simple settlement.</p>
                </details>
                <details>
                  <summary>Older homes in or near Old Mesilla</summary>
                  <p>The oldest, most river-adjacent ground in the valley. Proximity to the corridor is a reason to check for heave specifically rather than assume settlement.</p>
                </details>
              </div>
            </div>
          </div>
        </section>

        <!-- 03 LA MESA -->
        <section class="section" id="la-mesa-terrace">
          <span class="section-num">03</span>
          <div class="valley-band valley-east reveal">
            <span class="valley-band-dir">East → La Mesa</span>
            <h3 class="valley-band-title">La Mesa Terrace</h3>
            <span class="valley-band-tag">Collapsible alluvium · First wetting</span>
          </div>
          <div class="section-inner">
            <h2 class="section-heading reveal">La Mesa terrace — <em>stable until the first wetting</em></h2>
            <div class="folio-spread reveal">
              <div class="folio-num" aria-hidden="true">E</div>
              <div class="folio-main">
                <p>East of the river, much of Las Cruces sits on the La Mesa terrace — older, dry-deposited alluvium. Irrigation and urban development moisture have triggered first-wetting collapse in a number of mid-20th-century foundations.</p>
                <p><mark class="key">Collapsible soil stays stable while dry, then loses volume rapidly the first time sustained moisture reaches it</mark> — a first-wetting event, not a slow process. That can happen decades after a house was built, with no obvious cause from the outside.</p>
              </div>
              <div class="warn-stack">
                <span class="warn-stack-label">Warning signs · La Mesa</span>
                <details>
                  <summary>Settlement that seems to appear with no clear trigger</summary>
                  <p>First wetting can look sudden from inside the house. The trigger is often moisture that finally reached soil that had stayed dry for decades.</p>
                </details>
                <details>
                  <summary>Mid-century homes after a landscaping or irrigation change</summary>
                  <p>New landscaping, a new sprinkler system, or a changed drainage pattern can be exactly the sustained moisture that triggers collapse in terrace soil that's been dry for decades.</p>
                </details>
              </div>
            </div>
          </div>
        </section>

        <!-- 04 FORMER FARMLAND — own chapter (mandatory) -->
        <section class="section" id="former-farmland">
          <span class="section-num">04</span>
          <div class="valley-band valley-field reveal">
            <span class="valley-band-dir">Land-use history</span>
            <h3 class="valley-band-title">Former Farmland</h3>
            <span class="valley-band-tag">Field → subdivision · Differential fill</span>
          </div>
          <div class="section-inner">
            <h2 class="section-heading reveal">Former farmland — <em>the conversion that doesn't disappear</em></h2>
            <div class="irrig-ledger reveal">
              <div class="irrig-step"><span>1</span><p>Flood-irrigated fields for generations</p></div>
              <div class="irrig-step"><span>2</span><p>Leveled and subdivided</p></div>
              <div class="irrig-step"><span>3</span><p>Ditch lines &amp; field edges stay underground</p></div>
              <div class="irrig-step"><span>4</span><p>Differential movement under new streets</p></div>
            </div>
            <div class="folio-spread reveal">
              <div class="folio-num" aria-hidden="true">F</div>
              <div class="folio-main">
                <p><mark class="key">Much of the Mesilla Valley's newer growth sits on what used to be chile, pecan, or onion fields — flood-irrigated for generations before it was leveled and subdivided.</mark> That history doesn't disappear under a new slab.</p>
                <p>Old field boundaries, filled-in irrigation ditches, and decades of uneven moisture conditioning can leave inconsistent bearing ground across what looks like one uniform lot. That can show up as differential movement — one part of a foundation settling or heaving differently than the rest.</p>
                <p>We've seen differential movement on converted farmland directly. This chapter is the full argument for that land-use history — it cuts across both the river corridor and the terrace.</p>
                <div class="pull">Chile and pecans need irrigation to grow. Foundations need to know where that water history actually went.</div>
              </div>
              <div class="warn-stack">
                <span class="warn-stack-label">Warning signs · former farmland</span>
                <details>
                  <summary>Movement worse on one side or corner of the house</summary>
                  <p>A classic signature of differential movement — often tracing back to an old field boundary or ditch line nobody mapped before building.</p>
                </details>
                <details>
                  <summary>Newer construction on land that was farmland within living memory</summary>
                  <p>Doesn't mean there's a problem. It means the fill and moisture history under that slab is worth understanding before assuming the ground is as uniform as the new subdivision looks.</p>
                </details>
              </div>
            </div>
          </div>
        </section>

        <!-- 05 WHAT WE CHECK -->
        <section class="section" id="what-we-check">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Investigation · Mesilla Valley</span></div>
            <h2 class="section-heading reveal">What we check here — <em>which history, not which neighborhood name</em></h2>
            <div class="two-col reveal">
              <div>
                <p>Foundation inspection in Las Cruces means understanding which of the valley's three ground histories a specific address sits on — including what the land was used for before it was a subdivision — not assuming from what the neighborhood looks like.</p>
                <p>TLS Foundations works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when site conditions warrant a formal soil investigation before repair is recommended. Sometimes the honest answer is drainage correction. Sometimes it's monitoring and nothing else.</p>
              </div>
              <div>
                <div class="pull">We'd rather tell you nothing is wrong than sell you something that is.</div>
                <p>55 combined years working New Mexico soils. Owner-operated — you reach the person who looks at the house.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 06 BEFORE YOU SIGN — 1-2-3 ask strip (Las Cruces-only) -->
        <section class="section" id="before-you-sign">
          <span class="section-num">06</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Before You Sign · Three Steps</span></div>
            <h2 class="section-heading reveal">Ask in order — <em>before the estimate means anything</em></h2>

            <div class="ask-strip-bleed reveal">
            <div class="ask-strip">
              <div class="ask-step">
                <span class="ask-step-num">1</span>
                <h3>Which ground history?</h3>
                <p>River corridor, La Mesa terrace, or former farmland — or a mix. A quote written before that question is answered is a price tag on a guess.</p>
              </div>
              <div class="ask-step-arrow" aria-hidden="true">→</div>
              <div class="ask-step">
                <span class="ask-step-num">2</span>
                <h3>Was this a field?</h3>
                <p>If the subdivision was chile, pecan, or onion within living memory, ditch lines and field edges don't vanish when the land is leveled. Ask whether that history was considered.</p>
              </div>
              <div class="ask-step-arrow" aria-hidden="true">→</div>
              <div class="ask-step">
                <span class="ask-step-num">3</span>
                <h3>Who stands on the lot?</h3>
                <p>Not everyone who answers the phone is who ends up on your property. Call <a href="tel:5059914180">(505) 991-4180</a> — you reach the owner(s).</p>
              </div>
            </div>
            </div>
          </div>
        </section>

        <!-- 07 QUESTIONS — grouped by ground history -->
        <section class="section" id="questions">
          <span class="section-num">07</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Questions · By Ground History</span></div>
            <h2 class="section-heading reveal">Grouped the way the valley <em>actually works</em></h2>

            <div class="q-groups reveal">
              <div class="q-group">
                <h3 class="q-group-title">River Corridor</h3>
                <details class="q-details">
                  <summary>What's different about homes near Mesilla or the river?</summary>
                  <p>Ground closest to the Rio Grande and historic Mesilla carries more fine river and lake sediment — clay that's genuinely expansive. Not a guarantee of a problem, but a reason to check for heave specifically rather than assume settlement.</p>
                </details>
              </div>

              <div class="q-group">
                <h3 class="q-group-title">La Mesa Terrace</h3>
                <details class="q-details">
                  <summary>Why does settlement appear years after a house was built?</summary>
                  <p>On collapsible terrace alluvium, first sustained wetting can trigger rapid volume loss decades later — often after a landscaping or irrigation change. It can look like it came from nowhere.</p>
                </details>
              </div>

              <div class="q-group">
                <h3 class="q-group-title">Former Farmland</h3>
                <details class="q-details">
                  <summary>Does land that used to be farmland have different soil?</summary>
                  <p>It can. Flood-irrigated chile, pecan, or onion fields leveled into subdivisions can leave old field boundaries, filled-in ditches, and uneven moisture conditioning under what looks like one uniform lot — which shows up as differential movement.</p>
                </details>
              </div>

              <div class="q-group">
                <h3 class="q-group-title">General</h3>
                <details class="q-details">
                  <summary>Slab repair and pier choice in Las Cruces</summary>
                  <p>Slab-on-grade is common. A slab settling into collapsible terrace soil needs a different answer than one lifted by expanding river-valley clay, or one moving unevenly over former farmland. Helical and push piers both get used — choice follows mechanism and bearing depth, not a default product.</p>
                </details>
                <details class="q-details">
                  <summary>How much does foundation repair cost here?</summary>
                  <p>Cost follows cause. Drainage correction and a pier system are separated by an order of magnitude. If estimates vary wildly with no soil evaluation behind them, that spread is about the companies, not the house.</p>
                </details>
                <details class="q-details">
                  <summary>Do I need a soil investigation — and who does the work?</summary>
                  <p>Not every home needs a formal investigation. Many questions resolve with drainage, grading, and movement patterns. When the answer turns on depth or land-use history, TLS works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a>. Owner-operated: (505) 991-4180.</p>
                </details>
                <details class="q-details">
                  <summary>What happens during a foundation inspection?</summary>
                  <p>Exterior grading and drainage, cracking inside and out, door and window operation, floor elevations where warranted, and the site's history — irrigation, past leaks, landscaping changes, and what the land was used for before it was a subdivision. Sometimes the answer is "nothing yet."</p>
                </details>
              </div>
            </div>
          </div>
        </section>

        <div class="contact-closer reveal">
          <div class="contact-closer-inner">
            <div class="contact-closer-text">
              <span class="section-label-text" style="display:block;margin-bottom:16px;">Ready to talk</span>
              <p>River, terrace, or former field — we investigate which history your address sits on. You reach the owner(s) when you call.</p>
            </div>
            <div class="contact-closer-phone">
              <a href="tel:5059914180">(505) 991-4180</a>
              <span class="note">Text or call — your choice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const progressFill = document.getElementById('progressFill');
  const contentArea = document.querySelector('.content-area');
  window.addEventListener(
    'scroll',
    () => {
      if (!progressFill || !contentArea) return;
      const rect = contentArea.getBoundingClientRect();
      const total = (contentArea as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      (progressFill as HTMLElement).style.height = Math.min(100, (scrolled / total) * 100) + '%';
    },
    { passive: true }
  );

  const sections = document.querySelectorAll('.content-area section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove('active'));
          const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sections.forEach((s) => sectionObs.observe(s));

  navLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // Valley Transect band-select (Las Cruces-only)
  const bands = document.querySelectorAll('.t-band');
  const panels = document.querySelectorAll('.t-panel');

  function hidePanels() {
    panels.forEach((p) => {
      (p as HTMLElement).hidden = true;
    });
  }

  function showPanel(id: string) {
    panels.forEach((p) => {
      const el = p as HTMLElement;
      el.hidden = el.dataset.panel !== id;
    });
  }

  bands.forEach((band) => {
    band.addEventListener('click', () => {
      const id = (band as HTMLElement).dataset.band!;
      const was = band.classList.contains('active');
      bands.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      if (was) {
        hidePanels();
        return;
      }
      band.classList.add('active');
      band.setAttribute('aria-pressed', 'true');
      showPanel(id);
    });
  });
</script>

