<script>
  const questionKeys = [
    'cost', 'signs', 'engineer', 'heave', 'free-inspection',
    'insurance', 'wait', 'choose', 'causes', 'timeline',
    'sell', 'warranty', 'expansive', 'monitor', 'wrong-repair',
    'methods', 'doors-after', 'watering',
  ];

  let currentIndex = 0;

  function showPanel(panelId: string) {
    document.querySelectorAll<HTMLElement>('.answer-panel').forEach((panel) => (panel.style.display = 'none'));
    const target = document.getElementById(`answerPanel_${panelId}`);
    if (target) target.style.display = 'block';
  }

  function updateMobileCarousel() {
    const container = document.getElementById('mobileQuestionList');
    if (!container) return;
    container.innerHTML = '';
    questionKeys.forEach((key, idx) => {
      const btn = document.createElement('button');
      btn.textContent = document.querySelector(`.question-btn[data-q="${key}"]`)?.textContent || key;
      btn.classList.add('mobile-question-btn');
      if (idx === currentIndex) btn.classList.add('active');
      btn.addEventListener('click', () => {
        currentIndex = idx;
        updateMobileCarousel();
        showPanel(questionKeys[currentIndex]);
        const counter = document.getElementById('mobileCounter');
        if (counter) counter.textContent = `${currentIndex + 1} of ${questionKeys.length}`;
        document.querySelectorAll('.question-btn').forEach((b) => b.classList.remove('active'));
        const desktopBtn = document.querySelector(`.question-btn[data-q="${questionKeys[currentIndex]}"]`);
        desktopBtn?.classList.add('active');
      });
      container.appendChild(btn);
    });
    const counter = document.getElementById('mobileCounter');
    if (counter) counter.textContent = `${currentIndex + 1} of ${questionKeys.length}`;
  }

  function selectQuestion(key: string, opts: { scroll?: boolean } = {}) {
    if (!questionKeys.includes(key)) return;
    currentIndex = questionKeys.indexOf(key);
    document.querySelectorAll('.question-btn').forEach((b) => b.classList.remove('active'));
    const desktopBtn = document.querySelector(`.question-btn[data-q="${key}"]`);
    desktopBtn?.classList.add('active');
    showPanel(key);
    updateMobileCarousel();
    if (opts.scroll) {
      document.querySelector('.answer-card-col')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.question-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-q')!;
      selectQuestion(key);
      history.replaceState(null, '', `#${key}`);
    });
  });

  // "Related questions" links point at #<key> anchors on this same page --
  // intercept them so they switch the visible answer panel instead of
  // jumping to a hidden (display:none) panel div.
  document.querySelectorAll<HTMLAnchorElement>('.related-faq a[href^="/common-concerns#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const key = a.getAttribute('href')!.split('#')[1];
      if (!questionKeys.includes(key)) return;
      e.preventDefault();
      selectQuestion(key, { scroll: true });
      history.replaceState(null, '', `#${key}`);
    });
  });

  document.getElementById('prevBtn')?.addEventListener('click', () => {
    const nextIdx = currentIndex > 0 ? currentIndex - 1 : questionKeys.length - 1;
    selectQuestion(questionKeys[nextIdx]);
    history.replaceState(null, '', `#${questionKeys[nextIdx]}`);
  });
  document.getElementById('nextBtn')?.addEventListener('click', () => {
    const nextIdx = currentIndex < questionKeys.length - 1 ? currentIndex + 1 : 0;
    selectQuestion(questionKeys[nextIdx]);
    history.replaceState(null, '', `#${questionKeys[nextIdx]}`);
  });

  window.addEventListener('hashchange', () => {
    const key = window.location.hash.replace('#', '');
    if (questionKeys.includes(key)) selectQuestion(key, { scroll: true });
  });

  const initialKey = window.location.hash.replace('#', '');
  selectQuestion(questionKeys.includes(initialKey) ? initialKey : 'cost');
</script>
