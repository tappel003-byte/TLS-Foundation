  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Drainage and Grading Correction in New Mexico',
    description,
    about: description,
    author: { '@type': 'Organization', name: 'TLS Foundations' },
    publisher: { '@type': 'Organization', name: 'TLS Foundations' },
    url: 'https://www.tlsfoundations.com/drainage-correction-deep-dive',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
