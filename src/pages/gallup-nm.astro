---
// Gallup city page — Cliff Cross-Section magazine layout.
// Organizing principle: three underground stories under one hillside
// (Mancos heave · deep collapsible settlement · coal-mine voids).
// Signature: Cliff Cross-Section — soil bands panel-select; mine void
// is a broken gap (not a third equal soil layer), same tap-to-open as bands.
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Gallup, NM | TLS Foundations';
const description =
  'Foundation repair in Gallup, NM. Mancos Shale heave, deep collapsible soil, and old coal mine voids beneath parts of the Gallup coal field -- TLS Foundations investigates before recommending.';
const summary =
  "Gallup sits where the Gallup Sandstone meets the Mancos Shale beneath it, on top of well over a century of coal mining. We've measured both heave and deep collapsible settlement around Gallup, and we've also run into old mine workings and cavities that don't show up on any map -- which is exactly why a proper investigation matters more than assuming which one a given house has.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        datePublished: '2026-11-18',
        dateModified: '2026-11-19',
        headline: 'Foundation Repair in Gallup, NM',
        description,
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Gallup, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/gallup-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [{ '@type': 'City', name: 'Gallup', addressRegion: 'NM' }],
        description:
          'Foundation repair contractor serving Gallup, NM. Slab repair, foundation inspection, settlement, heave, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Gallup NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Gallup sits where the Gallup Sandstone meets the Mancos Shale beneath it. Depending on the specific lot, the cause can be expansive shale heave, deep collapsible soil settlement, or both. The mix varies by which formation is closer to the surface at that address, not by which side of town it's on.",
            },
          },
          {
            '@type': 'Question',
            name: 'Is Gallup’s soil the same as Farmington or the rest of the Four Corners?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Similar mechanisms, same basin. We've measured both heave and deep collapsible settlement around Gallup, the same two mechanisms we see throughout the San Juan Basin -- Farmington, Aztec, and Bloomfield included. The specific mix at a given address still has to be checked, not assumed from the region.",
            },
          },
          {
            '@type': 'Question',
            name: 'Are there old coal mines under homes in Gallup?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "In some areas, yes. State geological records catalog 129 known mines across the Gallup coal field, and a 2015 sinkhole opened above the abandoned Allison Mine on the city's west side. It's not every lot, and a mine map gap doesn't mean there's nothing there -- we've personally encountered old workings and cavities that don't show up on any map. That's worth ruling out before assuming the movement is a soil problem at all.",
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in Gallup?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. A drainage correction and a pier system differ by an order of magnitude, and both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies more than the house.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers or push piers used for foundation repair in Gallup?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Both get used in this area, and the choice depends on what's actually under a given slab -- the depth and consistency of bearing material, and whether the mechanism is heave or settlement. Piers installed for settlement don't fix heave, and in some configurations make it worse.",
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Gallup, NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves Gallup, NM with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with SandiaGEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 -- you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'Four Corners', item: 'https://www.tlsfoundations.com/four-corners' },
          { '@type': 'ListItem', position: 3, name: 'Gallup, NM', item: 'https://www.tlsfoundations.com/gallup-nm' },
        ],
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  ogImage="/images/four-corners-hero.webp"
  summary={summary}
  pageName="Gallup"
  nextPage={{ path: '/four-corners', name: 'Four Corners' }}
>
  <div class="gal-page">
    <div class="hero">
      <div class="hero-content">
        <span class="hero-city">Gallup, New Mexico</span>
        <span class="hero-eyebrow">Foundation Repair</span>
        <h1 class="hero-h1">
          <span class="w1">Red</span><span class="w2">rock country.</span>
          <span class="w3">Straight answers underneath.</span>
        </h1>
        <p class="hero-sub">Three underground stories under one hillside — shale heave, collapsible settlement, and mine voids that soil maps alone won't show.</p>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="statement-band">
      <div class="statement-band-inner">
        <span class="statement-band-line1">Foundation Repair</span>
        <span class="statement-band-line2">Gallup, New Mexico.</span>
        <p class="statement-band-secondary">The cliffs have a name. Under them: Mancos Shale, collapsible ground, and — in places — a century of coal workings. The view doesn't tell you which one is moving your slab.</p>
      </div>
    </div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Gallup</span>
        <ul class="nav-links">
          <li><a href="#the-stack"><span class="nav-dot"></span>The Stack</a></li>
          <li><a href="#mancos-heave"><span class="nav-dot"></span>Mancos Heave</a></li>
          <li><a href="#collapsible"><span class="nav-dot"></span>Collapsible Settlement</a></li>
          <li><a href="#mine-voids"><span class="nav-dot"></span>Mine Voids</a></li>
          <li><a href="#what-we-check"><span class="nav-dot"></span>What We Check Here</a></li>
          <li><a href="#before-you-sign"><span class="nav-dot"></span>Before You Sign</a></li>
          <li><a href="#questions"><span class="nav-dot"></span>Questions</a></li>
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s), or voicemail and a callback</span>
        </div>
      </nav>

      <div class="content-area">
        <!-- 01 THE STACK -->
        <section class="section" id="the-stack">
          <span class="section-num">01</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">The Stack · Gallup Sandstone on Mancos</span></div>
            <h2 class="section-heading reveal">Red rock on top. <em>Three stories underneath.</em></h2>
            <p class="lede reveal">Gallup was founded in 1881 as a railhead, named for a railroad paymaster, and grew in a valley where sandstone cliffs rise close on both sides. Geologists later named the Gallup Sandstone after this place — its type locality is here. That sandstone sits directly on the Mancos Shale: published mapping describes roughly 725 feet of marine shale at Gallup's western edge.</p>
            <p class="reveal">Two rock types, stacked, is the real story under the scenery. Add a third story that isn't rock at all — old coal workings and cavities — and a driveway diagnosis becomes a guess.</p>

            <!-- SIGNATURE: Cliff Cross-Section -->
            <div class="cliff reveal" id="cliffSection">
              <div class="cliff-label">Cliff Cross-Section</div>
              <div class="cliff-stage">
                <button type="button" class="cliff-band cliff-sandstone" data-band="sandstone" aria-pressed="false">
                  <span class="cliff-band-name">Gallup Sandstone</span>
                  <span class="cliff-band-hint">Tap to open</span>
                </button>
                <button type="button" class="cliff-band cliff-mancos" data-band="mancos" aria-pressed="false">
                  <span class="cliff-band-name">Mancos Shale</span>
                  <span class="cliff-band-hint">Tap to open</span>
                </button>
                <button type="button" class="cliff-void" data-band="void" aria-pressed="false">
                  <span class="cliff-void-gap" aria-hidden="true"></span>
                  <span class="cliff-void-label">Mine void · not a soil layer</span>
                  <span class="cliff-band-hint">Tap to open</span>
                </button>
              </div>
              <div class="cliff-panels">
                <div class="cliff-panel" data-panel="sandstone" hidden>
                  <span class="cliff-panel-tag">Formation · bearing</span>
                  <h3>Gallup Sandstone</h3>
                  <p>The red cliffs and ridges aren't just scenery — they're a formally named rock unit with its type locality at Gallup (1925). Where sandstone is the bearing ground under a slab, it is generally firm. The question that matters is what sits <em>directly</em> beneath a specific lot: sandstone, the Mancos under it, or fill.</p>
                </div>
                <div class="cliff-panel" data-panel="mancos" hidden>
                  <span class="cliff-panel-tag">Formation · heave</span>
                  <h3>Mancos Shale</h3>
                  <p>Directly beneath the sandstone: marine shale with clay minerals that expand when they absorb moisture and shrink as they dry. Where it's close to the surface or exposed by grading, that movement reaches a foundation. Damage can look like settlement. It isn't — and it calls for the opposite repair.</p>
                </div>
                <div class="cliff-panel cliff-panel-void" data-panel="void" hidden>
                  <span class="cliff-panel-tag">Not soil · void</span>
                  <h3>Old workings &amp; unmapped cavities</h3>
                  <p><mark class="key">State records catalog 129 known mines</mark> in the Gallup coal field, with maps where they exist — and cavities that no map shows. In 2015 a sinkhole opened above the abandoned Allison Mine on the city's west side. In our fieldwork we've run into old coal workings directly. This isn't a soil mechanism. It's a void where ground used to be, and it needs to be ruled in or out before anything else.</p>
                </div>
              </div>
            </div>

            <p class="atm reveal"><span class="atm-label">Atmosphere</span> Route 66 still runs the old alignment through downtown — vintage trading posts, neon, the El Rancho Hotel from 1937. That color is Gallup. It is not a diagnosis.</p>
          </div>
        </section>

        <!-- 02 MANCOS HEAVE -->
        <section class="section" id="mancos-heave">
          <span class="section-num">02</span>
          <div class="strata-strip strata-mancos reveal">
            <div class="strata-strip-num"><span>02</span></div>
            <div class="strata-strip-content">
              <h3 class="strata-strip-title">Mancos Heave</h3>
              <div class="strata-strip-tag">Expansive Shale · Opposite of Settlement</div>
            </div>
          </div>
          <div class="section-inner">
            <h2 class="section-heading reveal">Mancos heave — <em>the opposite of settlement</em></h2>
            <div class="oppose-slabs reveal">
              <div class="oppose-slab oppose-dark">
                <span class="oppose-kicker">What the shale does</span>
                <p>The Mancos Shale beneath the Gallup Sandstone contains clay minerals that <a href="/glossary#mancos-shale" class="body-link" style="color:var(--gold-lt);">expand significantly when they absorb moisture</a> and shrink as they dry. Where the shale is near the surface, wet–dry cycles reach the foundation.</p>
                <p><mark class="key">Humped driveways and heaved garage floors look like settlement to the untrained eye.</mark> They're often the opposite.</p>
              </div>
              <div class="oppose-slab oppose-light">
                <span class="oppose-kicker">What to watch</span>
                <p>Cracking that tracks wet and dry years. Floors that rise rather than sink. Movement that seems seasonal rather than one-time.</p>
                <p>None of those prove heave alone. They are reasons to ask the mechanism question before anyone prices a pier package. A pier system designed for settlement does not fix heave — and in some configurations makes it worse.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 03 COLLAPSIBLE -->
        <section class="section" id="collapsible">
          <span class="section-num">03</span>
          <div class="strata-strip strata-collapse reveal">
            <div class="strata-strip-num"><span>03</span></div>
            <div class="strata-strip-content">
              <h3 class="strata-strip-title">Collapsible Settlement</h3>
              <div class="strata-strip-tag">Deep Loose Soil · First Wetting</div>
            </div>
          </div>
          <div class="section-inner">
            <h2 class="section-heading reveal">Deep collapsible settlement — <em>first wetting, not slow creep</em></h2>
            <div class="oppose-slabs reveal">
              <div class="oppose-slab oppose-light">
                <span class="oppose-kicker">What we measure</span>
                <p>In our own fieldwork we've found deep, loose, <a href="/glossary#collapsible-soil">collapsible soil</a> around Gallup that causes real settlement — the same mechanism we've measured throughout the Four Corners, just not mapped house by house here any more than it is anywhere else in New Mexico.</p>
              </div>
              <div class="oppose-slab oppose-dark">
                <span class="oppose-kicker">Why it fools people</span>
                <p><mark class="key">Collapsible soils stay stable while dry, then lose volume rapidly the first time sustained moisture reaches them.</mark> That can happen decades after a house was built. It is a first-wetting event, not a gradual process you can assume from the hillside color.</p>
                <p class="oppose-pull">Heave and collapsible settlement can sit within sight of each other. Establishing which one is actually happening — or ruling the other out — is what determines the repair.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 04 MINE VOIDS -->
        <section class="section section-void" id="mine-voids">
          <span class="section-num">04</span>
          <div class="void-interrupt reveal">
            <div class="void-interrupt-gap" aria-hidden="true"></div>
            <div class="void-interrupt-copy">
              <span class="void-interrupt-kicker">Not a soil layer · Mechanism 03</span>
              <h2>Mine voids — <em>rule this out before you treat soil</em></h2>
              <p>Coal mining followed the railroad almost immediately — the Gallup (Gibson) Mine opened in 1882. Large-scale surface mining continued into the 1960s; the McKinley mine closed at the end of 2009. State geological records catalog <strong>129 known mines</strong> across the Gallup coal field, with maps where they exist.</p>
              <p>In 2015 a sinkhole opened above the abandoned Allison Mine on the city's west side. In our fieldwork we've encountered old workings directly — and cavities that don't show up on any map.</p>
              <p><mark class="key">A mine-map gap does not mean there is nothing there.</mark> Before assuming movement is a soil problem, this question is worth ruling out on lots where mining history or sudden voids are plausible.</p>
              <div class="void-callout">
                <span class="void-callout-label">Different problem · different tools</span>
                <p>Soil heave and collapsible settlement are ground mechanisms. A void is missing ground. Treating a void like shale — or ignoring it because the map is blank — is how you get the wrong repair.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 05 WHAT WE CHECK -->
        <section class="section" id="what-we-check">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Investigation · Gallup</span></div>
            <h2 class="section-heading reveal">What we check here — <em>before a repair has a name</em></h2>
            <div class="two-col reveal">
              <div>
                <p>Foundation inspection in Gallup means asking which formation — or which old workings — are actually under a specific address, not assuming because of what's visible on the hillside behind the house.</p>
                <p>TLS Foundations works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a>, a New Mexico geotechnical investigation firm, when site conditions warrant a formal soil investigation before repair is recommended. Sometimes the honest answer is drainage correction. Sometimes it's monitoring. Sometimes it's ruling out a void before any pier conversation starts.</p>
              </div>
              <div>
                <div class="pull">We'd rather tell you nothing is wrong than sell you something that is.</div>
                <p>55 combined years working New Mexico soils. Owner-operated — the person who looks at your home is the person who answers the phone, or calls you back.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 06 BEFORE YOU SIGN — numbered checklist (Gallup-only) -->
        <section class="section" id="before-you-sign">
          <span class="section-num">06</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Before You Sign · Numbered Checklist</span></div>
            <h2 class="section-heading reveal">Rule-outs worth making <em>before anyone prices a system</em></h2>
            <p class="lede reveal">Not a pitch — a Gallup-specific checklist. Start at the top. A quote written before these are answered is a price without a diagnosis.</p>

            <ol class="bys-list reveal">
              <li class="bys-list-item">
                <span class="bys-list-num" aria-hidden="true">01</span>
                <div>
                  <h3>Has anyone ruled out a void?</h3>
                  <p>On lots near the coal field — or where movement appeared suddenly — ask whether mine workings or unmapped cavities were considered. Soil repairs don't fix missing ground.</p>
                </div>
              </li>
              <li class="bys-list-item">
                <span class="bys-list-num" aria-hidden="true">02</span>
                <div>
                  <h3>Heave or settlement — which mechanism, and how do they know?</h3>
                  <p>Mancos heave and collapsible settlement need opposite responses. Ask for the evidence, not the product name.</p>
                </div>
              </li>
              <li class="bys-list-item">
                <span class="bys-list-num" aria-hidden="true">03</span>
                <div>
                  <h3>Who shows up — and who decides?</h3>
                  <p>You should reach the person who will stand on your lot, not a scheduler running a closing script. Call <a href="tel:5059914180">(505) 991-4180</a> — you reach the owner(s).</p>
                </div>
              </li>
            </ol>
          </div>
        </section>

        <!-- 07 QUESTIONS — seo accordion, Gallup-specific -->
        <section class="section" id="questions">
          <span class="section-num">07</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Questions · Gallup homeowners ask</span></div>
            <h2 class="section-heading reveal">Straight answers for <em>this hillside</em></h2>

            <div class="seo-accordion reveal">
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Are there old coal mines under homes in Gallup?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">In some areas, yes. State geological records catalog 129 known mines across the Gallup coal field, with maps where they exist, and in 2015 a sinkhole opened above the abandoned Allison Mine on the city's west side. It's not every lot, and a mine map gap doesn't mean there's nothing there — we've personally encountered old workings and cavities that don't show up on any map. Worth ruling out before assuming the movement is a soil problem.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Does living near the red-rock bluffs matter for my foundation?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">It can, but not the way it looks. The sandstone itself is generally firm bearing ground. The thing worth checking is what's directly beneath a specific lot — sandstone, the Mancos Shale under it, or fill — because that's what actually changes the repair, not the view.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Is Gallup's soil the same as Farmington or the rest of the Four Corners?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Similar mechanisms, same basin. We've measured both heave and deep collapsible settlement around Gallup — the same two we see throughout the San Juan Basin. The specific mix at a given address still has to be checked. Gallup also carries the mine-void question that most of the basin does not.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Slab repair and pier choice in Gallup</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Slab-on-grade is common here. A slab settling into collapsible ground needs a different answer than a slab lifted by expanding shale. Helical and push piers both get used — the choice follows depth and consistency of bearing material and whether the house is heaving or settling. Piers specified without that information are a design written on assumption.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">How much does foundation repair cost in Gallup?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Cost follows cause. A drainage correction and a pier system are separated by an order of magnitude. If estimates vary wildly with no soil evaluation behind any of them, that spread is telling you about the companies, not the house.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Do I need a soil investigation, or just a contractor?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Not every home needs one. Many questions resolve with a careful look at drainage, grading, and the pattern of movement. A formal geotechnical investigation is warranted when the answer turns on what's happening at depth — or when a void needs to be ruled out. TLS works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when a site reaches that threshold.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">What happens during a foundation inspection in Gallup?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">We look at exterior grading and drainage, cracking inside and out, door and window operation, floor elevations where warranted, and the site's history — including mining context when relevant. Then we tell you what we think is happening and what, if anything, is worth doing. That last part sometimes ends with "nothing yet."</div></div>
              </div>
            </div>
          </div>
        </section>

        <div class="contact-closer reveal">
          <div class="contact-closer-inner">
            <div class="contact-closer-text">
              <span class="section-label-text" style="display:block;margin-bottom:16px;">Ready to talk</span>
              <p>We've worked this ground — shale, collapsible soil, and the voids the maps miss. You reach the owner(s) when you call.</p>
            </div>
            <div class="contact-closer-phone">
              <a href="tel:5059914180">(505) 991-4180</a>
              <span class="note">Text or call — your choice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.documentElement.classList.add('js-reveal');

  const progressFill = document.getElementById('progressFill');
  const contentArea = document.querySelector('.content-area');
  window.addEventListener(
    'scroll',
    () => {
      if (!progressFill || !contentArea) return;
      const rect = contentArea.getBoundingClientRect();
      const total = (contentArea as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      (progressFill as HTMLElement).style.height = Math.min(100, (scrolled / total) * 100) + '%';
    },
    { passive: true }
  );

  const sections = document.querySelectorAll('.content-area section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove('active'));
          const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sections.forEach((s) => sectionObs.observe(s));

  navLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // Cliff Cross-Section: soil bands + void gap — same tap-to-open (no probe toy)
  const bands = document.querySelectorAll('.cliff-band, .cliff-void');
  const panels = document.querySelectorAll('.cliff-panel');

  function hidePanels() {
    panels.forEach((p) => {
      (p as HTMLElement).hidden = true;
      p.classList.remove('open');
    });
    bands.forEach((b) => {
      b.setAttribute('aria-pressed', 'false');
      b.classList.remove('active');
    });
  }

  function showPanel(id: string) {
    panels.forEach((p) => {
      const el = p as HTMLElement;
      const match = el.dataset.panel === id;
      el.hidden = !match;
      el.classList.toggle('open', match);
    });
  }

  bands.forEach((band) => {
    band.addEventListener('click', () => {
      const id = (band as HTMLElement).dataset.band!;
      const was = band.classList.contains('active');
      hidePanels();
      if (!was) {
        band.classList.add('active');
        band.setAttribute('aria-pressed', 'true');
        showPanel(id);
      }
    });
  });

  document.querySelectorAll('.seo-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.seo-item')!;
      const drawer = item.querySelector('.seo-drawer') as HTMLElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.seo-item.open').forEach((i) => {
        i.classList.remove('open');
        (i.querySelector('.seo-drawer') as HTMLElement).style.maxHeight = '0';
      });
      if (!isOpen) {
        item.classList.add('open');
        drawer.style.maxHeight = drawer.scrollHeight + 'px';
      }
    });
  });
</script>

