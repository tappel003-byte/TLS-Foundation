---
// Gallup, NM page. Same family as rio-rancho-nm.astro, santa-fe-nm.astro,
// albuquerque-nm.astro, and farmington-nm.astro -- same hero/left-nav/
// flip-card/SEO-accordion system, fresh content. Gallup is a single city
// (not a small-town cluster like Farmington/Aztec/Bloomfield), so this
// page is sized to one city's worth of real content -- six sections, no
// forced third component just to look as long as the bigger-market pages.
//
// Geology verified via web search before writing (Sears 1925; USGS
// Geolex; NMBGMR): Gallup Sandstone is a real, formally named Late
// Cretaceous unit with its type locality at Gallup, sitting directly on
// Mancos Shale (~725 ft of marine shale documented at Gallup's western
// edge). No Gallup-specific collapsible-soil study exists -- same gap as
// everywhere else in NM -- so that claim is framed as TLS's own fieldwork,
// not an uncited geological claim.
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Gallup, NM | TLS Foundations';
const description =
  'Foundation repair in Gallup, NM. Mancos Shale heave, deep collapsible soil, and the Gallup Sandstone it sits under -- TLS Foundations investigates before recommending.';
const summary =
  "Gallup sits where the Gallup Sandstone meets the Mancos Shale beneath it -- two different rock types, and the soil at a given address depends on which one is closer to the surface there. We've measured both heave and deep collapsible settlement around Gallup, which is exactly why a proper investigation matters more than assuming which one a given house has.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        datePublished: '2026-11-18',
        headline: 'Foundation Repair in Gallup, NM',
        description,
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Gallup, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/gallup-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [{ '@type': 'City', name: 'Gallup', addressRegion: 'NM' }],
        description:
          'Foundation repair contractor serving Gallup, NM. Slab repair, foundation inspection, settlement, heave, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Gallup NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Gallup sits where the Gallup Sandstone meets the Mancos Shale beneath it. Depending on the specific lot, the cause can be expansive shale heave, deep collapsible soil settlement, or both. The mix varies by which formation is closer to the surface at that address, not by which side of town it's on.",
            },
          },
          {
            '@type': 'Question',
            name: 'Is Gallup’s soil the same as Farmington or the rest of the Four Corners?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Similar mechanisms, same basin. We've measured both heave and deep collapsible settlement around Gallup, the same two mechanisms we see throughout the San Juan Basin -- Farmington, Aztec, and Bloomfield included. The specific mix at a given address still has to be checked, not assumed from the region.",
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in Gallup?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. A drainage correction and a pier system differ by an order of magnitude, and both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies more than the house.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers or push piers used for foundation repair in Gallup?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Both get used in this area, and the choice depends on what's actually under a given slab -- the depth and consistency of bearing material, and whether the mechanism is heave or settlement. Piers installed for settlement don't fix heave, and in some configurations make it worse.",
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Gallup, NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves Gallup, NM with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with SandiaGEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 -- you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'Four Corners', item: 'https://www.tlsfoundations.com/four-corners' },
          { '@type': 'ListItem', position: 3, name: 'Gallup, NM', item: 'https://www.tlsfoundations.com/gallup-nm' },
        ],
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  ogImage="/images/four-corners-hero.webp"
  summary={summary}
  pageName="Gallup"
  nextPage={{ path: '/four-corners', name: 'Four Corners' }}
>
  <div class="gal-page">
    <div class="hero">
      <div class="hero-photo"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="hero-city">Gallup, New Mexico</span>
        <span class="hero-eyebrow">Foundation Repair</span>
        <h1 class="hero-h1">
          <span class="w1">Red</span><span class="w2">rock country.</span>
          <span class="w3">Straight answers underneath.</span>
        </h1>
        <p class="hero-sub">Foundation repair in Gallup, NM — we investigate what's actually under a specific address before we recommend a repair, not after.</p>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="statement-band">
      <div class="statement-band-inner">
        <span class="statement-band-line1">Foundation Repair</span>
        <span class="statement-band-line2">Gallup, New Mexico.</span>
        <p class="statement-band-secondary">The cliffs around Gallup have a name. Your foundation problem should have an actual cause, not a guess from the sidewalk.</p>
      </div>
    </div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Gallup, NM</span>
        <ul class="nav-links">
          <li><a href="#what-we-see"><span class="nav-dot"></span>What We See</a></li>
          <li><a href="#history"><span class="nav-dot"></span>History</a></li>
          <li><a href="#geology"><span class="nav-dot"></span>Geology</a></li>
          <li><a href="#approach"><span class="nav-dot"></span>Our Approach</a></li>
          <li><a href="#difference"><span class="nav-dot"></span>Before You Sign</a></li>
          <li><a href="#questions"><span class="nav-dot"></span>Common Questions</a></li>
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s), or voicemail and a callback</span>
        </div>
      </nav>

      <div class="content-area">
        <section class="section" id="what-we-see">
          <span class="section-num">01</span>
          <div class="section-inner">
            <span class="section-label-text" style="display:block;margin-bottom:8px;">Gallup, NM · What We See</span>
            <h2 class="section-heading reveal">Foundation repair in Gallup — <em>what's actually happening under your home</em></h2>
            <div class="reveal">
              <p class="lede">A foundation problem in Gallup is not automatically one thing. The ground here is a stack, not a single layer — the Gallup Sandstone that forms the area's red cliffs sits directly on the Mancos Shale beneath it, and which one is closer to the surface at a given lot changes what you're dealing with.</p>
              <p><mark class="key">Published mapping documents the Mancos Shale at roughly 725 feet thick at Gallup's western edge, directly beneath the sandstone the city is named for.</mark> That's a better starting point than a single "it's all red rock" story, because it's closer to what's actually under these neighborhoods.</p>
              <p>The practical result: a repair that worked at a house on one side of a hill isn't automatically the right repair for a house on the other side. Similar-looking symptoms — a sloping floor, a cracked slab — don't establish the same cause. The repair should follow what's actually found, not the other way around.</p>
              <p>Foundation inspection here means understanding which formation is actually doing what, at a specific address, not assuming because of what's visible on the hillside behind the house.</p>
            </div>
          </div>
        </section>

        <section class="section" id="history">
          <span class="section-num">02</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">History</span></div>
            <h2 class="section-heading reveal">Built on the railroad. <em>Still moving.</em></h2>
            <div class="two-col reveal">
              <div>
                <p>Gallup was founded in 1881 as a railhead for the Atlantic and Pacific Railroad, named for David Gallup, the railroad's paymaster. The town grew up around the tracks, in a valley where red sandstone cliffs rise close on both sides.</p>
                <p>Route 66 reached Gallup in 1926, and the Mother Road is still part of the city's identity — vintage trading posts and neon signs remain along the old alignment through downtown. The El Rancho Hotel, built in 1937, became a regular stop for Hollywood film crews shooting Westerns in the surrounding red-rock country through the 1940s and '50s, with John Wayne among the guests.</p>
                <p>Gallup was later named America's Most Patriotic Small Town by Rand McNally — a distinction the city still carries since the contest was discontinued.</p>
              </div>
              <div>
                <div class="fact-box">
                  <span class="section-label-text" style="display:block;margin-bottom:14px;color:var(--gold);">Gallup Sandstone — The Rock, By Name</span>
                  <p>The red cliffs and ridges around Gallup aren't just scenery — they're a formally named rock unit. Geologists named the Gallup Sandstone after the city in 1925, and its type locality — the reference exposure geologists point to when defining the formation — is here.</p>
                  <p>It sits directly on the Mancos Shale, which published mapping describes as roughly 725 feet of marine shale at Gallup's western edge. Two different rock types, stacked, is the real story under the scenery.</p>
                </div>
              </div>
            </div>
            <div class="pull reveal">A Route 66 town deserves more than a drive-by diagnosis — the same way a red-rock skyline deserves more than a guess about what's actually underneath it.</div>
          </div>
        </section>

        <section class="section" id="geology">
          <span class="section-num">03</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Geology</span></div>
            <h2 class="section-heading reveal">Two unrelated mechanisms, <em>one hillside</em></h2>
            <p class="reveal" style="max-width:100%;">Around Gallup, we've measured both heave and deep collapsible settlement — the same two mechanisms that show up throughout the San Juan Basin, Farmington included. They're not sorted neatly by neighborhood. A diagnosis that assumes one without checking is a diagnosis that's guessing.</p>

            <div class="flip-cards reveal">
              <div class="flip-card" tabindex="0" role="button" aria-label="Expansive Mancos Shale — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">1</span>
                    <div>
                      <div class="flip-title">Expansive Mancos Shale</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 01</span>
                    <p class="flip-body">The Mancos Shale directly beneath the Gallup Sandstone contains clay minerals that <a href="/glossary#mancos-shale" class="body-link" style="color:var(--gold-text);">expand significantly when they absorb moisture</a> and shrink as they dry. Where it's close to the surface or exposed by grading, that movement reaches a foundation. The damage — humped driveways, heaved garage floors — looks like settlement to the untrained eye. It's the opposite, and it calls for the opposite repair.</p>
                    <span class="flip-tag">Foundation heave · Gallup, NM</span>
                  </div>
                </div>
              </div>
              <div class="flip-card" tabindex="0" role="button" aria-label="Deep collapsible soil — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">2</span>
                    <div>
                      <div class="flip-title">Deep Collapsible Soil</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 02</span>
                    <p class="flip-body">In our own fieldwork, we've found deep, loose, collapsible soil around Gallup that causes real settlement — the same mechanism we've measured throughout the Four Corners, just not mapped house by house here any more than it is anywhere else in New Mexico. Collapsible soils stay stable while dry, then lose volume rapidly the first time sustained moisture reaches them. That's a first-wetting event, not a slow process, and it can happen decades after a house was built.</p>
                    <span class="flip-tag">Settlement · Gallup area</span>
                  </div>
                </div>
              </div>
              <div class="flip-card" tabindex="0" role="button" aria-label="Two formations, one hillside — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">3</span>
                    <div>
                      <div class="flip-title">Two Formations, One Hillside</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 03</span>
                    <p class="flip-body">The Gallup Sandstone sits on the Mancos Shale, which in turn sits on older marine rock — a real stack, not one uniform "red rock" layer. Which one is closest to the surface at a specific lot determines whether expansive shale, collapsible fill, or firm sandstone bearing is actually under the slab. A blanket explanation for "Gallup soil" is too coarse to be useful at a specific address.</p>
                    <span class="flip-tag">Variable bedrock · Gallup Sandstone / Mancos Shale contact</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="pull reveal">Heave and deep collapsible settlement both show up around Gallup, sometimes within sight of each other. Establishing which one is actually happening is what determines the right repair.</div>
          </div>
        </section>

        <section class="section" id="approach">
          <span class="section-num">04</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Our Approach</span></div>
            <h2 class="section-heading reveal">Foundation investigation in Gallup — <em>before everything else</em></h2>
            <div class="two-col reveal">
              <div>
                <p><mark class="key">Here's what a same-day quote can't account for: which mechanism is actually under that specific slab, at what depth, and what the water has been doing to it for decades.</mark> A heaving-shale lot and a collapsible-soil lot a few streets apart are different problems with different answers. Nobody can tell them apart from the sidewalk.</p>
              </div>
              <div>
                <div class="pull">We'd rather tell you nothing is wrong than sell you something that is.</div>
                <p>TLS Foundations works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a>, a New Mexico geotechnical investigation firm, when site conditions warrant a formal soil investigation before repair is recommended. Sometimes the honest answer is drainage correction. Sometimes it's monitoring and nothing else. The investigation is what tells you which.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="difference">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Before You Sign</span></div>
            <h2 class="section-heading reveal">Three things worth <em>asking first</em></h2>
            <p class="lede reveal">Not a pitch — three questions worth asking any foundation contractor before you sign anything.</p>

            <div class="flip-cards reveal">
              <div class="flip-card abc" tabindex="0" role="button" aria-label="Get the soil looked at first. Tap to learn more.">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">1</span>
                    <div>
                      <div class="flip-title">Get the soil looked at first.</div>
                      <p class="flip-front-sub">Before a recommendation. Before a number. Before anything.</p>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Assessment</span>
                    <p class="flip-body">The ground under a home is the only thing that makes an estimate mean anything. Expansive shale here, collapsible silt there, sometimes both within a block. TLS works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when a formal soil investigation is warranted — before any repair method is recommended, not after.</p>
                    <span class="flip-tag">Investigation first</span>
                  </div>
                </div>
              </div>
              <div class="flip-card abc" tabindex="0" role="button" aria-label="Know your soil before you sign. Tap to learn more.">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">2</span>
                    <div>
                      <div class="flip-title">Know your soil before you sign.</div>
                      <p class="flip-front-sub">Heave and settlement need opposite repairs. Guessing wrong makes it worse.</p>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Before You Sign</span>
                    <p class="flip-body">Ask any contractor what mechanism is actually driving your movement and how they know. A pier installed for settlement doesn't fix heave — in some configurations it makes it worse. Get the diagnosis first. The estimate means something once you have it, and not before.</p>
                    <span class="flip-tag">Diagnosis before discount</span>
                  </div>
                </div>
              </div>
              <div class="flip-card abc" tabindex="0" role="button" aria-label="You reach the owner, not a rep. Tap to learn more.">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">3</span>
                    <div>
                      <div class="flip-title">You reach the owner, not a rep.</div>
                      <p class="flip-front-sub">The only thing that should close on a first visit is the list of what we still need to find out.</p>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Owner-Operated</span>
                    <p class="flip-body">55 combined years working New Mexico soils. Owner-operated, which means the person who looks at your home is the person who answers the phone — or calls you back if we're out under someone else's house. No scheduler, no commissioned rep, no expiring offer. If your foundation is fine, we'll tell you that and leave.</p>
                    <span class="flip-tag">TLS Foundations · Gallup, NM</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="questions">
          <span class="section-num">06</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Common Questions · Gallup, NM</span></div>
            <h2 class="section-heading reveal">Foundation repair questions <em>Gallup homeowners ask</em></h2>
            <p class="reveal" style="max-width:680px;">Methods, costs, and what to expect — answered for this market specifically, not in general.</p>

            <div class="seo-accordion reveal">
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Slab repair in Gallup, NM</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Slab-on-grade construction is common in Gallup, so slab repair is a frequent question in this market. The right approach depends on the mechanism: a slab settling into a soft or collapsible zone needs a different answer than a slab being lifted by expanding shale. Those two can look similar from inside the house and require opposite responses.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Foundation repair cost in Gallup</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Cost follows cause. A drainage correction and a pier system are separated by an order of magnitude, and both get recommended for the same set of symptoms by different companies. If estimates in this area vary wildly with no soil evaluation behind any of them, that spread is telling you about the companies, not the house.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Is Gallup's soil the same as Farmington or the rest of the Four Corners?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Similar mechanisms, same basin. We've measured both heave and deep collapsible settlement around Gallup — the same two mechanisms we see throughout the San Juan Basin, Farmington included. The specific mix at a given address still has to be checked, not assumed from the region.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Helical or push piers — which one for Gallup?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Both get used here, and the choice depends on what's actually under a given slab — the depth and consistency of bearing material, and whether the house is heaving or settling. Piers specified without that information are a design written on assumption rather than evidence.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Does living near the red-rock bluffs matter for my foundation?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">It can, but not the way it looks. The sandstone itself is generally firm bearing ground. The thing worth checking is what's directly beneath a specific lot — sandstone, the Mancos Shale under it, or fill soil — because that's what actually changes the repair, not the view.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Do I need a soil investigation, or just a contractor?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">Not every home needs one. Many questions in this area resolve with a careful look at drainage, grading, and the pattern of movement inside the house. A formal geotechnical investigation is warranted when the answer genuinely turns on what's happening at depth — and in those cases, the cost of the investigation is small against the cost of installing the wrong system. TLS works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when a site reaches that threshold.</div></div>
              </div>
              <div class="seo-item">
                <button class="seo-trigger"><span class="seo-trigger-text">Foundation inspection in Gallup — what happens?</span><span class="seo-trigger-icon">+</span></button>
                <div class="seo-drawer"><div class="seo-drawer-inner">We look at exterior grading and drainage, the pattern and location of cracking inside and out, door and window operation, floor elevations where warranted, and the site's history. Then we tell you what we think is happening and what, if anything, is worth doing about it. That last part sometimes ends with "nothing yet."</div></div>
              </div>
            </div>
          </div>
        </section>

        <div class="contact-closer reveal">
          <div class="contact-closer-inner">
            <div class="contact-closer-text">
              <span class="section-label-text" style="display:block;margin-bottom:16px;">Ready to talk</span>
              <p>We've worked this ground. We know what it does here, and how much it can change from one street to the next. You reach the owner(s) when you call.</p>
            </div>
            <div class="contact-closer-phone">
              <a href="tel:5059914180">(505) 991-4180</a>
              <span class="note">Text or call — your choice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const progressFill = document.getElementById('progressFill');
  const contentArea = document.querySelector('.content-area');
  window.addEventListener(
    'scroll',
    () => {
      if (!progressFill || !contentArea) return;
      const rect = contentArea.getBoundingClientRect();
      const total = (contentArea as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      (progressFill as HTMLElement).style.height = Math.min(100, (scrolled / total) * 100) + '%';
    },
    { passive: true }
  );

  const sections = document.querySelectorAll('.content-area section[id], .content-area div[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove('active'));
          const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sections.forEach((s) => sectionObs.observe(s));

  navLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  function toggleFlip(card: Element) {
    const isMobile = window.innerWidth <= 960;
    if (!isMobile) {
      const grid = card.closest('.flip-cards');
      grid?.querySelectorAll('.flip-card').forEach((c) => {
        if (c !== card) c.classList.remove('flipped');
      });
    }
    card.classList.toggle('flipped');
  }
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', () => toggleFlip(card));
    card.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        e.preventDefault();
        toggleFlip(card);
      }
    });
  });

  document.querySelectorAll('.seo-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.seo-item')!;
      const drawer = item.querySelector('.seo-drawer') as HTMLElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.seo-item.open').forEach((i) => {
        i.classList.remove('open');
        (i.querySelector('.seo-drawer') as HTMLElement).style.maxHeight = '0';
      });
      if (!isOpen) {
        item.classList.add('open');
        drawer.style.maxHeight = drawer.scrollHeight + 'px';
      }
    });
  });
</script>

