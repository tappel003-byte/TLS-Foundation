  id: string;
  q: string;
  teaser: string;
  tags: string[];
  p: string;
  nmNote: string;
  industryNote: string;
  primaryLinks: { href: string; text: string }[];
  relatedTerms: { href: string; text: string }[];
  relatedFaq: { href: string; text: string }[];
}

