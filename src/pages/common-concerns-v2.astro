<script>
  interface ConcernEl { el: HTMLElement; tags: string[] }

  function initCommonConcerns() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.concern-card'));
    const items: ConcernEl[] = cards.map((el) => ({ el, tags: (el.dataset.tags || '').split(',').filter(Boolean) }));
    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="concern-tag"]'));
    const clearBtn = document.getElementById('facetClear') as HTMLButtonElement | null;
    const matchedLead = document.getElementById('matchedLead') as HTMLElement | null;
    const list = document.getElementById('concernList') as HTMLElement | null;

    function openCard(el: HTMLElement) {
      el.classList.add('is-open');
      const head = el.querySelector('.concern-head');
      head?.setAttribute('aria-expanded', 'true');
    }
    function closeCard(el: HTMLElement) {
      el.classList.remove('is-open');
      const head = el.querySelector('.concern-head');
      head?.setAttribute('aria-expanded', 'false');
    }
    function toggleCard(el: HTMLElement) {
      if (el.classList.contains('is-open')) closeCard(el);
      else openCard(el);
    }

    cards.forEach((card) => {
      const head = card.querySelector<HTMLButtonElement>('[data-toggle]');
      head?.addEventListener('click', () => toggleCard(card));
    });

    function reorder() {
      const checked = checkboxes.filter((c) => c.checked).map((c) => c.value);
      clearBtn?.toggleAttribute('hidden', checked.length === 0);

      if (checked.length === 0) {
        if (matchedLead) matchedLead.hidden = true;
        cards.forEach((c) => c.classList.remove('is-dimmed'));
        // Restore original document order.
        items.forEach(({ el }) => list?.appendChild(el));
        return;
      }

      const scored = items.map((it) => ({ it, score: it.tags.filter((t) => checked.includes(t)).length }));
      scored.sort((a, b) => b.score - a.score);
      scored.forEach(({ it, score }) => {
        list?.appendChild(it.el);
        it.el.classList.toggle('is-dimmed', score === 0);
      });
      const matchCount = scored.filter((s) => s.score > 0).length;
      if (matchedLead) {
        matchedLead.hidden = false;
        matchedLead.textContent = matchCount > 0
          ? `${matchCount} of 18 closely match what you checked -- moved to the top`
          : 'No close matches -- here are all eighteen, most-asked first';
      }
    }

    checkboxes.forEach((cb) => cb.addEventListener('change', reorder));
    clearBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      reorder();
    });

    // Related-question links point at #<id> anchors on this same page --
    // open and scroll to that card instead of relying on default anchor jump.
    document.querySelectorAll<HTMLAnchorElement>('.related-faq-link').forEach((a) => {
      a.addEventListener('click', (e) => {
        const targetId = a.dataset.target;
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        e.preventDefault();
        openCard(target);
        const offset = 100;
        const pos = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: pos, behavior: 'smooth' });
        history.replaceState(null, '', `#${targetId}`);
      });
    });

    // Arriving with a #hash (from another page, or a shared link) -- open
    // and scroll to that specific concern on load.
    const initialId = window.location.hash.replace('#', '');
    if (initialId) {
      const target = document.getElementById(initialId);
      if (target) {
        openCard(target);
        setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
      }
    }
  }
  document.addEventListener('DOMContentLoaded', initCommonConcerns);
</script>
