    --blue-mid: #2a5480;
    --tls-gold: #b8860b;
    --gold-light: #d4a017;
    --gold-text: #7d5c08;
    --tls-sand: #f5efe6;
    --tls-stone: #e0d5c5;
    --tls-slate: #4a5568;
    --muted: #54626f;
    --dark: #1a1a1a;
    --tls-cream: #fdfaf6;
    --gutter: 64px;
