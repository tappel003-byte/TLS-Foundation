---
// DRAFT -- not linked from live nav except the temp "Draft (temp)" folder.
// Live "/" (index.astro) is untouched.
//
// First pass just reskinned the live homepage's widgets (accordion stack
// -> tab strip). Content was verbatim identical -- which is the exact
// "same page, different wrapper" problem Tim called out sitewide. This
// pass reworks the content itself:
// - Cut the "Dark Band" section entirely -- it restated the 55-years/NM
//   soils stat the page had already made in the stat band, with no new
//   information, just moodier prose.
// - Trimmed Tab 1's opening paragraph, which restated the Method
//   Statement directly above it ("the method follows the diagnosis") in
//   different words.
// - Cut "you reach the owner(s)" from 4 mentions down to 1 explicit
//   statement (in the tab panel, where it's actually explained) plus one
//   fresh, non-verbatim callback in the closer.
// - Fixed a real contradiction: the close claimed "we don't have an
//   About Us page... it's not about us" directly under a Story section
//   that IS about-us content. Rewrote the close to argue urgency instead
//   of making a claim the page itself was disproving.
import Layout from '../layouts/Layout.astro';

const title = 'TLS Foundations — New Mexico Foundation Repair';
const summary =
  "TLS Foundations is an owner-operated New Mexico foundation repair contractor with 55 combined years working the state's soils. The core position: the repair method should follow a real diagnosis, not the other way around, and TLS's affiliate Sandia GEO keeps investigation and repair as separate revenue streams so the recommendation isn't shaped by what gets sold. Six repair methods are carried -- helical piers, push piers, micropiles, compaction grouting, foam injection, and drainage correction -- because carrying a broad enough toolkit is what actually lets the diagnosis lead. The rest of the site exists to explain that reasoning in detail, region by region and question by question, rather than asking for trust upfront.";
const description =
  "We don't guess a fix and work backward; we read the site and let the remedy follow. 55 years of New Mexico foundation and geotechnical experience.";

const services = [
  { id: 'helical-piers', name: 'Helical Piers', description: 'A steel shaft with helical plates, rotated into the ground by torque -- not by pushing against the structure. The correct pier solution for most New Mexico residential foundations.' },
  { id: 'push-piers', name: 'Push Piers', description: "Installed by jacking against the structure's dead load. Appropriate for commercial and heavy structures. Not the right solution for most NM wood-frame residential homes." },
  { id: 'micropiles', name: 'Micropiles', description: 'Small-diameter drilled and grouted piers -- used when hard rock, cobbles, or dense caliche prevents helical installation, or when bearing depth is significant.' },
  { id: 'compaction-grouting', name: 'Compaction Grouting', description: 'Pressure-injected grout that densifies loose or collapsible soils beneath a structure. Appropriate for specific soil conditions -- not a universal fix.' },
  { id: 'foam-injection', name: 'Foam Injection', description: 'Void filling and slab stabilization using expanding polyurethane foam. Used where underlying soil conditions are understood and appropriate for the method.' },
  { id: 'drainage-correction', name: 'Surface & Drainage Correction', description: 'Many New Mexico foundation problems are moisture problems. Correcting drainage and surface grade is sometimes the complete repair -- not a consolation prize.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Foundation Repair Services',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.name,
        description: s.description,
        url: `https://www.tlsfoundations.com/foundation-repair-methods#${s.id}`,
        provider: { '@type': 'LocalBusiness', name: 'TLS Foundations' },
        areaServed: { '@type': 'State', name: 'New Mexico' },
        serviceType: 'Foundation repair',
      },
    })),
  },
];
---

<Layout
  title={title}
  description={description}
  footer="full"
  schema={schema}
  summary={summary}
  pageName="Home"
  nextPage={{ path: '/our-approach', name: 'Our Approach' }}
>
  <section class="hero">
    <img class="hero-photo" src="/images/home-hero.webp" alt="Sandia Mountains sunrise, New Mexico" fetchpriority="high" />
    <div class="hero-overlay"></div>
    <div class="tls-hero-wrap">
      <div class="tls-hero-box">
        <h1 class="tls-hero-headline">We fix foundations.</h1>
        <span class="tls-hero-sub"
          >We don't guess a fix and work backward; we read the site and let the remedy follow.</span
        >
      </div>
    </div>
  </section>

  <main class="tls-home">
    <section class="notice-router">
      <div class="notice-inner">
        <span class="notice-eyebrow">Not sure where to start?</span>
        <h2 class="notice-headline">What are you noticing?</h2>
        <p class="notice-sub">Pick what's going on. Every card below leads to a real answer — not a contact form.</p>
        <div class="notice-grid">
          <a href="/symptom-guide" class="notice-card">
            <span class="notice-card-title">Cracks, sticking doors, uneven floors</span>
            <span class="notice-card-desc">See what it usually means, and how New Mexico soil factors in.</span>
            <span class="notice-card-arrow">→</span>
          </a>
          <a href="/foundation-repair-methods#drainage-correction" class="notice-card">
            <span class="notice-card-title">Water pooling, drainage, moisture</span>
            <span class="notice-card-desc">Often the most important — and least expensive — first step.</span>
            <span class="notice-card-arrow">→</span>
          </a>
          <a href="/foundation-repair-methods" class="notice-card">
            <span class="notice-card-title">Already have a repair recommendation</span>
            <span class="notice-card-desc">Understand the method before you commit to it.</span>
            <span class="notice-card-arrow">→</span>
          </a>
          <a href="/our-approach#investigation" class="notice-card">
            <span class="notice-card-title">Want a real investigation, not a sales visit</span>
            <span class="notice-card-desc">The difference between a contractor inspection and a geotechnical one.</span>
            <span class="notice-card-arrow">→</span>
          </a>
          <a href="/why-foundations-move" class="notice-card">
            <span class="notice-card-title">Wondering why this is happening now</span>
            <span class="notice-card-desc">The soil science behind foundation movement in New Mexico.</span>
            <span class="notice-card-arrow">→</span>
          </a>
          <a href="/contact-us" class="notice-card notice-card-urgent">
            <span class="notice-card-title">Something's changing fast</span>
            <span class="notice-card-desc">Text or call — you reach the owner, not a scheduler.</span>
            <span class="notice-card-arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="story">
      <div class="story-inner">
        <p>
          There was a moment — and anyone who's been in any industry long enough knows the moment — where
          the work started feeling like work and not your calling. <span class="jm-moment"
            >This was our Jerry Maguire moment.</span
          >
        </p>
        <p>
          Foundation repair has started going a different direction. Real evaluation is giving way to sales
          volume. The soil isn't as important as the sales metric. We are watching what's happening in other
          major metro markets start to creep into New Mexico.
        </p>
        <p>So we decided to do it differently. New Mexico is home, and the people calling us deserve better than a sales process dressed up as an inspection.</p>
        <p class="story-closer">That's still the whole idea.</p>
      </div>
    </section>

    <div class="stat-band">
      <div class="stat-inner">
        <div class="stat-number">55</div>
        <div class="stat-divider"></div>
        <div>
          <span class="stat-label">Combined years and counting...</span>
          <p class="stat-desc">
            In New Mexico foundation repair and geotechnical investigation. The knowledge of this state's
            soil behavior that only comes from being here, working here, for a long time.
          </p>
        </div>
      </div>
    </div>

    <section class="method-statement">
      <div class="method-inner">
        <span class="method-eyebrow">Our approach</span>
        <div class="method-headline">The method follows the diagnosis.</div>
        <p class="method-sub">We don't lead with a solution. The soil tells us what it's doing. We listen first.</p>
      </div>
    </section>

    <!-- Three accordions replaced with one tab strip -- same three
         write-ups, one interaction instead of three separate toggles,
         and a different mechanism than the accordion stacks on Why NM's
         Different and Why Foundations Move. -->
    <section class="tabs-block">
      <div class="tabs-inner">
        <div class="tabs-header">
          <span class="tabs-eyebrow">How we operate</span>
          <div class="tabs-title">Three things that make an evaluation worth having.</div>
        </div>
        <div class="tabs-nav" role="tablist">
          <button class="tab-btn active" data-tab="investigation" role="tab" aria-selected="true">Investigation before recommendation</button>
          <button class="tab-btn" data-tab="owner" role="tab" aria-selected="false">The model</button>
          <button class="tab-btn" data-tab="soils" role="tab" aria-selected="false">New Mexico soils</button>
        </div>
        <div class="tabs-panels">
          <div class="tab-panel active" data-panel="investigation" role="tabpanel">
            <p><strong>You reach the owner(s).</strong> When you contact TLS, you are talking with an ownership team that has worked in these conditions for 55 years and counting. Not a scheduler. Not a salesperson. The people who will be on your property.</p>
            <p><strong>The evaluation is honest.</strong> We have told homeowners their foundation did not need <a href="/common-concerns#causes" class="body-link">repair</a>. We will tell you the same thing, if that is what the evidence shows. The goal is the right answer, not a sale.</p>
          </div>
          <div class="tab-panel" data-panel="owner" role="tabpanel">
            <p>Most foundation inspections are structured around finding something to sell. The inspector visiting your home typically has a financial interest in the outcome — their compensation depends on closing a job, not on giving you the most accurate picture of what your foundation is doing.</p>
            <div class="pull">
              <p>We stand behind our work. More importantly, we don't recommend work we can't stand behind.</p>
            </div>
            <p>TLS Foundations is built around a different model. Our geotechnical affiliate, Sandia GEO, generates investigation revenue independent of repair sales. When a situation calls for <a href="/our-approach#investigation" class="body-link">professional investigation rather than immediate repair</a>, we recommend it — and the business still works. The evaluation is not a loss leader. It is the work.</p>
          </div>
          <div class="tab-panel" data-panel="soils" role="tabpanel">
            <p>The Rio Grande Rift running through Albuquerque. Mancos Shale in the Four Corners. Permian karst dissolution beneath the Pecos Valley. Gypsum deposits in the Tularosa. <a href="/collapsible-soil#what-is" class="body-link">Collapsible desert soils</a> across the Jornada del Muerto. The geological knowledge that lives in this work is not in any national training manual.</p>
            <p>A repair method that works in one basin can make conditions worse in another. The difference between <a href="/glossary#heave" class="body-link">heave</a> and <a href="/glossary#settlement" class="body-link">settlement</a> — <a href="/expansive-soil#what-is" class="body-link">soil pushing up</a> versus soil pulling down — determines everything about how to respond. Misdiagnosis is consequential.</p>
            <a href="/new-mexico-soil-conditions" class="acc-link">Explore all five regions and New Mexico soils →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="services-section">
      <div class="services-section-inner">
        <div class="services-section-header">
          <span class="services-eyebrow">What we do</span>
          <h2 class="services-headline">Six methods. Hover to learn when each one applies.</h2>
        </div>
        <div class="services-grid">
          <div class="svc-item">
            Helical Piers
            <div class="tip">
              <p>A steel shaft with helical plates, rotated into the ground by torque — not by pushing against the structure. The correct pier solution for most New Mexico residential foundations.</p>
              <a href="/foundation-repair-methods#helical-piers" class="tip-link">Learn more →</a>
            </div>
          </div>
          <div class="svc-item">
            Push Piers
            <div class="tip">
              <p>Installed by jacking against the structure's dead load. Appropriate for commercial and heavy structures. Not the right solution for most NM wood-frame residential homes.</p>
              <a href="/foundation-repair-methods#push-piers" class="tip-link">Learn more →</a>
            </div>
          </div>
          <div class="svc-item">
            Micropiles
            <div class="tip">
              <p>Small-diameter drilled and grouted piers — used when hard rock, cobbles, or dense caliche prevents helical installation, or when bearing depth is significant.</p>
              <a href="/foundation-repair-methods#micropiles" class="tip-link">Learn more →</a>
            </div>
          </div>
          <div class="svc-item">
            Compaction Grouting
            <div class="tip">
              <p>Pressure-injected grout that densifies loose or collapsible soils beneath a structure. Appropriate for specific soil conditions — not a universal fix.</p>
              <a href="/foundation-repair-methods#compaction-grouting" class="tip-link">Learn more →</a>
            </div>
          </div>
          <div class="svc-item">
            Foam Injection
            <div class="tip">
              <p>Void filling and slab stabilization using expanding polyurethane foam. Used where underlying soil conditions are understood and appropriate for the method.</p>
              <a href="/foundation-repair-methods#foam-injection" class="tip-link">Learn more →</a>
            </div>
          </div>
          <div class="svc-item">
            Surface &amp; Drainage Correction
            <div class="tip">
              <p>Many New Mexico foundation problems are moisture problems. Correcting drainage and surface grade is sometimes the complete repair — not a consolation prize.</p>
              <a href="/foundation-repair-methods#drainage-correction" class="tip-link">Learn more →</a>
            </div>
          </div>
        </div>
        <a href="/foundation-repair-methods" class="acc-link">See how we approach each one →</a>
      </div>
    </section>

    <!-- Contact close: a split layout (headline left, contact card right)
         instead of the centered three-column band used verbatim on Why
         NM's Different and Why Foundations Move. -->
    <section class="contact-close">
      <div class="contact-split">
        <div class="contact-split-text">
          <span class="contact-eyebrow">Ready when you are</span>
          <h2 class="contact-headline">
            Foundation problems don't get better while you wait. Text or call — you'll reach the people
            who'll actually be at your house, not a scheduler.
          </h2>
          <p class="contact-sub">Real answers, no sales script.</p>
        </div>
        <div class="contact-card">
          <div class="contact-option">
            <span class="contact-option-label">Text</span>
            <a href="sms:5059914180" class="contact-option-value">Send a text →</a>
            <span class="contact-option-note">Usually same day</span>
          </div>
          <div class="contact-option">
            <span class="contact-option-label">Call</span>
            <a href="tel:5059914180" class="contact-option-value">(505) 991-4180</a>
            <span class="contact-option-note">No hold music, no script</span>
          </div>
          <div class="contact-option">
            <span class="contact-option-label">Location</span>
            <span class="contact-option-value">Albuquerque,&nbsp;New Mexico</span>
            <span class="contact-option-note">The state is our office</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function initTabs() {
    const nav = document.querySelector('.tabs-nav');
    if (!nav) return;
    const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('.tab-btn'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.tab-panel'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.tab;
        buttons.forEach((b) => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === key));
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initTabs);
</script>

<style>
  /* ── HERO (native Squarespace section-background-image + text overlay code block) ── */
  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-photo {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    object-position: center;
    animation: kenburns 20s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    0% {
      transform: scale(1) translate(1%, 0);
    }
    100% {
      transform: scale(1.06) translate(-1%, 0.5%);
    }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 34, 56, 0.15);
  }
  .tls-hero-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    background: transparent;
    padding: 0 clamp(20px, 5vw, 80px) clamp(40px, 6vw, 80px);
  }
  .tls-hero-box {
    display: inline-block;
    background: rgba(13, 34, 56, 0.65);
    padding: 28px 40px 32px;
  }
  .tls-hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
    display: block;
  }
  .tls-hero-sub {
    font-family: 'Source Serif 4', serif;
    font-size: clamp(15px, 1.8vw, 18px);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    font-style: italic;
    margin-top: 12px;
    display: block;
  }

  /* ── page-specific layout tokens (kept off :root — Astro scopes real elements, not :root) ── */
