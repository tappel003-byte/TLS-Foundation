    padding: 72px var(--gutter);
    border-bottom: 2px solid var(--gold);
  }
  .stat-inner {
    max-width: var(--col);
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 56px;
  }
  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 120px;
    font-weight: 700;
    color: var(--cream);
    line-height: 1;
    flex-shrink: 0;
    letter-spacing: -4px;
  }
  .stat-divider {
    width: 1px;
    height: 96px;
    background: rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }
