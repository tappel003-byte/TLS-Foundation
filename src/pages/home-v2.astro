    color: var(--gold-text);
  }
  /* ── NOTICE ROUTER ── */
  .notice-router {
    padding: 80px var(--gutter);
    border-bottom: 1px solid var(--stone);
    background: var(--sand);
  }
  .notice-inner {
    max-width: var(--acc-max);
    margin: 0 auto;
    text-align: center;
  }
  .notice-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-text);
    display: block;
    margin-bottom: 16px;
  }
  .notice-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    color: var(--blue);
    margin-bottom: 16px;
  }
  .notice-sub {
    font-size: 16px;
    font-weight: 300;
    color: var(--slate);
    max-width: 480px;
    margin: 0 auto;
  }
  .notice-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
    text-align: left;
  }
  .notice-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--stone);
    border-left: 4px solid transparent;
    padding: 28px 24px;
