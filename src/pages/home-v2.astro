    border-left-color: var(--gold);
    box-shadow: 0 16px 28px -20px rgba(0, 0, 0, 0.2);
    transform: translateY(-3px);
  }
  .notice-card-urgent {
    background: var(--blue);
    border-color: var(--blue);
  }
  .notice-card-urgent:hover {
    border-left-color: var(--gold-light);
  }
  .notice-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--blue);
    line-height: 1.3;
    margin-bottom: 8px;
  }
  .notice-card-urgent .notice-card-title {
    color: white;
  }
  .notice-card-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.6;
    flex: 1;
  }
  .notice-card-urgent .notice-card-desc {
    color: rgba(255, 255, 255, 0.75);
  }
  .notice-card-arrow {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    color: var(--gold-text);
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .notice-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .notice-grid {
      grid-template-columns: 1fr;
    }
  }

  .story {
    padding: 64px var(--gutter);
    border-bottom: 1px solid var(--stone);
    background: var(--cream);
  }
  .story-inner {
    max-width: var(--col);
