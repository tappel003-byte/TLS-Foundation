// topic and padding it out would be the same filler problem the Methods
// page cards were fixed for earlier. [TIM: ...] marks spots needing real
// field experience instead of guesses.
import Layout from '../layouts/Layout.astro';

const title = 'Monitoring in New Mexico Foundation Repair | TLS Foundations';
const summary =
  'Monitoring means tracking a foundation\'s elevation or crack width over time to determine whether movement is active, stable, or seasonal -- before recommending a repair. Not every crack needs repair, and no sales-only company can recommend monitoring, since it generates no revenue. It is the legitimate answer when movement is cosmetic, stable, or seasonal, and the wrong answer when it is not.';
const description =
  'What monitoring actually involves, why it is a legitimate recommendation and not a stall tactic, and when watching is the right call versus acting now.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Monitoring in New Mexico Foundation Repair',
    description,
    about: description,
    author: { '@type': 'Organization', name: 'TLS Foundations' },
    publisher: { '@type': 'Organization', name: 'TLS Foundations' },
    url: 'https://www.tlsfoundations.com/monitoring-deep-dive',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Foundation Repair Methods', item: 'https://www.tlsfoundations.com/foundation-repair-methods' },
      { '@type': 'ListItem', position: 3, name: 'Monitoring', item: 'https://www.tlsfoundations.com/monitoring-deep-dive' },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  footer="minimal"
  schema={schema}
  summary={summary}
  pageName="Monitoring"
  nextPage={{ path: '/foundation-repair-methods', name: 'Foundation Repair Methods' }}
>
  <div class="tls-article" id="top">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Methods · Monitoring</span>
        <h1>Monitoring —<br /><em>When Waiting Is the Right Call</em></h1>
        <p class="page-hero-sub">Not every issue needs immediate intervention. What monitoring actually involves, and why it's a real recommendation, not a stall tactic.</p>
      </div>
    </section>

    <div class="article-outer">
      <article class="article-body">
        <p class="article-lede">Monitoring is the one item in the toolkit that isn't a repair at all — it's a decision to wait and watch, made deliberately rather than by default. That distinction matters more than it sounds like it should.</p>

        <div class="article-section" id="what-it-is">
          <h2>What Monitoring <em>Actually Involves</em></h2>
          <p class="opening">Monitoring means tracking a foundation's elevation or crack width over time at fixed points — not a one-time visual check, but repeated measurements spaced out over weeks or months.</p>
          <p>In practice that's crack monitors or periodic measurements at consistent locations, compared over time to establish a pattern: is the movement active and progressing, has it stabilized, or is it seasonal — expanding and contracting with moisture cycles rather than trending in one direction. That pattern is what determines whether repair is actually warranted, and if so, how urgently. [TIM: roughly how long does a monitoring period actually run before you have enough data to call it one way or the other — weeks, a full seasonal cycle, something else?]</p>
        </div>

        <div class="article-section" id="why-it-is-legitimate">
          <h2>Why This Is a <em>Legitimate Recommendation</em></h2>
          <p class="opening">A company that only makes money on repairs has no incentive to ever tell a homeowner to wait — which is exactly why it's worth naming plainly when waiting genuinely is the right answer.</p>
          <p>Not every crack needs repair. Seasonal movement can stabilize on its own. Some movement is cosmetic rather than structural. Monitoring is how you find out which one you're actually looking at, instead of guessing — or being sold a repair for a problem that was never going to get worse.</p>
        </div>

        <div class="article-section" id="misconceptions">
          <h2>What People <em>Get Wrong</em></h2>
          <ul class="key-points">
            <li><strong>"Recommending monitoring means they don't want the job"</strong> — it means the honest answer right now is that repair isn't warranted yet. That's a real answer, not an evasion.</li>
            <li><strong>"Waiting is always risky"</strong> — sometimes it is. Sometimes the movement genuinely is seasonal or already stable, and repair would be premature. The point of monitoring is telling those two situations apart instead of assuming.</li>
            <li><strong>"One visit is enough to know"</strong> — a single measurement tells you where things stand today, not whether they're moving. That takes tracking over time.</li>
          </ul>
        </div>

        <a href="#top" class="back-to-top">↑ Back to top</a>

        <p class="closing-link"><a href="/foundation-repair-methods" class="body-link">← Back to Foundation Repair Methods</a> · <a href="/glossary#monitoring" class="body-link">Glossary: Monitoring →</a></p>
      </article>
    </div>
  </div>
</Layout>

