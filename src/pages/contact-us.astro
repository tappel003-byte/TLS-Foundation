---
// Contact Us. Built from the user-pasted code blocks: photo hero (fixed
// background-image, no Ken Burns per the source CSS), contact-section body
// with the Sandia GEO structural note, and a page-specific footer
// service-area block (a city list here, rather than a prose paragraph).
import Layout from '../layouts/Layout.astro';

const title = 'Contact TLS Foundations — New Mexico Foundation Repair';
const description =
  "Text or call and you reach the owner(s). TLS Foundations and Sandia GEO keep investigation and repair as separate revenue streams, so the recommendation follows the evidence, not the invoice.";

const serviceAreaText = `Albuquerque · Rio Rancho · Santa Fe · Las Cruces · Roswell · Placitas ·
      Farmington · Clovis · Hobbs · Alamogordo · Carlsbad ·
      Gallup · Los Lunas · Española · Las Vegas · Taos ·
      Artesia · Lovington · Portales · Silver City · Deming ·
      Ruidoso · Socorro · Truth or Consequences · Grants ·
      Bernalillo · Belen · Los Alamos · Shiprock · Aztec · Bloomfield ·
      Sunland Park · Anthony · Chaparral · North Valley · South Valley ·
      Rio Communities · Edgewood · Tijeras · Moriarty · Estancia ·
      Tucumcari · Clayton · Raton · Cimarron · Angel Fire · Taos Ski Valley`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: 'https://www.tlsfoundations.com/contact-us',
    mainEntity: {
      '@type': 'LocalBusiness',
      name: 'TLS Foundations',
      telephone: '+15059914180',
      email: 'TLSfoundationsNM@gmail.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '5048 Edith Blvd NE, Suite E',
        addressLocality: 'Albuquerque',
        addressRegion: 'NM',
        postalCode: '87107',
        addressCountry: 'US',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Contact Us', item: 'https://www.tlsfoundations.com/contact-us' },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  footer="full"
  schema={schema}
  ogImage="/images/contact-us-hero.jpg"
  footerProps={{ serviceAreaLabel: 'Fixing foundations in the following cities:', serviceAreaText }}
>
  <section class="contact-hero">
    <div class="hero-photo"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-headline">We're ready when you are.</h1>
      <p class="hero-sub">(but we're not sitting by the phone — we've got things to do)</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-inner">
      <span class="contact-eyebrow">Reach out</span>
      <h2>Start with a conversation.</h2>
      <p class="contact-body">We can't diagnose over the phone. But let's see if we can help.</p>

      <div class="contact-options">
        <div class="contact-option">
          <span class="contact-option-label">Text</span>
          <a href="sms:5059914180" class="contact-option-value">Send a text →</a>
          <span class="contact-option-sub">Texting is pretty easy</span>
        </div>

        <div class="contact-divider"></div>

        <div class="contact-option">
          <span class="contact-option-label">Call</span>
          <a href="tel:5059914180" class="contact-option-value">(505) 991-4180</a>
          <span class="contact-option-sub">The owner(s) answer</span>
        </div>

        <div class="contact-divider"></div>

        <div class="contact-option">
          <span class="contact-option-label">Location</span>
          <span class="contact-option-value" style="white-space:nowrap">Albuquerque,&nbsp;New Mexico</span>
          <span class="contact-option-sub">The state is our office</span>
        </div>
      </div>

      <div class="sandia-note">
        <span class="sandia-note-eyebrow">A note on how we're structured</span>
        <p>
          TLS Foundations and <a href="https://www.sandiageo.com" target="_blank" rel="noopener">Sandia GEO</a> are
          owned by the same principals. We keep investigation and repair as separate revenue streams on purpose —
          so that when we evaluate your foundation, the recommendation follows the evidence, not the invoice.
        </p>
      </div>

      <div class="expect-grid">
        <div class="expect-item">
          <span class="expect-label">First contact</span>
          <p>A conversation with someone who knows your neighborhood — not a scheduler, not a call center. Within a few exchanges you're talking with an owner who can speak directly to your area's soil conditions and whether what you're describing is worth investigating now or worth watching.</p>
        </div>
        <div class="expect-item">
          <span class="expect-label">Coverage</span>
          <p>All 33 counties, all five regions of New Mexico. Albuquerque is home base — the state is the office. The miles on the truck are what it takes to make an evaluation in Farmington as informed as one in the South Valley.</p>
        </div>
        <div class="expect-item">
          <span class="expect-label">Financing &amp; warranties</span>
          <p>We stand behind our installations, and we're honest about what a warranty can and can't guarantee — a warranty covers the work, not what the soil does next if the moisture source isn't fixed. Ask us about financing for your project.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  * {
    box-sizing: border-box;
  }

  /* ── HERO ── */
  .contact-hero {
    width: 100%;
    min-height: 560px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
  }
  .hero-photo {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    background: url('/images/contact-us-hero.jpg') center center / cover no-repeat;
    animation: kenburns 20s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    0% {
      transform: scale(1) translate(1%, 0);
    }
    100% {
      transform: scale(1.06) translate(-1%, 0.5%);
    }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(13, 34, 56, 0.82) 0%, rgba(13, 34, 56, 0.45) 55%, rgba(13, 34, 56, 0.65) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 3;
    padding: 0 80px 64px;
    max-width: 780px;
  }
  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 400;
    color: #fff;
    line-height: 1.1;
    letter-spacing: -1px;
  }
  .hero-sub {
    font-family: 'Source Serif 4', serif;
    font-size: clamp(13px, 1.5vw, 16px);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.38);
    margin-top: 20px;
    letter-spacing: 0.3px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .contact-hero {
      min-height: 60vh;
    }
    .hero-content {
      padding: 0 24px 48px;
    }
    .hero-headline {
      font-size: clamp(40px, 10vw, 64px);
    }
  }

  /* ── CONTACT SECTION ── */
  .contact-section {
    width: 100%;
    background: var(--sand);
    border-top: 2px solid var(--gold);
    padding: 88px 80px;
    font-family: 'Source Serif 4', Georgia, serif;
  }
  .contact-inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-eyebrow {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
  }
  .contact-inner h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .contact-body {
    font-size: 18px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.9;
    max-width: 560px;
    margin: 0 auto 64px;
  }
  .contact-options {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
  }
  .contact-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 0 56px;
  }
  .contact-option-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .contact-option-value {
    font-family: 'Playfair Display', serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 400;
    color: var(--blue);
    text-decoration: none;
    letter-spacing: 0.3px;
    line-height: 1;
    transition: color 0.2s;
  }
  a.contact-option-value:hover {
    color: var(--gold);
  }
  .contact-option-sub {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-divider {
    width: 1px;
    height: 56px;
    background: var(--stone);
    flex-shrink: 0;
    align-self: center;
  }
  .sandia-note {
    max-width: 660px;
    margin: 72px auto 0;
    padding-top: 40px;
    border-top: 1px solid var(--stone);
    text-align: left;
  }
  .sandia-note-eyebrow {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .sandia-note p {
    font-size: 15px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.85;
    margin: 0;
  }
  .sandia-note a {
    color: var(--slate);
    border-bottom: 1px solid var(--stone);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .sandia-note a:hover {
    color: var(--blue);
    border-color: var(--gold);
  }

  .expect-grid {
    max-width: 960px;
    margin: 56px auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    text-align: left;
  }
  .expect-label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .expect-item p {
    font-size: 15px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.85;
    margin: 0;
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 64px 24px;
    }
    .contact-options {
      flex-direction: column;
      gap: 36px;
      flex-wrap: wrap;
    }
    .contact-divider {
      display: none;
    }
    .contact-option {
      padding: 0;
      text-align: center;
      align-items: center;
      width: 100%;
    }
    .contact-body {
      margin-bottom: 48px;
    }
    .sandia-note {
      padding-top: 32px;
    }
    .expect-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 40px;
    }
  }
</style>
