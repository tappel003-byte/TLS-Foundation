---
// Individual Job Notes article. getStaticPaths only returns entries whose
// publishDate has passed (and which aren't marked draft) -- an article
// dated in the future produces no page at all, not even an unlinked one,
// until a build runs after that date. See src/content.config.ts for the
// schema and .github/workflows/scheduled-rebuild.yml for what triggers a
// build on days nobody pushes a commit.
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const now = new Date();
  const entries = await getCollection(
    'articles',
    ({ data }) => !data.draft && data.publishDate <= now
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, summary, publishDate, heroImage } = entry.data;
const { Content } = await render(entry);

const dateLabel = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    about: description,
    datePublished: publishDate.toISOString(),
    author: { '@type': 'Organization', name: 'TLS Foundations' },
    publisher: { '@type': 'Organization', name: 'TLS Foundations' },
    url: `https://www.tlsfoundations.com/job-notes/${entry.id}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Job Notes', item: 'https://www.tlsfoundations.com/job-notes' },
      { '@type': 'ListItem', position: 3, name: title, item: `https://www.tlsfoundations.com/job-notes/${entry.id}` },
    ],
  },
];
---

<Layout
  title={`${title} | TLS Foundations`}
  description={description}
  footer="minimal"
  schema={schema}
  ogImage={heroImage}
  summary={summary}
  pageName={title}
>
  <div class="tls-article" id="top">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Job Notes · {dateLabel}</span>
        <h1>{title}</h1>
      </div>
    </section>

    <div class="article-outer">
      <article class="article-body">
        <Content />
        <a href="/job-notes" class="back-to-list">← Back to Job Notes</a>
      </article>
    </div>
  </div>
</Layout>

<style>
  .tls-article {
    --blue: #1b3a5c;
    --blue-dark: #0d2238;
    --blue-mid: #2a5480;
    --gold: #b8860b;
    --gold-light: #d4a017;
    --gold-text: #7d5c08;
    --sand: #f5efe6;
    --stone: #e0d5c5;
    --slate: #4a5568;
    --muted: #54626f;
    --dark: #1a1a1a;
    --cream: #fdfaf6;
    --gutter: 64px;
    --content-max: 1100px;
    --article-max: 720px;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 18px;
    background: #fff;
    color: var(--dark);
    line-height: 1.9;
  }
  .page-hero {
    background: var(--blue);
    padding: 52px var(--gutter) 44px;
    border-bottom: 2px solid var(--gold);
  }
  .page-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-light);
    display: block;
    margin-bottom: 16px;
  }
  .page-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
  }
  .article-outer {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 64px var(--gutter) 80px;
  }
  .article-body {
    max-width: var(--article-max);
    margin: 0 auto;
  }
  .article-body :global(h2) {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.2;
    margin: 48px 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--stone);
  }
  .article-body :global(h2:first-child) {
    margin-top: 0;
  }
  .article-body :global(h2) :global(em) {
    font-style: italic;
    color: var(--gold-text);
  }
  .article-body :global(h3) {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--blue);
    margin: 36px 0 16px;
  }
  .article-body :global(p) {
    font-size: 17px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.9;
    margin-bottom: 20px;
  }
  .article-body > :global(p:first-of-type) {
    font-size: 20px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.85;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--stone);
  }
  .article-body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .article-body :global(a:hover) {
    color: var(--gold-text);
  }
  .article-body :global(blockquote) {
    margin: 40px 0;
    padding: 28px 36px;
    border-left: 3px solid var(--gold-text);
    background: var(--sand);
  }
  .article-body :global(blockquote p) {
    font-family: 'Playfair Display', serif;
    font-size: 20px !important;
    font-weight: 400;
    font-style: italic;
    color: var(--blue) !important;
    line-height: 1.55 !important;
    margin-bottom: 0 !important;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 24px 0 32px 1.25em;
  }
  .article-body :global(li) {
    font-size: 16px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.8;
    margin-bottom: 10px;
  }
  .article-body :global(strong) {
    color: var(--blue);
    font-weight: 600;
  }
  .back-to-list {
    display: block;
    margin-top: 48px;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-to-list:hover {
    color: var(--gold-text);
  }

  @media (max-width: 768px) {
    .tls-article {
      --gutter: 24px;
    }
    .article-outer {
      padding: 48px 24px 56px;
    }
  }
</style>
