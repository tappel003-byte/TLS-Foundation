---
// Job Notes listing page. Only lists articles whose publishDate has
// already passed (and which aren't marked draft) -- see
// src/content.config.ts and src/pages/job-notes/[slug].astro for how an
// article stays completely absent from the build until its date arrives.
//
// This page is not yet linked from the site nav (see Header.astro) --
// add it there when the section is ready to go public. It stays live at
// this URL either way once deployed, same as any other page.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const now = new Date();
const entries = (await getCollection('articles', ({ data }) => !data.draft && data.publishDate <= now)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const title = 'Job Notes | TLS Foundations';
const description = 'Notes from the field -- what we see in New Mexico soil and foundations, written up as it happens.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Job Notes',
    description,
    url: 'https://www.tlsfoundations.com/job-notes',
  },
];
---

<Layout title={title} description={description} footer="minimal" schema={schema}>
  <div class="jn-page">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">TLS Foundations</span>
        <h1>Job Notes</h1>
        <p class="page-hero-sub">Notes from the field — what we see in New Mexico soil and foundations, written up as it happens.</p>
      </div>
    </section>

    <div class="list-outer">
      {
        entries.length === 0 ? (
          <div class="empty-state">
            <p>First entry coming soon.</p>
          </div>
        ) : (
          <div class="entry-list">
            {entries.map((entry) => (
              <a href={`/job-notes/${entry.id}`} class="entry">
                <span class="entry-date">
                  {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <span class="entry-title">{entry.data.title}</span>
                <span class="entry-desc">{entry.data.description}</span>
                <span class="entry-arrow">Read more →</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .jn-page {
    --blue: #1b3a5c;
    --blue-dark: #0d2238;
    --gold: #b8860b;
    --gold-light: #d4a017;
    --gold-text: #7d5c08;
    --sand: #f5efe6;
    --stone: #e0d5c5;
    --slate: #4a5568;
    --muted: #54626f;
    --cream: #fdfaf6;
    --gutter: 64px;
    --content-max: 900px;
    font-family: 'Source Serif 4', Georgia, serif;
    background: #fff;
  }
  .page-hero {
    background: var(--blue);
    padding: 52px var(--gutter) 44px;
    border-bottom: 2px solid var(--gold);
  }
  .page-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-light);
    display: block;
    margin-bottom: 16px;
  }
  .page-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .page-hero-sub {
    font-size: 17px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    max-width: 560px;
  }
  .list-outer {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 64px var(--gutter) 100px;
  }
  .empty-state {
    padding: 48px 0;
    font-size: 17px;
    font-style: italic;
    color: var(--muted);
    border-top: 1px solid var(--stone);
  }
  .entry-list {
    border-top: 1px solid var(--stone);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 36px 0;
    border-bottom: 1px solid var(--stone);
    text-decoration: none !important;
    transition: background 0.2s;
  }
  .entry:hover {
    background: var(--sand);
  }
  .entry:hover .entry-arrow {
    color: var(--gold-text);
    transform: translateX(4px);
  }
  .entry-date {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .entry-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.6vw, 27px);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.25;
  }
  .entry-desc {
    font-size: 16px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.7;
    max-width: 640px;
  }
  .entry-arrow {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    transition: transform 0.2s, color 0.2s;
    width: fit-content;
  }

  @media (max-width: 768px) {
    .jn-page {
      --gutter: 24px;
    }
  }
</style>
