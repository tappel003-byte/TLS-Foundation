---
// Job Notes listing page. Only lists articles whose publishDate has
// already passed (and which aren't marked draft) -- see
// src/content.config.ts and src/pages/job-notes/[slug].astro for how an
// article stays completely absent from the build until its date arrives.
//
// Linked from the site nav under Reference (see Header.astro).
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const now = new Date();
const entries = (await getCollection('articles', ({ data }) => !data.draft && data.publishDate <= now)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const title = 'Job Notes | TLS Foundations';
const description = 'Notes from the field -- what we see in New Mexico soil and foundations, written up as it happens.';
const summary =
  "Job Notes is a running set of short field notes from real diagnostic calls across New Mexico -- genericized so no house or client is identifiable, but true to the actual judgment call made on site. They're grouped here by topic: water and drainage sources, soil and ground conditions, diagnosis and timing, and bid or scope questions. New notes are added as they're written, not on a fixed schedule.";

// Left-nav filter groups, matching the topic values in src/content.config.ts.
const topics = [
  { key: 'water-drainage', label: 'Water & Drainage' },
  { key: 'soil-ground', label: 'Soil & Ground Conditions' },
  { key: 'diagnosis-timing', label: 'Diagnosis & Timing' },
  { key: 'bids-scope', label: 'Bids & Scope' },
];
const counts = Object.fromEntries(topics.map((t) => [t.key, entries.filter((e) => e.data.topic === t.key).length]));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Job Notes',
    description,
    url: 'https://www.tlsfoundations.com/job-notes',
  },
];
---

<Layout title={title} description={description} footer="minimal" schema={schema} summary={summary} pageName="Job Notes">
  <div class="jn-page">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">TLS Foundations</span>
        <h1>Job Notes</h1>
        <p class="page-hero-sub">Notes from the field — what we see in New Mexico soil and foundations, written up as it happens.</p>
      </div>
    </section>

    <div class="jn-layout">
      <nav class="topic-nav" aria-label="Filter Job Notes by topic">
        <span class="topic-nav-label">Browse by topic</span>
        <ul class="topic-list">
          <li>
            <button type="button" class="topic-btn active" data-topic="all">
              <span class="topic-dot"></span>All Notes<span class="topic-count">{entries.length}</span>
            </button>
          </li>
          {
            topics.map((t) => (
              <li>
                <button type="button" class="topic-btn" data-topic={t.key}>
                  <span class="topic-dot" />
                  {t.label}
                  <span class="topic-count">{counts[t.key] || 0}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="list-col">
        <div class="topic-chips" aria-label="Filter Job Notes by topic">
          <button type="button" class="chip active" data-topic="all">All Notes</button>
          {
            topics.map((t) => (
              <button type="button" class="chip" data-topic={t.key}>
                {t.label}
              </button>
            ))
          }
        </div>

        <div class="list-outer">
          {
            entries.length === 0 ? (
              <div class="empty-state">
                <p>First entry coming soon.</p>
              </div>
            ) : (
              <div class="entry-list" id="entry-list">
                {entries.map((entry) => (
                  <a href={`/job-notes/${entry.id}`} class="entry" data-topic={entry.data.topic}>
                    <span class="entry-date">
                      {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                    <span class="entry-title">{entry.data.title}</span>
                    <span class="entry-desc">{entry.data.description}</span>
                    <span class="entry-arrow">Read more →</span>
                  </a>
                ))}
              </div>
            )
          }
          <p class="no-match" id="no-match" hidden>No notes filed under this topic yet.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .jn-page {
    --blue: #1b3a5c;
    --blue-dark: #0d2238;
    --gold: #b8860b;
    --gold-light: #d4a017;
    --gold-text: #7d5c08;
    --sand: #f5efe6;
    --stone: #e0d5c5;
    --slate: #4a5568;
    --muted: #54626f;
    --cream: #fdfaf6;
    --gutter: 64px;
    --content-max: 1160px;
    font-family: 'Source Serif 4', Georgia, serif;
    background: #fff;
  }
  .page-hero {
    background: var(--blue);
    padding: 52px var(--gutter) 44px;
    border-bottom: 2px solid var(--gold);
  }
  .page-hero-inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-light);
    display: block;
    margin-bottom: 16px;
  }
  .page-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .page-hero-sub {
    font-size: 17px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    max-width: 560px;
  }

  .jn-layout {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 64px var(--gutter) 100px;
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ── DESKTOP TOPIC SIDEBAR ── */
  .topic-nav {
    position: sticky;
    top: 100px;
  }
  .topic-nav-label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .topic-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .topic-btn {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    border-radius: 0;
    text-align: left;
    font-family: 'Source Serif 4', serif;
    font-size: 15px;
    font-weight: 300;
    color: var(--slate);
    padding: 9px 4px;
    cursor: pointer;
    line-height: 1.35;
  }
  .topic-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--stone);
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .topic-btn:hover {
    color: var(--blue);
  }
  .topic-btn.active {
    color: var(--blue);
    font-weight: 600;
  }
  .topic-btn.active .topic-dot {
    background: var(--gold);
  }
  .topic-count {
    margin-left: auto;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--muted);
  }
  .topic-btn.active .topic-count {
    color: var(--gold-text);
  }

  /* ── MOBILE TOPIC CHIPS ── */
  .topic-chips {
    display: none;
  }

  .list-outer {
    /* was the page's own max-width/centering before the sidebar existed --
       now just fills the right-hand grid column. */
  }
  .empty-state {
    padding: 48px 0;
    font-size: 17px;
    font-style: italic;
    color: var(--muted);
    border-top: 1px solid var(--stone);
  }
  .entry-list {
    border-top: 1px solid var(--stone);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 36px 0;
    border-bottom: 1px solid var(--stone);
    text-decoration: none !important;
    transition: background 0.2s;
  }
  .entry.is-hidden {
    display: none;
  }
  .entry:hover {
    background: var(--sand);
  }
  .entry:hover .entry-arrow {
    color: var(--gold-text);
    transform: translateX(4px);
  }
  .entry-date {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .entry-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 2.6vw, 27px);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.25;
  }
  .entry-desc {
    font-size: 16px;
    font-weight: 300;
    color: var(--slate);
    line-height: 1.7;
    max-width: 640px;
  }
  .entry-arrow {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    transition: transform 0.2s, color 0.2s;
    width: fit-content;
  }
  .no-match {
    padding: 48px 0;
    font-size: 16px;
    font-style: italic;
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .jn-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .topic-nav {
      display: none;
    }
    .topic-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-top: 8px;
      margin-bottom: 8px;
    }
    .chip {
      appearance: none;
      -webkit-appearance: none;
      border: 1px solid var(--stone);
      border-radius: 999px;
      background: #fff;
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.3px;
      color: var(--slate);
      padding: 8px 14px;
      cursor: pointer;
    }
    .chip.active {
      border-color: var(--gold);
      color: var(--gold-text);
      background: var(--sand);
    }
  }

  @media (max-width: 768px) {
    .jn-page {
      --gutter: 24px;
    }
  }
</style>

<script>
  const controls = document.querySelectorAll<HTMLButtonElement>('.topic-btn, .chip');
  const entries = document.querySelectorAll<HTMLAnchorElement>('.entry[data-topic]');
  const noMatch = document.getElementById('no-match');

  function applyFilter(topic: string) {
    let visible = 0;
    entries.forEach((entry) => {
      const match = topic === 'all' || entry.dataset.topic === topic;
      entry.classList.toggle('is-hidden', !match);
      if (match) visible++;
    });
    controls.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.topic === topic);
    });
    noMatch?.toggleAttribute('hidden', visible !== 0);
  }

  controls.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.topic || 'all'));
  });
</script>
