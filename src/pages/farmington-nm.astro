---
// Farmington / Aztec / Bloomfield tri-city page. Built from the same
// family as rio-rancho-nm.astro, santa-fe-nm.astro, and albuquerque-nm.astro
// -- same hero/left-nav/flip-card/SEO-accordion system, fresh content.
// "Tri-city" is not a label invented for this page: Bloomfield's own city
// website describes itself as part of a tri-city area with Aztec (county
// seat) and Farmington. Farmington is used as the URL slug and lead name
// since it's the primary search term and largest of the three.
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Farmington, Aztec & Bloomfield, NM | TLS Foundations';
const description =
  'Foundation repair across the Farmington, Aztec, and Bloomfield tri-city area. River deposits, terraces, expansive shale, and collapsible silt and sand -- often on the same street. TLS Foundations investigates before recommending.';
const summary =
  "The Farmington-Aztec-Bloomfield tri-city area sits on a patchwork of river deposits, old terraces, and interbedded sandstone and shale -- not one uniform soil. We've measured both heave and settlement across all three towns, sometimes within the same neighborhood, which is exactly why a proper investigation matters more than assuming which one a given house has.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        datePublished: '2026-11-17',
        headline: 'Foundation Repair in Farmington, Aztec & Bloomfield, NM',
        description,
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Farmington, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/farmington-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [
          { '@type': 'City', name: 'Farmington', addressRegion: 'NM' },
          { '@type': 'City', name: 'Aztec', addressRegion: 'NM' },
          { '@type': 'City', name: 'Bloomfield', addressRegion: 'NM' },
        ],
        description:
          'Foundation repair contractor serving Farmington, Aztec, and Bloomfield, NM. Slab repair, foundation inspection, settlement, heave, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Farmington NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Farmington sits on a patchwork of river deposits, older terraces, and interbedded sandstone and shale -- not one uniform soil. Depending on the specific lot, the cause can be expansive clay and shale heave, collapsible silt or sand settlement, or both. Two homes a few blocks apart can have genuinely different ground, which is why we investigate before recommending a repair.',
            },
          },
          {
            '@type': 'Question',
            name: 'Does Bloomfield have different soil than Farmington?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "We've measured both heave and settlement in Bloomfield -- expansive clay in some spots, loose, deep collapsible soil in others, sometimes close together. The regional geology varies at a scale finer than a town boundary, so Bloomfield, Aztec, and Farmington all show a similar mix rather than each having one signature soil.",
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in the Farmington area?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. A drainage correction and a pier system differ by an order of magnitude, and both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies more than the house.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers or push piers used for foundation repair in Farmington, Aztec, or Bloomfield?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Both get used in this area, and the choice depends on what's actually under a given slab -- the depth and consistency of bearing material, and whether the mechanism is heave or settlement. Piers installed for settlement don't fix heave, and in some configurations make it worse. Soil characterization comes before pier selection, not after.",
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Farmington, Aztec, and Bloomfield NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves the Farmington, Aztec, and Bloomfield tri-city area with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with SandiaGEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 -- you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'Four Corners', item: 'https://www.tlsfoundations.com/four-corners' },
          { '@type': 'ListItem', position: 3, name: 'Farmington, Aztec & Bloomfield', item: 'https://www.tlsfoundations.com/farmington-nm' },
        ],
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  ogImage="/images/four-corners-hero.webp"
  summary={summary}
  pageName="Farmington"
  nextPage={{ path: '/four-corners', name: 'Four Corners' }}
>
  <div class="fab-page">
    <div class="hero">
      <div class="hero-photo"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="hero-city">Farmington, Aztec &amp; Bloomfield, New Mexico</span>
        <span class="hero-eyebrow">Foundation Repair</span>
        <h1 class="hero-h1">
          <span class="w1">Different</span><span class="w2">ground.</span>
          <span class="w3">Different repair.</span>
        </h1>
        <p class="hero-sub">Foundation repair across the Farmington, Aztec, and Bloomfield tri-city area — where river deposits, terraces, shale, and sandstone meet in the same ground, sometimes under the same street.</p>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="statement-band">
      <div class="statement-band-inner">
        <span class="statement-band-line1">Foundation Repair</span>
        <span class="statement-band-line2">The Tri-City Area.</span>
        <p class="statement-band-secondary">Three rivers built this place. The same water that founded it now sits under it.</p>
      </div>
    </div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Tri-City Area</span>
        <ul class="nav-links">
          <li><a href="#what-we-see"><span class="nav-dot"></span>What We See</a></li>
          <li><a href="#history"><span class="nav-dot"></span>History</a></li>
          <li><a href="#geology"><span class="nav-dot"></span>Geology</a></li>
          <li><a href="#farmington"><span class="nav-dot"></span>Farmington</a></li>
          <li><a href="#aztec"><span class="nav-dot"></span>Aztec</a></li>
          <li><a href="#bloomfield"><span class="nav-dot"></span>Bloomfield</a></li>
          <li><a href="#approach"><span class="nav-dot"></span>Our Approach</a></li>
          <li><a href="#difference"><span class="nav-dot"></span>Before You Sign</a></li>
          <li><a href="#questions"><span class="nav-dot"></span>Common Questions</a></li>
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s), or voicemail and a callback</span>
        </div>
      </nav>

      <div class="content-area">
        <section class="section" id="what-we-see">
          <span class="section-num">01</span>
          <div class="section-inner">
            <span class="section-label-text" style="display:block;margin-bottom:8px;">Farmington, Aztec &amp; Bloomfield · What We See</span>
            <h2 class="section-heading reveal">Foundation repair in the tri-city area — <em>what's actually happening under your home</em></h2>
            <div class="reveal">
              <p class="lede">A foundation problem here is not automatically one thing. The ground under Farmington, Aztec, and Bloomfield is a patchwork — river deposits, old terraces, sandstone, and shale — not a single uniform soil.</p>
              <p><mark class="key">Detailed geologic mapping of the Farmington area identifies active river-channel deposits, older Animas and La Plata river terraces, and several distinct sandstone- and shale-bearing formations, sometimes transitioning within a short distance of each other.</mark> That's a better starting point than a single "signature soil" story, because it's closer to what's actually under these neighborhoods.</p>
              <p>The practical result: a repair that worked at another house in the area isn't automatically the right repair for yours. Similar-looking symptoms — a sloping floor, a cracked slab — don't establish the same cause. The repair should follow what's actually found, not the other way around.</p>
              <p>Foundation inspection here means understanding the ground at a specific address, across three towns that don't share one simple explanation.</p>
            </div>
          </div>
        </section>

        <section class="section" id="history">
          <span class="section-num">02</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">History</span></div>
            <h2 class="section-heading reveal">Founded by water. <em>Undermined by it too.</em></h2>
            <div class="two-col reveal">
              <div>
                <p>Farmington sits at the literal confluence of the San Juan, Animas, and La Plata rivers. The Navajo name for the area, Totah, means "waters flowing together." The town exists because of that confluence — good land, reliable water, a place worth settling.</p>
                <p>That same water shaped the local economy for generations. By the mid-20th century, the San Juan River valley was apple country: dozens of orchards, fruit moving out by rail on a line nicknamed the Red Apple Flyer. Kerby Orchard, founded in 1945, still grows apples today and still irrigates off the Animas River through the historic Echo ditch system — the same network that's been moving water across this ground for eighty years, long before most of today's neighborhoods existed.</p>
                <p>Then came gas. Oil seeps were noted here as early as 1879, but the real transformation hit in 1951, when a new pipeline opened distant markets and triggered a boom. Farmington's population grew dramatically through the 1950s — accounts of the exact numbers vary, but it went from a few thousand people to tens of thousands within a decade. That's rapid, boom-town construction, built fast, well ahead of modern geotechnical standards.</p>
              </div>
              <div>
                <div class="fact-box">
                  <span class="section-label-text" style="display:block;margin-bottom:14px;color:var(--gold);">Tri-City Area — By Description</span>
                  <p>Bloomfield's own city government describes itself as part of "a tri-city area which includes Aztec, the county seat, and Farmington, the largest city in the area." It's an accurate way to think about the three towns together — not one city with neighborhoods, but three real, distinct places that happen to sit on the same complicated ground.</p>
                  <p>Aztec, the county seat, sits on the Animas a few miles upriver from Farmington. The National Park Service has documented shallow groundwater as a real engineering concern there too — a subsurface drain and six observation wells were installed specifically to manage water beneath the Aztec Ruins.</p>
                </div>
              </div>
            </div>
            <div class="pull reveal">A century and a half ago, water is why people settled here. Today, it's a big part of why foundations need looking at.</div>
          </div>
        </section>

        <section class="section" id="geology">
          <span class="section-num">03</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Geology</span></div>
            <h2 class="section-heading reveal">Two unrelated mechanisms, <em>sometimes the same street</em></h2>
            <p class="reveal" style="max-width:100%;">Across Farmington, Aztec, and Bloomfield, we've measured both heave and settlement — expansive clay and shale in some spots, loose, collapsible silt and sand in others. They're not sorted neatly by town. A diagnosis that assumes one without checking is a diagnosis that's guessing.</p>

            <div class="flip-cards reveal">
              <div class="flip-card" tabindex="0" role="button" aria-label="Expansive shale and clay — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">1</span>
                    <div>
                      <div class="flip-title">Expansive Shale &amp; Clay</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 01</span>
                    <p class="flip-body">Mancos Shale underlies or outcrops across a wide area here, and it contains clay minerals that <a href="/glossary#mancos-shale" class="body-link" style="color:var(--gold-text);">expand significantly when they absorb moisture</a> and shrink as they dry. The damage this produces — humped driveways, heaved garage floors — looks like settlement to the untrained eye. It's the opposite, and it calls for the opposite repair.</p>
                    <span class="flip-tag">Foundation heave · tri-city area</span>
                  </div>
                </div>
              </div>
              <div class="flip-card" tabindex="0" role="button" aria-label="Collapsible silt and sand — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">2</span>
                    <div>
                      <div class="flip-title">Collapsible Silt &amp; Sand</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 02</span>
                    <p class="flip-body">In our own fieldwork, we've found a specific corridor in Bloomfield with deep, loose, collapsible soil that causes real settlement — even where it isn't reflected on regional geological maps. Collapsible soils stay stable while dry, then lose volume rapidly the first time sustained moisture reaches them. That's a first-wetting event, not a slow process, and it can happen decades after a house was built.</p>
                    <span class="flip-tag">Settlement · Bloomfield corridor</span>
                  </div>
                </div>
              </div>
              <div class="flip-card" tabindex="0" role="button" aria-label="A patchwork of bedrock and terraces — tap to learn more">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">3</span>
                    <div>
                      <div class="flip-title">A Patchwork, Not One Layer</div>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Mechanism 03</span>
                    <p class="flip-body">Published geologic mapping of the area shows river terraces, floodplain gravels, and several distinct sandstone- and shale-bearing formations, transitioning laterally within short distances. That's the real reason a blanket explanation — "it's all Mancos Shale" or "it's all collapsible fill" — is too coarse to be useful at a specific address.</p>
                    <span class="flip-tag">Variable bedrock · Farmington North quadrangle</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="pull reveal">Both settlement and heave occur throughout this area, sometimes within the same neighborhood, and damage can look like either depending on how you read it. Establishing the actual mechanism is what determines the right repair.</div>
          </div>
        </section>

        <section class="section" id="farmington">
          <span class="section-num">04</span>
          <div class="section-inner">
            <div class="zone-strip reveal">
              <div class="zone-strip-num"><span>01</span></div>
              <div class="zone-strip-content">
                <h3 class="zone-strip-title">Farmington</h3>
                <div class="zone-strip-tag">River Confluence · Boom-Era Construction · Mixed Ground</div>
              </div>
            </div>

            <div class="two-col reveal">
              <div>
                <p>Farmington is the largest of the three, founded at the meeting point of the San Juan, Animas, and La Plata rivers — Totah, "waters flowing together," in Navajo. That confluence is why the town exists where it does, and it's part of why the ground here holds moisture the way it does today.</p>
                <p>Most of the city's present size came fast, during the 1950s gas boom — production-era construction on ground that wasn't characterized lot by lot. <mark class="key">That construction era, more than any single soil type, shapes what we actually find in Farmington's older neighborhoods.</mark> Decades of irrigation from the historic Echo ditch system, still running water from the Animas through the old orchard country, add their own long moisture history to parts of this ground.</p>
              </div>
              <div>
                <div class="zone-warnings">
                  <span class="zone-warning-label">Warning signs — Farmington homes</span>
                  <ul class="warning-list">
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Cracking that follows a wet year</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Expansive clay and shale respond to moisture on a seasonal cycle. Damage that seems to track wet and dry years, rather than appearing once and staying put, points toward heave rather than simple settlement.</div></div>
                    </li>
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Older homes near downtown or the river corridor</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Construction from the 1950s–60s boom was fast and production-scale, on ground that wasn't always studied parcel by parcel. Age alone isn't a verdict, but it's a reason to look closely rather than assume.</div></div>
                    </li>
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Humped driveways and heaved garage floors</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">A common visible sign of expansive soil activity nearby. Exterior concrete can move independently of the house, so what matters is whether the pattern shows up inside the structure too.</div></div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="aztec">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="zone-strip reveal">
              <div class="zone-strip-num"><span>02</span></div>
              <div class="zone-strip-content">
                <h3 class="zone-strip-title">Aztec</h3>
                <div class="zone-strip-tag">County Seat · Shallow Groundwater · Animas River Terraces</div>
              </div>
            </div>

            <div class="two-col reveal">
              <div>
                <p>Aztec is the San Juan County seat, a few miles upriver from Farmington on the Animas. The name comes from the nearby Aztec Ruins — built by Ancestral Puebloan people, not the Aztec civilization, a 19th-century naming mistake that stuck.</p>
                <p>Shallow groundwater is a documented concern here, not a guess: the National Park Service installed a subsurface drain and six observation wells specifically to manage water beneath the ruins themselves. <mark class="key">That's a real, documented example of consequential shallow water in this exact area</mark> — not proof that every lot in Aztec has the same water table depth, but a reason to ask the question rather than assume it away.</p>
              </div>
              <div>
                <div class="pull">A house built on an old river terrace isn't necessarily a problem. A house built on an old river terrace that nobody checked is a bet.</div>
                <div class="zone-warnings" style="margin-top:0;">
                  <span class="zone-warning-label">Warning signs — Aztec homes</span>
                  <ul class="warning-list">
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Persistently damp crawlspaces</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Where the water table runs shallow, moisture under a home can be a standing condition rather than something that clears after a storm. That changes both the diagnosis and the fix.</div></div>
                    </li>
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Movement in homes near the river corridor</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Older river terrace deposits along the Animas can behave differently than ground a short distance away on higher, drier terrain — one more reason a blanket explanation for "Aztec soil" doesn't hold up at a specific address.</div></div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="bloomfield">
          <span class="section-num">06</span>
          <div class="section-inner">
            <div class="zone-strip reveal">
              <div class="zone-strip-num"><span>03</span></div>
              <div class="zone-strip-content">
                <h3 class="zone-strip-title">Bloomfield</h3>
                <div class="zone-strip-tag">Documented Corridor · Shale Outcrops · Terrain Change</div>
              </div>
            </div>

            <div class="two-col reveal">
              <div>
                <p>Driving in from the south, the terrain visibly changes around Bloomfield — the hills take on a gray-green color where shale outcrops and weathers at the surface. It's one of the few places in this area where you can see the geology before you ever look at a foundation.</p>
                <p><mark class="key">In our own fieldwork, we've found a specific corridor in Bloomfield with deep, loose, collapsible soil that causes real settlement — even where it isn't reflected on regional geological maps.</mark> We've also measured expansive heave in the same town, sometimes not far from that corridor. Two unrelated mechanisms, close together, is the actual story here — not one signature Bloomfield soil.</p>
              </div>
              <div>
                <div class="zone-warnings">
                  <span class="zone-warning-label">Warning signs — Bloomfield homes</span>
                  <ul class="warning-list">
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Settlement that seems to appear out of nowhere</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Collapsible soil stays stable while dry, then loses volume rapidly the first time sustained moisture reaches it — a first-wetting event, not a slow process. That can happen decades after a house was built, with no obvious trigger from the outside.</div></div>
                    </li>
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">Gray-green hillsides and shale outcrops nearby</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">A visible sign of Mancos Shale at or near the surface. Doesn't mean every home nearby has a problem — it means the expansive-clay mechanism is realistically on the table alongside collapsible settlement, and the two require opposite repairs.</div></div>
                    </li>
                    <li class="warning-item">
                      <button class="warning-trigger"><span class="warning-trigger-text">A neighbor's foundation trouble, but yours looks fine</span><span class="warning-trigger-icon">+</span></button>
                      <div class="warning-drawer"><div class="warning-drawer-inner">Because the collapsible corridor and the shale aren't evenly distributed, two houses close together can have genuinely different ground. A neighbor's repair history isn't a diagnosis for your own home.</div></div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="approach">
          <span class="section-num">07</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Our Approach</span></div>
            <h2 class="section-heading reveal">Foundation investigation in the tri-city area — <em>before everything else</em></h2>
            <div class="two-col reveal">
              <div>
                <p><mark class="key">Here's what a same-day quote can't account for: which mechanism is actually under that specific slab, at what depth, and what the water has been doing to it for decades.</mark> A heaving-clay lot and a collapsible-soil lot a few streets apart are different problems with different answers. Nobody can tell them apart from a driveway.</p>
              </div>
              <div>
                <div class="pull">We'd rather tell you nothing is wrong than sell you something that is.</div>
                <p>TLS Foundations works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a>, a New Mexico geotechnical investigation firm, when site conditions warrant a formal soil investigation before repair is recommended. Sometimes the honest answer is drainage correction. Sometimes it's monitoring and nothing else. The investigation is what tells you which.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="difference">
          <span class="section-num">08</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Before You Sign</span></div>
            <h2 class="section-heading reveal">Three things worth <em>asking first</em></h2>
            <p class="lede reveal">Not a pitch — three questions worth asking any foundation contractor before you sign anything.</p>

            <div class="flip-cards reveal">
              <div class="flip-card abc" tabindex="0" role="button" aria-label="Get the soil looked at first. Tap to learn more.">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">1</span>
                    <div>
                      <div class="flip-title">Get the soil looked at first.</div>
                      <p class="flip-front-sub">Before a recommendation. Before a number. Before anything.</p>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Assessment</span>
                    <p class="flip-body">The ground under a home is the only thing that makes an estimate mean anything. Expansive shale here, collapsible silt there, sometimes both within a block. TLS works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when a formal soil investigation is warranted — before any repair method is recommended, not after.</p>
                    <span class="flip-tag">Investigation first</span>
                  </div>
                </div>
              </div>
              <div class="flip-card abc" tabindex="0" role="button" aria-label="Know your soil before you sign. Tap to learn more.">
                <div class="flip-card-inner">
                  <div class="flip-front">
                    <span class="flip-num">2</span>
                    <div>
                      <div class="flip-title">Know your soil before you sign.</div>
                      <p class="flip-front-sub">Heave and settlement need opposite repairs. Guessing wrong makes it worse.</p>
                      <span class="flip-hint">Tap to learn more</span>
                    </div>
                  </div>
                  <div class="flip-back">
                    <span class="flip-tag">Before You Sign</span>
                    <p class="flip-body">Ask any contractor what mechanism is actually driving your movement and how they know. A pier installed for settlement doesn't fix heave — in some configurations it makes it worse. Get the diagnosis first. The estimate means something once you have it, and not before.</p>
                    <span class="flip-tag">Diagnosis before discount</span>
                  </div>
                </div>
              </div>
              <div class="flip-card abc" tabindex="0" role="button" aria-label="You reach the owner, not a rep. Tap to learn more.">
                <div class="flip-card-inner">
