---
// Farmington / Aztec / Bloomfield — Confluence Triptych magazine layout.
// Organizing principle: Totah — three towns on one river system; ground
// that ignores city limits. Signature: real Leaflet/OSM map of the
// San Juan / Animas / La Plata confluence + asymmetric town cards
// (Farmington primary; Aztec upstream; Bloomfield satellite).
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Farmington, Aztec & Bloomfield, NM | TLS Foundations';
const description =
  'Foundation repair across Farmington, Aztec, and Bloomfield, NM. River deposits, terraces, expansive shale, and collapsible silt and sand -- often on the same street. TLS Foundations investigates before recommending.';
const summary =
  "Farmington, Aztec, and Bloomfield sit on a patchwork of river deposits, old terraces, and interbedded sandstone and shale -- not one uniform soil. We've measured both heave and settlement across all three towns, sometimes within the same neighborhood, which is exactly why a proper investigation matters more than assuming which one a given house has.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        datePublished: '2026-11-17',
        dateModified: '2026-11-19',
        headline: 'Foundation Repair in Farmington, Aztec & Bloomfield, NM',
        description,
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Farmington, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/farmington-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [
          { '@type': 'City', name: 'Farmington', addressRegion: 'NM' },
          { '@type': 'City', name: 'Aztec', addressRegion: 'NM' },
          { '@type': 'City', name: 'Bloomfield', addressRegion: 'NM' },
        ],
        description:
          'Foundation repair contractor serving Farmington, Aztec, and Bloomfield, NM. Slab repair, foundation inspection, settlement, heave, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Farmington NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Farmington sits on a patchwork of river deposits, older terraces, and interbedded sandstone and shale -- not one uniform soil. Depending on the specific lot, the cause can be expansive clay and shale heave, collapsible silt or sand settlement, or both. Two homes a few blocks apart can have genuinely different ground, which is why we investigate before recommending a repair.',
            },
          },
          {
            '@type': 'Question',
            name: 'Does Bloomfield have different soil than Farmington?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "We've measured both heave and settlement in Bloomfield -- expansive clay in some spots, loose, deep collapsible soil in others, sometimes close together. The regional geology varies at a scale finer than a town boundary, so Bloomfield, Aztec, and Farmington all show a similar mix rather than each having one signature soil.",
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in the Farmington area?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. A drainage correction and a pier system differ by an order of magnitude, and both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies more than the house.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers or push piers used for foundation repair in Farmington, Aztec, or Bloomfield?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Both get used in this area, and the choice depends on what's actually under a given slab -- the depth and consistency of bearing material, and whether the mechanism is heave or settlement. Piers installed for settlement don't fix heave, and in some configurations make it worse. Soil characterization comes before pier selection, not after.",
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Farmington, Aztec, and Bloomfield NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves Farmington, Aztec, and Bloomfield, NM with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with SandiaGEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 -- you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'Four Corners', item: 'https://www.tlsfoundations.com/four-corners' },
          { '@type': 'ListItem', position: 3, name: 'Farmington, Aztec & Bloomfield', item: 'https://www.tlsfoundations.com/farmington-nm' },
        ],
      },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  ogImage="/images/farmington-hero.webp"
  summary={summary}
  pageName="Farmington"
  nextPage={{ path: '/gallup-nm', name: 'Gallup' }}
>
  <div class="fab-page">
    <div class="hero">
      <div class="hero-photo"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="hero-city">Farmington, Aztec &amp; Bloomfield, New Mexico</span>
        <span class="hero-eyebrow">Foundation Repair</span>
        <h1 class="hero-h1">
          <span class="w1">Different</span><span class="w2">ground.</span>
          <span class="w3">Different repair.</span>
        </h1>
        <p class="hero-sub">Three towns on one river system — Totah, waters flowing together. Town limits are not soil maps.</p>
      </div>
      <p class="hero-credit">
        <a href="https://unsplash.com/@wildhoney" rel="noopener noreferrer" target="_blank">J. Fowler</a>
        {' '}·{' '}
        <a href="https://unsplash.com/photos/aerial-view-of-rock-cliffs-ONNLFLtiTrQ" rel="noopener noreferrer" target="_blank">Unsplash</a>
      </p>
    </div>

    <div class="gold-rule"></div>

    <div class="statement-band">
      <div class="statement-band-inner">
        <span class="statement-band-line1">Foundation Repair</span>
        <span class="statement-band-line2">Farmington, Aztec &amp; Bloomfield.</span>
        <p class="statement-band-secondary">Three rivers built this place. The same water that founded it still sits under it — and the ground ignores the city limits drawn on top.</p>
      </div>
    </div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Totah</span>
        <ul class="nav-links">
          <li><a href="#totah"><span class="nav-dot"></span>Totah</a></li>
          <li><a href="#heave-vs-settlement"><span class="nav-dot"></span>Heave vs Settlement</a></li>
          <li><a href="#farmington"><span class="nav-dot"></span>Farmington</a></li>
          <li><a href="#aztec"><span class="nav-dot"></span>Aztec</a></li>
          <li><a href="#bloomfield"><span class="nav-dot"></span>Bloomfield</a></li>
          <li><a href="#across-three-towns"><span class="nav-dot"></span>Across Three Towns</a></li>
          <li><a href="#before-you-sign"><span class="nav-dot"></span>Before You Sign</a></li>
          <li><a href="#questions"><span class="nav-dot"></span>Questions</a></li>
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s), or voicemail and a callback</span>
        </div>
      </nav>

      <div class="content-area">
        <!-- 01 TOTAH -->
        <section class="section" id="totah">
          <span class="section-num">01</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Totah · Waters Flowing Together</span></div>
            <h2 class="section-heading reveal">Three towns. One confluence. <em>Ground that ignores the map.</em></h2>
            <p class="lede reveal">Farmington sits at the literal confluence of the San Juan, Animas, and La Plata rivers. The Navajo name for the area, Totah, means "waters flowing together." Aztec sits a few miles up the Animas. Bloomfield sits on the San Juan side. Three real places — one complicated river system underneath.</p>
            <p class="reveal"><mark class="key">Detailed geologic mapping of the Farmington area identifies active river-channel deposits, older Animas and La Plata river terraces, and several distinct sandstone- and shale-bearing formations, sometimes transitioning within a short distance of each other.</mark> That is closer to what's under these neighborhoods than any single "signature soil" story.</p>

            <!-- SIGNATURE: Real confluence map + asymmetric town cards -->
            <div class="confluence reveal" id="confluence">
              <div class="confluence-label">Totah · San Juan · Animas · La Plata</div>
              <div
                id="confluenceMap"
                class="confluence-map"
                role="img"
                aria-label="Map of Farmington, Aztec, and Bloomfield at the San Juan, Animas, and La Plata river confluence"
              ></div>

              <div class="confluence-layout">
                <a class="conf-primary" href="#farmington" data-town="farmington">
                  <span class="conf-kicker">At the confluence · primary</span>
                  <span class="conf-title">Farmington</span>
                  <span class="conf-rivers">San Juan · Animas · La Plata</span>
                  <span class="conf-blurb">Largest of the three. Boom-era construction on ground that wasn't characterized lot by lot — plus decades of irrigation from the Echo ditch system.</span>
                  <span class="conf-cta">Read Farmington →</span>
                </a>

                <div class="conf-satellites">
                  <a class="conf-rail" href="#aztec" data-town="aztec">
                    <span class="conf-rail-line" aria-hidden="true"></span>
                    <span class="conf-kicker">Upstream · Animas</span>
                    <span class="conf-title">Aztec</span>
                    <span class="conf-blurb">County seat. Shallow groundwater is documented — not a guess.</span>
                    <span class="conf-cta">Read Aztec →</span>
                  </a>

                  <a class="conf-sat" href="#bloomfield" data-town="bloomfield">
                    <span class="conf-kicker">Terrain change · San Juan side</span>
                    <span class="conf-title">Bloomfield</span>
                    <span class="conf-blurb">Gray-green shale outcrops you can see from the road — and a collapsible corridor nearby.</span>
                    <span class="conf-cta">Read Bloomfield →</span>
                  </a>
                </div>
              </div>
              <p class="confluence-caption">Town limits are not soil maps. The ground still varies block to block.</p>
            </div>

            <p class="atm reveal"><span class="atm-label">Atmosphere</span> By mid-century this valley was apple country — the Red Apple Flyer, Kerby Orchard still irrigating off the Animas through the Echo ditch. That water history is color and context. It is not a town-by-town soil legend.</p>
          </div>
        </section>

        <!-- RIVER TIMELINE (layout DNA — survives mobile) -->
        <div class="river-timeline reveal" id="river-timeline">
          <span class="river-timeline-label">Totah ledger · water made the towns</span>
          <ol class="river-timeline-list">
            <li>
              <span class="rtl-year">1879</span>
              <div>
                <strong>Oil seeps noted</strong>
                <p>Early marker that the basin under these towns was never quiet ground.</p>
              </div>
            </li>
            <li>
              <span class="rtl-year">1945–</span>
              <div>
                <strong>Apple country &amp; Echo ditch</strong>
                <p>Kerby Orchard and the historic ditch system — irrigation history still conditioning ground under neighborhoods.</p>
              </div>
            </li>
            <li>
              <span class="rtl-year">1951</span>
              <div>
                <strong>Gas boom</strong>
                <p>Pipeline opens distant markets. Farmington grows from thousands to tens of thousands in a decade — boom-era slabs on confluence ground.</p>
              </div>
            </li>
            <li>
              <span class="rtl-year">Today</span>
              <div>
                <strong>Three towns, one patchwork</strong>
                <p>Heave and collapsible settlement still ignore the city limits drawn on top of the rivers.</p>
              </div>
            </li>
          </ol>
        </div>

        <!-- 02 HEAVE VS SETTLEMENT -->
        <section class="section" id="heave-vs-settlement">
          <span class="section-num">02</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Two Mechanisms · Same Streets</span></div>
            <h2 class="section-heading reveal">Heave and settlement — <em>sometimes the same street</em></h2>
            <div class="mech-bleed on-dark reveal">
            <div class="mech-pair">
              <div class="mech-col mech-heave">
                <span class="mech-tag">Mechanism A</span>
                <h3>Expansive shale &amp; clay</h3>
                <p>Mancos Shale underlies or outcrops across a wide area here. Clay minerals <a href="/glossary#mancos-shale" class="body-link">expand when they absorb moisture</a> and shrink as they dry. Humped driveways and heaved garage floors look like settlement. Often they aren't.</p>
              </div>
              <div class="mech-vs" aria-hidden="true">vs</div>
              <div class="mech-col mech-settle">
                <span class="mech-tag">Mechanism B</span>
                <h3>Collapsible silt &amp; sand</h3>
                <p>We've found a corridor in Bloomfield with deep, loose, <a href="/glossary#collapsible-soil" class="body-link">collapsible soil</a> that causes real settlement — even where regional maps don't show it. Stable while dry; loses volume rapidly on first sustained wetting, sometimes decades after a house was built.</p>
              </div>
            </div>
            <div class="pull">A diagnosis that assumes one without checking is a diagnosis that's guessing — in Farmington, Aztec, or Bloomfield alike.</div>
            </div>
          </div>
        </section>

        <!-- 03 FARMINGTON -->
        <section class="section town-lead-section" id="farmington">
          <span class="section-num">03</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Farmington · Lead Town at the Join</span></div>
            <h2 class="section-heading reveal">Farmington — <em>boom-era slabs on confluence ground</em></h2>
            <div class="town-lead-stats reveal">
              <div class="tls-stat"><span class="tls-stat-num">1951</span><span class="tls-stat-cap">Pipeline boom</span></div>
              <div class="tls-stat"><span class="tls-stat-num">3</span><span class="tls-stat-cap">Rivers meet here</span></div>
              <div class="tls-stat"><span class="tls-stat-num">Echo</span><span class="tls-stat-cap">Ditch still irrigates</span></div>
            </div>
            <p class="lede reveal">Oil seeps were noted here as early as 1879; the real transformation hit in 1951 when a new pipeline opened distant markets. Farmington grew from a few thousand people to tens of thousands within a decade — rapid, boom-town construction, built fast, well ahead of modern geotechnical standards.</p>
            <p class="reveal"><mark class="key">That construction era, more than any single soil type, shapes what we find in Farmington's older neighborhoods.</mark> Decades of irrigation from the historic Echo ditch system add their own long moisture history to parts of this ground.</p>
            <div class="fact-box on-dark reveal" style="margin-top:28px;">
              <span class="fact-box-label">Worth noting · Farmington</span>
              <p>Cracking that tracks wet and dry years points toward heave, not settlement. Older homes near downtown or the river corridor were built fast during the boom — look at what the slab was built on, not just how it looks now.</p>
            </div>
          </div>
        </section>

        <!-- 04 AZTEC -->
        <section class="section town-rail-section" id="aztec">
          <span class="section-num">04</span>
          <div class="town-rail reveal">
            <div class="town-rail-spine" aria-hidden="true"></div>
            <div class="town-rail-body">
              <span class="section-label-text" style="display:block;margin-bottom:12px;">Aztec · Upstream rail on the Animas</span>
              <h2 class="section-heading" style="margin-bottom:20px;">Aztec — <em>shallow groundwater is documented</em></h2>
              <blockquote class="town-rail-quote">A subsurface drain and six observation wells manage water beneath Aztec Ruins — published engineering on this same corridor, not a guess.</blockquote>
              <p>The San Juan County seat sits a few miles upriver from Farmington on the Animas — named for nearby Ancestral Puebloan ruins, not the Aztec civilization, a 19th-century naming mistake that stuck.</p>
              <p>Persistently damp crawlspaces can mean a standing water-table condition, not a one-time leak. Homes near the river corridor sit on older terrace deposits that can behave differently than higher ground nearby.</p>
            </div>
          </div>
        </section>

        <!-- 05 BLOOMFIELD -->
        <section class="section town-grid-section" id="bloomfield">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Bloomfield · Terrain Change</span></div>
            <h2 class="section-heading reveal">Bloomfield — <em>shale you can see, and a corridor you can't</em></h2>
            <div class="town-grid reveal">
              <div class="town-cell town-cell-see">
                <span class="town-cell-label">What you can see</span>
                <h3>Gray-green shale outcrops</h3>
                <p>Driving in from the south, the terrain visibly changes — hills take on a gray-green color where shale weathers at the surface. One of the few places here you can see the geology before you look at a foundation.</p>
              </div>
              <div class="town-cell town-cell-cant on-dark">
                <span class="town-cell-label">What you can't</span>
                <h3>Collapsible corridor</h3>
                <p>We've found deep collapsible soil here too, close enough to the shale that two unrelated mechanisms show up blocks apart. <mark class="key">A neighbor's repair history is not a diagnosis.</mark></p>
              </div>
            </div>
            <p class="reveal" style="margin-top:24px;">We've measured both heave and settlement in Bloomfield — sometimes close together. Town boundaries don't sort them.</p>
          </div>
        </section>

        <!-- 06 ACROSS THREE TOWNS -->
        <section class="section" id="across-three-towns">
          <span class="section-num">06</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Investigation · Across the Confluence</span></div>
            <h2 class="section-heading reveal">One investigation standard — <em>three municipal names</em></h2>
            <div class="two-col reveal">
              <div>
                <p>Foundation inspection here means understanding the ground at a specific address, across three towns that don't share one simple explanation. A repair that worked at another house in the area isn't automatically the right repair for yours.</p>
                <p>TLS Foundations works with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a> when site conditions warrant a formal soil investigation before repair is recommended. Sometimes the honest answer is drainage. Sometimes it's monitoring. The investigation is what tells you which.</p>
              </div>
              <div>
                <div class="pull">We'd rather tell you nothing is wrong than sell you something that is.</div>
              </div>
            </div>
          </div>
        </section>

        <!-- 07 BEFORE YOU SIGN — two-column by town (Farmington-only) -->
        <section class="section" id="before-you-sign">
          <span class="section-num">07</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Before You Sign · Ask by Town</span></div>
            <h2 class="section-heading reveal">One question framed for <em>each place on the confluence</em></h2>
            <p class="lede reveal">Not three copies of the same pitch — three different questions worth asking before you sign, tagged to where you actually live.</p>

            <div class="bys-twocol reveal">
              <article class="bys-twocol-primary">
                <span class="bys-twocol-tag">Farmington</span>
                <h3>Was this house built in the boom — and has anyone characterized the ground under it?</h3>
                <p>1950s gas-boom stock went up fast. A same-day pier quote that never mentions era or soil depth is pricing a symptom, not a site.</p>
              </article>
              <div class="bys-twocol-stack">
                <article class="bys-twocol-item">
                  <span class="bys-twocol-tag">Aztec</span>
                  <h3>Have they asked about water — not just cracks?</h3>
                  <p>Shallow groundwater is documented on this corridor. Persistently damp conditions change what "settlement" even means.</p>
                </article>
                <article class="bys-twocol-item">
                  <span class="bys-twocol-tag">Bloomfield</span>
                  <h3>Are they assuming shale because they can see it?</h3>
                  <p>Visible outcrops don't rule out the collapsible corridor nearby. Ask which mechanism they think you have — and how they know.</p>
                </article>
              </div>
            </div>
            <p class="ask-closer reveal">Whoever you call, you should reach the person who will stand on your lot. Ours: <a href="tel:5059914180">(505) 991-4180</a>.</p>
          </div>
        </section>

        <!-- 08 QUESTIONS — tagged Q list (not Gallup accordion chrome) -->
        <section class="section" id="questions">
          <span class="section-num">08</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Questions · Tagged by Place &amp; Mechanism</span></div>
            <h2 class="section-heading reveal">Answers that name the town — <em>or the mechanism</em></h2>

            <div class="q-list reveal">
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">Farmington</span><span class="q-tag q-tag-mech">Patchwork ground</span></div>
                <h3>What causes foundation problems in Farmington?</h3>
                <p>River deposits, older terraces, and interbedded sandstone and shale — not one uniform soil. Depending on the lot: expansive clay/shale heave, collapsible silt or sand settlement, or both. Two homes a few blocks apart can have genuinely different ground.</p>
              </div>
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">Bloomfield</span><span class="q-tag q-tag-mech">Heave + settlement</span></div>
                <h3>Does Bloomfield have different soil than Farmington?</h3>
                <p>We've measured both heave and settlement in Bloomfield — expansive clay in some spots, loose deep collapsible soil in others, sometimes close together. Geology varies at a finer scale than a town boundary. Aztec shows the same mix, not one signature soil per city limit.</p>
              </div>
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">All three</span><span class="q-tag q-tag-mech">Cost</span></div>
                <h3>How much does foundation repair cost in the Farmington area?</h3>
                <p>Cost follows cause. Drainage correction and a pier system differ by an order of magnitude; both get recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread reflects the companies more than the house.</p>
              </div>
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">All three</span><span class="q-tag q-tag-mech">Piers</span></div>
                <h3>Helical or push piers?</h3>
                <p>Both get used. Choice depends on what's under a given slab — depth and consistency of bearing material, and whether the mechanism is heave or settlement. Piers for settlement don't fix heave. Soil characterization comes before pier selection.</p>
              </div>
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">Aztec</span><span class="q-tag q-tag-mech">Groundwater</span></div>
                <h3>Why does water keep coming up in Aztec conversations?</h3>
                <p>Because it's documented on this corridor — including engineered drainage under Aztec Ruins. Persistently damp crawlspaces can be a water-table condition, not a one-off plumbing leak. That changes how you read movement.</p>
              </div>
              <div class="q-item">
                <div class="q-meta"><span class="q-tag">All three</span><span class="q-tag q-tag-mech">Investigation</span></div>
                <h3>Who does foundation repair here — and when is a soil investigation needed?</h3>
                <p>TLS Foundations serves Farmington, Aztec, and Bloomfield with 55 combined years of New Mexico soil experience. Owner-operated. Not every home needs a formal geotech investigation; many questions resolve with drainage, grading, and movement patterns. When the answer turns on depth, we work with <a href="https://www.sandiageo.com" target="_blank" rel="noopener">SandiaGEO</a>. Call (505) 991-4180.</p>
              </div>
            </div>
          </div>
        </section>

        <div class="contact-closer reveal">
          <div class="contact-closer-inner">
            <div class="contact-closer-text">
              <span class="section-label-text" style="display:block;margin-bottom:16px;">Ready to talk</span>
              <p>Three towns. One confluence. We investigate the address — not the city-limit assumption. You reach the owner(s) when you call.</p>
            </div>
            <div class="contact-closer-phone">
              <a href="tel:5059914180">(505) 991-4180</a>
              <span class="note">Text or call — your choice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.documentElement.classList.add('js-reveal');

  const progressFill = document.getElementById('progressFill');
  const contentArea = document.querySelector('.content-area');
  window.addEventListener(
    'scroll',
    () => {
      if (!progressFill || !contentArea) return;
      const rect = contentArea.getBoundingClientRect();
      const total = (contentArea as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      (progressFill as HTMLElement).style.height = Math.min(100, (scrolled / total) * 100) + '%';
    },
    { passive: true }
  );

  const sections = document.querySelectorAll('.content-area section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove('active'));
          const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sections.forEach((s) => sectionObs.observe(s));

  navLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // Real confluence map (Leaflet + OSM) — no API key
  const towns = {
    farmington: { name: 'Farmington', lat: 36.7282, lng: -108.2187, zoom: 12 },
    aztec: { name: 'Aztec', lat: 36.8222, lng: -107.9928, zoom: 12 },
    bloomfield: { name: 'Bloomfield', lat: 36.7114, lng: -107.9845, zoom: 12 },
  } as const;

  type TownKey = keyof typeof towns;

  function loadLeaflet(): Promise<any> {
    const w = window as any;
    if (w.L) return Promise.resolve(w.L);
    return new Promise((resolve, reject) => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = () => resolve(w.L);
      script.onerror = () => reject(new Error('Leaflet failed to load'));
      document.head.appendChild(script);
    });
  }

  const mapEl = document.getElementById('confluenceMap');
  let map: any = null;
  let mapReady = false;
  const markers: Partial<Record<TownKey, any>> = {};

  function townIcon(L: any, label: string) {
    return L.divIcon({
      className: 'tls-map-marker',
      html: `<span class="tls-map-pin"></span><span class="tls-map-label">${label}</span>`,
      iconSize: [120, 36],
      iconAnchor: [12, 18],
    });
  }

  async function initConfluenceMap() {
    if (!mapEl || mapReady) return;
    mapReady = true;
    try {
      const L = await loadLeaflet();
      map = L.map(mapEl, {
        scrollWheelZoom: false,
        attributionControl: true,
      });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const bounds = L.latLngBounds([]);
      (Object.keys(towns) as TownKey[]).forEach((key) => {
        const t = towns[key];
        const m = L.marker([t.lat, t.lng], { icon: townIcon(L, t.name) }).addTo(map);
        m.bindPopup(`<strong>${t.name}</strong>`);
        markers[key] = m;
        bounds.extend([t.lat, t.lng]);
      });
      map.fitBounds(bounds.pad(0.35));
      window.setTimeout(() => map?.invalidateSize(), 50);

      mapEl.addEventListener('click', () => map.scrollWheelZoom.enable());
    } catch {
      mapEl.innerHTML =
        '<p class="confluence-map-fallback">Map could not load. Farmington, Aztec, and Bloomfield sit on the San Juan / Animas / La Plata confluence in northwest New Mexico.</p>';
    }
  }

  // Init when confluence section scrolls into view (reveal starts at opacity 0)
  const confluenceEl = document.getElementById('confluence');
  if (confluenceEl) {
    const mapObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            initConfluenceMap().then(() => window.setTimeout(() => map?.invalidateSize(), 100));
            mapObs.disconnect();
          }
        });
      },
      { rootMargin: '80px' }
    );
    mapObs.observe(confluenceEl);
  }

  document.querySelectorAll('.confluence-layout [data-town]').forEach((el) => {
    el.addEventListener('click', () => {
      const key = (el as HTMLElement).dataset.town as TownKey;
      document.querySelectorAll('.confluence-layout [data-town]').forEach((n) => n.classList.remove('active'));
      el.classList.add('active');
      if (map && towns[key]) {
        map.flyTo([towns[key].lat, towns[key].lng], towns[key].zoom, { duration: 0.8 });
        markers[key]?.openPopup();
      }
    });
  });
</script>

