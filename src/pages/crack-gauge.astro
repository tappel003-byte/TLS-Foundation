    /* Belt-and-suspenders alongside .bar's own rule -- covers anything
       else on this page relying on a background-color fill to print
       faithfully instead of getting muted to save ink. */
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }
    @page { size: Letter portrait; margin: 0; }
