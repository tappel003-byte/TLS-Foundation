<script>
  const printBtn = document.getElementById('printGaugeBtn');
  printBtn?.addEventListener('click', () => window.print());

  const form = document.getElementById('crackGaugeForm') as HTMLFormElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;
  const submitBtn = form?.querySelector('.form-submit') as HTMLButtonElement | null;
  const accessKey = (form?.querySelector('input[name="access_key"]') as HTMLInputElement | null)?.value;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submitBtn || !form) return;

    if (!accessKey) {
      status.textContent = "This isn't hooked up yet — text or call (505) 991-4180 in the meantime.";
      status.classList.add('is-error');
      return;
    }

    submitBtn.disabled = true;
    status.classList.remove('is-error');
    status.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();
      if (data.success) {
        status.textContent = "Sent — we'll be in touch.";
        form.reset();
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch {
      status.textContent = 'Something went wrong — text or call (505) 991-4180 instead.';
      status.classList.add('is-error');
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
