    /* Neutralize the on-screen horizontal-scroll wrapper for print --
       it exists only so a sheet wider than the article column doesn't
       get squished on screen (see the box-sizing note above); carrying
       any of that overflow/width behavior into print risked exactly
       the kind of multi-page tiling this fixes. */
    .print-preview-scroll { overflow: visible !important; width: auto !important; }
    .print-sheet, .print-sheet-2 {
      box-shadow: none !important;
      margin: 0 !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    /* Scoped to the first sheet specifically, not the shared .print-sheet
       class -- that class used to also match #print-sheet-2, which (on
       top of its own page-break-before) meant the LAST page got a
       trailing page-break-after too, producing a stray blank page. */
    #print-sheet { page-break-after: always; break-after: page; }
    #print-sheet-2 { page-break-before: always; break-before: page; }
  }
