// [TIM: ...] marks spots needing real NM numbers/field experience.
import Layout from '../layouts/Layout.astro';

const title = 'Micropiles in New Mexico | TLS Foundations';
const summary =
  'Micropiles are small-diameter (3 to 12 inch) drilled and grouted foundation elements that carry load through the bond between grout and the surrounding ground along the shaft -- not primarily through bearing at the tip, the way a helical or push pier works. That bond varies dramatically by soil type and grouting method, which is exactly why they exist: they can reach load-bearing ground through hard rock, cobbles, or dense caliche that would stop a driven or torqued pier cold, in places too tight for larger equipment to access.';
const description =
  'What micropiles are, how they carry load through grout-to-soil bond rather than bearing, and when New Mexico ground calls for the drilled option instead of a driven or torqued pier.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Micropiles in New Mexico',
    description,
    about: description,
    author: { '@type': 'Organization', name: 'TLS Foundations' },
