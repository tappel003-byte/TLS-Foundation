// soil over cobbles over more loose soil) forces real-time
// means-and-methods decisions -- hollow bar vs. cased hole, grouting
// approach -- which is exactly why both contractor and design-engineer
// experience are paramount on a micropile job. Ties directly to the
// delegated-design point above.
import Layout from '../layouts/Layout.astro';

const title = 'Micropiles in New Mexico | TLS Foundations';
const description =
  'What micropiles are, how they carry load through grout-to-soil bond rather than bearing, and when New Mexico ground calls for the drilled option instead of a driven or torqued pier.';

