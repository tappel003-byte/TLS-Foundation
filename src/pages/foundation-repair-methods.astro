---
// Foundation Repair Methods ("The Tool Box"). Built from the user-pasted
// code blocks: Ken Burns hero, a fully self-contained page (stats bar,
// 4-step process flow, 8 expandable method cards, 6 flip-card symptoms),
// and a page-specific footer service-area paragraph.
//
// Content check (see CONTENT_TRIM_LOG.md): this page already avoided the
// "same argument restated" problem -- it correctly never imports the
// investigation-first/Sandia GEO argument that belongs to /our-approach.
// The real issue was narrower: 4 of the 8 method cards (Push Piers,
// Micropiles, Compaction Grouting, Foam Injection) had "expand for more"
// bodies that were pure filler, restating the preview in vaguer words
// with no new information -- unlike the Drainage card next to them,
// which names specific real hazards (Mancos Shale, karst, mine
// subsidence). Replaced all 4 with genuine technical distinctions,
// including the wood-frame/push-pier limitation already stated
// elsewhere on the site (index.astro's services list) but missing from
// this page's own dedicated Push Piers card.
import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair Methods | TLS Foundations New Mexico';
const summary =
  "Eight tools, not one system: helical piers, push piers, and micropiles for deep support; compaction grouting and foam injection for loose soil and voids; drainage correction when moisture is the actual problem; monitoring when repair would be premature; and custom solutions when nothing standard fits. None of these methods are proprietary -- any contractor can offer them. The difference is whether the method gets picked before or after the soil is actually understood. A company that sells one system evaluates every problem through that system; carrying the full toolkit means the method follows the diagnosis instead of the other way around.";
const description =
  'We match the repair method to the problem, not the other way around. Helical piers, push piers, grouting, drainage -- all based on a proper diagnosis.';

const serviceAreaText = `TLS Foundations is a New Mexico foundation repair contractor serving residential and commercial clients across the state. We install helical piers, push piers, and micropiles for deep foundation support. We perform compaction grouting and foam injection for void fill and soil densification. We correct drainage and surface grading when moisture is the problem — which in New Mexico, it usually is. We recommend monitoring when repair is premature. We design custom solutions when the soil profile requires something the standard toolkit doesn't cover. Eight methods on this page. The one we recommend is the one the soil warrants — not the one that generates the largest invoice. A company that sells a system evaluates every problem through the lens of that system. We carry a broad enough toolkit that the method genuinely follows the diagnosis. That is the difference.`;

const methods = [
  { id: 'helical-piers', name: 'Helical Piers', description: 'Steel piers with helical plates, rotated into the ground to reach competent bearing soil. Installed where deeper support is needed for homes with shallow foundations, expansive clay, or variable soil conditions.' },
  { id: 'push-piers', name: 'Push Piers', description: 'Steel piers driven into the ground using the weight of the structure as reaction force. Used for commercial buildings, multi-storey homes, and heavy structures where a driven deep-support system is the right approach.' },
  { id: 'micropiles', name: 'Micropiles', description: 'Small-diameter drilled and grouted deep foundation elements. Used where access is limited or the soil profile requires reaching bearing at significant depth through hard material.' },
  { id: 'compaction-grouting', name: 'Compaction Grouting', description: 'Low-slump grout injected under pressure to densify loose soil and fill voids. Used for settled slabs, voids under foundations, collapsible soil, or loose zones that need densification.' },
  { id: 'foam-injection', name: 'Foam Injection', description: 'Expanding polyurethane foam injected beneath slabs to lift and fill light voids. Used for sunken driveways, sidewalks, light interior slabs, or small voids under concrete.' },
  { id: 'drainage-correction', name: 'Drainage and Grading Correction', description: "Correcting grading, gutters, and surface drainage to direct water away from the foundation. Often the correct first intervention, since most New Mexico foundation movement is moisture-driven -- though it has real limits once soil has already lost bearing capacity or the cause is geological." },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Foundation Repair Methods',
    itemListElement: methods.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: m.name,
        description: m.description,
        url: `https://www.tlsfoundations.com/foundation-repair-methods#${m.id}`,
        provider: { '@type': 'LocalBusiness', name: 'TLS Foundations' },
        areaServed: { '@type': 'State', name: 'New Mexico' },
        serviceType: 'Foundation repair',
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Foundation Repair Methods', item: 'https://www.tlsfoundations.com/foundation-repair-methods' },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  footer="full"
  schema={schema}
  ogImage="/images/foundation-repair-methods-hero.jpg"
  summary={summary}
  pageName="Foundation Repair Methods"
  nextPage={{ path: '/new-mexico-soil-conditions', name: 'New Mexico Soil Conditions' }}
  footerProps={{
    serviceAreaLabel: "Six methods (not to mention a couple others we have up our sleeves). The right one depends on your soil.",
    serviceAreaText,
  }}
>
  <div class="tls-hero">
    <img class="tls-hero-photo" src="/images/foundation-repair-methods-hero.jpg" alt="Foundation repair tools and equipment" fetchpriority="high" />
    <div class="tls-hero-overlay"></div>
    <div class="tls-hero-wrap">
      <div class="tls-hero-box">
        <span class="tls-hero-headline">The tool box</span>
        <span class="tls-hero-sub">(Using the right tool makes all the difference.)</span>
      </div>
    </div>
  </div>

  <div class="tlsfrm">
    <header class="hero">
      <div class="tlsfrm-container">
        <span class="hero-eyebrow">Foundation Repair Methods</span>
        <h1>We start with the ground. <em>The method follows.</em></h1>
        <p>New Mexico soils do not behave the same from one property to the next. We do not force a repair method first and explain it later. We look at what is actually happening, then choose the method that fits the problem.</p>
        <a href="tel:5059914180" class="hero-phone">(505) 991-4180</a>
        <span class="hero-note">You reach the owner</span>
      </div>
    </header>

    <div class="stats-bar reveal">
      <div class="tlsfrm-container">
        <div class="stat-item">
          <span class="stat-num" data-target="1000000">0<span>+</span></span>
          <span class="stat-label">Miles across New Mexico</span>
        </div>
        <div class="stat-connector">We didn't read about this ground. We drove it. <em>And still driving</em> — we wouldn't have it any other way.</div>
        <div class="stat-item">
          <span class="stat-num" data-target="440000">0</span>
          <span class="stat-label">Field miles on one truck</span>
        </div>
      </div>
    </div>

    <div class="gold-rule" aria-hidden="true"></div>

    <section class="section" id="how-we-decide">
      <div class="tlsfrm-container">
        <div class="section-label reveal">
          <span class="section-label-bar" aria-hidden="true"></span>
          <span class="section-label-text">How we decide</span>
        </div>
        <h2 class="reveal">A repair is only as good as <em>the judgment behind it.</em></h2>
        <p class="reveal">We are not looking for a reason to install a product. We are looking for the reason the structure moved in the first place. Sometimes the right answer is a foundation repair method. Sometimes it is drainage. Sometimes it is monitoring. Sometimes it is a combination of those things.</p>

        <div class="process-flow reveal">
          <div class="process-step">
            <span class="step-number">Step 1</span>
            <div class="step-title">Evaluate the soil</div>
            <p class="step-desc">Identify the soil type, moisture content, and how it's moving. Expansive clay, collapsible sand — each behaves differently.</p>
          </div>
          <span class="process-arrow">→</span>
          <div class="process-step">
            <span class="step-number">Step 2</span>
            <div class="step-title">Find the cause</div>
            <p class="step-desc">Is water pooling near the foundation? A plumbing leak? Seasonal drying? We trace the movement back to its source.</p>
          </div>
          <span class="process-arrow">→</span>
          <div class="process-step">
            <span class="step-number">Step 3</span>
            <div class="step-title">Select the method</div>
            <p class="step-desc">We match the repair to the soil, the structure, and the budget. Each method has a specific use.</p>
          </div>
          <span class="process-arrow">→</span>
          <div class="process-step">
            <span class="step-number">Step 4</span>
            <div class="step-title">Verify and monitor</div>
            <p class="step-desc">We check that the repair is working. Sometimes that means monitoring over time. We stay with the job until it's stable.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="methods">
      <div class="tlsfrm-container">
        <div class="section-label reveal">
          <span class="section-label-bar" aria-hidden="true"></span>
          <span class="section-label-text">Our methods</span>
        </div>
        <h2 class="reveal">The method follows the problem. <em>These are the tools.</em></h2>
        <p class="reveal">Eight tools, eight different jobs — no single one of them is the answer to everything. Click or tap any method to learn what it's actually for.</p>

        <div class="methods-grid reveal">
          <div class="method-card" id="helical-piers" role="button" tabindex="0" aria-label="Expand to learn more about Helical Piers">
            <div class="method-header">
              <span class="method-number">01</span>
              <div>
                <div class="method-name">Helical Piers</div>
                <span class="method-tag">Deep bearing · Residential</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Installed where deeper support is needed and where site conditions call for a deep foundation solution.</p>
            <div class="method-body">
              <p>In New Mexico, that may mean clay, fill, collapsible soil, or something else entirely. The point is reaching competent support in the right place.</p>
              <div class="method-fit"><strong>When it fits:</strong> Homes with shallow foundations, expansive clay, or variable soil conditions.</div>
            </div>
          </div>

          <div class="method-card" id="push-piers" role="button" tabindex="0" aria-label="Expand to learn more about Push Piers">
            <div class="method-header">
              <span class="method-number">02</span>
              <div>
                <div class="method-name">Push Piers</div>
                <span class="method-tag">Heavy structures · Settlement</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Used when the structure and site conditions call for a driven deep support system.</p>
            <div class="method-body">
              <p>Push piers rely on the structure's own weight to seat them, which is exactly why they're the right call for heavy commercial buildings and the wrong call for most New Mexico wood-frame homes — there isn't enough dead load to drive them properly.</p>
              <div class="method-fit"><strong>When it fits:</strong> Commercial buildings, multi-storey homes, or heavy structures where driven support is the right approach.</div>
            </div>
          </div>

          <div class="method-card" id="micropiles" role="button" tabindex="0" aria-label="Expand to learn more about Micropiles">
            <div class="method-header">
              <span class="method-number">03</span>
              <div>
                <div class="method-name">Micropiles</div>
                <span class="method-tag">Drilled · Deep profiles</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Useful where access is limited or where the site calls for a drilled deep foundation solution.</p>
            <div class="method-body">
              <p>Drilled and grouted rather than driven or torqued in, which is what makes them work where hard rock, cobbles, or dense caliche would stop a helical pier cold.</p>
              <div class="method-fit"><strong>When it fits:</strong> Tight spaces, deep unstable soil, or limited access where other equipment can't reach.</div>
            </div>
          </div>

          <div class="method-card" id="compaction-grouting" role="button" tabindex="0" aria-label="Expand to learn more about Compaction Grouting">
            <div class="method-header">
              <span class="method-number">04</span>
              <div>
                <div class="method-name">Compaction Grouting</div>
                <span class="method-tag">Loose soils · Void fill</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Used where voids, loose zones, or settlement conditions call for densification and support.</p>
            <div class="method-body">
              <p>A different tool than foam injection: this densifies the soil itself under pressure rather than filling a void from beneath a slab — the right call when the ground has lost density, not just when a slab has dropped.</p>
              <div class="method-fit"><strong>When it fits:</strong> Settled slabs, voids under foundations, collapsible soil, or loose zones that need densification.</div>
            </div>
          </div>

          <div class="method-card" id="foam-injection" role="button" tabindex="0" aria-label="Expand to learn more about Foam Injection">
            <div class="method-header">
              <span class="method-number">05</span>
              <div>
                <div class="method-name">Foam Injection</div>
                <span class="method-tag">Slab leveling · Light voids</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Often used for slab lifting and void filling where the movement is more about the slab than the larger foundation system.</p>
            <div class="method-body">
              <p>Lifts by expansion force, which is plenty for a sidewalk or a light slab but not a substitute for piers under a structure carrying real structural load.</p>
              <div class="method-fit"><strong>When it fits:</strong> Sunken driveways, sidewalks, light interior slabs, or small voids under concrete.</div>
            </div>
          </div>

          <div class="method-card" id="drainage-correction" role="button" tabindex="0" aria-label="Expand to learn more about Drainage and Grading">
            <div class="method-header">
              <span class="method-number">06</span>
              <div>
                <div class="method-name">Drainage and Grading</div>
                <span class="method-tag">Often the right first step</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Sometimes the right repair is not a structural repair at all.</p>
            <div class="method-body">
              <p>The majority of foundation movement in New Mexico is moisture-driven, so correcting drainage and grading is often the most important step on a property — and the correct first intervention, since a structural repair doesn't change what the water is doing. It has real limits, though: once soil has already lost its bearing capacity, or the cause is geological — Mancos Shale heave, karst voids in the Pecos Valley, mine subsidence in the Raton Basin — drainage correction alone won't fix it.</p>
              <div class="method-fit"><strong>When it fits:</strong> Water is the obvious culprit — downspouts, grading, irrigation, or surface runoff — and the soil hasn't yet lost its ability to bear load.</div>
            </div>
          </div>

          <div class="method-card" role="button" tabindex="0" aria-label="Expand to learn more about Monitoring">
            <div class="method-header">
              <span class="method-number">07</span>
              <div>
                <div class="method-name">Monitoring</div>
                <span class="method-tag">When waiting is right</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Not every issue needs immediate intervention.</p>
            <div class="method-body">
              <p>In some cases, the smartest move is to watch the movement over time so we can understand whether it is active, stable, or related to a seasonal condition.</p>
              <div class="method-fit"><strong>When it fits:</strong> Minor movement that may stabilise on its own, or when we need more data before acting.</div>
            </div>
          </div>

          <div class="method-card" role="button" tabindex="0" aria-label="Expand to learn more about Custom Solutions">
            <div class="method-header">
              <span class="method-number">08</span>
              <div>
                <div class="method-name">Custom Solutions</div>
                <span class="method-tag">When nothing else fits</span>
              </div>
              <span class="method-expand-icon">+</span>
            </div>
            <p class="method-preview">Some sites do not fit neatly into a standard category.</p>
            <div class="method-body">
              <p>When that happens, we build the repair around the actual conditions instead of forcing the problem into a template.</p>
              <div class="method-fit"><strong>When it fits:</strong> Unique structures, historic buildings, complex site conditions, or anything that doesn't fit a standard method.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="symptoms">
      <div class="tlsfrm-container">
        <div class="section-label reveal">
          <span class="section-label-bar" aria-hidden="true"></span>
          <span class="section-label-text">Common symptoms</span>
        </div>
        <h2 class="reveal">What homeowners notice <em>before they call us</em></h2>
        <p class="reveal">These are some of the signs that usually bring people to us. Tap or click a card to flip it for more context.</p>

        <div class="symptom-grid reveal">
          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Doors or windows that start sticking</div>
                <p class="symptom-desc">Often the first sign of foundation movement.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>If they worked before and now don't, the frame may have shifted. This is often subtle at first but worth investigating.</p>
              </div>
            </div>
          </div>

          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Cracks above openings</div>
                <p class="symptom-desc">Diagonal cracks from corners of doors and windows.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>Diagonal cracks often indicate differential settlement. Hairline vertical cracks may be minor settling. The direction and width matter.</p>
              </div>
            </div>
          </div>

          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Uneven floors</div>
                <p class="symptom-desc">Feeling like you're walking uphill inside.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>If a floor that used to feel level now slopes noticeably, the foundation could be sinking on one side. A level check can confirm.</p>
              </div>
            </div>
          </div>

          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Gaps where walls and ceilings separate</div>
                <p class="symptom-desc">Separation at the top of interior walls.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>This can indicate the foundation is settling unevenly, causing the structure to pull apart. It's often accompanied by other signs.</p>
              </div>
            </div>
          </div>

          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Stair-step cracks in masonry</div>
                <p class="symptom-desc">Cracks that follow mortar joints in brick or block.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>These often point to ongoing movement. The pattern and width can tell us whether it's active or historical.</p>
              </div>
            </div>
          </div>

          <div class="symptom-card" role="button" tabindex="0" aria-label="Tap to flip for more information">
            <div class="symptom-card-inner">
              <div class="symptom-front">
                <div class="symptom-title">Water collecting near the foundation</div>
                <p class="symptom-desc">Soggy soil around the perimeter.</p>
                <span class="symptom-hint">Tap to learn more</span>
              </div>
              <div class="symptom-back">
                <p>Moisture is often the root cause of movement. Downspouts, grading, and irrigation are the first things we check.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function initMethodsPage() {
    const flow = document.querySelector('.process-flow');
    if (flow) {
      const steps = Array.from(flow.querySelectorAll<HTMLElement>('.process-step'));
      let walked = false;
      function walk() {
        if (walked) return;
        walked = true;
        let i = 0;
        function light() {
          steps.forEach((s) => s.classList.remove('active'));
          if (i < steps.length) {
            steps[i].classList.add('active');
            i++;
            setTimeout(light, 1500);
          }
        }
        light();
      }
      const flowObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              walk();
              flowObs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.4 }
      );
      flowObs.observe(flow);
    }

    const revealObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObs.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

    function animateCount(el: HTMLElement) {
      const target = parseInt(el.dataset.target || '0', 10);
      if (!target) return;
      const suffixEl = el.querySelector('span');
      const suffix = suffixEl ? suffixEl.outerHTML : '';
      const duration = 3000;
      const start = performance.now();
      function update(now: number) {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        const val = Math.floor(eased * target);
        el.innerHTML = val.toLocaleString() + suffix;
        if (p < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }
    const statsBar = document.querySelector('.stats-bar');
    if (statsBar) {
      const statObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.querySelectorAll<HTMLElement>('.stat-num[data-target]').forEach(animateCount);
              statObs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -80px 0px' }
      );
      statObs.observe(statsBar);
    }

    document.querySelectorAll<HTMLElement>('.method-card').forEach((card) => {
      card.addEventListener('click', () => card.classList.toggle('expanded'));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.classList.toggle('expanded');
        }
      });
    });

    document.querySelectorAll<HTMLElement>('.symptom-card').forEach((card) => {
      card.addEventListener('click', () => card.classList.toggle('flipped'));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.classList.toggle('flipped');
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initMethodsPage);
</script>

<style>
  /* ===== TLS KEN BURNS HERO ===== */
  .tls-hero {
    position: relative;
    width: 100%;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .tls-hero-photo {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    animation: tlsKenBurns 20s ease-in-out infinite alternate;
  }
  @keyframes tlsKenBurns {
    from {
      transform: scale(1) translate(0, 0);
    }
    to {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }
  .tls-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 34, 56, 0.55) 0%, rgba(13, 34, 56, 0.25) 45%, rgba(13, 34, 56, 0.1) 100%);
  }
  .tls-hero-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 clamp(20px, 5vw, 80px) clamp(28px, 5vw, 64px);
  }
  .tls-hero-box {
    display: inline-block;
    background: rgba(13, 34, 56, 0.55);
    padding: 28px 40px 32px;
  }
  .tls-hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 400;
    color: #fff;
    line-height: 1.15;
    display: block;
