import Layout from '../layouts/Layout.astro';

const title = 'Why Foundations Move in New Mexico — TLS Foundations';
const summary =
  "Every foundation problem traces back to one of three things: the soil's behavior changed, the moisture regime changed, or the load on the foundation changed -- often more than one at once. Which driver is at work determines whether underpinning helps or makes things worse, and that can't be read off the surface symptoms alone, since heave and settlement often look identical. The full Cause Library catalogs 26 specific causes across six mechanisms -- from lost soil support to deep geologic hazards -- because the right response depends entirely on which one is actually happening.";
const description =
  "Foundations move because soil moves, and in New Mexico no two soils move the same way. The reference on causes, symptoms, and underpinning.";

const serviceAreaText = `Foundations move because soil moves — and in New Mexico, no two soils move the same way. The causes are specific: collapsible soil settlement, expansive clay heave, expansive shale movement, hydrocompaction, caliche/cemented soil bearing failure, soil piping, karst subsidence, evaporite dissolution, frost heave, post-tension slab failure, poorly compacted fill, cut-and-fill transition movement, plumbing leaks beneath slabs, irrigation-driven moisture change, tree root extraction, hillside creep, seismic activity along the Rio Grande Rift, and regional groundwater subsidence. The symptoms look similar — foundation cracks, sticking doors, uneven floors, slab gaps, wall separation, diagonal cracking at corners. The causes are not similar. Getting the diagnosis wrong produces a worse outcome than the original condition. Many New Mexico foundations don't need underpinning. The ones that do, we repair.`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does every foundation crack mean I need underpinning?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Cosmetic curing cracks, seasonal thermal movement, and stabilized historic settlement typically need no structural repair at all. Underpinning is one response among several -- drainage correction, leak repair, and monitoring are often the honest first step.',
      },
    },
    {
      '@type': 'Question',
      name: "What's the difference between heave and settlement?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Settlement is soil pulling down; heave is soil pushing up. They can look identical from cracking alone, but the correct response is opposite in each case -- underpinning fixes settlement, not heave.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why does the same crack pattern have so many possible causes in New Mexico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'New Mexico spans sixteen geologically distinct basins, each with its own soil behavior -- expansive clay, collapsible soil, karst, evaporite dissolution, and more. Visual inspection alone cannot distinguish between them; that requires investigation.',
      },
    },
  ],
};
