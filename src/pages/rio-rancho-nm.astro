import Layout from '../layouts/Layout.astro';

const title = 'Foundation Repair in Rio Rancho, NM — The City of Vision | TLS Foundations';
const description =
  'Foundation repair in Rio Rancho, NM. Variable West Mesa sandy loam, inconsistent caliche, and pocket clays across six decades of construction.';
const summary =
  "Rio Rancho sits on variable West Mesa sandy loam, with caliche depth and hardness that changes block to block and pocket clays scattered unpredictably across six decades of construction. That variability is exactly why a quick visual read isn't reliable here -- investigation before recommendation matters as much in Rio Rancho as anywhere in the state, maybe more, given how much the ground can change within a single neighborhood.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        headline: 'Foundation Repair in Rio Rancho, NM — The City of Vision',
        description:
          'Foundation repair in Rio Rancho, NM. Variable West Mesa sandy loam, inconsistent caliche, and pocket clays across six decades of construction. TLS Foundations investigates before recommending.',
        author: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        publisher: { '@type': 'Organization', name: 'TLS Foundations', url: 'https://www.tlsfoundations.com' },
        about: { '@type': 'Place', name: 'Rio Rancho, New Mexico' },
        mainEntityOfPage: 'https://www.tlsfoundations.com/rio-rancho-nm',
      },
      {
        '@type': 'LocalBusiness',
        name: 'TLS Foundations',
        telephone: '+15059914180',
        url: 'https://www.tlsfoundations.com',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '5048 Edith Blvd NE Suite E',
          addressLocality: 'Albuquerque',
          addressRegion: 'NM',
          postalCode: '87107',
          addressCountry: 'US',
        },
        areaServed: [
          { '@type': 'City', name: 'Rio Rancho', addressRegion: 'NM' },
          { '@type': 'City', name: 'Corrales', addressRegion: 'NM' },
          { '@type': 'City', name: 'Bernalillo', addressRegion: 'NM' },
        ],
        description:
          'Foundation repair contractor serving Rio Rancho, NM. Slab repair, foundation inspection, settlement, helical piers, drainage correction. 55 combined years of New Mexico soil experience. Investigation-first, owner-operated.',
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'What causes foundation problems in Rio Rancho NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Foundation movement in Rio Rancho is driven by soil conditions on the West Mesa: sandy loam, caliche at variable depth, and pocket clays that are not uniformly distributed and not visible at the surface. Because those conditions change across short distances, two homes on the same street can behave differently. Drainage on flat mesa terrain is a frequent contributing factor.',
            },
          },
          {
            '@type': 'Question',
            name: 'What is the most common sign of foundation movement in Rio Rancho?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Stucco and drywall cracks, usually first, especially around doors and windows. Both materials show movement quickly. Hairline cracking is often cosmetic. Cracks that grow, reappear after patching, or angle away from corners are more meaningful — particularly when they appear alongside sticking doors, uneven floors, or gaps opening around trim and cabinets.',
            },
          },
          {
            '@type': 'Question',
            name: 'How much does foundation repair cost in Rio Rancho NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cost follows cause. Drainage correction and a pier system differ by an order of magnitude, and both are commonly recommended for the same symptoms by different companies. Without a soil evaluation behind an estimate, a wide spread between quotes reflects the companies rather than the house. TLS Foundations investigates before recommending.',
            },
          },
          {
            '@type': 'Question',
            name: 'Are helical piers the right repair for Rio Rancho homes?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Sometimes. Helical piers transfer load to a deeper bearing layer, and on the West Mesa the governing question is the depth and consistency of caliche beneath the specific home. Shallow continuous caliche produces a very different design than caliche that varies from two feet to eight feet under the same slab. Pier selection should follow soil characterization, not precede it.',
            },
          },
          {
            '@type': 'Question',
            name: 'Who does foundation repair in Rio Rancho NM?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'TLS Foundations serves Rio Rancho, New Mexico with 55 combined years of New Mexico soil and foundation repair experience. Owner-operated, affiliated with Sandia GEO for geotechnical investigation when a site warrants it. Call (505) 991-4180 — you reach the owner(s).',
            },
          },
        ],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
          { '@type': 'ListItem', position: 2, name: 'City Pages', item: 'https://www.tlsfoundations.com/city-pages' },
          { '@type': 'ListItem', position: 3, name: 'Rio Rancho', item: 'https://www.tlsfoundations.com/rio-rancho-nm' },
        ],
