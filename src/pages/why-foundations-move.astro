<script>
  function tlsToggle(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const header = document.querySelector<HTMLButtonElement>(`[data-acc="${id}"]`);
    if (el.style.maxHeight && el.style.maxHeight !== '0px') {
      el.style.maxHeight = '0px';
      el.setAttribute('aria-hidden', 'true');
      header?.setAttribute('aria-expanded', 'false');
    } else {
      el.style.maxHeight = '2000px';
      el.setAttribute('aria-hidden', 'false');
      header?.setAttribute('aria-expanded', 'true');
    }
  }
  (window as any).tlsToggle = tlsToggle;

  function initWfm() {
    document.querySelectorAll<HTMLButtonElement>('.accordion-header[data-acc]').forEach((header) => {
      header.addEventListener('click', () => {
        const id = header.getAttribute('data-acc');
        if (id) tlsToggle(id);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('.jump-links a').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const group = link.getAttribute('data-group');
        if (group) document.getElementById(group)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-accordion-link]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const contentId = link.getAttribute('data-accordion-link');
        if (!contentId) return;
        const content = document.getElementById(contentId);
        if (content && (!content.style.maxHeight || content.style.maxHeight === '0px')) {
          tlsToggle(contentId);
        }
        setTimeout(() => {
          document.getElementById(contentId)?.closest('.accordion-item')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      });
    });

    const sections = document.querySelectorAll<HTMLElement>('.tls-body section[id]');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc a');
    function updateActiveToc() {
      let current = '';
      const scrollPos = window.scrollY + 150;
      sections.forEach((section) => {
        const top = section.offsetTop;
        const bottom = top + section.offsetHeight;
        if (scrollPos >= top && scrollPos < bottom) current = section.id;
      });
      tocLinks.forEach((link) => {
        link.classList.remove('active');
        if (link.getAttribute('href')?.substring(1) === current) link.classList.add('active');
      });
    }
    window.addEventListener('scroll', updateActiveToc);
    updateActiveToc();

    document.querySelectorAll<HTMLAnchorElement>('.tls-body a[href^="#"]').forEach((anchor) => {
      const hash = anchor.getAttribute('href');
      if (hash && hash.length > 1) {
        anchor.addEventListener('click', (e) => {
          const target = document.querySelector(hash);
          if (target) {
            e.preventDefault();
            const offset = 100;
            const pos = target.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: pos, behavior: 'smooth' });
          }
        });
      }
    });

    const dropdown = document.getElementById('cause-dropdown') as HTMLSelectElement | null;
    dropdown?.addEventListener('change', () => {
      const value = dropdown.value;
      if (!value) return;
      const content = document.getElementById(value);
      if (content) {
        const accordionItem = content.closest('.accordion-item') || content;
        if (content.classList.contains('accordion-content') && (!content.style.maxHeight || content.style.maxHeight === '0px')) {
          tlsToggle(value);
        }
        accordionItem.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      dropdown.value = '';
    });
  }
  document.addEventListener('DOMContentLoaded', initWfm);
</script>

