---
// Foundation Symptom Guide — reimagined per explicit creative license (not
// a family/sacred-cow page). Original content (19 symptoms, 5 categories)
// kept verbatim from the live page; presentation rebuilt around three
// goals: (1) answers visible without a click, so both readers and AI
// answer engines can actually see them, (2) one region picker instead of
// 19 duplicated ones, (3) FAQPage schema since the content already is Q&A.
// Also fixes a real bug found on the live page: its <title> tag read
// "Most Common Foundation Concerns in New Mexico" (a different page's
// title) instead of anything about symptoms.
import Layout from '../layouts/Layout.astro';
import ReferenceNav from '../components/ReferenceNav.astro';

const title = 'Foundation Symptom Guide — What Cracks, Sticking Doors & Uneven Floors Mean | TLS Foundations';
const summary =
  "This guide organizes the most common signs New Mexico homeowners notice -- cracks, sticking doors, uneven floors, foundation-specific symptoms, and water or drainage issues -- into a searchable, filterable set of symptom cards, each explaining what's typically happening and whether it usually warrants attention. It's explicitly a starting point, not a diagnosis: soil conditions, site drainage, and how long something has been changing all matter, and heave and settlement can look identical while requiring opposite repairs. A quick myth-buster section up front tackles the questions people actually have before digging in -- is this really \"foundation failure,\" does every crack matter, do you need repair right now.";
const description =
  "See something? Here's what it usually means and whether it warrants attention -- New Mexico foundation symptoms grouped by category and soil context.";

interface Symptom {
  q: string;
  whatsHappening: string;
  needsRepair: string;
  nmContext: string;
  links: { text: string; href: string }[];
}
interface Category {
  id: string;
  label: string;
  items: Symptom[];
}

const categories: Category[] = [
  {
    id: 'cracks',
    label: 'Cracks in Walls & Floors',
    items: [
      {
        q: 'Diagonal cracks near doors or windows',
        whatsHappening:
          'Differential settlement, seasonal soil movement, or framing shrinkage concentrating stress at the weakest points in the wall — door and window openings.',
        needsRepair: 'Often not urgent. Monitor for progression. If actively widening, have it evaluated before assuming the cause.',
        nmContext:
          'Clay soil cycles drive seasonal cracking across the Rio Grande corridor. Heave and settlement produce identical-looking cracks — the wrong diagnosis leads to the wrong repair.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Expansive Soils', href: '/expansive-soil' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Horizontal cracks in foundation or basement wall',
        whatsHappening:
          "Lateral soil pressure against the wall — the most structurally significant crack pattern in foundation walls. Horizontal cracking means the wall is being pushed inward.",
        needsRepair: 'Yes, evaluate promptly. Horizontal cracks are a different category from diagonal or vertical cracking. Active inward movement requires attention.',
        nmContext:
          'Expansive clays exert significant lateral pressure after monsoon saturation. Poorly drained sites in the Rio Grande Valley and Four Corners are highest risk.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Expansive Soils', href: '/expansive-soil' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Ceiling cracks or gaps at ceiling-wall junction',
        whatsHappening:
          'Differential movement between the wall and ceiling plane — framing settling unevenly, or the wall moving relative to the roof structure above.',
        needsRepair: 'Hairline ceiling cracks are common and usually cosmetic. A gap opening between the ceiling and wall — especially if progressive — warrants investigation.',
        nmContext:
          'Seasonal moisture cycling in clay soils produces cyclical movement that opens and closes ceiling gaps over the course of a year. Document with photos and dates before calling anyone.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Cracks in concrete slab or garage floor',
        whatsHappening: 'Concrete shrinkage, restraint cracking, curing stress, or soil movement beneath the slab.',
        needsRepair: "Most are cosmetic. If cracks are widening, if one side is higher than the other, or if you can feel a lip underfoot, evaluate.",
        nmContext:
          "New Mexico's extreme drying cycles accelerate concrete shrinkage cracking — more so than in humid climates. Not every slab crack is a foundation crack.",
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Foam Injection', href: '/foundation-repair-methods#foam-injection' },
        ],
      },
      {
        q: 'Stucco cracks on exterior walls',
        whatsHappening: 'Curing shrinkage, thermal movement, or substrate movement. Most stucco cracks are not foundation cracks.',
        needsRepair: 'Most are cosmetic. Widening cracks, cracks with displacement, or cracks that correlate with interior symptoms warrant investigation.',
        nmContext:
          'High desert temperature swings — often 40°F in a single day — cause significant stucco movement. Evaluate interior symptoms alongside exterior cracking before concluding the cause.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
    ],
  },
  {
    id: 'doors-windows',
    label: 'Doors & Windows',
    items: [
      {
        q: "Doors that stick, bind, or won't latch",
        whatsHappening: 'The door frame has racked — meaning the opening is no longer square. This happens when one corner of the structure moves relative to another.',
        needsRepair:
          "Note whether it's seasonal or constant. A door that sticks only in summer and frees up in winter is often responding to humidity or soil cycling, not structural failure.",
        nmContext:
          'Seasonal clay soil movement — wet season expansion, dry season contraction — is the most common cause of sticking doors in New Mexico. Document the pattern before calling anyone.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Heave vs. Settlement', href: '/common-concerns#heave' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: "Windows that stick, won't open, or won't close fully",
        whatsHappening: 'Same mechanism as sticking doors — the rough opening has racked out of square. Windows are less forgiving than doors because the frame tolerances are tighter.',
        needsRepair:
          'Check whether multiple windows on the same wall are affected, or if the pattern correlates with doors sticking on the same side of the house. Isolated window issues are often installation or expansion — multiple affected openings on one side suggest soil movement.',
        nmContext:
          'One side of a house affected, the other side fine — a common New Mexico pattern indicating differential soil movement under one corner or edge of the foundation.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Gaps at the top or bottom of door frames',
        whatsHappening:
          'The door frame has moved relative to the door — the opening has become parallelogram-shaped rather than rectangular. Visible daylight at corners or an uneven gap across the top of the door.',
        needsRepair: "A gap that has been stable for years is different from one that is growing. Photograph and measure. If it's changing, investigate.",
        nmContext:
          'A diagonal gap — wide at one corner, tight at the other — is a classic differential movement signature. Which corner is tight tells you the direction of movement.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Heave vs. Settlement', href: '/common-concerns#heave' },
        ],
      },
    ],
  },
  {
    id: 'floors-walls',
    label: 'Uneven Floors & Walls',
    items: [
      {
        q: 'Sloping, uneven, or sinking floors',
        whatsHappening: 'Foundation settlement, collapsible soil subsidence, or framing deflection. The floor is following the foundation.',
        needsRepair: 'Monitor whether the slope is changing. A static slope that has been there for years is often normal; a progressive one warrants investigation.',
        nmContext:
          "Collapsible soils are widespread across New Mexico's basin floors — the West Mesa, Estancia Valley, and river corridors. They can collapse rapidly when moisture is introduced for the first time.",
        links: [
          { text: 'Common Concerns: Timing', href: '/common-concerns#wait' },
          { text: 'Collapsible Soils', href: '/collapsible-soil' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Gaps between walls and floors or ceilings',
        whatsHappening:
          'The wall has moved relative to the floor or ceiling plane — or the floor has dropped, or the ceiling has lifted. Separation at the junction is visible evidence of differential movement.',
        needsRepair:
          'A gap that is stable and has been present for years is different from one that is opening. If you can track the change over weeks or months, document it and get an evaluation.',
        nmContext:
          'Gaps that open in spring and close in fall — or vice versa — are often seasonal soil cycling, not progressive structural movement. The pattern matters as much as the gap itself.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Cabinets or countertops pulling away from walls',
        whatsHappening:
          'The wall has moved relative to the cabinet or countertop mounting — or the floor below has settled, pulling the base cabinet down and away from the wall above.',
        needsRepair:
          'A small gap that has been stable is often just settling. A gap that is growing, or that appeared suddenly, is worth investigating — particularly if other symptoms are present in the same area of the house.',
        nmContext:
          'Kitchen and bath areas are often first indicators of localized movement — plumbing leaks beneath slabs in these areas are a common trigger for sudden soil changes.',
        links: [
          { text: 'Collapsible Soils', href: '/collapsible-soil' },
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
        ],
      },
      {
        q: 'Bowed or leaning foundation wall',
        whatsHappening: 'Lateral soil pressure, expansive clay heave, or hydrostatic pressure pushing against the foundation wall from outside.',
        needsRepair:
          'Active inward movement warrants evaluation. Some walls stabilize once drainage is corrected. The rate of movement matters — slow and stable is different from progressive.',
        nmContext:
          'Expansive clay exerts significant lateral pressure after monsoon saturation. Poorly drained sites in the Rio Grande Valley and Four Corners are highest risk for wall bowing.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Expansive Soils', href: '/expansive-soil' },
          { text: 'Repair Methods', href: '/foundation-repair-methods' },
        ],
      },
    ],
  },
  {
    id: 'foundation',
    label: 'The Foundation Itself',
    items: [
      {
        q: 'Visible cracks in the stem wall or foundation',
        whatsHappening: 'The foundation itself is cracking — either from shrinkage during curing, differential settlement, heave, or lateral pressure.',
        needsRepair:
          'Hairline cracks in cured concrete are common and usually stable. Cracks wider than 1/4 inch, cracks with displacement (one side higher than the other), or cracks that are actively growing warrant evaluation.',
        nmContext:
          'Photograph and measure any foundation crack. A crack that has been unchanged for five years is a different situation from one that has doubled in width over six months. The record you create now is the evidence that matters later.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Gap between foundation and house framing',
        whatsHappening:
          'The sill plate or mudsill — the wood framing member that sits on top of the foundation — has separated from the concrete below. Either the foundation has dropped, or the framing has lifted.',
        needsRepair: 'A visible gap at the foundation-to-framing connection is worth evaluating. It affects both structural integrity and pest and moisture intrusion.',
        nmContext:
          'Heave lifting the interior slab while perimeter walls settle — or vice versa — is a common New Mexico pattern that creates gaps at the foundation perimeter. The direction of the gap tells part of the story.',
        links: [
          { text: 'Heave vs. Settlement', href: '/common-concerns#heave' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Soil pulling away from the foundation perimeter',
        whatsHappening:
          'Soil shrinkage during dry cycles, or settlement of fill soil placed during construction. The gap exposes the foundation and allows water to pond directly against the concrete during rain events.',
        needsRepair:
          "The gap itself is worth filling to prevent water infiltration. More importantly, it's a sign of active soil shrinkage — which means the same soil is likely shrinking beneath the foundation as well.",
        nmContext:
          'This is extremely common across New Mexico during drought cycles. The visible gap is the surface expression of what is happening at depth. Backfill the gap and monitor for recurrence — recurring gaps indicate ongoing active soil volume change.',
        links: [
          { text: 'Drainage Correction', href: '/foundation-repair-methods#drainage-correction' },
          { text: 'Expansive Soils', href: '/expansive-soil' },
          { text: 'Why Foundations Move', href: '/why-foundations-move' },
        ],
      },
      {
        q: 'Chimney leaning or separating from the house',
        whatsHappening:
          'The chimney foundation is settling or moving independently from the main house foundation. Chimneys are often built on their own footing, which may behave differently from the main slab.',
        needsRepair:
          'A chimney that is visibly leaning or has opened a gap at the house connection warrants evaluation. Beyond aesthetics, a separating chimney affects flashing, roofing, and weathertightness.',
        nmContext:
          'Adobe and older masonry construction with separate chimney footings is common in historic Santa Fe, Taos, and Albuquerque properties. Differential movement between the chimney and the main structure is a frequent finding in these homes.',
        links: [
          { text: 'Common Concerns: Signs', href: '/common-concerns#signs' },
          { text: 'Northern NM Soils', href: '/northern-new-mexico' },
          { text: 'Central NM Soils', href: '/central-new-mexico' },
        ],
      },
    ],
  },
  {
    id: 'water',
    label: 'Water & Drainage Issues',
    items: [
      {
        q: 'Water pooling near the foundation',
        whatsHappening: 'Negative site drainage, improper grade, or irrigation runoff collecting against the foundation instead of draining away from it.',
        needsRepair: 'Fix drainage first. Correcting grade often eliminates the need for structural repair entirely — the moisture trigger is removed and the soil stabilizes.',
        nmContext:
          'Moisture is the critical trigger for both expansive soil heave and collapsible soil collapse. Moisture migration is frequently the most important repair a New Mexico homeowner can make — and the least expensive.',
        links: [
          { text: 'Drainage Correction', href: '/foundation-repair-methods#drainage-correction' },
          { text: 'Drainage Correction', href: '/foundation-repair-methods#drainage-correction' },
          { text: "Why NM's Different", href: '/our-approach' },
        ],
      },
      {
        q: 'Foundation symptoms appearing after a plumbing change',
        whatsHappening:
          'A plumbing leak — supply line or waste line — has introduced moisture to soil that may have been dry since the home was built. In collapsible soils, that first wetting event can cause rapid settlement. In expansive clays, a localized leak can trigger heave directly above it.',
        needsRepair:
          'Rule out plumbing before scheduling any foundation evaluation. A pressure test on both supply and waste lines is the right first step when symptoms appeared suddenly or are concentrated in one area — significantly less expensive than foundation repair, and the right call when the pattern suggests it.',
        nmContext:
          "Waste line leaks cause more foundation damage than supply line leaks in our experience — they introduce water continuously and go undetected longer. Both sides need to be tested. Worth checking before you pay out of pocket: many homeowners policies cover locating a sudden, accidental leak even though they exclude the resulting soil movement — read your policy or call your agent and ask specifically.",
        links: [
          { text: 'Common Concerns: Insurance', href: '/common-concerns#insurance' },
          { text: 'Collapsible Soils', href: '/collapsible-soil' },
        ],
      },
      {
        q: 'Crawlspace moisture or sagging floors',
        whatsHappening:
          'Poor site drainage, inadequate ventilation, or foundation movement affecting the floor system. Moisture in a crawlspace accelerates wood decay and can affect floor framing independently of the foundation.',
        needsRepair:
          'Address moisture source first. If the floor framing is sagging, investigate the foundation below it. The two problems can coexist — moisture damage to framing and soil movement beneath it — and both need to be evaluated.',
        nmContext:
          'Monsoon season can saturate crawlspaces quickly in low-lying areas. Proper drainage and vapor management are critical — especially in older Albuquerque South Valley and Santa Fe homes near acequias.',
        links: [
          { text: 'Drainage Correction', href: '/foundation-repair-methods#drainage-correction' },
          { text: "Why NM's Different", href: '/our-approach' },
        ],
      },
    ],
  },
];

const regions = [
  { name: 'Central New Mexico', url: '/central-new-mexico' },
  { name: 'Northern New Mexico', url: '/northern-new-mexico' },
  { name: 'Four Corners', url: '/four-corners' },
  { name: 'Eastern New Mexico', url: '/eastern-new-mexico' },
  { name: 'Southern New Mexico', url: '/southern-new-mexico' },
];

const allSymptoms = categories.flatMap((c) => c.items);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allSymptoms.map((s) => ({
      '@type': 'Question',
      name: s.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${s.whatsHappening} ${s.needsRepair}`,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Reference', item: 'https://www.tlsfoundations.com/common-concerns' },
      { '@type': 'ListItem', position: 3, name: 'Symptom Guide', item: 'https://www.tlsfoundations.com/symptom-guide' },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  summary={summary}
  pageName="Symptom Guide"
  nextPage={{ path: '/common-concerns', name: 'Common Concerns' }}
>
  <div class="sg-page">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Resources · Reference</span>
        <h1>Foundation <em>Symptom Guide</em></h1>
        <p class="page-hero-sub">See something? Here's what it means — and how New Mexico soils affect it.</p>
      </div>
    </section>

    <div class="page">
      <div class="diagnostic-note">
        <p>
          These are the most common signs New Mexico homeowners notice when something feels off with their
          foundation. For each one, here's what's typically happening and whether it usually warrants
          attention. Soil conditions, site drainage, and how long something has been changing all matter —
          this is a <strong>starting point, not a diagnosis</strong>. If you're seeing signs that concern
          you, <a href="/contact-us">call us</a>. You reach the owner, not a scheduler.{' '}
          <a href="/common-concerns" class="body-link">If you have questions about cost, timing, or contractors, see our Common Concerns page.</a>
        </p>
        <p>
          <strong>Before you call anyone, document what you're seeing.</strong> Photograph every crack — note
          its location, orientation, and approximate width. Check whether doors or windows that are sticking
          are doing so consistently or only seasonally. Mark crack edges with pencil and a date so you have a
          reference point to measure change over time. A crack that's been stable for years is a different
          conversation than one that opened last month, and documentation gives any evaluator — us, an
          engineer, a geotechnical investigator — a starting point grounded in evidence rather than
          impression. If you're seeing rapid, progressive change instead — cracks widening over days, doors
          that suddenly won't close, visible structural distress — that's a different situation and warrants
          a call sooner rather than later.
        </p>
      </div>

      <div class="myth-section">
        <span class="myth-label">Quick answers, before you dig in</span>
        <div class="myth-grid">
          <div class="myth-card" role="button" tabindex="0" aria-label="Tap to flip for the answer">
            <div class="myth-card-inner">
              <div class="myth-front">
                <div class="myth-title">Is it "foundation failure"?</div>
                <span class="myth-hint">Tap to see</span>
              </div>
              <div class="myth-back">
                <p>Rarely. Most of what homeowners call failure is soil movement — the ground moving, not the structure losing its ability to stand. "Failure" is urgency language more than an accurate description.</p>
              </div>
            </div>
          </div>
          <div class="myth-card" role="button" tabindex="0" aria-label="Tap to flip for the answer">
            <div class="myth-card-inner">
              <div class="myth-front">
                <div class="myth-title">Is every crack serious?</div>
                <span class="myth-hint">Tap to see</span>
              </div>
              <div class="myth-back">
                <p>No. Many reflect historic movement that already stabilized years ago. What matters is whether it's growing now — not whether it exists.</p>
              </div>
            </div>
          </div>
          <div class="myth-card" role="button" tabindex="0" aria-label="Tap to flip for the answer">
            <div class="myth-card-inner">
              <div class="myth-front">
                <div class="myth-title">Do I need repair right now?</div>
                <span class="myth-hint">Tap to see</span>
              </div>
              <div class="myth-back">
                <p>Depends on why it's moving, not on how alarming it looks. Some situations call for acting now; a lot of them call for documenting and watching first.</p>
              </div>
            </div>
          </div>
          <div class="myth-card" role="button" tabindex="0" aria-label="Tap to flip for the answer">
            <div class="myth-card-inner">
              <div class="myth-front">
                <div class="myth-title">Can a repair itself fail?</div>
                <span class="myth-hint">Tap to see</span>
              </div>
              <div class="myth-back">
                <p>Yes — usually from misdiagnosis, not bad material. The most common cause is a repair designed for settlement applied to a foundation that's actually heaving.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="region-finder" id="regionFinder">
        <span class="region-finder-label">Where are you in New Mexico?</span>
        <div class="region-finder-row">
          <select id="regionSelect" aria-label="Select your region">
            <option value="">Select your region</option>
            {regions.map((r) => <option value={r.url}>{r.name}</option>)}
          </select>
          <button id="regionSave" type="button">Remember my area →</button>
        </div>
        <p class="region-finder-current" id="regionCurrent" hidden>
          Showing regional links for <strong id="regionCurrentName"></strong> ·
          <button type="button" id="regionChange">change</button>
        </p>
      </div>

      <div class="filter-bar">
        <input type="search" id="symptomSearch" placeholder="Search symptoms — e.g. &quot;sticking door&quot;" aria-label="Search symptoms" />
        <div class="filter-chips" id="filterChips">
          <button type="button" class="chip active" data-filter="all">All</button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter={c.id}>{c.label}</button>
          ))}
        </div>
      </div>

      {categories.map((cat) => (
        <div class="category-group" id={cat.id} data-category={cat.id}>
          <div class="category-label">{cat.label}</div>
          <div class="symptom-list">
            {cat.items.map((s) => (
              <article class="symptom" data-search={s.q.toLowerCase()}>
                <h2>{s.q}</h2>
                <p class="whats-happening"><strong>What's happening:</strong> {s.whatsHappening}</p>
                <p class="needs-repair"><strong>Does it need repair?</strong> {s.needsRepair}</p>
                <p class="nm-note">NM context: {s.nmContext}</p>
                <div class="symptom-links">
                  {s.links.map((l) => (
                    <a href={l.href} class="symptom-link">{l.text} →</a>
                  ))}
                  <a href="/new-mexico-soil-conditions" class="symptom-link region-link" data-region-link>
                    Explore regional soil pages →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}

      <div class="contact-footer">
        <p><strong>Nothing beats talking through what you're seeing.</strong></p>
        <p><a href="tel:5059914180">(505) 991-4180</a> · <a href="/contact-us">Send a message</a></p>
        <p class="contact-footer-sub">
          Not ready to call yet? <a href="/homeowner-decision-series">Homeowner Decision Series</a> covers what to
          document and watch for first, on camera.
        </p>
      </div>
    </div>
  </div>

  <ReferenceNav />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.myth-card').forEach((card) => {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('flipped');
      }
    });
  });

  const STORAGE_KEY = 'tls-region';
  const regionSelect = document.getElementById('regionSelect') as HTMLSelectElement;
  const regionSave = document.getElementById('regionSave') as HTMLButtonElement;
  const regionCurrent = document.getElementById('regionCurrent') as HTMLElement;
  const regionCurrentName = document.getElementById('regionCurrentName') as HTMLElement;
  const regionChange = document.getElementById('regionChange') as HTMLButtonElement;
  const finder = document.getElementById('regionFinder') as HTMLElement;

  function applyRegion(url: string, name: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-region-link]').forEach((a) => {
      a.href = url;
      a.textContent = `See ${name} soil context →`;
    });
    regionCurrentName.textContent = name;
    regionCurrent.hidden = false;
    finder.classList.add('is-set');
  }

  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    try {
      const { url, name } = JSON.parse(saved);
      applyRegion(url, name);
      regionSelect.value = url;
    } catch {
      /* ignore malformed storage */
    }
  }

  regionSave.addEventListener('click', () => {
    const url = regionSelect.value;
    const name = regionSelect.options[regionSelect.selectedIndex]?.textContent || '';
    if (!url) return;
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ url, name }));
    applyRegion(url, name);
  });

  regionChange.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_KEY);
    regionCurrent.hidden = true;
    finder.classList.remove('is-set');
    regionSelect.value = '';
    document.querySelectorAll<HTMLAnchorElement>('[data-region-link]').forEach((a) => {
      a.href = '/new-mexico-soil-conditions';
      a.textContent = 'Explore regional soil pages →';
    });
  });

  // Search + category filter
  const search = document.getElementById('symptomSearch') as HTMLInputElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const groups = document.querySelectorAll<HTMLElement>('.category-group');
  let activeCategory = 'all';

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    groups.forEach((group) => {
      const catId = group.dataset.category;
      const categoryMatches = activeCategory === 'all' || activeCategory === catId;
      let anyVisible = false;
      group.querySelectorAll<HTMLElement>('.symptom').forEach((item) => {
        const textMatches = !q || item.dataset.search!.includes(q) || item.textContent!.toLowerCase().includes(q);
        const visible = categoryMatches && textMatches;
        item.hidden = !visible;
        if (visible) anyVisible = true;
      });
      group.hidden = !anyVisible;
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      activeCategory = chip.dataset.filter || 'all';
      applyFilters();
    });
  });
  search.addEventListener('input', applyFilters);
</script>

