// One blurb per destination, keyed by href -- shown on every inline
// "further reading" link below a card (so a reader knows what they're
// about to leave the page for) and reused as-is by the client-side
// "related reading" feature built from the top-ranked matches. Single
// source of truth, passed to the client via a JSON script tag below,
// so the two never drift out of sync with each other.
const linkBlurbs: Record<string, string> = {
  '/expansive-soil#what-is': 'How clay soils that swell and shrink with moisture drive seasonal cracking and heave.',
  '/expansive-soil#misdiagnosis': 'Why soil movement gets misread as settlement — and why the mix-up leads to the wrong repair.',
  '/common-concerns#heave': 'Why heave and settlement look identical but need opposite repairs.',
  '/common-concerns#wait': "When it's safe to monitor and when waiting makes things worse.",
  '/common-concerns#insurance': 'What homeowners insurance actually covers here.',
  '/collapsible-soil#signs': 'What actually triggers a collapse, and why it can happen suddenly after decades of stability.',
  '/foundation-repair-methods': 'The full range of repair approaches, not just piers.',
  '/foundation-repair-methods#drainage-correction': 'Often the cheapest fix, and sometimes the only one you need.',
  '/northern-new-mexico': 'Soil conditions specific to Santa Fe, Taos, and the north.',
  '/central-new-mexico': 'Soil conditions specific to Albuquerque and the Rio Grande corridor.',
  '/our-approach': "Why New Mexico's soil and climate make foundation problems here different from anywhere else.",
};

const allSymptoms = categories.flatMap((c) => c.items);

// Facet definitions -- shared vocabulary with cause-library.astro so
// checked boxes carry forward through the pill at the bottom of the page.
const onsetOptions = [
  { id: 'sudden', label: 'Started suddenly' },
  { id: 'gradual', label: "Been happening gradually, over time" },
  { id: 'seasonal', label: 'Comes and goes with the seasons' },
];
const seeOptions = [
  { id: 'see-crack-vertical', label: 'Vertical crack in a wall or drywall' },
  { id: 'see-crack-horizontal', label: 'Horizontal crack in a wall or drywall' },
  { id: 'see-crack-diagonal', label: 'Diagonal crack near a door or window' },
  { id: 'see-crack-ceiling', label: 'Crack or gap where the wall meets the ceiling' },
  { id: 'see-cracks-exterior', label: 'Cracks in stucco, brick, or exterior walls' },
  { id: 'see-cracks-slab', label: 'Cracks in a concrete slab or garage floor' },
  { id: 'see-doors', label: "Doors that won't close, latch, or stick" },
  { id: 'see-windows', label: "Windows that won't open or close" },
  { id: 'see-floors', label: 'Sloping, uneven, dipping, or bouncy floors' },
  { id: 'see-gaps', label: 'Gaps around doors, windows, or baseboards' },
  { id: 'see-foundation-cracks', label: 'Foundation cracks or crumbling concrete' },
  { id: 'see-foundation-gap', label: 'A gap between the house and the foundation' },
  { id: 'see-chimney', label: 'Chimney leaning or separating from the house' },
  { id: 'see-drainage', label: 'Water pooling or poor drainage near the house' },
  { id: 'see-crawlspace', label: 'Wet, damp, or musty crawlspace' },
  { id: 'see-leak-signs', label: 'A warm/wet spot on the floor, or a sudden jump in your water bill' },
];
const siteOptions = [
  { id: 'site-cutfill', label: 'Built on a cut-and-fill or hillside lot' },
  { id: 'site-clay', label: 'Known clay or "heavy" soil in the area' },
  { id: 'site-arroyo', label: 'Near an arroyo or drainage channel' },
  { id: 'site-adobe', label: 'Older adobe or mud-brick construction' },
  { id: 'site-plumbing', label: 'Recent plumbing leak or repair nearby' },
  { id: 'site-trees', label: 'Large trees close to the house' },
  { id: 'site-soil-issues', label: 'Known soil issues in the area' },
  { id: 'site-settlement-issues', label: 'Known settlement issues in the neighborhood' },
];
const foundationOptions = [
  { id: 'fnd-slab', label: 'Slab on grade' },
  { id: 'fnd-monolithic', label: 'Monolithic slab (turned-down edge)' },
  { id: 'fnd-posttension', label: 'Post-tension slab' },
  { id: 'fnd-spreadfooting', label: 'Spread footing' },
  { id: 'fnd-pierbeam', label: 'Pier and beam / crawlspace' },
  { id: 'fnd-unsure', label: 'Not sure' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allSymptoms.map((s) => ({
      '@type': 'Question',
      name: s.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${s.whatsHappening} ${s.needsRepair}`,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'Reference', item: 'https://www.tlsfoundations.com/common-concerns' },
      { '@type': 'ListItem', position: 3, name: 'Symptom Guide', item: 'https://www.tlsfoundations.com/symptom-guide' },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  footer="minimal"
  summary={summary}
  pageName="Symptom Guide"
  nextPage={{ path: '/common-concerns', name: 'Common Concerns' }}
>
  <div class="sg-page">
    <!-- Screen-hidden, print-only -- becomes the actual header of the
         printed page since the site nav, hero, and checkboxes are all
         stripped out for print. -->
    <div class="print-header">
      <div class="print-header-brand">TLS Foundations</div>
      <div class="print-header-phone">(505) 991-4180 · tlsfoundations.com</div>
      <p class="print-header-disclaimer">
        Educational reference only — not a diagnosis or professional evaluation. Prepared from checkboxes
        selected on <span id="printDate"></span>.
      </p>
    </div>

    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Interactive Guides · Symptom Triage</span>
        <h1>Foundation <em>Symptom Guide</em></h1>
        <p class="page-hero-sub">See something? Check what applies below and we'll sort what it usually means — and how New Mexico soils affect it.</p>
      </div>
    </section>

    <div class="page">
      <div class="diagnostic-note">
        <p>
          These are the signs New Mexico homeowners notice most. Check what applies and we'll show you what
          it usually means — <strong>a starting point, not a diagnosis</strong>. Concerned?{' '}
          <a href="/contact-us">Call us</a> — you reach the owner, not a scheduler.{' '}
          <a href="/common-concerns" class="body-link">Questions about cost or timing? See Common Concerns.</a>
        </p>
      </div>

      <!-- CHECK ALL THAT APPLY -->
      <div class="facet-panel" id="facetPanel">
        <div class="facet-panel-head">
          <span class="facet-panel-label">Check all that apply</span>
          <p class="facet-panel-sub">This describes common patterns, not an evaluation of your home — the safest step, if you're ever unsure, is to have someone look.</p>
          <p class="facet-panel-note">Same checklist on the <a href="/cause-library">Cause Library</a> — check it once and we'll carry your answers over, either direction.</p>
        </div>

        <fieldset class="facet-group">
          <legend>Where are you in New Mexico?</legend>
          <div class="region-row">
            <select id="regionSelect" aria-label="Select your region (optional)">
              <option value="">Select your region (optional)</option>
              {regionCities.map((r) => (
                <option value={r.region} data-region-url={r.url}>{r.region}</option>
              ))}
              <option value="Other / not listed">Other / not listed</option>
            </select>
            <select id="citySelect" aria-label="Select your city or town (optional)" disabled>
              <option value="">Select your region first</option>
            </select>
          </div>
          <p class="facet-tip" id="regionLinkTip" hidden></p>
          <script type="application/json" id="regionCitiesData" set:html={JSON.stringify(regionCities)} />
          <script type="application/json" id="linkBlurbsData" set:html={JSON.stringify(linkBlurbs)} />
        </fieldset>

        <fieldset class="facet-group">
          <legend>What kind of foundation do you have? <span class="facet-group-note">(check the one you're sure of)</span></legend>
          <div class="facet-options">
            {foundationOptions.map((o) => (
              <label class="facet-chip">
                <input type="radio" name="foundation" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>Do you have building plans for your house?</legend>
          <div class="facet-options">
            <label class="facet-chip">
              <input type="radio" name="plans" value="yes" id="plansYes" />
              <span>Yes</span>
            </label>
            <label class="facet-chip">
              <input type="radio" name="plans" value="no" id="plansNo" />
              <span>No</span>
            </label>
          </div>
          <p class="facet-tip" id="plansTip" hidden>Good — having a copy on hand at the time of an evaluation can speed things up.</p>
        </fieldset>

        <fieldset class="facet-group">
          <legend>When did it start?</legend>
          <div class="facet-options">
            {onsetOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="onset" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>What are you seeing?</legend>
          <div class="facet-options">
            {seeOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="see" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>What do you know about your site?</legend>
          <div class="facet-options">
            {siteOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="site" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="facet-actions">
          <button type="button" id="facetClear" class="facet-clear" hidden>Clear all</button>
        </div>
      </div>

      <!-- OUTCOME -->
      <div class="outcome-box" id="outcomeBox" hidden>
        <span class="outcome-label">Based on what you checked</span>
        <p class="outcome-text" id="outcomeText"></p>
        <div class="outcome-cta">
          <a href="tel:5059914180" class="outcome-phone">(505) 991-4180</a>
          <button type="button" id="printResults" class="outcome-print">Print your results</button>
          <button type="button" id="sendResultsToggle" class="outcome-print" aria-expanded="false">Send this to TLS</button>
        </div>

        <div class="send-form-wrap" id="sendFormWrap" hidden>
          <form id="sendResultsForm" class="send-form" novalidate>
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="Symptom Guide results from tlsfoundations.com" />
            <input type="hidden" name="from_name" value="TLS Foundations website" />
            <input type="hidden" name="message" id="sendMessageField" />
            <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />
            <p class="send-form-note">We'll send exactly what's on this page — what you checked, and the read above.</p>
            <div class="form-row">
              <label for="send-name">Name</label>
              <input id="send-name" name="name" type="text" required autocomplete="name" />
