      <div class="results-lead" id="resultsLead" hidden>
        <h2 class="results-lead-heading">Ranked Reading</h2>
        <p class="results-lead-text">Ranked for you — based on what you checked, this is likely the most useful reading on this page for your situation.</p>
      </div>

      <div class="symptom-grid" id="symptomGrid">
        {categories.map((cat) =>
          cat.items.map((s) => (
            <article
              class="symptom"
              data-search={s.q.toLowerCase()}
              data-category={cat.id}
              data-onset={s.onset.join(',')}
              data-see={s.see.join(',')}
              data-site={s.site.join(',')}
              data-foundation={s.foundation.join(',')}
            >
              <span class="symptom-category-badge">{cat.label}</span>
              <h2 class="symptom-title-row"><span>{s.q}</span><span class="rest-chevron" aria-hidden="true">⌄</span></h2>
              <p class="needs-repair"><strong>Does it need repair?</strong> <Fragment set:html={s.needsRepair} /></p>

              <button type="button" class="symptom-detail-toggle" data-detail-toggle="whats">What's happening →</button>
              <div class="symptom-detail" data-detail="whats" hidden>
                <p class="symptom-match-tag" data-match-tag hidden></p>
                <p class="whats-happening"><Fragment set:html={s.whatsHappening} /></p>
              </div>

              <button type="button" class="symptom-detail-toggle" data-detail-toggle="nm">NM context →</button>
              <div class="symptom-detail" data-detail="nm" hidden>
                <p class="nm-note"><Fragment set:html={s.nmContext} /></p>
              </div>

              {s.links.length > 0 && (
                <div class="symptom-links">
                  {s.links.map((l) => (
                    <a href={l.href} class="symptom-link-item">
                      <span class="symptom-link-title">{l.text} →</span>
                      {linkBlurbs[l.href] && <span class="symptom-link-blurb">{linkBlurbs[l.href]}</span>}
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        )}
      </div>

      <button type="button" class="other-strip" id="otherStrip" hidden></button>

      <div class="contact-footer">
        <p><strong>Nothing beats talking through what you're seeing.</strong></p>
        <p><a href="tel:5059914180">(505) 991-4180</a> · <a href="/contact-us">Send a message</a></p>
        <p class="contact-footer-sub">
          Not ready to call yet? <a href="/homeowner-decision-series">Homeowner Decision Series</a> covers what to
          document and watch for first, on camera. Want the full picture of why this happens?{' '}
          <a href="/why-foundations-move">Why Foundations Move</a> covers the mechanism.
        </p>
      </div>
    </div>
  </div>

  <ReferenceNav />
</Layout>

<script>
  // Fires a GA4 custom event if the tag is present, no-ops otherwise --
  // Cloudflare Web Analytics (also on this page) doesn't support custom
  // events, only page views, so this is GA4-specific by design.
  function track(name: string, params?: Record<string, string>) {
    if (typeof (window as any).gtag === 'function') (window as any).gtag('event', name, params || {});
  }

  // Region picker first, city picker populated from that region's real city
  // list once a region is chosen. Remembers the choice across visits,
  // tracks it, and surfaces a single link back to that region's soil page.
  const STORAGE_KEY = 'tls-region';
  const regionSelect = document.getElementById('regionSelect') as HTMLSelectElement;
  const citySelect = document.getElementById('citySelect') as HTMLSelectElement;
  const regionLinkTip = document.getElementById('regionLinkTip') as HTMLElement;
  const regionData = JSON.parse(document.getElementById('regionCitiesData')!.textContent || '[]') as {
    region: string;
    url: string;
    cities: string[];
  }[];

  function populateCities(regionName: string, selectedCity = '') {
    citySelect.innerHTML = '';
    const region = regionData.find((r) => r.region === regionName);
    if (!region) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = regionName ? 'City (optional)' : 'Select your region first';
      citySelect.appendChild(opt);
      citySelect.disabled = true;
      return;
    }
    citySelect.disabled = false;
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select your city or town (optional)';
    citySelect.appendChild(placeholder);
    region.cities.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c;
      citySelect.appendChild(opt);
    });
    const other = document.createElement('option');
    other.value = 'Other / not listed';
    other.textContent = 'Other / not listed';
    citySelect.appendChild(other);
    citySelect.value = selectedCity;
  }

  function showRegionTip(region: string, url: string) {
    if (region && url) {
      regionLinkTip.hidden = false;
      regionLinkTip.innerHTML = `<a href="${url}">More about the ${region} region →</a>`;
    } else {
      regionLinkTip.hidden = true;
    }
  }

  populateCities('');

  const urlParams = new URLSearchParams(window.location.search);
  const urlRegion = urlParams.get('region');
  if (urlRegion) {
    // Arriving via the handoff from the Cause Library with a region already
    // picked -- URL wins over whatever's in localStorage from a prior visit.
    const opt = Array.from(regionSelect.options).find((o) => o.value === urlRegion);
    const url = opt?.dataset.regionUrl || '';
    const urlCity = urlParams.get('city') || '';
    regionSelect.value = urlRegion;
    populateCities(urlRegion, urlCity);
    showRegionTip(urlRegion, url);
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region: urlRegion, url, city: urlCity }));
  } else {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const { region, url, city } = JSON.parse(saved);
        if (region) {
          regionSelect.value = region;
          populateCities(region, city || '');
          showRegionTip(region, url || '');
        }
      } catch {
        /* ignore malformed storage */
      }
    }
  }

  regionSelect.addEventListener('change', () => {
    const region = regionSelect.value;
    const opt = regionSelect.options[regionSelect.selectedIndex];
    const url = opt.dataset.regionUrl || '';
    populateCities(region);
    if (!region) {
      localStorage.removeItem(STORAGE_KEY);
      regionLinkTip.hidden = true;
      return;
    }
    showRegionTip(region, url);
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region, url, city: '' }));
    track('region_selected', { region });
  });

  citySelect.addEventListener('change', () => {
    const city = citySelect.value;
    const region = regionSelect.value;
    const opt = regionSelect.options[regionSelect.selectedIndex];
    const url = opt.dataset.regionUrl || '';
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region, url, city }));
    track('city_selected', { city, region: region || 'unspecified' });
  });

  // "Do you have building plans" is a prep tip, not a fact that predicts
  // any cause -- it doesn't feed the scoring below at all, just reveals a
  // one-line note when checked.
  const plansTip = document.getElementById('plansTip') as HTMLElement;
  (['plansYes', 'plansNo'] as const).forEach((id) => {
    document.getElementById(id)?.addEventListener('change', () => {
      plansTip.hidden = id !== 'plansYes';
      track('house_plans_available', { value: id === 'plansYes' ? 'yes' : 'no' });
    });
  });

  // ── Check-all-that-apply: score, sort (never hide), collapse, outcome ──
  const grid = document.getElementById('symptomGrid') as HTMLElement;
  const otherStrip = document.getElementById('otherStrip') as HTMLButtonElement;
  const resultsLead = document.getElementById('resultsLead') as HTMLElement;
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.symptom')).map((el) => ({
    el,
    originalIndex: 0,
    onset: (el.dataset.onset || '').split(',').filter(Boolean),
    see: (el.dataset.see || '').split(',').filter(Boolean),
    site: (el.dataset.site || '').split(',').filter(Boolean),
    foundation: (el.dataset.foundation || '').split(',').filter(Boolean),
  }));
  items.forEach((it, i) => (it.originalIndex = i));

  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.facet-panel input[type="checkbox"], .facet-panel input[type="radio"]'));
  const clearBtn = document.getElementById('facetClear') as HTMLButtonElement;
  const outcomeBox = document.getElementById('outcomeBox') as HTMLElement;
  const outcomeText = document.getElementById('outcomeText') as HTMLElement;
  const outcomePill = document.getElementById('outcomePill') as HTMLAnchorElement;
  const relatedReading = document.getElementById('relatedReading') as HTMLElement;
  const relatedReadingList = document.getElementById('relatedReadingList') as HTMLElement;
  let stripOpen = false;

  // Same map the per-card inline links use, server-rendered into the
  // frontmatter's linkBlurbs -- read back here so the two can't drift.
  const LINK_BLURBS = JSON.parse(document.getElementById('linkBlurbsData')!.textContent || '{}') as Record<string, string>;

  const LABELS: Record<string, string> = {
    sudden: 'sudden onset',
    gradual: 'gradual, over time',
    seasonal: 'seasonal, comes and goes',
    'see-crack-vertical': 'a vertical crack',
    'see-crack-horizontal': 'a horizontal crack',
    'see-crack-diagonal': 'a diagonal crack',
    'see-crack-ceiling': 'a crack at the ceiling line',
    'see-cracks-exterior': 'exterior cracking',
    'see-cracks-slab': 'a slab or garage-floor crack',
    'see-doors': 'doors that stick or won’t close',
    'see-windows': 'windows that stick or won’t close',
    'see-floors': 'sloping or uneven floors',
    'see-gaps': 'gaps around doors, windows, or baseboards',
    'see-foundation-cracks': 'foundation cracking',
    'see-foundation-gap': 'a gap between the house and foundation',
    'see-chimney': 'a leaning or separating chimney',
    'see-drainage': 'water pooling near the house',
    'see-crawlspace': 'a wet or musty crawlspace',
    'see-leak-signs': 'signs of a possible leak',
    'site-cutfill': 'a cut-and-fill or hillside lot',
    'site-clay': 'known clay soil',
    'site-arroyo': 'a site near an arroyo',
    'site-adobe': 'older adobe construction',
    'site-plumbing': 'a recent plumbing leak nearby',
    'site-trees': 'large trees close to the house',
    'fnd-slab': 'a slab-on-grade foundation',
    'fnd-monolithic': 'a monolithic slab with a turned-down edge',
    'fnd-posttension': 'a post-tension slab',
    'fnd-spreadfooting': 'a spread-footing foundation',
    'fnd-pierbeam': 'a pier-and-beam or crawlspace foundation',
  };

  // Literally shows the decision-tree logic instead of leaving it hidden
  // behind the ranking -- which of the reader's own checked answers is
  // the reason this specific card is showing up.
  function buildMatchTag(it: (typeof items)[number], checked: ReturnType<typeof getChecked>): string {
    const hits = [
      ...it.see.filter((s) => checked.see.includes(s)),
      ...it.onset.filter((s) => checked.onset.includes(s)),
      ...it.site.filter((s) => checked.site.includes(s)),
      ...it.foundation.filter((s) => checked.foundation.includes(s)),
    ]
      .map((id) => LABELS[id])
      .filter(Boolean);
    return hits.length ? `Matches what you checked: ${hits.join(', ')}` : '';
  }

  function getChecked() {
    const onset = checkboxes.filter((c) => c.checked && c.name === 'onset').map((c) => c.value);
    const see = checkboxes.filter((c) => c.checked && c.name === 'see').map((c) => c.value);
    const site = checkboxes.filter((c) => c.checked && c.name === 'site').map((c) => c.value);
    const foundation = checkboxes.filter((c) => c.checked && c.name === 'foundation' && c.value !== 'fnd-unsure').map((c) => c.value);
    return { onset, see, site, foundation };
  }

  function score(it: (typeof items)[number], checked: ReturnType<typeof getChecked>) {
    const seeMatches = it.see.filter((s) => checked.see.includes(s)).length;
    // Onset/site/foundation only sharpen ranking among cards you've
    // actually indicated a symptom for -- they never qualify a card on
    // their own. Without this, a card could out-rank everything else
    // purely from background facts (e.g. "older adobe construction")
    // with no observed symptom checked at all, surfacing in "related
    // reading" for something the reader never said they were seeing.
    if (seeMatches === 0) return 0;
    const onsetMatches = it.onset.filter((s) => checked.onset.includes(s)).length;
    const siteMatches = it.site.filter((s) => checked.site.includes(s)).length;
    const foundationMatches = it.foundation.filter((s) => checked.foundation.includes(s)).length;
    return seeMatches * 3 + onsetMatches + siteMatches * 2 + foundationMatches * 2;
  }

  function urgencyTier(checked: ReturnType<typeof getChecked>) {
    const seeCount = checked.see.length;
    const sudden = checked.onset.includes('sudden');
    if (sudden && seeCount >= 2) return 'call-soon';
    if (sudden || seeCount >= 2) return 'evaluate';
    if (seeCount === 0 && checked.onset.length === 0 && checked.site.length === 0 && checked.foundation.length === 0) return 'none';
    return 'watch';
  }

  function buildPattern(checked: ReturnType<typeof getChecked>) {
    const parts = [...checked.onset, ...checked.see, ...checked.site, ...checked.foundation].map((id) => LABELS[id]).filter(Boolean);
    if (parts.length === 0) return 'What you checked';
    if (parts.length === 1) return parts[0][0].toUpperCase() + parts[0].slice(1);
    const last = parts[parts.length - 1];
    return parts.slice(0, -1).join(', ') + ' together with ' + last;
  }

  function buildOutcome() {
    const checked = getChecked();
    const tier = urgencyTier(checked);
    if (tier === 'none') {
      outcomeBox.hidden = true;
      return;
    }
    outcomeBox.hidden = false;
    const pattern = buildPattern(checked);
    const geotech = checked.site.includes('site-cutfill') || checked.site.includes('site-arroyo');
    const geotechClause = geotech
      ? ' If the site conditions point toward a deeper geotechnical question, we can loop in our affiliate Sandia GEO as well.'
      : '';
    // What a floor-level survey actually does, stated plainly and without
    // naming or implying any specific repair method -- we don't know soil
    // conditions until this happens, so nothing here should sound like a
    // recommendation for piers, foam, or anything else.
    const surveyClause = 'The first step is almost always the same: a floor-level survey and a distress investigation — think of it as triage, real data before anything else gets decided.';

    let text = '';
    if (tier === 'watch') {
      text = `${pattern} is a common, usually lower-urgency pattern. The way to know for sure is still to check. ${surveyClause}${geotechClause} Call us and we'll walk you through what a simple monitoring program looks like.`;
    } else if (tier === 'evaluate') {
      text = `${pattern} is worth having a professional look at, even if nothing here points to an emergency. ${surveyClause}${geotechClause} Call us and we'll get that scheduled.`;
    } else {
      text = `${pattern} — especially sudden onset with more than one symptom at once — is the kind of pattern that usually warrants a closer look sooner rather than later. ${surveyClause}${geotechClause} Call us and we'll get that scheduled.`;
    }
    outcomeText.textContent = text;

    const params = new URLSearchParams();
    if (checked.onset.length) params.set('onset', checked.onset.join(','));
    if (checked.see.length) params.set('see', checked.see.join(','));
    if (checked.site.length) params.set('site', checked.site.join(','));
    if (checked.foundation.length) params.set('foundation', checked.foundation.join(','));
    if (regionSelect.value) params.set('region', regionSelect.value);
    if (citySelect.value) params.set('city', citySelect.value);
    outcomePill.href = '/cause-library' + (params.toString() ? '?' + params.toString() : '');

    buildRelatedReading();
  }

  // Pulls the further-reading links straight off the matched cards -- no
  // separate content to maintain, just the same links already rendered,
  // deduplicated and given one line of context so they're worth clicking
  // from inside the outcome box instead of scattered across every card.
  function buildRelatedReading() {
    // Only the top 3 matches, capped at 4 links total -- pulling from
    // every matched card was recreating the "wall of links" problem this
    // section was built to solve once more than a couple of boxes were
    // checked. This should read as "here's what's worth reading," not
    // "here's everything that happened to match."
    const seen = new Set<string>();
    const found: { href: string; text: string }[] = [];
    const topMatched = Array.from(document.querySelectorAll<HTMLElement>('.symptom.matched')).slice(0, 3);
    topMatched.forEach((card) => {
      card.querySelectorAll<HTMLAnchorElement>('.symptom-link-item').forEach((a) => {
        if (found.length >= 4) return;
        const href = a.getAttribute('href') || '';
        if (!href || seen.has(href)) return;
        seen.add(href);
        const title = a.querySelector('.symptom-link-title')?.textContent || href;
        found.push({ href, text: title.replace(/\s*→\s*$/, '').trim() });
      });
    });

    relatedReadingList.innerHTML = '';
    if (found.length === 0) {
      relatedReading.hidden = true;
      return;
    }
    relatedReading.hidden = false;
    found.forEach(({ href, text }) => {
      const row = document.createElement('a');
      row.href = href;
      row.className = 'related-reading-item';
      const blurb = LINK_BLURBS[href];
      row.innerHTML = `<span class="related-reading-title">${text} →</span>` + (blurb ? `<span class="related-reading-blurb">${blurb}</span>` : '');
      relatedReadingList.appendChild(row);
    });
  }

  // Individually-expanded "other symptom" rows -- separate from stripOpen
  // (the "show all N" bulk toggle), so someone can peek at one collapsed
  // row without having to open every other one too.
  const individuallyOpened = new Set<HTMLElement>();

  // The checked pill's blue fill is styled with :has(input:checked), a
  // relatively new CSS selector -- on a browser without it (older
  // Safari/WebKit especially), the checkbox itself still gets checked
  // and works correctly, but the pill silently never turns blue, which
  // reads as "the boxes didn't stay checked." This makes the visual
  // state deterministic in every browser, independent of :has() support.
  function syncChipVisuals() {
    checkboxes.forEach((cb) => cb.closest('.facet-chip')?.classList.toggle('is-checked', cb.checked));
  }

  function applySort() {
    syncChipVisuals();
    const checked = getChecked();
    const anyChecked = checked.onset.length + checked.see.length + checked.site.length + checked.foundation.length > 0;
    clearBtn.hidden = !anyChecked;

    const scored = items.map((it) => ({ it, s: anyChecked ? score(it, checked) : 0 }));
    scored.sort((a, b) => (anyChecked ? b.s - a.s || a.it.originalIndex - b.it.originalIndex : a.it.originalIndex - b.it.originalIndex));

    const matched = scored.filter((x) => x.s > 0);
    const rest = scored.filter((x) => x.s === 0);

    [...matched, ...rest].forEach(({ it }) => grid.appendChild(it.el));

    resultsLead.hidden = !anyChecked;

    if (!anyChecked) {
      items.forEach((it) => {
        it.el.classList.remove('collapsed', 'matched', 'rest');
        const tag = it.el.querySelector<HTMLElement>('[data-match-tag]')!;
        tag.hidden = true;
      });
      otherStrip.hidden = true;
      stripOpen = false;
      individuallyOpened.clear();
    } else {
      matched.forEach(({ it }) => {
        it.el.classList.add('matched');
        it.el.classList.remove('collapsed', 'rest');
        const tag = it.el.querySelector<HTMLElement>('[data-match-tag]')!;
        tag.textContent = buildMatchTag(it, checked);
        tag.hidden = false;
      });
      rest.forEach(({ it }) => {
        it.el.classList.remove('matched');
        it.el.classList.add('rest');
        it.el.classList.toggle('collapsed', !stripOpen && !individuallyOpened.has(it.el));
        const tag = it.el.querySelector<HTMLElement>('[data-match-tag]')!;
        tag.hidden = true;
      });
      if (rest.length > 0) {
        otherStrip.hidden = false;
        otherStrip.textContent = stripOpen
          ? `Hide ${rest.length} other symptom${rest.length === 1 ? '' : 's'}`
          : `${rest.length} other symptom${rest.length === 1 ? '' : 's'}, less likely — tap to show`;
      } else {
        otherStrip.hidden = true;
      }
    }

    buildOutcome();
  }

  const printBtn = document.getElementById('printResults') as HTMLButtonElement;
  const printDate = document.getElementById('printDate') as HTMLElement;
  printBtn.addEventListener('click', () => {
    printDate.textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    track('print_results_clicked');
    window.print();
  });

  outcomePill.addEventListener('click', () => track('handoff_to_cause_library'));

  // "Send this to TLS" -- same content as the print version, sent through
  // the same Web3Forms delivery as the main contact form (see the TODO on
  // WEB3FORMS_ACCESS_KEY above).
  function buildSendMessage(): string {
    const checked = getChecked();
    const lines: string[] = [];
    if (regionSelect.value) lines.push(`Region: ${regionSelect.value}${citySelect.value ? ' — ' + citySelect.value : ''}`);
    const parts = [...checked.onset, ...checked.see, ...checked.site, ...checked.foundation].map((id) => LABELS[id]).filter(Boolean);
    if (parts.length) lines.push(`Checked: ${parts.join(', ')}`);
    lines.push('');
    lines.push(outcomeText.textContent || '');
    lines.push('');
    lines.push('Sent from the Symptom Guide at tlsfoundations.com/symptom-guide');
    return lines.join('\n');
  }

  const sendToggle = document.getElementById('sendResultsToggle') as HTMLButtonElement;
  const sendFormWrap = document.getElementById('sendFormWrap') as HTMLElement;
  const sendForm = document.getElementById('sendResultsForm') as HTMLFormElement;
  const sendMessageField = document.getElementById('sendMessageField') as HTMLInputElement;
  const sendStatus = sendForm.querySelector('.form-status') as HTMLElement;
  const sendSubmitBtn = sendForm.querySelector('.form-submit') as HTMLButtonElement;
  const sendAccessKey = (sendForm.querySelector('input[name="access_key"]') as HTMLInputElement).value;

  sendToggle.addEventListener('click', () => {
    const open = sendFormWrap.hidden;
    sendFormWrap.hidden = !open;
    sendToggle.setAttribute('aria-expanded', String(open));
    if (open) track('send_to_tls_opened');
  });

  sendForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    sendMessageField.value = buildSendMessage();

    if (!sendAccessKey) {
      sendStatus.textContent = "This isn't hooked up yet — text or call (505) 991-4180 in the meantime.";
      sendStatus.classList.add('is-error');
      return;
    }

    sendSubmitBtn.disabled = true;
    sendStatus.classList.remove('is-error');
    sendStatus.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(sendForm))),
      });
      const data = await res.json();
      if (data.success) {
        sendStatus.textContent = "Sent — we'll be in touch.";
        sendForm.reset();
        track('send_to_tls_submitted');
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch {
      sendStatus.textContent = "Something went wrong — text or call (505) 991-4180 instead.";
      sendStatus.classList.add('is-error');
    } finally {
      sendSubmitBtn.disabled = false;
    }
  });

  otherStrip.addEventListener('click', () => {
    stripOpen = !stripOpen;
    applySort();
  });

  // Each "other symptom" row's title doubles as its own accordion toggle --
  // tapping it opens just that one card without needing the "show all"
  // strip above. Only wired for cards currently marked .rest; matched
  // cards always show full content already and have nothing to toggle.
  document.querySelectorAll<HTMLElement>('.symptom-title-row').forEach((row) => {
    row.addEventListener('click', () => {
      const article = row.closest('.symptom') as HTMLElement;
      if (!article.classList.contains('rest')) return;
      const nowOpen = article.classList.contains('collapsed');
      if (nowOpen) {
        individuallyOpened.add(article);
        article.classList.remove('collapsed');
      } else {
        individuallyOpened.delete(article);
        article.classList.add('collapsed');
      }
    });
  });

  // Per-card "What's happening" / "NM context" dropdowns -- independent
  // of each other, and independent of the outer matched/collapsed state.
  // Content stays in the DOM either way, just visually toggled, so
  // nothing here changes what a reader without JS or an AI crawler sees.
  document.querySelectorAll<HTMLButtonElement>('.symptom-detail-toggle').forEach((btn) => {
    const key = btn.dataset.detailToggle;
    const panel = btn.parentElement!.querySelector<HTMLElement>(`[data-detail="${key}"]`)!;
    const label = btn.textContent!.replace(' →', '').replace(' ↑', '');
    btn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      btn.textContent = open ? `${label} ↑` : `${label} →`;
    });
  });

  checkboxes.forEach((cb) =>
    cb.addEventListener('change', () => {
      // Only the foundation-type question is tracked individually -- it's
      // the one Tim specifically asked about, and it's a single fact
      // about the house rather than one of a dozen interchangeable
      // symptom checkboxes that would just be noise as separate events.
      if (cb.checked && cb.name === 'foundation') track('foundation_type_selected', { foundation_type: cb.value });
      applySort();
    })
  );
  clearBtn.addEventListener('click', () => {
    checkboxes.forEach((cb) => (cb.checked = false));
    stripOpen = false;
    applySort();
  });

  // Arriving via the pill from the Cause Library -- pre-check boxes from the URL.
  ['onset', 'see', 'site', 'foundation'].forEach((group) => {
    const val = urlParams.get(group);
    if (!val) return;
    val.split(',').forEach((id) => {
      const cb = checkboxes.find((c) => c.name === group && c.value === id);
      if (cb) cb.checked = true;
    });
  });
  applySort();
</script>

