              <label for="send-contact">Best way to reach you (email or phone)</label>
              <input id="send-contact" name="email" type="text" required autocomplete="email" />
            </div>
            <button type="submit" class="form-submit">Send my results</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="outcome-more" id="outcomeMore">
          <div class="related-reading" id="relatedReading" hidden>
            <span class="related-reading-label">Related reading, based on your closest matches</span>
            <div class="related-reading-list" id="relatedReadingList"></div>
          </div>
          <div class="handoff">
            <p class="handoff-text">Want the deeper explanation of why this happens, mechanism by mechanism? Your answers carry over automatically.</p>
            <a href="/cause-library" id="outcomePill" class="handoff-btn">Go to the Cause Library →</a>
          </div>
