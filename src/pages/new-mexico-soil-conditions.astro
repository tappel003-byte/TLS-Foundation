---
// New Mexico Soil Conditions ("Soil Roadmap"). Restyled in the same
// magazine visual language as the 5 regional pages and 3 city pages
// (sticky left nav, numbered sections, zone-strip treatment) instead of
// the previous plain hero + card-grid layout. Section 02 reads as a
// magazine table of contents -- each region is a numbered entry linking
// out to its own detailed breakdown, rather than a grid of cards.
import Layout from '../layouts/Layout.astro';

const title = 'New Mexico Soil Conditions — Soil Roadmap | TLS Foundations';
const summary =
  "All 33 New Mexico counties, organized into five geological regions by how the soil actually behaves rather than by map convenience: Central (Rio Grande Rift basins), Northern (frost heave and volcanic clays), Four Corners (Mancos Shale, the most misdiagnosed environment in the state), Eastern (Permian evaporite dissolution and aquifer subsidence), and Southern (collapsible desert soils and gypsum dissolution). A repair method that works reliably in one region can make things worse in another, which is the entire argument against a national contractor's one-size-fits-all playbook. Each region links to its own detailed breakdown.";
const description =
  'All 33 New Mexico counties. Five regions organized by soil behavior -- the roadmap to how foundation repair should be approached in each.';

const regions = [
  {
    id: 'central',
    name: 'Central New Mexico',
    url: '/central-new-mexico',
    tag: 'Rio Grande Rift Country',
    desc: 'Albuquerque, Rio Rancho, Belen, Bernalillo. Expansive clays, rift basin alluvium, volcanic formations. The most geologically complex urban corridor in the state.',
  },
  {
    id: 'northern',
    name: 'Northern New Mexico',
    url: '/northern-new-mexico',
    tag: 'High Country & Historic Basins',
    desc: 'Santa Fe, Taos, Española, Las Vegas. Adobe construction, historic neighborhoods, high-altitude soils, Española Basin geology.',
  },
  {
    id: 'four-corners',
    name: 'Four Corners',
    url: '/four-corners',
    tag: 'Mancos Shale Territory',
    desc: 'Farmington, Aztec, Bloomfield, Gallup. Mancos Shale — one of the most expansive soil formations in the American West. Significant diagnostic discipline required.',
  },
  {
    id: 'eastern',
    name: 'Eastern New Mexico',
    url: '/eastern-new-mexico',
    tag: 'Plains & Karst Country',
    desc: 'Roswell, Carlsbad, Artesia, Clovis, Portales. Permian karst dissolution, Pecos Valley alluvium, dissolution voids. High plains soils behave differently than rift basin formations.',
  },
  {
    id: 'southern',
    name: 'Southern New Mexico',
    url: '/southern-new-mexico',
    tag: 'Tularosa & Rio Grande South',
    desc: 'Las Cruces, Alamogordo, Deming, Silver City, Truth or Consequences. Gypsum deposits, Tularosa Basin, Jornada del Muerto collapsible soils, desert alluvium.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'New Mexico Soil Conditions — Soil Roadmap',
    description,
    about: description,
    author: { '@type': 'Organization', name: 'TLS Foundations' },
    publisher: { '@type': 'Organization', name: 'TLS Foundations' },
    url: 'https://www.tlsfoundations.com/new-mexico-soil-conditions',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: "New Mexico's five geological soil regions",
    itemListElement: regions.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.name,
      url: `https://www.tlsfoundations.com${r.url}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tlsfoundations.com' },
      { '@type': 'ListItem', position: 2, name: 'New Mexico Soil Conditions', item: 'https://www.tlsfoundations.com/new-mexico-soil-conditions' },
    ],
  },
];

const serviceAreaText = `TLS Foundations provides foundation repair and geotechnical investigation across all five geological regions of New Mexico. We diagnose and repair foundation movement caused by expansive clay, Mancos Shale heave, montmorillonite swelling, collapsible soil settlement, hydrocompaction, caliche bearing failure, karst dissolution voids, evaporite subsidence, gypsum dissolution, aquifer compaction, lacustrine clay, alluvial fan deposits, soil piping, and cut-and-fill differential settlement. We work across the Rio Grande Rift corridor, the San Juan Basin, the Permian Basin, the Tularosa Basin, the Estancia Basin, the Mimbres Basin, the Jornada del Muerto, the Española Basin, the Raton Basin, and the High Plains of eastern New Mexico. All 33 counties. Every formation. The soil roadmap on this page exists because a contractor who doesn't understand the ground has no business recommending what to do with it.`;
---

<Layout
  title={title}
  description={description}
  footer="full"
  schema={schema}
  ogImage="/images/new-mexico-soil-conditions-hero.webp"
  summary={summary}
  pageName="New Mexico Soil Conditions"
  nextPage={{ path: '/central-new-mexico', name: 'Central New Mexico' }}
  footerProps={{ serviceAreaLabel: 'New Mexico soils. All of them.', serviceAreaText }}
>
  <div class="roadmap-page">
    <!-- HERO -->
    <div class="hero">
      <img class="hero-photo" src="/images/new-mexico-soil-conditions-hero.webp" alt="New Mexico high desert road and mesa" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="hero-eyebrow">New Mexico · Statewide</span>
        <h1 class="hero-h1">
          <span class="w1">New Mexico</span><span class="w2">Soil Conditions.</span>
        </h1>
        <p class="hero-sub">"I knew I shoulda taken that left turn at Albuquerque." <span class="hero-sub-attr">— Bugs Bunny, 1953</span></p>
        <div class="hero-cta">
          <span class="hero-cities-label">The roadmap, in short</span>
          <p class="hero-aside">Five regions · Thirty-three counties · One diagnostic standard</p>
        </div>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="page-layout">
      <!-- LEFT NAV -->
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Soil Roadmap</span>
        <ul class="nav-links">
          <li><a href="#overview"><span class="nav-dot"></span>Overview</a></li>
          <li><a href="#regions"><span class="nav-dot"></span>Service Regions</a></li>
          {regions.map((r) => (
            <li><a href={`#${r.id}`}><span class="nav-dot"></span>{r.name}</a></li>
          ))}
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s)</span>
        </div>
      </nav>

      <div class="content-area">
        <!-- 01 OVERVIEW -->
        <section class="section" id="overview">
          <span class="section-num">01</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Overview · All 33 Counties</span></div>
            <h2 class="section-heading reveal">Why the same repair method <em>doesn't work everywhere</em></h2>

            <div class="two-col-wide reveal">
              <div>
                <p class="lede">Most foundation contractors work from a national playbook. The same methods, the same sales pitch, the same repair sequence — applied regardless of what the soil is actually doing. That works fine in places with predictable geology. New Mexico is not one of those places.</p>

                <p>The state spans sixteen geologically distinct basins. <a href="/expansive-soil">Expansive clays</a> that heave upward in wet cycles. <a href="/collapsible-soil">Collapsible soils</a> that compress suddenly when saturated. <a href="/glossary#karst">Karst dissolution voids</a> beneath the surface. <a href="/glossary#evaporite-dissolution">Gypsum deposits that dissolve</a> over time. Each formation has its own behavior, its own diagnostic requirements, and its own appropriate response.</p>

                <div class="pull">A repair method that works in one basin can make conditions worse in another.</div>

                <p>The difference between <a href="/glossary#heave">heave</a> and <a href="/glossary#settlement">settlement</a> — soil pushing up versus soil pulling down — determines everything about how to respond. Getting that diagnosis wrong is consequential. We built our diagnostic standard around this: heave until proven settlement. The soil tells you what it's doing. You have to know how to read it.</p>
              </div>
              <div>
                <div class="basin-stat reveal">
                  <div class="basin-stat-item">
                    <span class="basin-stat-num">5</span>
                    <span class="basin-stat-label">Regions</span>
                    <p class="basin-stat-desc">Organized by soil behavior, not map convenience</p>
                  </div>
                  <div class="basin-stat-divider"></div>
                  <div class="basin-stat-item">
                    <span class="basin-stat-num">33</span>
                    <span class="basin-stat-label">Counties</span>
                    <p class="basin-stat-desc">Every formation, statewide</p>
                  </div>
                </div>

                <div class="fact-box reveal">
                  <span class="fact-box-label">Related reading</span>
                  <p><a href="/why-foundations-move">For the full range of causes behind foundation movement, see Why Foundations Move →</a></p>
                  <p><a href="/symptom-guide">Not sure what you're seeing? See our Symptom Guide →</a></p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 SERVICE REGIONS (table of contents) -->
        <section class="section" id="regions">
          <span class="section-num">02</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Service Regions · Table of Contents</span></div>
            <h2 class="section-heading reveal">Where we work in <em>New Mexico</em></h2>
            <p class="lede reveal">All 33 New Mexico counties. Five regions organized by soil behavior and geological character — each one links to its own detailed breakdown.</p>

            <div class="toc-list">
              {regions.map((r, i) => (
                <a href={r.url} class="toc-entry reveal" id={r.id}>
                  <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="toc-entry-body">
                    <span class="toc-entry-label">{r.name}</span>
                    <span class="toc-entry-title">{r.tag}</span>
                    <span class="toc-entry-desc">{r.desc}</span>
                  </span>
                  <span class="toc-entry-arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  const progressFill = document.getElementById('progressFill');
  const contentArea = document.querySelector('.content-area');
  window.addEventListener(
    'scroll',
    () => {
      if (!progressFill || !contentArea) return;
      const rect = contentArea.getBoundingClientRect();
      const total = (contentArea as HTMLElement).offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      (progressFill as HTMLElement).style.height = Math.min(100, (scrolled / total) * 100) + '%';
    },
    { passive: true }
  );

  const sections = document.querySelectorAll('.content-area section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sectionObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.remove('active'));
          const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sections.forEach((s) => sectionObs.observe(s));

  navLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const t = document.querySelector(a.getAttribute('href')!);
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -60px 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));
</script>

<style>
  .roadmap-page {
    --navy: #0d2238;
    --blue: #1b3a5c;
    --gold: #b8860b;
    /*
      --gold-text: the same gold family but darkened for text sitting on
      light backgrounds (cream/sand/white) -- --gold only clears WCAG AA
      (4.5:1) against dark backgrounds; against cream it's 3.13:1 and
      against sand 2.85:1, both real failures for small label text.
      --gold stays as-is where it's already on a dark background (hero
      overlay, the basin-stat number) and already passes there.
    */
    --gold-text: #7d5c08;
    --sand: #f5efe6;
    --stone: #ddd5c8;
    --slate: #2c3a4a;
    --muted: #54626f;
    --cream: #fdfaf6;
    --white: #ffffff;
    font-family: 'Source Serif 4', Georgia, serif;
    background: var(--cream);
    color: var(--slate);
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 480px;
    padding-top: 60px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .hero-photo {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    object-position: center 50%;
    animation: kenburns 20s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    0% {
      transform: scale(1) translate(1%, 0);
    }
    100% {
      transform: scale(1.06) translate(-1%, 0.5%);
    }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 34, 56, 0.88) 0%, rgba(13, 34, 56, 0.45) 45%, rgba(13, 34, 56, 0.1) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 80px 64px;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    /*
      Thin, widely-tracked monospace text sitting directly on a photo
      (no background box, unlike hero-sub), and different hero photos put
      very different things behind it -- pale sky, white cloud, or a dark
      rock silhouette all in the same label. A single small, tight shadow
      (no second ambient glow term) reads as contrast, not a halo -- an
      earlier version added a soft 6px glow on top of this, which looked
      fine on a flat sky but turned into a visible dark "sticker" ring
      around round letters like O once the label crossed a busy edge
      (e.g. the mesa silhouette on Four Corners).
    */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    display: block;
    margin-bottom: 20px;
  }
  .hero-h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(40px, 6.5vw, 84px);
    font-weight: 700;
    color: var(--white);
    line-height: 1.05;
    letter-spacing: -1.5px;
    margin-bottom: 22px;
  }
  .hero-h1 .w1 {
    display: block;
  }
  .hero-h1 .w2 {
    display: block;
    font-style: italic;
    color: var(--white);
  }
  .hero-content .hero-sub {
    display: inline-block;
    font-size: clamp(16px, 1.7vw, 19px);
    font-weight: 400;
    font-style: italic;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9), 0 2px 14px rgba(0, 0, 0, 0.6);
    background: rgba(13, 34, 56, 0.55);
    max-width: 560px;
    line-height: 1.6;
    margin-bottom: 32px;
    border-left: 2px solid rgba(184, 134, 11, 0.5);
    padding: 18px 24px 18px 22px;
  }
  .hero-sub-attr {
    display: block;
    margin-top: 6px;
    font-size: 0.8em;
    color: rgba(255, 255, 255, 0.7);
  }
  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hero-cities-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero-aside {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.3px;
    color: rgba(255, 255, 255, 0.85);
  }
  @media (max-width: 767px) {
    .hero-content {
      padding: 0 24px 40px;
    }
  }

  .gold-rule {
    height: 3px;
    background: linear-gradient(90deg, var(--gold), var(--stone));
  }

  /* ── LAYOUT ── */
  .page-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    max-width: 1400px;
    margin: 0 auto;
  }
  .left-nav {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--stone);
  }
  .nav-progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--stone);
  }
  .nav-progress-fill {
    width: 100%;
    height: 0%;
    background: var(--gold);
    transition: height 0.1s linear;
  }
  .nav-brand {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 15px;
    flex: 1;
    overflow-y: auto;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--stone);
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .nav-links a:hover {
    color: var(--blue);
  }
  .nav-links a.active {
    color: var(--blue);
    font-weight: 600;
  }
  .nav-links a.active .nav-dot {
    background: var(--gold);
  }
  .nav-contact {
    padding-top: 24px;
    border-top: 1px solid var(--stone);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-contact-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .nav-contact a {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    color: var(--blue);
    text-decoration: none;
  }
  .nav-contact-sub {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .page-layout {
      grid-template-columns: 1fr;
    }
    .left-nav {
      display: none;
    }
  }

  /* ── SECTIONS ── */
  .content-area {
    padding: 0 64px;
  }
  .section {
    position: relative;
    padding: 72px 0;
    border-bottom: 1px solid var(--stone);
  }
  .section:last-of-type {
    border-bottom: none;
  }
  .section-num {
    position: absolute;
    top: 60px;
    right: 0;
    font-family: 'Playfair Display', serif;
    font-size: 96px;
    font-weight: 700;
    color: var(--sand);
    line-height: 1;
    z-index: 0;
  }
  .section-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .section-label-bar {
    width: 24px;
    height: 2px;
    background: var(--gold);
  }
  .section-label-text {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    color: var(--blue);
    line-height: 1.25;
    margin-bottom: 20px;
    max-width: 760px;
  }
  .section-heading em {
    color: var(--gold-text);
    font-style: italic;
  }

  .two-col-wide {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two-col-wide {
      grid-template-columns: 1fr;
    }
  }

  .lede {
    font-size: 19px;
    line-height: 1.75;
    color: var(--slate);
    margin-bottom: 20px;
    max-width: 760px;
  }
  .section-inner p {
    font-size: 17px;
    line-height: 1.9;
    margin-bottom: 20px;
  }
  .roadmap-page :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .roadmap-page :global(a):hover {
    color: var(--gold-text);
  }
  .pull {
    border-left: 3px solid var(--gold);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 21px;
    color: var(--blue);
    line-height: 1.5;
  }

  .basin-stat {
    display: flex;
    background: var(--navy);
    border-radius: 6px;
    padding: 28px;
    margin-bottom: 24px;
  }
  .basin-stat-item {
    flex: 1;
    text-align: center;
  }
  .basin-stat-num {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 40px;
    color: var(--gold);
    line-height: 1;
  }
  .basin-stat-label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin: 10px 0 8px;
  }
  .basin-stat-item .basin-stat-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }
  .basin-stat-divider {
    width: 1px;
    background: rgba(255, 255, 255, 0.15);
    margin: 0 20px;
  }

  .fact-box {
    background: var(--sand);
    border-left: 3px solid var(--gold);
    padding: 22px 26px;
  }
  .fact-box-label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-bottom: 12px;
  }
  .fact-box p {
    font-size: 14px !important;
    margin-bottom: 8px !important;
  }
  .fact-box p:last-child {
    margin-bottom: 0 !important;
  }

  /* ── TABLE OF CONTENTS (service regions) ── */
  .toc-list {
    margin-top: 40px;
    border-top: 1px solid var(--stone);
  }
  .toc-entry {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 32px 0;
    border-bottom: 1px solid var(--stone);
    text-decoration: none !important;
    transition: background 0.2s;
