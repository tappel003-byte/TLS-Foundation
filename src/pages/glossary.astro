---
// Foundation & Soil Terms glossary. Built verbatim from the user-pasted
// code block (autocomplete search, sticky A-Z letter nav, term cards with
// clickable related-term popups), plus the shared ReferenceNav cross-link band.
import Layout from '../layouts/Layout.astro';
import ReferenceNav from '../components/ReferenceNav.astro';

const title = 'Foundation Repair Glossary | TLS Foundations New Mexico';
const description =
  "Plain-language definitions of foundation repair and soil science terms -- from acequia to underpinning. Browse and link directly to any term.";

// Single source of truth for every glossary term's name and short
// description -- feeds both the DefinedTermSet schema below and the
// client-side related-term popup script (via define:vars), so the two
// can no longer drift out of sync the way they did before this existed.
const terms: { id: string; name: string; description: string }[] = [
  { id: 'acequia', name: 'Acequia', description: 'A community irrigation ditch system with roots in Spanish colonial New Mexico. Can create seasonal wet-dry cycles that affect nearby foundations.' },
  { id: 'active-movement', name: 'Active Movement', description: 'Foundation movement occurring in real time, as opposed to movement that has already stabilized.' },
  { id: 'active-zone', name: 'Active Zone', description: 'The depth of soil that experiences seasonal moisture change and volume change.' },
  { id: 'adobe-foundation', name: 'Adobe Foundation', description: 'Traditional New Mexico construction using sun-dried mud bricks. Requires specialized evaluation and moisture management.' },
  { id: 'alluvial-fan', name: 'Alluvial Fan', description: 'A fan-shaped deposit of sediment where a stream exits a mountain canyon. Upper fans are often collapsible; lower fans have more clay.' },
  { id: 'alluvial-soils', name: 'Alluvial Soils', description: 'Sediment deposited by moving water. Composition varies with position relative to the water that deposited it.' },
  { id: 'aquifer-compaction-subsidence', name: 'Aquifer Compaction Subsidence', description: 'Regional ground settlement caused by groundwater pumping. Seen in the Deming area. Cannot be reversed by foundation repair.' },
  { id: 'bearing-capacity', name: 'Bearing Capacity', description: 'The ability of soil or rock to support the load placed on it without failing or compressing excessively.' },
  { id: 'boring', name: 'Boring', description: 'A hole drilled into the ground to collect soil samples and measure soil properties at depth.' },
  { id: 'caliche', name: 'Caliche', description: 'A calcium carbonate hardpan common in New Mexico soils. Often mistaken for competent bearing material.' },
  { id: 'collapsible-soil', name: 'Collapsible Soil', description: 'Soil that carries load when dry but collapses when wet. Common on the West Mesa, Estancia Valley, and Jornada del Muerto.' },
  { id: 'compaction-grouting', name: 'Compaction Grouting', description: 'Injecting low-slump grout under pressure to compact and densify loose soil. Used for loose soil, not as a substitute for piers.' },
  { id: 'conflict-of-interest', name: 'Conflict of Interest', description: 'A structural incentive where the person recommending a repair is also paid to perform it.' },
  { id: 'cosmetic-crack', name: 'Cosmetic Crack', description: 'A crack reflecting normal material behavior rather than ongoing structural movement.' },
  { id: 'cut-and-fill', name: 'Cut-and-Fill Construction', description: 'Construction technique where hillsides are cut and valleys are filled to create building pads. Can cause differential settlement.' },
  { id: 'dead-load', name: 'Dead Load', description: 'The permanent static weight of a structure — framing, roofing, concrete, and fixed components.' },
  { id: 'differential-settlement', name: 'Differential Settlement', description: 'Uneven movement where one part of a foundation settles more than another. Causes diagonal cracking at door and window corners.' },
  { id: 'disclosure', name: 'Disclosure', description: 'The legal requirement to inform a buyer of known material defects, including prior foundation repair.' },
  { id: 'drainage', name: 'Drainage', description: 'The general movement of surface and subsurface water away from a structure.' },
  { id: 'drainage-correction', name: 'Drainage Correction', description: 'Redirecting surface water away from a foundation to prevent soil saturation. Often the most important first step in foundation repair.' },
  { id: 'earth-movement-exclusion', name: 'Earth Movement Exclusion', description: 'A standard insurance policy clause excluding coverage for damage caused by earth movement.' },
  { id: 'evaporite', name: 'Evaporite', description: 'Minerals deposited by evaporation of water, such as gypsum and anhydrite. Can dissolve over time, creating voids.' },
  { id: 'evaporite-dissolution', name: 'Evaporite Dissolution', description: 'The gradual dissolving of underground gypsum or salt by groundwater, creating voids.' },
  { id: 'expansive-clay', name: 'Expansive Clay', description: 'The specific clay mineral responsible for expansive soil behavior, as distinct from the soil condition itself.' },
  { id: 'expansive-soil', name: 'Expansive Soil', description: 'Soil containing clay minerals that swell when wet and shrink when dry. Common in the Four Corners (Mancos Shale) and parts of the Rio Grande Valley.' },
  { id: 'finish-materials', name: 'Finish Materials', description: 'Visible interior and exterior surfaces — drywall, stucco, tile, trim — as distinct from structural framing.' },
  { id: 'first-wetting-collapse', name: 'First-Wetting Collapse', description: 'The consolidation of a collapsible soil when it is subjected to sustained moisture for the first time in its history.' },
  { id: 'free-estimate', name: 'Free Estimate', description: 'A no-cost price quote for a proposed repair, typically offered after a free inspection.' },
  { id: 'free-inspection', name: 'Free Inspection', description: 'An inspection offered at no cost, typically performed by someone compensated to sell the repair that follows.' },
  { id: 'geotechnical-investigation', name: 'Geotechnical Investigation', description: 'A systematic program to characterize soil and groundwater conditions at a site.' },
  { id: 'heave', name: 'Heave', description: 'Upward movement of a foundation caused by expanding soil beneath it. Common in expansive clay areas. Often misdiagnosed as settlement.' },
  { id: 'helical-pier', name: 'Helical Pier', description: 'A steel shaft with helical plates, installed by rotating it into the ground. Used to transfer foundation loads to deeper, stable soil. The correct pier solution for most New Mexico residential foundations.' },
  { id: 'home-inspection', name: 'Home Inspection', description: 'A general-condition inspection performed during a real estate transaction.' },
  { id: 'hydrocompaction', name: 'Hydrocompaction', description: 'Settlement caused by sudden collapse of loose, dry soil when moisture is introduced.' },
  { id: 'hydrostatic-pressure', name: 'Hydrostatic Pressure', description: 'The lateral force exerted by water-saturated soil against foundation walls.' },
  { id: 'investigation', name: 'Investigation', description: 'The process of collecting soil samples and analyzing movement to determine the appropriate response.' },
  { id: 'jornada-del-muerto', name: 'Jornada del Muerto', description: 'A desert basin in south-central New Mexico with high-risk collapsible soils.' },
  { id: 'karst', name: 'Karst', description: 'A landscape formed by dissolution of soluble rock (gypsum, limestone). Creates voids in the subsurface. Primary hazard in the Pecos Valley.' },
  { id: 'lacustrine-clay', name: 'Lacustrine Clay', description: 'Clay deposited in ancient lake beds. Found in the Estancia, Mimbres, and Tularosa basins. Often highly expansive.' },
  { id: 'lateral-variability', name: 'Lateral Variability', description: 'Significant changes in soil type, density, or bearing capacity over short horizontal distances.' },
  { id: 'lifetime-warranty', name: 'Lifetime Warranty', description: 'A warranty covering a repair for the life of the structure, subject to the warranty document\'s terms.' },
  { id: 'mancos-shale', name: 'Mancos Shale', description: 'A dark, clay-rich shale formation in northwest New Mexico. Expansive when wet; frequently misdiagnosed as settlement.' },
  { id: 'micropile', name: 'Micropile', description: 'A small-diameter drilled and grouted deep foundation element, typically 3 to 12 inches in diameter. Used when hard rock, cobbles, or dense caliche prevents helical installation.' },
  { id: 'misdiagnosis', name: 'Misdiagnosis', description: 'An incorrect determination of what is causing foundation movement, such as treating heave as settlement.' },
  { id: 'moisture-content', name: 'Moisture Content', description: 'The amount of water present in a soil sample, expressed as a percentage of dry weight.' },
  { id: 'moisture-migration', name: 'Moisture Migration', description: 'The movement of water through soil via capillary action, lateral flow, or vapor transmission.' },
  { id: 'moisture-trigger', name: 'Moisture Trigger', description: 'The specific source of moisture that initiated or is sustaining foundation movement. Often irrigation, leaks, or drainage issues.' },
  { id: 'monitoring', name: 'Monitoring', description: 'Tracking a foundation\'s elevation or crack width over time to determine whether movement is active.' },
  { id: 'montmorillonite', name: 'Montmorillonite', description: 'A highly expansive clay mineral that absorbs water between its molecular layers. Causes foundations to heave upward.' },
  { id: 'mudsill', name: 'Mudsill', description: 'The wood member that sits on the foundation wall and anchors the framing. Vulnerable to rot in wet conditions.' },
  { id: 'no-repair-recommendation', name: 'No‑Repair Recommendation', description: 'An honest assessment that no structural repair is warranted.' },
  { id: 'organic-decomposition', name: 'Organic Decomposition', description: 'Settlement caused by buried vegetation decomposing over time, creating voids.' },
  { id: 'pier', name: 'Pier', description: 'A structural element that transfers load to deeper, competent bearing material.' },
  { id: 'pier-selection', name: 'Pier Selection', description: 'The engineering decision of which pier type, spacing, depth, and capacity to specify for a repair.' },
  { id: 'plasticity-index', name: 'Plasticity Index', description: 'A lab measurement of how much water a soil can absorb while remaining plastic. High values indicate high swell potential.' },
  { id: 'playa', name: 'Playa', description: 'A shallow depression that concentrates fine, expansive sediment. Common on the High Plains.' },
  { id: 'plumbing-leak-coverage', name: 'Plumbing Leak Coverage', description: 'The portion of an insurance claim covering damage from a sudden plumbing leak, as distinct from resulting soil movement.' },
  { id: 'polyurethane-foam', name: 'Polyurethane Foam', description: 'The expanding synthetic material used in polyurethane foam injection.' },
  { id: 'polyurethane-foam-injection', name: 'Polyurethane Foam Injection', description: 'A method of injecting expanding foam beneath slabs to fill voids and restore elevation.' },
  { id: 'post-tension-slab', name: 'Post-Tension Slab', description: 'A concrete slab reinforced with tensioned steel cables, common on expansive soils.' },
  { id: 'push-pier', name: 'Push Pier', description: 'A steel pier installed by jacking against the structure\'s dead load. Used for heavy commercial structures, not typical NM residential wood-frame homes.' },
  { id: 'refusal', name: 'Refusal', description: 'The point at which a drill or pier cannot be advanced due to encountering hard material.' },
  { id: 'rio-grande-rift', name: 'Rio Grande Rift', description: 'The active crustal extension zone running the length of New Mexico.' },
  { id: 'sales-inspection', name: 'Sales Inspection', description: 'A near-synonym for a free inspection — an evaluation whose primary purpose is to generate a sale.' },
  { id: 'sales-metric', name: 'Sales Metric', description: 'An internal performance measure used to evaluate salespeople or inspectors in a commission-driven company.' },
  { id: 'scope-of-work', name: 'Scope of Work', description: 'The written description of exactly what a repair will and will not include.' },
  { id: 'seasonal-movement', name: 'Seasonal Movement', description: 'Foundation movement that recurs on a roughly annual cycle, tracking seasonal moisture change.' },
  { id: 'settlement', name: 'Settlement', description: 'Downward movement of a foundation caused by compression or consolidation of soil. Common in collapsible soil areas.' },
  { id: 'slab-on-grade', name: 'Slab-on-Grade', description: 'A concrete slab poured directly on prepared soil. The dominant foundation type in New Mexico residential construction.' },
  { id: 'soil-investigation', name: 'Soil Investigation', description: 'A near-synonym for geotechnical investigation, sometimes describing the field sampling portion specifically.' },
  { id: 'soil-piping', name: 'Soil Piping', description: 'Erosion of soil particles by concentrated water flow through subsurface channels, forming pipe-like voids.' },
  { id: 'structural-engineer', name: 'Structural Engineer', description: 'A licensed engineer qualified to evaluate a structure\'s load-bearing systems.' },
  { id: 'structural-repair', name: 'Structural Repair', description: 'Work that changes how a foundation carries or transfers load, as distinct from non-structural intervention.' },
  { id: 'subsidence', name: 'Subsidence', description: 'A general term for the downward settling of ground surface, from any cause.' },
  { id: 'sulfate-heave', name: 'Sulfate Heave', description: 'Upward foundation movement caused by chemical reaction between sulfates in soil and calcium in concrete.' },
  { id: 'swell-potential', name: 'Swell Potential', description: 'The tendency of a soil to increase in volume when moisture is added. Measured in the laboratory on undisturbed samples.' },
  { id: 'swell-pressure', name: 'Swell Pressure', description: 'The force expansive clay generates as it absorbs moisture but is restrained from expanding.' },
  { id: 'tesuque-formation', name: 'Tesuque Formation', description: 'A laterally variable sedimentary formation in the Española Basin with interbedded clays and sands.' },
  { id: 'torque-monitoring', name: 'Torque Monitoring', description: 'Measuring rotational resistance during helical pier installation to confirm bearing capacity in real time.' },
  { id: 'transferable-warranty', name: 'Transferable Warranty', description: 'A repair warranty written to remain in effect for a new owner if the property is sold.' },
  { id: 'underpinning', name: 'Underpinning', description: 'Methods used to extend or reinforce an existing foundation so loads are transferred to deeper or more stable soil.' },
  { id: 'undisturbed-sample', name: 'Undisturbed Sample', description: 'A soil sample collected in a way that preserves the natural structure, density, and moisture content.' },
  { id: 'value-impact', name: 'Value Impact', description: 'The effect a foundation\'s condition and repair history has on a property\'s market value.' },
  { id: 'void', name: 'Void', description: 'An open space in the subsurface where bearing material is absent. Can form from dissolution of evaporite or deterioration of mine workings.' },
  { id: 'watering-foundation', name: 'Watering a Foundation', description: 'Attempting to control soil moisture around a foundation. Only appropriate for certain soil types.' },
  { id: 'workmanship-warranty', name: 'Workmanship Warranty', description: 'A warranty covering the quality of the installation itself, as distinct from future soil movement.' },
];

const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Foundation & Soil Terms Glossary',
  description,
  url: 'https://www.tlsfoundations.com/glossary',
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.name,
    description: t.description,
    url: `https://www.tlsfoundations.com/glossary#${t.id}`,
    inDefinedTermSet: 'https://www.tlsfoundations.com/glossary',
  })),
};
---

<Layout title={title} description={description} footer="minimal" schema={[definedTermSetSchema]}>
  <div class="tls-glossary" id="top">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Resources · Reference</span>
        <h1>Foundation & Soil <em>Terms</em></h1>
        <p class="page-hero-sub">Plain‑language definitions — technical precision where it matters, plain English everywhere else.</p>
      </div>
    </section>

    <div class="page">
      <div class="search-container">
        <div class="search-wrapper">
          <input type="text" class="search-input" id="glossarySearch" placeholder="Search for a term… (type to see suggestions)" autocomplete="off" />
          <div class="autocomplete-results" id="autocompleteResults"></div>
        </div>
      </div>

      <div class="letter-nav" id="letter-nav">
        <a href="#A">A</a>
        <a href="#B">B</a>
        <a href="#C">C</a>
        <a href="#D">D</a>
        <a href="#E">E</a>
        <a href="#F">F</a>
        <a href="#G">G</a>
        <a href="#H">H</a>
        <a href="#I">I</a>
        <a href="#J">J</a>
        <a href="#K">K</a>
        <a href="#L">L</a>
        <a href="#M">M</a>
        <a href="#N">N</a>
        <a href="#O">O</a>
        <a href="#P">P</a>
        <span class="letter-gap">Q</span>
        <a href="#R">R</a>
        <a href="#S">S</a>
        <a href="#T">T</a>
        <a href="#U">U</a>
        <a href="#V">V</a>
        <a href="#W">W</a>
        <span class="letter-gap">X</span>
        <span class="letter-gap">Y</span>
        <span class="letter-gap">Z</span>
      </div>

      <!-- A -->
      <section class="letter-section" id="A">
        <h2 class="letter-heading">A</h2>

        <div class="term-card" id="acequia">
          <div class="term-name">Acequia</div>
          <div class="term-definition">
            <p>A community irrigation ditch system with roots in Spanish colonial New Mexico. Acequias introduce seasonal moisture into soils along their corridors, creating cyclical wet-dry patterns that drive foundation movement in adjacent properties. Homes near acequias in the Rio Grande Valley, Española Basin, and Mesilla Valley may experience seasonal heave or settlement tied directly to irrigation cycles rather than weather.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="heave">Heave</span>
          </div>
        </div>

        <div class="term-card" id="active-movement">
          <div class="term-name">Active Movement</div>
          <div class="term-definition">
            <p>Foundation movement occurring in real time, as opposed to movement that occurred in the past and has since stabilized. Distinguishing active movement from historic, stabilized movement is one of the first jobs of an investigation — a foundation that moved once and stopped may need nothing at all, while one still moving needs an intervention now. Monitoring over time is often the only reliable way to make the distinction.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="monitoring">Monitoring</span>
            <span class="related-term" data-term="investigation">Investigation</span>
            <span class="related-term" data-term="no-repair-recommendation">No‑Repair Recommendation</span>
          </div>
        </div>

        <div class="term-card" id="active-zone">
          <div class="term-name">Active Zone</div>
          <div class="term-definition">
            <p>The depth of soil that experiences significant moisture change — and therefore significant volume change — in response to seasonal and long-term surface moisture conditions. Above the active zone, the soil wets and dries with the seasons. Below it, moisture content is relatively stable year-round.</p>
            <p>The depth of the active zone is a critical design parameter for any deep foundation repair in expansive clay country. A pier that bears within the active zone is still subject to the uplift forces generated by the surrounding clay when it swells.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
          </div>
        </div>

        <div class="term-card" id="adobe-foundation">
          <div class="term-name">Adobe Foundation</div>
          <div class="term-definition">
            <p>A foundation system using adobe brick or rammed earth, common in historic New Mexico construction. Behaves differently from concrete — more susceptible to moisture intrusion, erosion at the base, and differential movement. Repair approaches that work on conventional concrete foundations often do not apply directly. Evaluation requires understanding the original construction method and current condition of the adobe itself.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="differential-settlement">Differential Movement</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>

        <div class="term-card" id="alluvial-fan">
          <div class="term-name">Alluvial Fan</div>
          <div class="term-definition">
            <p>A fan-shaped deposit of sediment laid down where a stream or wash exits a mountain canyon and spreads across a flatter surface. In New Mexico, alluvial fans extend from every mountain range onto the adjacent basin floors.</p>
            <p>Foundation implications vary by position on the fan: upper fans are typically granular and potentially collapsible; lower fans are finer-grained and more likely to contain clay.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="caliche">Caliche</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
          </div>
        </div>

        <div class="term-card" id="alluvial-soils">
          <div class="term-name">Alluvial Soils</div>
          <div class="term-definition">
            <p>Sediment deposited by moving water — streams, rivers, washes — as opposed to soil formed in place or laid down by wind or standing water. Alluvial soils vary widely in composition depending on where they sit relative to the water that deposited them: coarser and often more stable near a channel, finer-grained and more likely to contain clay or collapsible material farther out. Most of New Mexico's developed valleys sit on alluvial soils, which is part of why soil conditions can change dramatically within a short distance.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="alluvial-fan">Alluvial Fan</span>
            <span class="related-term" data-term="lateral-variability">Lateral Variability</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
          </div>
        </div>

        <div class="term-card" id="aquifer-compaction-subsidence">
          <div class="term-name">Aquifer Compaction Subsidence</div>
          <div class="term-definition">
            <p>Ground settlement caused by the removal of groundwater from an aquifer. When water is pumped from fine-grained sediments, the water pressure that was partly supporting those sediments is reduced and they consolidate.</p>
            <p>In the Deming area of the Mimbres Basin, decades of agricultural pumping have produced measurable subsidence. Unlike most foundation movement, this is a regional process — it cannot be reversed by foundation repair.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
      </section>

      <!-- B -->
      <section class="letter-section" id="B">
        <h2 class="letter-heading">B</h2>
        <div class="term-card" id="bearing-capacity">
          <div class="term-name">Bearing Capacity</div>
          <div class="term-definition">
            <p>The ability of soil or rock to support the load placed on it without failing or compressing excessively. Bearing capacity depends on soil type, density, moisture content, and load geometry.</p>
            <p>In New Mexico, finding competent bearing often means getting through caliche, loose alluvial material, and active clay zones to reach stable material. The depth to competent bearing varies by location and is established by investigation.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="caliche">Caliche</span>
            <span class="related-term" data-term="boring">Boring</span>
          </div>
        </div>
        <div class="term-card" id="boring">
          <div class="term-name">Boring</div>
          <div class="term-definition">
            <p>A hole drilled into the ground to collect soil samples and measure soil properties at depth. Borings reveal what is actually in the ground below the surface.</p>
            <p>Multiple borings are necessary in laterally variable environments where a single boring characterizes only one location in what may be a complex soil profile.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="undisturbed-sample">Undisturbed Sample</span>
            <span class="related-term" data-term="lateral-variability">Lateral Variability</span>
          </div>
        </div>
      </section>

      <!-- C -->
      <section class="letter-section" id="C">
        <h2 class="letter-heading">C</h2>
        <div class="term-card" id="caliche">
          <div class="term-name">Caliche</div>
          <div class="term-definition">
            <p>A hardened calcium carbonate layer found throughout New Mexico soils, formed over thousands of years as mineral-rich water evaporated near the surface. Caliche depth, thickness, and hardness vary significantly across the state — block by block in some Albuquerque neighborhoods. Often misread as reliable bearing material; a thin caliche layer over loose soil below is not a stable foundation. Drilling through caliche for pier installation requires equipment and experience specific to New Mexico conditions.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="cut-and-fill">Cut-and-Fill Construction</span>
          </div>
        </div>
        <div class="term-card" id="collapsible-soil">
          <div class="term-name">Collapsible Soil</div>
          <div class="term-definition">
            <p>Soil that carries load adequately under dry conditions but consolidates — loses volume — when moisture infiltrates it. The open particle structure collapses when water dissolves the bonds between particles.</p>
            <p>Collapsible soil is common across most developed basin floors and alluvial fan surfaces in New Mexico. A foundation stable for decades can begin moving within a season if moisture conditions change.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="first-wetting-collapse">First-Wetting Collapse</span>
            <span class="related-term" data-term="moisture-trigger">Moisture Trigger</span>
            <span class="related-term" data-term="hydrocompaction">Hydrocompaction</span>
          </div>
        </div>
        <div class="term-card" id="compaction-grouting">
          <div class="term-name">Compaction Grouting</div>
          <div class="term-definition">
            <p>A ground improvement technique where low-slump grout is injected under pressure into the soil, compacting the surrounding material and filling voids. The grout forms a bulb that displaces and densifies the adjacent material.</p>
            <p>Used when the problem is loose, poorly consolidated soil rather than a condition requiring piers to transfer load to deeper bearing.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
          </div>
        </div>
        <div class="term-card" id="conflict-of-interest">
          <div class="term-name">Conflict of Interest</div>
          <div class="term-definition">
            <p>A structural incentive, not a personal failing — a situation where the person recommending a repair is also the person paid to perform it. This is standard in the foundation repair industry and doesn't make any individual dishonest, but it does mean the recommendation and the sale are never fully separated. TLS Foundations and Sandia GEO are structured to keep investigation and repair as separate revenue streams specifically to remove this incentive from the diagnosis.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="free-inspection">Free Inspection</span>
            <span class="related-term" data-term="sales-inspection">Sales Inspection</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
          </div>
        </div>
        <div class="term-card" id="cosmetic-crack">
          <div class="term-name">Cosmetic Crack</div>
          <div class="term-definition">
            <p>A crack in drywall, stucco, or finish material that reflects normal material behavior — shrinkage, temperature cycling, minor settling during the first year or two after construction — rather than ongoing structural movement. Cosmetic cracks are typically hairline, don't recur after repair, and aren't accompanied by door or window binding or other movement indicators. The distinction between cosmetic and structural cracking is a diagnostic question, not a cosmetic one — getting it wrong in either direction has a cost.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="differential-settlement">Differential Settlement</span>
            <span class="related-term" data-term="finish-materials">Finish Materials</span>
            <span class="related-term" data-term="misdiagnosis">Misdiagnosis</span>
          </div>
        </div>
        <div class="term-card" id="cut-and-fill">
          <div class="term-name">Cut-and-Fill Construction</div>
          <div class="term-definition">
            <p>A grading practice where soil is cut from high areas of a site and used to fill low areas before construction. The filled portion is often less compacted than undisturbed native soil, creating differential settlement risk as the fill consolidates over time. Common in New Mexico's hilly terrain and a frequent contributor to foundation movement in tract developments built on graded lots.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="differential-settlement">Differential Movement</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="compaction-grouting">Compaction Grouting</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
          </div>
        </div>
      </section>

      <!-- D -->
      <section class="letter-section" id="D">
        <h2 class="letter-heading">D</h2>
        <div class="term-card" id="dead-load">
          <div class="term-name">Dead Load</div>
          <div class="term-definition">
            <p>The permanent, static weight of a structure — the weight of framing, roofing, concrete, and all fixed components. Does not include variable weight of occupants, furniture, or snow.</p>
            <p>Push piers use dead load to drive themselves to bearing. This is why push piers are problematic for most New Mexico residential construction: wood-frame homes do not have enough dead load to drive piers to adequate depth.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="push-pier">Push Pier</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
          </div>
        </div>
        <div class="term-card" id="differential-settlement">
          <div class="term-name">Differential Settlement</div>
          <div class="term-definition">
            <p>Settlement that occurs unevenly across a foundation — one part moves down more than another. The structural damage associated with foundation problems is almost always the result of differential settlement.</p>
            <p>Diagonal cracking at door and window corners is the classic indicator. The crack geometry indicates which part of the foundation dropped.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="heave">Heave</span>
          </div>
        </div>
        <div class="term-card" id="disclosure">
          <div class="term-name">Disclosure</div>
          <div class="term-definition">
            <p>The legal requirement, in a real estate transaction, to inform a buyer of known material defects — including prior foundation repair or known foundation movement. A disclosed repair with documentation (warranty, engineering report, permit) reads very differently to a buyer or their lender than an undisclosed one discovered later. Sellers and buyers both benefit from records that make the history of a foundation legible.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="transferable-warranty">Transferable Warranty</span>
            <span class="related-term" data-term="home-inspection">Home Inspection</span>
            <span class="related-term" data-term="value-impact">Value Impact</span>
          </div>
        </div>
        <div class="term-card" id="drainage">
          <div class="term-name">Drainage</div>
          <div class="term-definition">
            <p>The general movement of surface and subsurface water away from a structure — the broader condition that drainage correction is designed to fix. Good drainage means grade sloping away from the foundation, gutters and downspouts discharging well clear of the walls, and no low spots that pond water against the structure. Because most New Mexico foundation movement is moisture-driven, drainage is often the single largest controllable variable in whether a foundation stays stable.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
            <span class="related-term" data-term="moisture-trigger">Moisture Trigger</span>
          </div>
        </div>
        <div class="term-card" id="drainage-correction">
          <div class="term-name">Drainage Correction</div>
          <div class="term-definition">
            <p>Modifications to the grading, gutters, downspouts, or surface drainage around a structure to direct water away from the foundation. In New Mexico, where the majority of foundation movement is moisture-driven, drainage correction is often the most effective first intervention — and sometimes the only one needed. Not a structural repair, but frequently more useful than one.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
            <span class="related-term" data-term="hydrostatic-pressure">Hydrostatic Pressure</span>
            <span class="related-term" data-term="heave">Heave</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
      </section>

      <!-- E -->
      <section class="letter-section" id="E">
        <h2 class="letter-heading">E</h2>
        <div class="term-card" id="earth-movement-exclusion">
          <div class="term-name">Earth Movement Exclusion</div>
          <div class="term-definition">
            <p>A standard clause in most homeowners insurance policies excluding coverage for damage caused by earth movement — settlement, heave, expansion, or contraction of soil — regardless of what triggered it. This is why most foundation repair is paid out of pocket rather than through a homeowner's policy, and why the plumbing-leak-coverage distinction matters: a leak itself may be covered even when the resulting soil movement is not.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="plumbing-leak-coverage">Plumbing Leak Coverage</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="heave">Heave</span>
          </div>
        </div>
        <div class="term-card" id="evaporite">
          <div class="term-name">Evaporite</div>
          <div class="term-definition">
            <p>A mineral deposited when a body of water evaporated and left its dissolved minerals behind. Common evaporite minerals include gypsum, anhydrite, and halite (rock salt).</p>
            <p>Evaporites are soluble. Groundwater that contacts these formations dissolves them over time, creating subsurface voids — the primary foundation hazard in the Pecos Valley.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="karst">Karst</span>
            <span class="related-term" data-term="void">Void</span>
          </div>
        </div>
        <div class="term-card" id="evaporite-dissolution">
          <div class="term-name">Evaporite Dissolution</div>
          <div class="term-definition">
            <p>The gradual dissolving of soluble underground minerals — primarily gypsum and halite (salt) — by groundwater movement. Common in eastern and southern New Mexico. As the mineral mass dissolves, voids form beneath the surface that can cause sudden settlement or sinkhole-like collapse. Not detectable by visual inspection; requires subsurface investigation.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="void">Void</span>
            <span class="related-term" data-term="sulfate-heave">Sulfate Heave</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="karst">Karst</span>
          </div>
        </div>
        <div class="term-card" id="expansive-clay">
          <div class="term-name">Expansive Clay</div>
          <div class="term-definition">
            <p>The specific clay material responsible for expansive soil behavior — as distinct from "expansive soil," which describes the condition of a soil profile containing it. Expansive clay minerals, montmorillonite chief among them, are what swell and shrink with moisture change; a soil is called expansive because of the percentage and type of clay it contains. The terms are often used interchangeably, but the clay is the cause and the soil is the result.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="montmorillonite">Montmorillonite</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
          </div>
        </div>
        <div class="term-card" id="expansive-soil">
          <div class="term-name">Expansive Soil</div>
          <div class="term-definition">
            <p>Soil containing clay minerals that swell when they absorb water and shrink when they dry out — repeating that cycle indefinitely. Volume change can be ten to fifteen percent between dry and saturated states.</p>
            <p>A foundation bearing on expansive soil is pushed upward in wet conditions and drops back in dry conditions. The only reliable way to know if clay is present is to get into the ground at the specific site.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="montmorillonite">Montmorillonite</span>
            <span class="related-term" data-term="heave">Heave</span>
          </div>
        </div>
      </section>

      <!-- F -->
      <section class="letter-section" id="F">
        <h2 class="letter-heading">F</h2>
        <div class="term-card" id="finish-materials">
          <div class="term-name">Finish Materials</div>
          <div class="term-definition">
            <p>The visible interior and exterior surfaces of a structure — drywall, stucco, tile, flooring, trim — as distinct from the structural framing and foundation beneath them. Finish materials often crack or shift in response to very minor structural movement that isn't itself a problem, because they're rigid and brittle relative to what's behind them. Reading finish-material damage correctly — is it reflecting real structural movement, or just responding to normal material behavior — is a core diagnostic skill.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="cosmetic-crack">Cosmetic Crack</span>
            <span class="related-term" data-term="differential-settlement">Differential Settlement</span>
            <span class="related-term" data-term="misdiagnosis">Misdiagnosis</span>
          </div>
        </div>
        <div class="term-card" id="first-wetting-collapse">
          <div class="term-name">First-Wetting Collapse</div>
          <div class="term-definition">
            <p>The initial and often most dramatic settlement that occurs when dry, loose soil receives significant moisture for the first time. Collapsible soils can maintain their structure for decades in arid conditions, then consolidate rapidly on first wetting from a plumbing leak, irrigation change, or heavy rain event. Common across the West Mesa, Estancia Valley, and Jornada del Muerto.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="hydrocompaction">Hydrocompaction</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
            <span class="related-term" data-term="jornada-del-muerto">Jornada del Muerto</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
        <div class="term-card" id="free-estimate">
          <div class="term-name">Free Estimate</div>
          <div class="term-definition">
            <p>A no-cost price quote for a proposed repair, typically offered after a free inspection has already identified — and often sold — a specific fix. A free estimate answers "what will this cost," not "is this the right thing to do" or "is there a cheaper, less invasive option." It's useful once you already know what you need; it isn't a substitute for an independent evaluation of whether you need it.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="free-inspection">Free Inspection</span>
            <span class="related-term" data-term="sales-inspection">Sales Inspection</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
          </div>
        </div>
        <div class="term-card" id="free-inspection">
          <div class="term-name">Free Inspection</div>
          <div class="term-definition">
            <p>An inspection offered at no cost, typically performed by someone compensated to sell the repair that follows. The inspection itself can be genuinely useful — an experienced eye catches real problems — but it isn't independent of the sale, which is a structural fact worth knowing rather than a criticism of any individual inspector. A paid geotechnical investigation is the independent alternative.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="conflict-of-interest">Conflict of Interest</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
            <span class="related-term" data-term="sales-inspection">Sales Inspection</span>
          </div>
        </div>
      </section>

      <!-- G -->
      <section class="letter-section" id="G">
        <h2 class="letter-heading">G</h2>
        <div class="term-card" id="geotechnical-investigation">
          <div class="term-name">Geotechnical Investigation</div>
          <div class="term-definition">
            <p>A systematic program of field and laboratory work to characterize the soil and groundwater conditions at a specific site — including what materials are present, how deep they extend, and how they behave under load and moisture.</p>
            <p>A geotechnical investigation produces data, not a sales proposal. The repair decision follows from that understanding.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="boring">Boring</span>
            <span class="related-term" data-term="undisturbed-sample">Undisturbed Sample</span>
          </div>
        </div>
      </section>

      <!-- H -->
      <section class="letter-section" id="H">
        <h2 class="letter-heading">H</h2>
        <div class="term-card" id="heave">
          <div class="term-name">Heave</div>
          <div class="term-definition">
            <p>Upward movement of a foundation driven by expanding soil beneath it. The most common cause in New Mexico is expansive clay swelling as it absorbs moisture. Frost heave is also significant at higher elevations.</p>
            <p>Heave is consistently misdiagnosed as settlement. Installing settlement piers on a heaving foundation pins the structure while the surrounding soil continues to push up, making the problem worse.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="mancos-shale">Mancos Shale</span>
          </div>
        </div>
        <div class="term-card" id="helical-pier">
          <div class="term-name">Helical Pier</div>
          <div class="term-definition">
            <p>A steel shaft with one or more helical plates, installed by rotating it into the ground using hydraulic torque equipment. The helical plates advance the pier like a screw, allowing it to reach bearing depth without requiring the structure's dead load.</p>
            <p>Helical piers are the correct residential pier solution for most New Mexico foundation work. Installation torque is monitored in real time and correlates directly to bearing capacity.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="push-pier">Push Pier</span>
            <span class="related-term" data-term="torque-monitoring">Torque Monitoring</span>
          </div>
        </div>
        <div class="term-card" id="home-inspection">
          <div class="term-name">Home Inspection</div>
          <div class="term-definition">
            <p>A general-condition inspection performed during a real estate transaction, covering the structure, systems, and major components of a house. A home inspector is a generalist — trained to notice signs of foundation movement and flag them, but not to diagnose the cause or design a repair. A flagged concern in a home inspection is the reason to call in a specialist, not the specialist's own conclusion.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="disclosure">Disclosure</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
            <span class="related-term" data-term="structural-engineer">Structural Engineer</span>
          </div>
        </div>
        <div class="term-card" id="hydrocompaction">
          <div class="term-name">Hydrocompaction</div>
          <div class="term-definition">
            <p>Settlement caused by the sudden collapse of loose, dry soil structure when moisture is introduced. The soil grains, held in an open arrangement by capillary tension when dry, lose that tension when wet and consolidate into a denser state. Distinct from gradual settlement — hydrocompaction can occur quickly and produce significant elevation change.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="first-wetting-collapse">First-Wetting Collapse</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
            <span class="related-term" data-term="jornada-del-muerto">Jornada del Muerto</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
          </div>
        </div>
        <div class="term-card" id="hydrostatic-pressure">
          <div class="term-name">Hydrostatic Pressure</div>
          <div class="term-definition">
            <p>The lateral force exerted by water-saturated soil against foundation walls, basement walls, or crawlspace walls. In New Mexico, most relevant in areas with high water tables or poor drainage. Can cause wall bowing, cracking, and water intrusion independent of foundation settlement or heave.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="moisture-migration">Moisture Migration</span>
          </div>
        </div>
      </section>

      <!-- I -->
      <section class="letter-section" id="I">
        <h2 class="letter-heading">I</h2>
        <div class="term-card" id="investigation">
          <div class="term-name">Investigation</div>
          <div class="term-definition">
            <p>The process of collecting soil samples, surveying the foundation, and analyzing movement to determine the appropriate response. In New Mexico, investigation is not optional — the soil varies too much to guess.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
            <span class="related-term" data-term="boring">Boring</span>
          </div>
        </div>
      </section>

      <!-- J -->
      <section class="letter-section" id="J">
        <h2 class="letter-heading">J</h2>
        <div class="term-card" id="jornada-del-muerto">
          <div class="term-name">Jornada del Muerto</div>
          <div class="term-definition">
            <p>A desert basin in south-central New Mexico running roughly from Socorro to Las Cruces. Characterized by collapsible soils — fine-grained deposits that maintain structure when dry but consolidate rapidly when water is introduced. One of the higher-risk zones in the state for sudden settlement triggered by plumbing leaks, irrigation changes, or first-time wetting events.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
            <span class="related-term" data-term="hydrocompaction">Hydrocompaction</span>
            <span class="related-term" data-term="first-wetting-collapse">First-Wetting Collapse</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
      </section>

      <!-- K -->
      <section class="letter-section" id="K">
        <h2 class="letter-heading">K</h2>
        <div class="term-card" id="karst">
          <div class="term-name">Karst</div>
          <div class="term-definition">
            <p>A landscape and subsurface condition formed by the dissolution of soluble rock — typically limestone, gypsum, or other evaporite minerals — by groundwater over long periods. Karst terrain can contain voids, channels, and unpredictable bearing conditions well below the surface, with little or no warning at grade. It's the primary hazard in parts of the Pecos Valley, where the same dissolution process that formed Carlsbad Caverns is still slowly at work beneath developed land.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="evaporite">Evaporite</span>
            <span class="related-term" data-term="evaporite-dissolution">Evaporite Dissolution</span>
            <span class="related-term" data-term="void">Void</span>
          </div>
        </div>
      </section>

      <!-- L -->
      <section class="letter-section" id="L">
        <h2 class="letter-heading">L</h2>
        <div class="term-card" id="lacustrine-clay">
          <div class="term-name">Lacustrine Clay</div>
          <div class="term-definition">
            <p>Fine-grained sediment deposited at the bottom of an ancient lake. New Mexico's closed basins — the Estancia, the Mimbres, the Tularosa — held lakes during wetter periods of the Pleistocene.</p>
            <p>Lacustrine clays tend to be highly expansive. They are often buried beneath younger, drier surface soils, meaning a foundation may have expansive clay at depth without any surface indication.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
          </div>
        </div>
        <div class="term-card" id="lateral-variability">
          <div class="term-name">Lateral Variability</div>
          <div class="term-definition">
            <p>Significant changes in soil type, density, or bearing capacity over short horizontal distances — sometimes within a single foundation footprint. Common in river floodplains and alluvial fan margins.</p>
            <p>In practice, lateral variability means a single boring does not characterize the site. The Hatch–Rincon Corridor is an example where lateral variability within a single lot is the rule.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="boring">Boring</span>
            <span class="related-term" data-term="differential-settlement">Differential Settlement</span>
          </div>
        </div>
        <div class="term-card" id="lifetime-warranty">
          <div class="term-name">Lifetime Warranty</div>
          <div class="term-definition">
            <p>A warranty term covering the installed repair for the life of the structure, subject to the terms of the warranty document — typically the workmanship and the material, not the soil conditions that caused the original movement. "Lifetime" describes the coverage period, not a guarantee against every possible future cause of movement; understanding what a warranty actually covers matters more than its headline length.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="workmanship-warranty">Workmanship Warranty</span>
            <span class="related-term" data-term="transferable-warranty">Transferable Warranty</span>
            <span class="related-term" data-term="disclosure">Disclosure</span>
          </div>
        </div>
      </section>

      <!-- M -->
      <section class="letter-section" id="M">
        <h2 class="letter-heading">M</h2>
        <div class="term-card" id="mancos-shale">
          <div class="term-name">Mancos Shale</div>
          <div class="term-definition">
            <p>A dark, clay-rich shale formation underlying much of northwest New Mexico, particularly the San Juan Basin and Four Corners region. Expands significantly when it absorbs moisture and shrinks when dry, producing some of the most pronounced foundation heave in the state. Frequently misdiagnosed as settlement because surface symptoms look identical — a critical distinction because the repairs are opposite.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="heave">Heave</span>
            <span class="related-term" data-term="sulfate-heave">Sulfate Heave</span>
            <span class="related-term" data-term="differential-settlement">Differential Movement</span>
          </div>
        </div>
        <div class="term-card" id="micropile">
          <div class="term-name">Micropile</div>
          <div class="term-definition">
            <p>A small-diameter drilled and grouted deep foundation element, typically 3 to 12 inches in diameter. Micropiles are drilled rather than driven, allowing them to penetrate hard rock, cobbles, and dense caliche.</p>
            <p>Used when the soil profile requires reaching bearing at significant depth through materials that would prevent helical pier installation.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
          </div>
        </div>
        <div class="term-card" id="misdiagnosis">
          <div class="term-name">Misdiagnosis</div>
          <div class="term-definition">
            <p>An incorrect determination of what's causing foundation movement — most consequentially, treating heave as settlement or vice versa. Because the two produce nearly identical surface symptoms but require opposite repairs, misdiagnosis isn't a minor error: a repair designed for the wrong mechanism can actively worsen the condition it was meant to fix. Investigation before repair exists specifically to prevent this.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="heave">Heave</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="pier-selection">Pier Selection</span>
          </div>
        </div>
        <div class="term-card" id="moisture-content">
          <div class="term-name">Moisture Content</div>
          <div class="term-definition">
            <p>The amount of water present in a soil sample, expressed as a percentage of the soil's dry weight. Moisture content is one of the basic measurements taken during a geotechnical investigation, and it's compared against a soil's known behavior at different moisture levels — dry, optimal, saturated — to understand where in its expansion or collapse cycle a given sample currently sits.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
            <span class="related-term" data-term="boring">Boring</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
          </div>
        </div>
        <div class="term-card" id="moisture-migration">
          <div class="term-name">Moisture Migration</div>
          <div class="term-definition">
            <p>The movement of water through soil via capillary action, lateral flow, or vapor transmission. In foundation contexts, moisture migration can introduce water to soils that were dry at the time of construction, triggering expansion in clays or collapse in collapsible soils. Sources include irrigation, plumbing leaks, ponding surface water, and seasonal groundwater fluctuation.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="acequia">Acequia</span>
            <span class="related-term" data-term="hydrostatic-pressure">Hydrostatic Pressure</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
          </div>
        </div>
        <div class="term-card" id="moisture-trigger">
          <div class="term-name">Moisture Trigger</div>
          <div class="term-definition">
            <p>The specific source of moisture that initiated or is sustaining foundation movement. Identifying the moisture trigger is the starting point for repair design in moisture-driven foundation problems.</p>
            <p>Common triggers: landscape irrigation on previously dry soil, broken supply lines, roof drainage directed toward the foundation, and changes in surface grade that concentrate runoff.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="first-wetting-collapse">First-Wetting Collapse</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
          </div>
        </div>
        <div class="term-card" id="monitoring">
          <div class="term-name">Monitoring</div>
          <div class="term-definition">
            <p>Tracking a foundation's elevation or crack width over time, using periodic surveys or fixed monitoring points, to determine whether movement is active, has stabilized, or is progressing. Monitoring is sometimes the correct recommendation on its own — not every observed condition needs immediate structural intervention, and monitoring data can confirm that before any repair is proposed.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="active-movement">Active Movement</span>
            <span class="related-term" data-term="no-repair-recommendation">No‑Repair Recommendation</span>
            <span class="related-term" data-term="investigation">Investigation</span>
          </div>
        </div>
        <div class="term-card" id="montmorillonite">
          <div class="term-name">Montmorillonite</div>
          <div class="term-definition">
            <p>A clay mineral with a layered atomic structure that absorbs water between its molecular layers, causing the mineral — and the soil containing it — to swell. Sodium montmorillonite is the most expansive form.</p>
            <p>It is present in the Mancos Shale of the San Juan Basin, in basalt-derived soils on the Taos Plateau, and as a component of clay assemblages throughout New Mexico.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="mancos-shale">Mancos Shale</span>
          </div>
        </div>
        <div class="term-card" id="mudsill">
          <div class="term-name">Mudsill</div>
          <div class="term-definition">
            <p>The horizontal wood member that sits on top of the foundation wall and anchors the structural framing. The transition point between concrete or masonry and wood framing.</p>
            <p>In elevated-moisture environments, if water consistently reaches the mudsill, it will rot. A rotting mudsill produces the same visible symptoms as foundation settlement.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="adobe-foundation">Adobe Foundation</span>
          </div>
        </div>
      </section>

      <!-- N -->
      <section class="letter-section" id="N">
        <h2 class="letter-heading">N</h2>
        <div class="term-card" id="no-repair-recommendation">
          <div class="term-name">No‑Repair Recommendation</div>
          <div class="term-definition">
            <p>An honest assessment that no structural repair is warranted — sometimes the correct answer after evaluation. TLS Foundations recommends this when the evidence shows movement has stabilized or can be managed with drainage correction alone.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
      </section>

      <!-- O -->
      <section class="letter-section" id="O">
        <h2 class="letter-heading">O</h2>
        <div class="term-card" id="organic-decomposition">
          <div class="term-name">Organic Decomposition</div>
          <div class="term-definition">
            <p>Settlement caused by buried vegetation or stumps decomposing over time, creating voids beneath foundations. Common on lots where trees were cleared and stumps buried rather than removed.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="void">Void</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
      </section>

      <!-- P -->
      <section class="letter-section" id="P">
        <h2 class="letter-heading">P</h2>
        <div class="term-card" id="pier">
          <div class="term-name">Pier</div>
          <div class="term-definition">
            <p>A structural element installed beneath a foundation to transfer load from a shallow footing to deeper, more competent bearing material. Piers are the primary structural repair tool in foundation work.</p>
            <p>Piers solve a load-transfer problem — they do not address soil conditions causing movement unless those are specifically accounted for in the design.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="push-pier">Push Pier</span>
          </div>
        </div>
        <div class="term-card" id="pier-selection">
          <div class="term-name">Pier Selection</div>
          <div class="term-definition">
            <p>The engineering decision of which pier type — helical, push, or micropile — and what spacing, depth, and capacity to specify for a given repair. Pier selection should follow directly from investigation findings: the soil profile, the depth to competent bearing, and the structure's dead load all constrain which pier type will actually work. Selecting a pier type before investigating the soil reverses the correct order of operations.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="push-pier">Push Pier</span>
            <span class="related-term" data-term="micropile">Micropile</span>
          </div>
        </div>
        <div class="term-card" id="plasticity-index">
          <div class="term-name">Plasticity Index</div>
          <div class="term-definition">
            <p>A laboratory measurement that quantifies how much the water content of a soil can change while the soil remains plastic. A high plasticity index indicates a soil with high swell potential.</p>
            <p>Plasticity index is a key parameter in swell potential assessment. In Mancos Shale evaluation, plasticity index testing is part of the standard investigation sequence.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
            <span class="related-term" data-term="montmorillonite">Montmorillonite</span>
          </div>
        </div>
        <div class="term-card" id="playa">
          <div class="term-name">Playa</div>
          <div class="term-definition">
            <p>A shallow, flat-floored depression in arid terrain that collects water after rain events and drains by evaporation rather than outflow. Common across eastern New Mexico and the High Plains.</p>
            <p>Playas concentrate the most expansive material in the formation. A structure on or near a playa margin consistently sees more moisture-driven foundation movement.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
          </div>
        </div>
        <div class="term-card" id="plumbing-leak-coverage">
          <div class="term-name">Plumbing Leak Coverage</div>
          <div class="term-definition">
            <p>The portion of a homeowners insurance claim, if any, that covers damage caused by a sudden and accidental plumbing leak — as distinct from the resulting soil movement, which typically falls under the earth movement exclusion. Depending on the policy, the leak itself and water damage to finishes may be covered even when the foundation movement it triggered is not. Reading the specific policy language, and documenting the leak promptly, matters for what gets paid.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="earth-movement-exclusion">Earth Movement Exclusion</span>
            <span class="related-term" data-term="drainage">Drainage</span>
            <span class="related-term" data-term="disclosure">Disclosure</span>
          </div>
        </div>
        <div class="term-card" id="polyurethane-foam">
          <div class="term-name">Polyurethane Foam</div>
          <div class="term-definition">
            <p>The expanding synthetic material used in polyurethane foam injection — as distinct from the injection method itself. The foam expands on contact with the surrounding soil or void, filling gaps and, depending on formulation, densifying loose material around it. Lightweight relative to grout, which makes it suited to void-filling and slab-leveling applications where added weight isn't desirable.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="polyurethane-foam-injection">Polyurethane Foam Injection</span>
            <span class="related-term" data-term="void">Void</span>
            <span class="related-term" data-term="compaction-grouting">Compaction Grouting</span>
          </div>
        </div>
        <div class="term-card" id="polyurethane-foam-injection">
          <div class="term-name">Polyurethane Foam Injection</div>
          <div class="term-definition">
            <p>A method of injecting expanding polyurethane foam beneath slabs, into soil voids, or along foundation perimeters to fill gaps, stabilize loose material, and restore elevation. Applied through small drilled ports with minimal excavation. Sometimes used for slab leveling, void filling, compaction trench remediation, and perimeter soil stabilization.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="void">Void</span>
            <span class="related-term" data-term="compaction-grouting">Compaction Grouting</span>
            <span class="related-term" data-term="underpinning">Underpinning</span>
          </div>
        </div>
        <div class="term-card" id="post-tension-slab">
          <div class="term-name">Post-Tension Slab</div>
          <div class="term-definition">
            <p>A concrete slab foundation reinforced with steel cables (tendons) that are tensioned after the concrete cures, putting the slab under continuous compression. Common in newer New Mexico construction, particularly on expansive soils, because the tensioning helps the slab resist cracking under differential movement. A post-tension slab is a more resilient system, not an immune one — the tendons resist cracking, they don't eliminate the underlying soil movement that stresses the slab.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="slab-on-grade">Slab-on-Grade</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
            <span class="related-term" data-term="differential-settlement">Differential Settlement</span>
          </div>
        </div>
        <div class="term-card" id="push-pier">
          <div class="term-name">Push Pier</div>
          <div class="term-definition">
            <p>A steel pier installed by hydraulically jacking it into the ground using the weight of the structure as a reaction force. The pier is driven until the resistance at depth equals the capacity of the hydraulic ram.</p>
            <p>Push piers are not appropriate for most New Mexico residential foundation work. Wood-frame homes do not generate enough dead load to drive piers to the depths required in our soil profiles.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="dead-load">Dead Load</span>
          </div>
        </div>
      </section>

      <!-- R -->
      <section class="letter-section" id="R">
        <h2 class="letter-heading">R</h2>
        <div class="term-card" id="refusal">
          <div class="term-name">Refusal</div>
          <div class="term-definition">
            <p>The point at which a drill or pier cannot be advanced further due to encountering hard material like caliche or bedrock. Caliche refusal does not necessarily mean competent bearing has been reached — the hard layer may be thin.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="caliche">Caliche</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
          </div>
        </div>
        <div class="term-card" id="rio-grande-rift">
          <div class="term-name">Rio Grande Rift</div>
          <div class="term-definition">
            <p>A zone of active crustal extension running the length of New Mexico, where the earth's crust is pulling apart along a series of faults. The pulling-apart process dropped elongated basins while adjacent mountain ranges rose.</p>
            <p>Those basins have been filling with sediment for millions of years, creating the thick sequences of alluvial fan deposits, river sediments, and lake beds that now underlie most of New Mexico's developed areas.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="alluvial-fan">Alluvial Fan</span>
          </div>
        </div>
      </section>

      <!-- S -->
      <section class="letter-section" id="S">
        <h2 class="letter-heading">S</h2>
        <div class="term-card" id="sales-inspection">
          <div class="term-name">Sales Inspection</div>
          <div class="term-definition">
            <p>A near-synonym for a free inspection — an evaluation whose primary purpose, from the company performing it, is to generate a sale. The term makes explicit what "free inspection" leaves implicit: the person doing the evaluating is compensated by closing the deal, not by the accuracy of the diagnosis.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="free-inspection">Free Inspection</span>
            <span class="related-term" data-term="sales-metric">Sales Metric</span>
            <span class="related-term" data-term="conflict-of-interest">Conflict of Interest</span>
          </div>
        </div>
        <div class="term-card" id="sales-metric">
          <div class="term-name">Sales Metric</div>
          <div class="term-definition">
            <p>An internal performance measure — close rate, average ticket size, inspections-to-contracts ratio — used to evaluate salespeople or inspectors in a commission-driven repair company. Sales metrics aren't inherently improper, but when the person recommending a repair is measured on how often that recommendation converts to a signed contract, the incentive runs counter to a purely evidence-based diagnosis.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="conflict-of-interest">Conflict of Interest</span>
            <span class="related-term" data-term="sales-inspection">Sales Inspection</span>
            <span class="related-term" data-term="free-inspection">Free Inspection</span>
          </div>
        </div>
        <div class="term-card" id="scope-of-work">
          <div class="term-name">Scope of Work</div>
          <div class="term-definition">
            <p>The written description of exactly what a repair will and won't include — number of piers, locations, drainage work, finish restoration, and what's explicitly excluded. A clear scope of work is what lets a homeowner compare proposals meaningfully and know, after the fact, whether the work performed matches what was promised. A vague scope is a common source of disputes that have nothing to do with whether the repair itself was any good.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="free-estimate">Free Estimate</span>
            <span class="related-term" data-term="workmanship-warranty">Workmanship Warranty</span>
            <span class="related-term" data-term="structural-repair">Structural Repair</span>
          </div>
        </div>
        <div class="term-card" id="seasonal-movement">
          <div class="term-name">Seasonal Movement</div>
          <div class="term-definition">
            <p>Foundation movement that recurs on a roughly annual cycle, tracking seasonal moisture changes rather than a one-time trigger. Expansive clay soils commonly produce seasonal movement — heaving in wet seasons, settling back in dry ones — which can look alarming in isolation but may represent a stable, repeating pattern rather than progressive damage. Distinguishing seasonal movement from progressive movement generally requires monitoring across at least one full cycle.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="monitoring">Monitoring</span>
            <span class="related-term" data-term="active-movement">Active Movement</span>
            <span class="related-term" data-term="expansive-clay">Expansive Clay</span>
          </div>
        </div>
        <div class="term-card" id="settlement">
          <div class="term-name">Settlement</div>
          <div class="term-definition">
            <p>Downward movement of a foundation caused by compression or consolidation of the soil beneath it. Settlement can be uniform or differential.</p>
            <p>The critical diagnostic distinction in New Mexico is between settlement and heave — both produce visible distress, but the correct repair for each is different. The wrong repair produces a worse outcome than the original condition.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="heave">Heave</span>
            <span class="related-term" data-term="differential-settlement">Differential Settlement</span>
          </div>
        </div>
        <div class="term-card" id="slab-on-grade">
          <div class="term-name">Slab-on-Grade</div>
          <div class="term-definition">
            <p>A foundation system consisting of a concrete slab poured directly on the prepared ground surface, without a basement or crawlspace. The slab bears directly on the soil below it and is the dominant foundation type for residential construction in New Mexico.</p>
            <p>When the soil swells, the slab heaves. When the soil consolidates, the slab settles. Differential movement across the slab produces cracking, floor tilt, and door problems.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
          </div>
        </div>
        <div class="term-card" id="soil-investigation">
          <div class="term-name">Soil Investigation</div>
          <div class="term-definition">
            <p>A near-synonym for geotechnical investigation, sometimes used more narrowly to describe the field sampling portion — borings, sampling, in-situ testing — as distinct from the lab analysis and engineering interpretation that follow. Either way, it's the step that replaces assumption with data about what's actually present at a specific site.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
            <span class="related-term" data-term="boring">Boring</span>
            <span class="related-term" data-term="undisturbed-sample">Undisturbed Sample</span>
          </div>
        </div>
        <div class="term-card" id="soil-piping">
          <div class="term-name">Soil Piping</div>
          <div class="term-definition">
            <p>The erosion of soil particles by concentrated water flow through subsurface channels, gradually enlarging those channels into pipe-like voids. Distinct from evaporite dissolution — piping erodes granular or silty soil mechanically rather than dissolving soluble minerals chemically — but the result is similar: hidden subsurface voids that can lead to sudden settlement when their roof collapses. Concentrated drainage discharge near a foundation is a common contributor.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="void">Void</span>
            <span class="related-term" data-term="drainage">Drainage</span>
            <span class="related-term" data-term="evaporite-dissolution">Evaporite Dissolution</span>
          </div>
        </div>
        <div class="term-card" id="structural-engineer">
          <div class="term-name">Structural Engineer</div>
          <div class="term-definition">
            <p>A licensed engineer qualified to evaluate a structure's load-bearing systems and, where needed, design or stamp a repair. Not every foundation problem requires a structural engineer's direct involvement, but some — particularly ones involving unusual construction, significant damage, or insurance and legal disputes — do. A structural engineer's evaluation is independent of any repair company's inspection.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="geotechnical-investigation">Geotechnical Investigation</span>
            <span class="related-term" data-term="structural-repair">Structural Repair</span>
            <span class="related-term" data-term="home-inspection">Home Inspection</span>
          </div>
        </div>
        <div class="term-card" id="structural-repair">
          <div class="term-name">Structural Repair</div>
          <div class="term-definition">
            <p>Work that changes how a foundation carries or transfers load — piers, underpinning, slab stabilization — as distinct from non-structural interventions like drainage correction or cosmetic patching. Not every foundation problem needs a structural repair; that determination is the point of investigation. Recommending structural repair before ruling out non-structural causes is a common and expensive mistake.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="pier">Pier</span>
            <span class="related-term" data-term="underpinning">Underpinning</span>
            <span class="related-term" data-term="drainage-correction">Drainage Correction</span>
          </div>
        </div>
        <div class="term-card" id="subsidence">
          <div class="term-name">Subsidence</div>
          <div class="term-definition">
            <p>A general term for the downward settling of ground surface, from any cause — soil consolidation, void collapse, aquifer compaction, or mine-related ground loss. Broader than "settlement," which usually refers specifically to a structure's foundation; subsidence can occur across a whole area independent of any building on it, as in the Deming area's aquifer compaction subsidence, and is not something foundation repair can reverse.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="settlement">Settlement</span>
            <span class="related-term" data-term="aquifer-compaction-subsidence">Aquifer Compaction Subsidence</span>
            <span class="related-term" data-term="void">Void</span>
          </div>
        </div>
        <div class="term-card" id="sulfate-heave">
          <div class="term-name">Sulfate Heave</div>
          <div class="term-definition">
            <p>Upward foundation movement caused by the formation of ettringite, a mineral that expands significantly when sulfate-bearing soils react with calcium in concrete. Common in areas with gypsum-rich soils and Mancos Shale. Distinct from standard expansive clay heave — the mechanism is chemical, not moisture-driven swelling — and requires different evaluation and repair approach.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="heave">Heave</span>
            <span class="related-term" data-term="mancos-shale">Mancos Shale</span>
            <span class="related-term" data-term="evaporite-dissolution">Evaporite Dissolution</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
          </div>
        </div>
        <div class="term-card" id="swell-potential">
          <div class="term-name">Swell Potential</div>
          <div class="term-definition">
            <p>The tendency of a soil to increase in volume when moisture is added, expressed as a percentage volume change or as the pressure the expanding soil can generate. Measured in the laboratory on undisturbed samples.</p>
            <p>Swell potential drives helical pier design in expansive clay environments. A pier specified without accounting for uplift forces will be inadequate in high-swell-potential soil.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="plasticity-index">Plasticity Index</span>
            <span class="related-term" data-term="undisturbed-sample">Undisturbed Sample</span>
          </div>
        </div>
        <div class="term-card" id="swell-pressure">
          <div class="term-name">Swell Pressure</div>
          <div class="term-definition">
            <p>The force expansive clay generates as it absorbs moisture and tries to increase in volume but is restrained — by a foundation, a slab, or overburden soil — from doing so. Measured in the laboratory, swell pressure is what a pier or slab design has to resist in expansive soil; specifying a pier without accounting for it is one of the more common under-designs in expansive clay country.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
            <span class="related-term" data-term="expansive-clay">Expansive Clay</span>
            <span class="related-term" data-term="plasticity-index">Plasticity Index</span>
          </div>
        </div>
      </section>

      <!-- T -->
      <section class="letter-section" id="T">
        <h2 class="letter-heading">T</h2>
        <div class="term-card" id="tesuque-formation">
          <div class="term-name">Tesuque Formation</div>
          <div class="term-definition">
            <p>A laterally variable sedimentary formation in the Española Basin, with interbedded expansive clays and non‑expansive sands. Foundations in this formation often experience differential movement between adjacent areas of the same site.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="lateral-variability">Lateral Variability</span>
            <span class="related-term" data-term="expansive-soil">Expansive Soil</span>
          </div>
        </div>
        <div class="term-card" id="torque-monitoring">
          <div class="term-name">Torque Monitoring</div>
          <div class="term-definition">
            <p>The practice of continuously measuring the rotational resistance encountered during helical pier installation, and using that measurement to infer bearing capacity in real time.</p>
            <p>Torque monitoring is the primary quality control method for helical pier installation and is essential in variable soil profiles where bearing conditions change significantly with depth.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
          </div>
        </div>
        <div class="term-card" id="transferable-warranty">
          <div class="term-name">Transferable Warranty</div>
          <div class="term-definition">
            <p>A repair warranty written to remain in effect for a new owner if the property is sold, rather than terminating with the original customer. Transferability matters disproportionately to resale value and buyer confidence — a non-transferable warranty on a prior repair is close to worthless to a buyer evaluating the property, while a transferable one is a real, disclosable asset.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="lifetime-warranty">Lifetime Warranty</span>
            <span class="related-term" data-term="disclosure">Disclosure</span>
            <span class="related-term" data-term="workmanship-warranty">Workmanship Warranty</span>
          </div>
        </div>
      </section>

      <!-- U -->
      <section class="letter-section" id="U">
        <h2 class="letter-heading">U</h2>
        <div class="term-card" id="underpinning">
          <div class="term-name">Underpinning</div>
          <div class="term-definition">
            <p>The process of extending a foundation's support to deeper, more stable soil or bedrock. Accomplished through various pier systems — helical piers, push piers, micropiles — driven or drilled past unstable near-surface soils to reach material with adequate bearing capacity. The appropriate depth depends on local soil conditions and cannot be determined without investigation.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="helical-pier">Helical Pier</span>
            <span class="related-term" data-term="push-pier">Push Pier</span>
            <span class="related-term" data-term="micropile">Micropile</span>
            <span class="related-term" data-term="bearing-capacity">Bearing Capacity</span>
            <span class="related-term" data-term="settlement">Settlement</span>
          </div>
        </div>
        <div class="term-card" id="undisturbed-sample">
          <div class="term-name">Undisturbed Sample</div>
          <div class="term-definition">
            <p>A soil sample collected in a way that preserves the natural structure, density, and moisture content of the in-place material — as opposed to a disturbed sample that has been remolded during collection.</p>
            <p>Undisturbed samples are required for laboratory tests that depend on natural soil structure: consolidation testing, swell potential testing, and shear strength testing.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="swell-potential">Swell Potential</span>
            <span class="related-term" data-term="boring">Boring</span>
          </div>
        </div>
      </section>

      <!-- V -->
      <section class="letter-section" id="V">
        <h2 class="letter-heading">V</h2>
        <div class="term-card" id="value-impact">
          <div class="term-name">Value Impact</div>
          <div class="term-definition">
            <p>The effect — positive or negative — that a foundation's condition and repair history has on a property's market value. Undisclosed or unrepaired foundation movement typically has a negative value impact once discovered, often larger than the repair would have cost; a documented, warrantied repair frequently has little to no negative impact and can even reassure a buyer relative to an undisclosed unknown.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="disclosure">Disclosure</span>
            <span class="related-term" data-term="transferable-warranty">Transferable Warranty</span>
            <span class="related-term" data-term="lifetime-warranty">Lifetime Warranty</span>
          </div>
        </div>
        <div class="term-card" id="void">
          <div class="term-name">Void</div>
          <div class="term-definition">
            <p>An open space in the subsurface created by the dissolution of soluble rock or soil, the decomposition of organic material, or the deterioration of mine workings. Voids represent the complete absence of bearing material at a given depth.</p>
            <p>Dissolution voids have no surface expression while forming. A void growing beneath a foundation produces no visible indication until it is large enough to cause movement — or until its roof collapses suddenly.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="karst">Karst</span>
            <span class="related-term" data-term="evaporite">Evaporite</span>
          </div>
        </div>
      </section>

      <!-- W -->
      <section class="letter-section" id="W">
        <h2 class="letter-heading">W</h2>
        <div class="term-card" id="watering-foundation">
          <div class="term-name">Watering a Foundation</div>
          <div class="term-definition">
            <p>Attempting to control soil moisture around a foundation. This is only appropriate for certain soil types; doing it on collapsible soil can cause settlement.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="collapsible-soil">Collapsible Soil</span>
            <span class="related-term" data-term="moisture-trigger">Moisture Trigger</span>
          </div>
        </div>
        <div class="term-card" id="workmanship-warranty">
          <div class="term-name">Workmanship Warranty</div>
          <div class="term-definition">
            <p>A warranty covering the quality of the installation itself — that the piers were installed correctly, to spec, and will perform as designed — as distinct from a warranty against future soil movement from an unrelated or unaddressed cause. A workmanship warranty is what most reputable foundation repair companies stand behind; understanding that it covers the work rather than everything the soil might do next is the important distinction.</p>
          </div>
          <div class="related-terms">
            <span class="related-label">Related:</span>
            <span class="related-term" data-term="lifetime-warranty">Lifetime Warranty</span>
            <span class="related-term" data-term="transferable-warranty">Transferable Warranty</span>
            <span class="related-term" data-term="scope-of-work">Scope of Work</span>
          </div>
        </div>
      </section>
    </div>
  </div>

  <ReferenceNav />
</Layout>

<script type="application/json" id="glossary-terms-data" set:html={JSON.stringify(terms)} />

<script>
  type TermData = { id: string; name: string; description: string };
  const termsData: TermData[] = JSON.parse(document.getElementById('glossary-terms-data')?.textContent || '[]');
  const definitions: Record<string, string> = {};
  for (const t of termsData) definitions[t.id] = t.description;

  function removeAllPopups() {
    document.querySelectorAll('.definition-popup').forEach((p) => p.remove());
  }

  function showPopup(termKey: string, clickedElement: HTMLElement) {
    removeAllPopups();
    const defText = definitions[termKey] || 'Definition coming soon.';
    const popup = document.createElement('div');
    popup.className = 'definition-popup';
    const closeBtn = document.createElement('span');
    closeBtn.className = 'popup-close';
    closeBtn.innerHTML = '×';
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      popup.remove();
    });
    popup.appendChild(closeBtn);
    const defPara = document.createElement('p');
    defPara.textContent = defText;
    popup.appendChild(defPara);
    const parentBlock = clickedElement.closest('.term-card');
    if (parentBlock && parentBlock.parentNode) {
      parentBlock.parentNode.insertBefore(popup, parentBlock.nextSibling);
    } else if (clickedElement.parentNode) {
      clickedElement.parentNode.insertBefore(popup, clickedElement.nextSibling);
    }
  }

  function initGlossary() {
    document.querySelectorAll<HTMLElement>('.related-term').forEach((term) => {
      term.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const termKey = term.getAttribute('data-term');
        if (termKey) showPopup(termKey, term);
      });
    });

    const sections = document.querySelectorAll<HTMLElement>('.letter-section');
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.letter-nav a');
    function setActiveLetter() {
      let current = '';
      const scrollPos = window.scrollY + 120;
      sections.forEach((section) => {
        const sectionTop = section.offsetTop;
        const sectionBottom = sectionTop + section.offsetHeight;
        if (scrollPos >= sectionTop && scrollPos < sectionBottom) {
          current = section.getAttribute('id') || '';
        }
      });
      navLinks.forEach((link) => {
        link.classList.toggle('active', link.getAttribute('href') === '#' + current);
      });
    }
    window.addEventListener('scroll', setActiveLetter, { passive: true });
    setActiveLetter();

    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (!href) return;
        const target = document.querySelector<HTMLElement>(href);
        if (target) {
          const offset = 100;
          const targetPos = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top: targetPos, behavior: 'smooth' });
        }
      });
    });

    const searchInput = document.getElementById('glossarySearch') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('autocompleteResults');
    const termCards = document.querySelectorAll<HTMLElement>('.term-card');
    if (!searchInput || !resultsContainer) return;

    const allTerms: { name: string; id: string; element: HTMLElement }[] = [];
    termCards.forEach((card) => {
      const termName = card.querySelector('.term-name')?.textContent?.trim();
      if (termName) {
        allTerms.push({ name: termName, id: card.id, element: card });
      }
    });

    function highlightMatch(text: string, query: string) {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<strong>$1</strong>');
    }

    function updateAutocomplete() {
      const query = (searchInput as HTMLInputElement).value.trim().toLowerCase();
      if (!resultsContainer) return;
      if (query === '') {
        resultsContainer.classList.remove('show');
        return;
      }

      const matches = allTerms.filter((term) => term.name.toLowerCase().includes(query)).slice(0, 10);

      if (matches.length === 0) {
        resultsContainer.classList.remove('show');
        return;
      }

      resultsContainer.innerHTML = '';
      matches.forEach((match) => {
        const div = document.createElement('div');
        div.className = 'autocomplete-item';
        div.innerHTML = highlightMatch(match.name, query);
        div.addEventListener('click', () => {
          match.element.scrollIntoView({ behavior: 'smooth', block: 'start' });
          match.element.style.transition = 'background 0.3s';
          match.element.style.backgroundColor = 'var(--tls-sand)';
          setTimeout(() => {
            match.element.style.backgroundColor = '';
          }, 1500);
          (searchInput as HTMLInputElement).value = match.name;
          resultsContainer.classList.remove('show');
        });
        resultsContainer.appendChild(div);
      });
      resultsContainer.classList.add('show');
    }

    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !resultsContainer.contains(e.target as Node)) {
        resultsContainer.classList.remove('show');
      }
    });

    searchInput.addEventListener('input', updateAutocomplete);
    searchInput.addEventListener('focus', updateAutocomplete);
  }

  document.addEventListener('DOMContentLoaded', initGlossary);
</script>

