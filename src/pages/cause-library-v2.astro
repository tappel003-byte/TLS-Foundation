];
const verdictDefs: Record<string, string> = {
  'verdict-strong': 'Usually the right call once the cause is confirmed.',
  'verdict-conditional': 'Depends on specifics — moisture, extent, or site conditions decide it.',
  'verdict-weak': "Usually not the first move — something else needs fixing first.",
