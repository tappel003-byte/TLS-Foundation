<script>
  function tlsToggle(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const header = document.querySelector<HTMLButtonElement>(`[data-acc="${id}"]`);
    if (el.style.maxHeight && el.style.maxHeight !== '0px') {
      el.style.maxHeight = '0px';
      el.setAttribute('aria-hidden', 'true');
      header?.setAttribute('aria-expanded', 'false');
    } else {
      el.style.maxHeight = '2000px';
      el.setAttribute('aria-hidden', 'false');
      header?.setAttribute('aria-expanded', 'true');
    }
  }
  (window as any).tlsToggle = tlsToggle;

  function initCauseLibrary() {
    document.querySelectorAll<HTMLButtonElement>('.accordion-header[data-acc]').forEach((header) => {
      header.addEventListener('click', () => {
        const id = header.getAttribute('data-acc');
        if (id) tlsToggle(id);
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('.jump-links a').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const group = link.getAttribute('data-group');
        if (group) document.getElementById(group)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('#cause-library a[href^="#"]').forEach((anchor) => {
      const hash = anchor.getAttribute('href');
      if (hash && hash.length > 1) {
        anchor.addEventListener('click', (e) => {
          const target = document.querySelector(hash);
          if (target) {
            e.preventDefault();
            const offset = 100;
            const pos = target.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: pos, behavior: 'smooth' });
          }
        });
      }
    });

    const dropdown = document.getElementById('cause-dropdown') as HTMLSelectElement | null;
    dropdown?.addEventListener('change', () => {
      const value = dropdown.value;
      if (!value) return;
      const content = document.getElementById(value);
      if (content) {
        const accordionItem = content.closest('.accordion-item') || content;
        if (content.classList.contains('accordion-content') && (!content.style.maxHeight || content.style.maxHeight === '0px')) {
          tlsToggle(value);
        }
        accordionItem.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      dropdown.value = '';
    });

    // Cross-page deep links (e.g. from the Symptom Matrix on the overview
    // page) land here as a plain #id in the URL -- auto-expand and scroll
    // to that item on load so the experience matches the old same-page
    // click-to-expand behavior.
    const hash = window.location.hash.slice(1);
    if (hash) {
      const item = document.getElementById(hash);
      const content = item?.querySelector<HTMLElement>('.accordion-content');
      if (content && content.id) {
        tlsToggle(content.id);
        setTimeout(() => item?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
      }
    }
  }
  document.addEventListener('DOMContentLoaded', initCauseLibrary);
</script>

