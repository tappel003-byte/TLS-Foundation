interface Cause {
  code: string;
  name: string;
  verdict: string;
  verdictClass: 'verdict-strong' | 'verdict-conditional' | 'verdict-weak';
  what: string;
  where?: string;
  underpinning: string;
  missed?: string;
  regional?: string;
  // Something real a homeowner can do today, wherever it genuinely exists --
  // independent of tier/verdict. Most Tier 1 causes have one (that's most of
  // what "rule out first" means); a few Tier 2/3 causes have a real partial
  // piece even though the overall fix is structural (e.g. checking gutters
  // on the fill side of a cut-and-fill house doesn't undo the differential
  // settlement, but it stops making it worse). Plenty of causes -- across
  // every tier -- genuinely have nothing to add here (a static pre-existing
  // condition, something only a professional can assess, a regional issue
  // nobody controls); leave those without one rather than inventing a step.
  homeownerAction?: string;
  related?: { text: string; href: string; blurb?: string }[];
  anchorId?: string;
  onset: string[];
  see: string[];
  site: string[];
  foundation: string[];
}
interface Group {
  id: string;
  label: string;
  title: string;
  tagline: string;
  causes: Cause[];
}

