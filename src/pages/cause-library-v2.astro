<Layout
  title={title}
  description={description}
  ogImage="/images/why-foundations-move-hero.webp"
  summary={summary}
  pageName="The Cause Library"
  nextPage={{ path: '/expansive-soil', name: 'Expansive Soils' }}
>
  <div class="sg-page">
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="hero-eyebrow">Interactive Guides · Differential Diagnosis</span>
        <h1>The Cause <em>Library</em></h1>
        <p class="page-hero-sub">
          <a href="/symptom-guide-v2">Symptom Guide</a> is what you notice — the crack, the sticking door, the floor
          that dips. This is what's underneath. A symptom doesn't diagnose itself — the twenty-six causes below are
          sorted into three tiers: what's worth ruling out first, what needs a closer look, and what's usually
          structural.
        </p>
      </div>
    </section>

    <div class="page">
      <!-- CHECK ALL THAT APPLY -->
      <div class="facet-panel" id="facetPanel">
        <div class="facet-panel-head">
          <span class="facet-panel-label">Check all that apply</span>
          <p class="facet-panel-sub">This describes common patterns, not an evaluation of your home — the safest step, if you're ever unsure, is to have someone look.</p>
          <p class="facet-panel-note">Same checklist on the <a href="/symptom-guide-v2">Symptom Guide</a> — check it once and we'll carry your answers over, either direction.</p>
        </div>

        <fieldset class="facet-group">
          <legend>Where are you in New Mexico?</legend>
          <div class="region-row">
            <select id="regionSelect" aria-label="Select your region (optional)">
              <option value="">Select your region (optional)</option>
              {regionCities.map((r) => (
                <option value={r.region} data-region-url={r.url}>{r.region}</option>
              ))}
              <option value="Other / not listed">Other / not listed</option>
            </select>
            <select id="citySelect" aria-label="Select your city or town (optional)" disabled>
              <option value="">Select your region first</option>
            </select>
          </div>
          <p class="facet-tip" id="regionLinkTip" hidden></p>
          <script type="application/json" id="regionCitiesData" set:html={JSON.stringify(regionCities)} />
        </fieldset>

        <fieldset class="facet-group">
          <legend>What kind of foundation do you have? <span class="facet-group-note">(check the one you're sure of)</span></legend>
          <div class="facet-options">
            {foundationOptions.map((o) => (
              <label class="facet-chip">
                <input type="radio" name="foundation" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>When did it start?</legend>
          <div class="facet-options">
            {onsetOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="onset" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>What are you seeing?</legend>
          <div class="facet-options">
            {seeOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="see" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="facet-group">
          <legend>What do you know about your site?</legend>
          <div class="facet-options">
            {siteOptions.map((o) => (
              <label class="facet-chip">
                <input type="checkbox" name="site" value={o.id} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="facet-actions">
          <button type="button" id="facetClear" class="facet-clear" hidden>Clear all</button>
        </div>
      </div>

      <!-- OUTCOME -->
      <div class="outcome-box" id="outcomeBox" hidden>
        <span class="outcome-label">Based on what you checked</span>
        <p class="outcome-text" id="outcomeText"></p>
        <div class="outcome-cta">
          <a href="tel:5059914180" class="outcome-phone">(505) 991-4180</a>
          <button type="button" id="sendResultsToggle" class="outcome-print" aria-expanded="false">Send this to TLS</button>
        </div>

        <div class="send-form-wrap" id="sendFormWrap" hidden>
          <form id="sendResultsForm" class="send-form" novalidate>
            <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
            <input type="hidden" name="subject" value="Cause Library results from tlsfoundations.com" />
            <input type="hidden" name="from_name" value="TLS Foundations website" />
            <input type="hidden" name="message" id="sendMessageField" />
            <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" />
            <p class="send-form-note">We'll send exactly what's on this page — what you checked, and the read above.</p>
            <div class="form-row">
              <label for="send-name">Name</label>
              <input id="send-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="form-row">
              <label for="send-contact">Best way to reach you (email or phone)</label>
              <input id="send-contact" name="email" type="text" required autocomplete="email" />
            </div>
            <button type="submit" class="form-submit">Send my results</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="outcome-more" id="outcomeMore">
          <p class="outcome-triage">Notice most results point toward the same first step? That's deliberate — like a doctor taking vital signs before treating you, we gather real data before recommending anything else.</p>
          <div class="related-reading" id="relatedReading" hidden>
            <span class="related-reading-label">Related reading, based on your closest matches</span>
            <div class="related-reading-list" id="relatedReadingList"></div>
          </div>
          <div class="handoff">
            <p class="handoff-text">Want to check this against what you're actually seeing in the house, rather than by mechanism? Your answers carry over automatically.</p>
            <a href="/symptom-guide-v2" id="outcomePill" class="handoff-btn">Go to the Symptom Guide →</a>
          </div>
        </div>
      </div>

      <p class="results-lead" id="resultsLead" hidden>Ranked by how closely it matches what you checked — the tiers step aside once we're ranking; the closest matches simply rise to the top.</p>

      <div class="tier-grid" id="causeGrid">
        {causesByTier.map((tier) => (
          <>
            <div class="tier-header" id={tier.id} data-tier-header style={`order:${tierHeaderOrder[tier.id]}`}>
              <span class="tier-number">{tier.number}</span>
              <div class="tier-header-text">
                <h2>{tier.title}</h2>
                <p>{tier.tagline}</p>
              </div>
            </div>
            {tier.causes.map((c) => (
              <article
                class="specimen-card"
                data-order={causeOrder[c.code]}
                style={`order:${causeOrder[c.code]}`}
                data-onset={c.onset.join(',')}
                data-see={c.see.join(',')}
                data-site={c.site.join(',')}
                data-foundation={c.foundation.join(',')}
              >
                <div class="specimen-head">
                  <h3 class="warning-trigger-text">{c.name}</h3>
                </div>
                <div class="verdict-line">
                  <span class={`verdict-badge ${c.verdictClass}`} data-def={verdictDefs[c.verdictClass]} tabindex="0" role="button" aria-label={`Is underpinning the first choice for this cause? ${c.verdict}. Tap for more.`}>
                    <span class="verdict-q">Is underpinning the first choice here?</span>
                    <span class="verdict-a">{c.verdict}</span>
                  </span>
                  <span class="verdict-def" hidden></span>
                </div>
                <p class="specimen-desc">{c.what}</p>
                <button type="button" class="continue-reading" data-detail-toggle>Continue reading →</button>
                <div class="warning-drawer" id={c.anchorId} hidden>
                  <div class="warning-drawer-inner">
                    <span class="symptom-category-badge">{c.groupTitle}</span>
                    <p class="cause-match-tag" data-match-tag hidden></p>
                    {c.where && <p><span class="field-label">Where in NM</span>{c.where}</p>}
                    <p><span class="field-label">Underpinning appropriate?</span>{c.underpinning}</p>
                    {c.homeownerAction && (
                      <p class="homeowner-action"><span class="field-label">Try this yourself first</span>{c.homeownerAction}</p>
                    )}
                    {c.missed && <p><span class="field-label">Commonly missed</span>{c.missed}</p>}
                    {c.regional && <p><span class="field-label">Regional variations</span>{c.regional}</p>}
                    {c.related && (
                      <div class="specimen-related">
                        {c.related.map((r) => (
                          <a href={r.href} class="specimen-related-item">
                            <span class="specimen-related-title">{r.text}</span>
                            {r.blurb && <span class="specimen-related-blurb">{r.blurb}</span>}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </>
        ))}
      </div>

      <button type="button" class="other-strip" id="otherStrip" hidden></button>

      <div class="contact-footer">
        <p><strong>If this matches what you're seeing, the next step is having someone confirm it in person.</strong></p>
        <p><a href="tel:5059914180">(505) 991-4180</a> · <a href="/contact-us">Send a message</a></p>
        <p class="contact-footer-sub">
          This is a reference, not a diagnosis — no visual inspection alone, including this page, can tell these
          apart with certainty; a floor-level survey does that.
        </p>
        <p class="contact-footer-sub">
          Prefer the short version first? <a href="/why-foundations-move-v2">Why Foundations Move</a> covers the
          five most common patterns and how underpinning decisions actually get made.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  function track(name: string, params: Record<string, string> = {}) {
    if (typeof (window as any).gtag === 'function') (window as any).gtag('event', name, params);
  }

  // Region picker first, city picker populated from that region's real city
  // list once a region is chosen. Same localStorage key as symptom-guide-v2
  // so a choice made on either page is remembered on both.
  const STORAGE_KEY = 'tls-region';
  const regionSelect = document.getElementById('regionSelect') as HTMLSelectElement;
  const citySelect = document.getElementById('citySelect') as HTMLSelectElement;
  const regionLinkTip = document.getElementById('regionLinkTip') as HTMLElement;
  const regionData = JSON.parse(document.getElementById('regionCitiesData')!.textContent || '[]') as {
    region: string;
    url: string;
    cities: string[];
  }[];

  function populateCities(regionName: string, selectedCity = '') {
    citySelect.innerHTML = '';
    const region = regionData.find((r) => r.region === regionName);
    if (!region) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = regionName ? 'City (optional)' : 'Select your region first';
      citySelect.appendChild(opt);
      citySelect.disabled = true;
      return;
    }
    citySelect.disabled = false;
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select your city or town (optional)';
    citySelect.appendChild(placeholder);
    region.cities.forEach((c) => {
      const opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c;
      citySelect.appendChild(opt);
    });
    const other = document.createElement('option');
    other.value = 'Other / not listed';
    other.textContent = 'Other / not listed';
    citySelect.appendChild(other);
    citySelect.value = selectedCity;
  }

  function showRegionTip(region: string, url: string) {
    if (region && url) {
      regionLinkTip.hidden = false;
      regionLinkTip.innerHTML = `<a href="${url}">More about the ${region} region →</a>`;
    } else {
      regionLinkTip.hidden = true;
    }
  }

  populateCities('');

  const urlParams = new URLSearchParams(window.location.search);
  const urlRegion = urlParams.get('region');
  if (urlRegion) {
    // Arriving via the handoff from symptom-guide-v2 with a region already
    // picked -- URL wins over whatever's in localStorage from a prior visit.
    const opt = Array.from(regionSelect.options).find((o) => o.value === urlRegion);
    const url = opt?.dataset.regionUrl || '';
    const urlCity = urlParams.get('city') || '';
    regionSelect.value = urlRegion;
    populateCities(urlRegion, urlCity);
    showRegionTip(urlRegion, url);
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region: urlRegion, url, city: urlCity }));
  } else {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const { region, url, city } = JSON.parse(saved);
        if (region) {
          regionSelect.value = region;
          populateCities(region, city || '');
          showRegionTip(region, url || '');
        }
      } catch {
        /* ignore malformed storage */
      }
    }
  }

  regionSelect.addEventListener('change', () => {
    const region = regionSelect.value;
    const opt = regionSelect.options[regionSelect.selectedIndex];
    const url = opt.dataset.regionUrl || '';
    populateCities(region);
    if (!region) {
      localStorage.removeItem(STORAGE_KEY);
      regionLinkTip.hidden = true;
      return;
    }
    showRegionTip(region, url);
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region, url, city: '' }));
    track('region_selected', { region });
  });

  citySelect.addEventListener('change', () => {
    const city = citySelect.value;
    const region = regionSelect.value;
    const opt = regionSelect.options[regionSelect.selectedIndex];
    const url = opt.dataset.regionUrl || '';
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ region, url, city }));
    track('city_selected', { city, region: region || 'unspecified' });
  });

  const grid = document.getElementById('causeGrid') as HTMLElement;
  const otherStrip = document.getElementById('otherStrip') as HTMLButtonElement;
  const resultsLead = document.getElementById('resultsLead') as HTMLElement;
  const tierHeaders = Array.from(document.querySelectorAll<HTMLElement>('[data-tier-header]'));
  const items = Array.from(grid.querySelectorAll<HTMLElement>('.specimen-card')).map((el) => ({
    el,
    onset: (el.dataset.onset || '').split(',').filter(Boolean),
    see: (el.dataset.see || '').split(',').filter(Boolean),
    site: (el.dataset.site || '').split(',').filter(Boolean),
    foundation: (el.dataset.foundation || '').split(',').filter(Boolean),
  }));

  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.facet-panel input[type="checkbox"], .facet-panel input[type="radio"]'));
  const LABELS: Record<string, string> = {};
  checkboxes.forEach((cb) => {
    const span = cb.parentElement?.querySelector('span');
    if (span) LABELS[cb.value] = span.textContent || cb.value;
  });
  const clearBtn = document.getElementById('facetClear') as HTMLButtonElement;
  const outcomeBox = document.getElementById('outcomeBox') as HTMLElement;
  const outcomeText = document.getElementById('outcomeText') as HTMLElement;
  const outcomePill = document.getElementById('outcomePill') as HTMLAnchorElement;
  const relatedReading = document.getElementById('relatedReading') as HTMLElement;
  const relatedReadingList = document.getElementById('relatedReadingList') as HTMLElement;
  let stripOpen = false;

  function getChecked() {
    const onset = checkboxes.filter((c) => c.checked && c.name === 'onset').map((c) => c.value);
    const see = checkboxes.filter((c) => c.checked && c.name === 'see').map((c) => c.value);
    const site = checkboxes.filter((c) => c.checked && c.name === 'site').map((c) => c.value);
    const foundation = checkboxes.filter((c) => c.checked && c.name === 'foundation' && c.value !== 'fnd-unsure').map((c) => c.value);
    return { onset, see, site, foundation };
  }

  function score(it: (typeof items)[number], checked: ReturnType<typeof getChecked>) {
    const seeMatches = it.see.filter((s) => checked.see.includes(s)).length;
    // A cause can't register as a match without an actual observed-symptom
    // match -- foundation type/onset/site alone (e.g. a uniquely-tagged site
    // condition) must never outrank a real "what are you seeing" match. Same
    // bug class found and fixed on symptom-guide-v2.
    if (seeMatches === 0) return 0;
    const onsetMatches = it.onset.filter((s) => checked.onset.includes(s)).length;
    const siteMatches = it.site.filter((s) => checked.site.includes(s)).length;
    const foundationMatches = it.foundation.filter((s) => checked.foundation.includes(s)).length;
    return seeMatches * 3 + onsetMatches + siteMatches * 2 + foundationMatches * 2;
  }

  function buildMatchTag(it: (typeof items)[number], checked: ReturnType<typeof getChecked>) {
    const parts: string[] = [];
    (['see', 'onset', 'site', 'foundation'] as const).forEach((group) => {
      it[group].forEach((id) => {
        if (checked[group].includes(id) && LABELS[id]) parts.push(LABELS[id]);
      });
    });
    return parts.length ? `Matches what you checked: ${parts.join(', ')}` : '';
  }

  function buildOutcome() {
    const checked = getChecked();
    const any = checked.onset.length + checked.see.length + checked.site.length + checked.foundation.length > 0;
    if (!any) {
      outcomeBox.hidden = true;
      return;
    }
    outcomeBox.hidden = false;

    const scored = items
      .map((it) => ({ it, s: score(it, checked) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s);
    const topNames = scored.slice(0, 3).map((x) => x.it.el.querySelector('.warning-trigger-text')?.textContent).filter(Boolean);
    const names = topNames.length ? topNames.join(', ') : 'a few of the patterns below';

    const geotech = checked.site.includes('site-cutfill') || checked.site.includes('site-arroyo');
    const geotechClause = geotech
      ? " Given the site conditions you noted, this is also the kind of case where we'd likely loop in our affiliate Sandia GEO for a deeper geotechnical read."
      : '';

    outcomeText.textContent = `Based on what you selected, the closest matches below are ${names}. That's a starting point, not a determination — the way to know for sure is a floor-level survey and distress investigation, which gives an objective baseline to work from and something to monitor over time.${geotechClause} Call us and we'll walk you through it.`;

    const params = new URLSearchParams();
    if (checked.onset.length) params.set('onset', checked.onset.join(','));
    if (checked.see.length) params.set('see', checked.see.join(','));
    if (checked.site.length) params.set('site', checked.site.join(','));
    if (checked.foundation.length) params.set('foundation', checked.foundation.join(','));
    if (regionSelect.value) params.set('region', regionSelect.value);
    if (citySelect.value) params.set('city', citySelect.value);
    outcomePill.href = '/symptom-guide-v2' + (params.toString() ? '?' + params.toString() : '');

    buildRelatedReading(scored);
  }

  // Pulls the further-reading links straight off the top-matched cards'
  // own .specimen-related-item elements -- no separate content to
  // maintain, and no re-querying the DOM by class (cards are reordered
  // via CSS `order`, not DOM position, so `.matched` query order wouldn't
  // match score order). Capped at 3 cards / 4 links, same restraint as
  // symptom-guide-v2's version, for the same reason: past a couple of
  // checked boxes this was turning into a wall of links again.
  function buildRelatedReading(scoredMatches: { it: (typeof items)[number]; s: number }[]) {
    const seen = new Set<string>();
    const found: { href: string; text: string; blurb: string }[] = [];
    scoredMatches.slice(0, 3).forEach(({ it }) => {
      it.el.querySelectorAll<HTMLAnchorElement>('.specimen-related-item').forEach((a) => {
        if (found.length >= 4) return;
        const href = a.getAttribute('href') || '';
        if (!href || seen.has(href)) return;
        seen.add(href);
        const text = a.querySelector('.specimen-related-title')?.textContent?.replace(/\s*→\s*$/, '').trim() || href;
        const blurb = a.querySelector('.specimen-related-blurb')?.textContent?.trim() || '';
        found.push({ href, text, blurb });
      });
    });

    relatedReadingList.innerHTML = '';
    if (found.length === 0) {
      relatedReading.hidden = true;
      return;
    }
    relatedReading.hidden = false;
    found.forEach(({ href, text, blurb }) => {
      const row = document.createElement('a');
      row.href = href;
      row.className = 'related-reading-item';
      row.innerHTML = `<span class="related-reading-title">${text} →</span>` + (blurb ? `<span class="related-reading-blurb">${blurb}</span>` : '');
      relatedReadingList.appendChild(row);
    });
  }

  function applySort() {
    const checked = getChecked();
    const anyChecked = checked.onset.length + checked.see.length + checked.site.length + checked.foundation.length > 0;
    clearBtn.hidden = !anyChecked;
    resultsLead.hidden = !anyChecked;
    tierHeaders.forEach((h) => (h.hidden = anyChecked));

    if (!anyChecked) {
      items.forEach((it) => {
        it.el.classList.remove('matched');
        it.el.hidden = false;
        it.el.style.order = it.el.dataset.order || '0';
        const tag = it.el.querySelector<HTMLElement>('[data-match-tag]');
        if (tag) tag.hidden = true;
      });
      otherStrip.hidden = true;
      stripOpen = false;
      buildOutcome();
      return;
    }

    const scored = items.map((it) => ({ it, s: score(it, checked) }));
    const matched = scored.filter((x) => x.s > 0).sort((a, b) => b.s - a.s);
    const rest = scored.filter((x) => x.s === 0);

    matched.forEach(({ it }, i) => {
      it.el.classList.add('matched');
      it.el.hidden = false;
      it.el.style.order = String(i - 10000);
      const tag = it.el.querySelector<HTMLElement>('[data-match-tag]');
      if (tag) {
        const text = buildMatchTag(it, checked);
        tag.textContent = text;
        tag.hidden = !text;
      }
    });
    rest.forEach(({ it }) => {
      it.el.classList.remove('matched');
      it.el.hidden = !stripOpen;
      it.el.style.order = it.el.dataset.order || '0';
      const tag = it.el.querySelector<HTMLElement>('[data-match-tag]');
      if (tag) tag.hidden = true;
    });

    if (rest.length > 0) {
      otherStrip.hidden = false;
      otherStrip.textContent = stripOpen
        ? `Hide ${rest.length} other cause${rest.length === 1 ? '' : 's'}`
        : `${rest.length} other cause${rest.length === 1 ? '' : 's'}, less likely — tap to show`;
    } else {
      otherStrip.hidden = true;
    }

    buildOutcome();
  }

  otherStrip.addEventListener('click', () => {
    stripOpen = !stripOpen;
    applySort();
  });

  checkboxes.forEach((cb) =>
    cb.addEventListener('change', () => {
      if (cb.name === 'foundation') track('foundation_type_selected', { value: cb.value });
      applySort();
    })
  );
  clearBtn.addEventListener('click', () => {
    checkboxes.forEach((cb) => (cb.checked = false));
    stripOpen = false;
    applySort();
  });
  outcomePill.addEventListener('click', () => track('cross_page_handoff', { from: 'cause-library', to: 'symptom-guide' }));

  // "Send this to TLS" -- same content as what's on the page, sent through
  // the same Web3Forms delivery as the main contact form (see the TODO on
  // WEB3FORMS_ACCESS_KEY above).
  function buildSendMessage(): string {
    const checked = getChecked();
    const lines: string[] = [];
    if (regionSelect.value) lines.push(`Region: ${regionSelect.value}${citySelect.value ? ' — ' + citySelect.value : ''}`);
    const parts = (['see', 'onset', 'site', 'foundation'] as const).flatMap((g) => checked[g]).map((id) => LABELS[id]).filter(Boolean);
    if (parts.length) lines.push(`Checked: ${parts.join(', ')}`);
    lines.push('');
    lines.push(outcomeText.textContent || '');
    lines.push('');
    lines.push('Sent from the Cause Library at tlsfoundations.com/cause-library-v2');
    return lines.join('\n');
  }

  const sendToggle = document.getElementById('sendResultsToggle') as HTMLButtonElement;
  const sendFormWrap = document.getElementById('sendFormWrap') as HTMLElement;
  const sendForm = document.getElementById('sendResultsForm') as HTMLFormElement;
  const sendMessageField = document.getElementById('sendMessageField') as HTMLInputElement;
  const sendStatus = sendForm.querySelector('.form-status') as HTMLElement;
  const sendSubmitBtn = sendForm.querySelector('.form-submit') as HTMLButtonElement;
  const sendAccessKey = (sendForm.querySelector('input[name="access_key"]') as HTMLInputElement).value;

  sendToggle.addEventListener('click', () => {
    const open = sendFormWrap.hidden;
    sendFormWrap.hidden = !open;
    sendToggle.setAttribute('aria-expanded', String(open));
    if (open) track('send_to_tls_opened');
  });

  sendForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    sendMessageField.value = buildSendMessage();

    if (!sendAccessKey) {
      sendStatus.textContent = "This isn't hooked up yet — text or call (505) 991-4180 in the meantime.";
      sendStatus.classList.add('is-error');
      return;
    }

    sendSubmitBtn.disabled = true;
    sendStatus.classList.remove('is-error');
    sendStatus.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(sendForm))),
      });
      const data = await res.json();
      if (data.success) {
        sendStatus.textContent = "Sent — we'll be in touch.";
        sendForm.reset();
        track('send_to_tls_submitted');
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch {
      sendStatus.textContent = "Something went wrong — text or call (505) 991-4180 instead.";
      sendStatus.classList.add('is-error');
    } finally {
      sendSubmitBtn.disabled = false;
    }
  });

  // Arriving via the handoff from symptom-guide-v2 -- pre-check boxes from the URL.
  ['onset', 'see', 'site', 'foundation'].forEach((group) => {
    const val = urlParams.get(group);
    if (!val) return;
    val.split(',').forEach((id) => {
      const cb = checkboxes.find((c) => c.name === group && c.value === id);
      if (cb) cb.checked = true;
    });
  });
  applySort();

  // Each card opens and closes independently -- no more "closes whatever
  // else was open," which fought against the explicit "Continue reading"
  // button once that button existed (clicking it on one card silently
  // closing another card the reader was still looking at made no sense).
  function setCardOpen(article: HTMLElement, open: boolean) {
    const drawer = article.querySelector('.warning-drawer') as HTMLElement;
    const btn = article.querySelector<HTMLButtonElement>('.continue-reading');
    article.classList.toggle('open', open);
    drawer.hidden = !open;
    if (btn) btn.textContent = open ? 'Show less ↑' : 'Continue reading →';
  }
  document.querySelectorAll<HTMLButtonElement>('.continue-reading').forEach((btn) => {
    btn.addEventListener('click', () => {
      const article = btn.closest('.specimen-card') as HTMLElement;
      setCardOpen(article, !article.classList.contains('open'));
    });
  });

  // Tappable verdict badges -- toggle an inline one-line definition without
  // triggering the parent trigger's open/close (stopPropagation), so the
  // legend travels with the reader instead of living only at the page top.
  document.querySelectorAll<HTMLElement>('.verdict-badge').forEach((badge) => {
    const def = badge.nextElementSibling as HTMLElement;
    function toggle(e: Event) {
      e.stopPropagation();
      e.preventDefault();
      const isOpen = !def.hidden;
      document.querySelectorAll<HTMLElement>('.verdict-def').forEach((d) => (d.hidden = true));
      def.hidden = isOpen;
      if (!isOpen) def.textContent = badge.dataset.def || '';
    }
    badge.addEventListener('click', toggle);
    badge.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') toggle(e);
    });
  });

  // Cross-page deep links (e.g. from Why Foundations Move's Symptom Matrix)
  // land here as a #id in the URL -- auto-open the matching card and scroll.
  const hash = window.location.hash.slice(1);
  if (hash) {
    const drawer = document.getElementById(hash);
    const article = drawer?.closest('.specimen-card') as HTMLElement | null;
    if (article) {
      setCardOpen(article, true);
      setTimeout(() => article.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
    }
  }
</script>

