// DRAFT (temp) -- prototype only, linked from a clearly-marked "Draft (temp)"
// nav folder in Header.astro. Second pass at this page: the first cut just
// relocated the 26-item accordion wholesale onto its own URL, but it still
// looked like the same plain reference-document template as every other
// reference page. This version rebuilds it in the site's established
// magazine format (sticky left-nav, numbered sections, Ken Burns hero --
// same toolkit as the regional pages) with a new "specimen card" treatment
// for each cause: a catalog-style code tag (A1, B1...), a compact
// underpinning-verdict badge for scanning without opening every card, and
// structured labeled fields instead of plain paragraphs. Content itself is
// unchanged from the original -- only the presentation is new.
// Hero photo is a placeholder (reuses why-foundations-move-hero.webp) --
// Tim is supplying a new one.
// Delete this file, why-foundations-move-v2.astro, and the "Draft (temp)"
// folder in Header.astro together once a direction is picked.
import Layout from '../layouts/Layout.astro';

const title = 'The Cause Library — Why Foundations Move | TLS Foundations';
const summary =
  'Twenty-six specific causes of foundation movement in New Mexico, organized by mechanism across six groups -- loss of support, soil volume change, water and moisture drivers, deep geologic hazards, construction deficiencies, and site triggers. Each entry covers what it is, where in New Mexico it shows up, whether underpinning is the right response, and what gets commonly missed.';
const description =
  '26 specific causes of New Mexico foundation movement, organized by mechanism -- what it is, where it happens, and whether underpinning is the right response.';

const groups = [
  { id: 'group-a', label: 'Group A', title: 'Loss of Support', tagline: 'The soil can no longer carry the weight. Underpinning is often the right answer.' },
  { id: 'group-b', label: 'Group B', title: 'Soil Volume Change', tagline: 'Soils expand, shrink, or react chemically with moisture. Underpinning is often NOT the first response.' },
  { id: 'group-c', label: 'Group C', title: 'Water & Moisture Drivers', tagline: 'Water is the trigger for nearly every cause. These cases are primarily water problems, not soil problems.' },
  { id: 'group-d', label: 'Group D', title: 'Deep Geologic Hazards', tagline: 'Instability deeper or broader than surface corrections can address. Some unique to NM.' },
  { id: 'group-e', label: 'Group E', title: 'Construction Deficiencies', tagline: 'Not all movement is soil — some is a design or materials problem.' },
  { id: 'group-f', label: 'Group F', title: 'Site & Environmental', tagline: 'Triggers from outside the soil itself — traffic, freeze-thaw, wildlife.' },
];
---

<Layout
  title={title}
  description={description}
  ogImage="/images/why-foundations-move-hero.webp"
  summary={summary}
  pageName="The Cause Library"
  nextPage={{ path: '/expansive-soil', name: 'Expansive Soils' }}
>
  <div class="cl-page">
    <div class="hero">
      <div class="hero-photo"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="hero-eyebrow">TLS Foundations Reference</span>
        <h1 class="hero-h1">The Cause<span class="w2">Library.</span></h1>
        <p class="hero-sub">Twenty-six specific causes, organized by mechanism — because understanding the mechanism is the prerequisite for understanding the fix.</p>
        <div class="hero-cta">
          <span class="hero-cities-label">Companion to</span>
          <p class="hero-aside"><a href="/why-foundations-move-v2">Why Foundations Move</a></p>
        </div>
      </div>
    </div>

    <div class="gold-rule"></div>

    <div class="page-layout">
      <nav class="left-nav">
        <div class="nav-progress"><div class="nav-progress-fill" id="progressFill"></div></div>
        <span class="nav-brand">TLS Foundations · Cause Library</span>
        <ul class="nav-links">
          <li><a href="#overview"><span class="nav-dot"></span>Overview</a></li>
          {groups.map((g) => (
            <li><a href={`#${g.id}`}><span class="nav-dot"></span>{g.title}</a></li>
          ))}
        </ul>
        <div class="nav-contact">
          <span class="nav-contact-label">Ready to talk</span>
          <a href="tel:5059914180">(505) 991-4180</a>
          <span class="nav-contact-sub">You reach the owner(s)</span>
        </div>
      </nav>

      <div class="content-area">
        <!-- OVERVIEW -->
        <section class="section" id="overview">
          <span class="section-num">00</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Reference · How to use this</span></div>
            <h2 class="section-heading reveal">Twenty-six causes, <em>one mechanism each</em></h2>
            <div class="two-col-wide reveal">
              <div>
                <p>Foundation movement in New Mexico has many causes. They are organized here by mechanism — what is actually happening to the soil — because understanding the mechanism is the prerequisite for understanding the fix.</p>
                <p><em>Every cause described here requires professional evaluation to diagnose correctly. No visual inspection alone can distinguish between them.</em></p>
                <p>Each entry carries a quick <strong>Underpinning?</strong> read so you can scan before you dig in — solid means it's usually the right call, an outline means it's conditional, and a muted pill means it's rarely the first move.</p>
              </div>
              <div>
                <div class="basin-stat reveal">
                  <div class="basin-stat-item">
                    <span class="basin-stat-num">26</span>
                    <span class="basin-stat-label">Causes</span>
                  </div>
                  <div class="basin-stat-divider"></div>
                  <div class="basin-stat-item">
                    <span class="basin-stat-num">6</span>
                    <span class="basin-stat-label">Mechanisms</span>
                  </div>
                </div>
                <div class="fact-box reveal">
                  <span class="fact-box-label">Related reading</span>
                  <p><a href="/why-foundations-move-v2">Why Foundations Move</a> — the fast overview and symptom matrix.</p>
                  <p><a href="/symptom-guide">Symptom Guide</a> — what you're seeing, organized by symptom instead of cause.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP A — LOSS OF SUPPORT -->
        <section class="section" id="group-a">
          <span class="section-num">01</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Group A · Loss of Support</span></div>
            <h2 class="section-heading reveal">Loss of Support</h2>
            <p class="basin-tagline reveal">The soil can no longer carry the weight. Underpinning is often the right answer.</p>

            <div class="specimen-list reveal">
              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A1</span>
                  <span class="warning-trigger-text">Collapsible Soils</span>
                  <span class="verdict-badge verdict-strong">Yes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer" id="collapsible-soils">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Some New Mexico soils have a loose, open structure — almost like a honeycomb — held together by weak bonds that dissolve when water reaches them. These soils can support a house for decades while they stay dry. When water is introduced from any source — a leak, irrigation, a storm — the bonds break and the soil drops. Settlement can be sudden and dramatic.</p>
                    <p><span class="field-label">Where in NM</span>Extremely common statewide, particularly on valley margins, alluvial fan deposits, and mesa edges where development has moved from irrigated valley floors onto previously dry higher ground.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Yes — once collapse has occurred, the soil structure is permanently altered. Piers driven through the collapsed zone to stable material below are the standard response. But the water source must be found and controlled first, or collapse will continue in untreated areas.</p>
                    <p><span class="field-label">Commonly missed</span>This is routinely misdiagnosed as 'normal settling' or blamed on poor compaction. The mechanism is fundamentally different — it is not gradual compression under weight, it is a sudden collapse of the soil structure, triggered by water. This is arguably the most underappreciated foundation hazard in New Mexico.</p>
                    <p class="specimen-related"><a href="/collapsible-soil">Collapsible Soils article →</a> | <a href="/glossary#hydrocompaction">Glossary: Hydrocompaction →</a></p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A2</span>
                  <span class="warning-trigger-text">Poorly Compacted Fill</span>
                  <span class="verdict-badge verdict-strong">Yes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>When a building site is graded, excavated material is used as fill to create a level pad. If this fill isn't properly compacted in controlled lifts, it compresses under the weight of the structure over time. Settlement is typically uneven because fill thickness varies across the site. Some fill contains debris, construction waste, or organic material that decomposes and creates voids.</p>
                    <p><span class="field-label">Where in NM</span>Everywhere homes are built, but especially on hillside lots, subdivisions cut into mesas, sites where arroyos or drainages were filled, and rapid-growth developments.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Yes. The fill will not improve on its own. Piers through the fill to competent native soil or bedrock are the standard solution.</p>
                    <p><span class="field-label">Commonly missed</span>Without as-built records, it's difficult to know fill is present without investigation. The homeowner typically has no idea their lot was filled. Contractors often label this 'natural settlement' without checking.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A3</span>
                  <span class="warning-trigger-text">Cut-and-Fill Transition Movement</span>
                  <span class="verdict-badge verdict-strong">Often</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Houses built into hillsides often sit partly on undisturbed cut soil and partly on compressible fill. These two portions bear on fundamentally different materials. The fill side settles; the cut side doesn't. Differential movement is virtually guaranteed.</p>
                    <p><span class="field-label">Where in NM</span>Foothills developments, Santa Fe hillsides, East Mountains, any area where lots were created by grading into slopes.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Often yes, especially when fill is deep. The fill side will typically require deeper piers than the cut side.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A4</span>
                  <span class="warning-trigger-text">Landfill and Undocumented Fill Sites</span>
                  <span class="verdict-badge verdict-conditional">Depends</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Homes built on or near former landfill sites face ongoing settlement as buried waste decomposes, compresses, and creates voids. Gas migration from decomposition can also affect soil chemistry and moisture patterns. Older landfills may not appear on any map the homeowner has access to.</p>
                    <p><span class="field-label">Where in NM</span>Scattered across the state. Municipal records may or may not document former disposal sites, particularly informal ones from earlier decades.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Depends on depth and extent. Deep piers to stable material below the fill may work for localized settlement. Widespread active decomposition may make the site unsuitable for standard residential repair.</p>
                    <p><span class="field-label">Commonly missed</span>Homeowners often have no idea their property sits on or near a former landfill. Investigation is the only way to identify it.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A5</span>
                  <span class="warning-trigger-text">Subsurface Erosion and Soil Piping</span>
                  <span class="verdict-badge verdict-conditional">Depends</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Water moving through erodible soils creates underground channels that carry soil particles away, forming voids beneath foundations. In New Mexico's climate of long dry periods interrupted by intense monsoon rainfall, this process can accelerate dramatically during storm events.</p>
                    <p><span class="field-label">Where in NM</span>Common in dispersive soils (sodium-rich clays), fine-grained alluvial deposits, and loess. Rio Grande Valley and statewide.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Depends. Void filling may be the first priority. The water pathway must be interrupted. Underpinning alone does not solve subsurface erosion.</p>
                    <p><span class="field-label">Commonly missed</span>Invisible until it manifests as sudden settlement or sinkhole-like depressions. Rarely considered in standard repair evaluations.</p>
                    <p class="specimen-related"><a href="/glossary#soil-piping">Glossary: Soil piping →</a></p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A6</span>
                  <span class="warning-trigger-text">Consolidation of Deep Alluvium</span>
                  <span class="verdict-badge verdict-conditional">Sometimes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Naturally deposited soft clays and silts compress under the weight of a structure over time. This is a load-driven process — the soil is squeezing water from its pore spaces under sustained pressure. Settlement can continue for years after construction but typically slows over time.</p>
                    <p><span class="field-label">Where in NM</span>Rio Grande floodplain, major tributary floodplains, and ancient lake bed deposits in closed basins.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Yes, if the settlement is differential and exceeds structural tolerance. If uniform and within tolerance, monitoring is more appropriate.</p>
                    <p><span class="field-label">Commonly missed</span>Confused with other settlement types. The distinguishing feature: it's predictable, load-related, and decelerates over time.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">A7</span>
                  <span class="warning-trigger-text">Bearing Failure from Load Changes</span>
                  <span class="verdict-badge verdict-strong">Often</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Additions, second stories, remodels that remove load-bearing walls, or changes that concentrate weight in new locations can exceed what the original soil and foundation were designed to support.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Often yes — the foundation needs deeper or broader support to handle the new loads.</p>
                    <p><span class="field-label">Commonly missed</span>Blamed on 'bad soil' when the real issue is a load change the original design didn't anticipate.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP B — SOIL VOLUME CHANGE -->
        <section class="section" id="group-b">
          <span class="section-num">02</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Group B · Soil Volume Change</span></div>
            <h2 class="section-heading reveal">Soil Volume Change <em>(Active Zone)</em></h2>
            <p class="basin-tagline reveal">Soils expand, shrink, or react chemically with moisture. Underpinning is often <strong>not</strong> the first response.</p>
            <p class="reveal">Beneath every foundation, moisture fluctuates seasonally — this is the <a href="/glossary#active-zone">active zone</a>. Most movement originates here, driven by moisture.</p>

            <div class="specimen-list reveal">
              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">B1</span>
                  <span class="warning-trigger-text">Expansive Clay Soils (incl. Mancos Shale, Sulfate Heave, Caliche)</span>
                  <span class="verdict-badge verdict-conditional">Sometimes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer" id="expansive-clay">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Clay minerals that swell when wet, shrink when dry. Cyclical movement. Damage comes from repeated cycles over years. In New Mexico, these clays often come from specific geological formations that make them particularly reactive.</p>
                    <p><span class="field-label">Where in NM</span>Statewide; severe in Rio Grande Valley, San Juan Basin, areas underlain by weathered Cretaceous shales. Caliche is common on alluvial fans and piedmont slopes.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Sometimes — when differential movement has caused structural distress that moisture control cannot reverse. But many expansive clay cases are better addressed first through drainage correction, irrigation management, and stabilizing the moisture envelope around the foundation. Underpinning without addressing moisture treats the symptom, not the cause.</p>
                    <p><span class="field-label">Commonly missed</span>Heave is frequently misread as settlement. Homeowners see cracks and think their house is sinking when part of it is actually being pushed up. Underpinning a heaving foundation does not fix the problem — it fights the earth. The honest first step is always to evaluate and manage the moisture before reaching for piers.</p>
                    <p><span class="field-label">Regional variations</span>In the San Juan Basin, Mancos Shale weathers into highly expansive clay that can be more severe than typical expansive soils; this weathered zone can extend many feet below grade, and the boundary between weathered and stable material is not uniform. In areas with Permian evaporites or gypsiferous soils, sulfate heave can occur — a chemical reaction between calcium stabilizers and sulfate-bearing soils that creates progressive, irreversible heave that does not reverse with drying. Caliche — a hard calcium carbonate layer — can provide false bearing if fractured or sitting on unstable material.</p>
                    <p class="specimen-related"><a href="/expansive-soil">Expansive Soils article →</a> | <a href="/glossary">Glossary: Heave, Caliche →</a></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP C — WATER & MOISTURE DRIVERS -->
        <section class="section" id="group-c">
          <span class="section-num">03</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Group C · Water & Moisture Drivers</span></div>
            <h2 class="section-heading reveal">Water and Moisture Drivers</h2>
            <p class="basin-tagline reveal">Water is the trigger for nearly every cause. These cases are primarily water problems, not soil problems.</p>

            <div class="specimen-list reveal">
              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">C1</span>
                  <span class="warning-trigger-text">Plumbing and Sewer Leaks Beneath Slab</span>
                  <span class="verdict-badge verdict-weak">No</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer" id="plumbing-leaks">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Leaks from supply, sewer, or drains saturate soil, causing heave, collapse, or erosion. Sewer leaks are especially insidious — they are deep, persistent, and often go undetected for years.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>No while leak active. Repair leak first, allow soil to stabilize, then reassess.</p>
                    <p><span class="field-label">Commonly missed</span>Many repair contracts signed without sewer camera inspection. A plumber fixes the pipe; a contractor sells piers — but nobody evaluates whether the soil will stabilize on its own once the water stops.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">C2</span>
                  <span class="warning-trigger-text">Poor Surface Drainage &amp; Concentrated Runoff</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Water ponds against foundation due to improper grading, missing gutters, short downspouts, or hardscape directing runoff toward the building.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Almost never. Drainage correction should always come first; in many cases, it eliminates the movement entirely.</p>
                    <p><span class="field-label">Commonly missed</span>Less profitable to fix gutters than sell piers. This is the single most controllable factor in foundation performance.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">C3</span>
                  <span class="warning-trigger-text">Irrigation and Landscaping</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Sprinklers or drip lines against foundation create moisture differential between irrigated perimeter and dry native soil.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Almost never. Move irrigation away; establish a dry buffer zone.</p>
                    <p><span class="field-label">Commonly missed</span>Homeowners rarely connect watering habits to foundation cracks.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">C4</span>
                  <span class="warning-trigger-text">Tree Root Moisture Extraction</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Large trees extract moisture from soil, causing shrinkage and settlement.</p>
                    <p><span class="field-label">Where in NM</span>Rio Grande Valley, irrigated areas with cottonwoods, elms.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Rarely as first step. Root barriers, pruning, tree management first.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">C5</span>
                  <span class="warning-trigger-text">Altered Moisture from Adjacent Development</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>New construction, paving, or landscaping on neighboring properties changes water infiltration patterns.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Rarely. Identify what changed and correct if possible.</p>
                    <p><span class="field-label">Commonly missed</span>Focus stays on damaged house; nobody looks at neighbor's property.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP D — DEEP GEOLOGIC HAZARDS -->
        <section class="section" id="group-d">
          <span class="section-num">04</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Group D · Deep Geologic Hazards</span></div>
            <h2 class="section-heading reveal">Deep Geologic Hazards</h2>
            <p class="basin-tagline reveal">Instability deeper or broader than surface corrections can address. Some unique to NM.</p>

            <div class="specimen-list reveal">
              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">D1</span>
                  <span class="warning-trigger-text">Evaporite Dissolution &amp; Karst Subsidence</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Gypsum, salt dissolve at depth, creating voids and sinkholes.</p>
                    <p><span class="field-label">Where in NM</span>Southeastern NM (Permian Basin), Santa Rosa, Tularosa Basin.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Rarely. Standard residential piers cannot bridge deep voids. This is a site suitability question requiring geologic investigation.</p>
                    <p><span class="field-label">Commonly missed</span>Gradual subsidence attributed to 'normal settling.' Contractors rarely discuss cases where no practical localized fix exists.</p>
                    <p class="specimen-related"><a href="/glossary#subsidence">Glossary: Subsidence →</a> | <a href="/glossary#karst">Glossary: Karst →</a></p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">D2</span>
                  <span class="warning-trigger-text">Hillside Creep &amp; Slope Instability</span>
                  <span class="verdict-badge verdict-conditional">Sometimes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Slow downhill soil movement, applying lateral force to foundations.</p>
                    <p><span class="field-label">Where in NM</span>Sandia/Manzano foothills, Santa Fe hillsides, Jemez Mountains, mesa edges.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Only after slope stabilization. Piers alone will not resist lateral movement.</p>
                    <p><span class="field-label">Commonly missed</span>Symptoms mimic differential settlement; clue is consistent downhill pattern.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">D3</span>
                  <span class="warning-trigger-text">Seismic Activity &amp; Rio Grande Rift</span>
                  <span class="verdict-badge verdict-conditional">Mixed</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Earthquakes can cause soil densification or liquefaction.</p>
                    <p><span class="field-label">Where in NM</span>Rift corridor — Albuquerque, Socorro, Santa Fe, Taos.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Post-earthquake settlement: yes. Fault rupture: underpinning doesn't address.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">D4</span>
                  <span class="warning-trigger-text">Regional Groundwater Changes</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Decades of pumping draw down water tables, causing broad subsidence.</p>
                    <p><span class="field-label">Where in NM</span>Albuquerque Basin, Mimbres, Estancia, lower Rio Grande.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Not typically; regional issue. Underpinning may stabilize individual structure but won't stop subsidence.</p>
                    <p><span class="field-label">Commonly missed</span>Almost universally missed at individual-home level. Systematically absent from contractor education.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">D5</span>
                  <span class="warning-trigger-text">Arroyo and Flash Flood Erosion</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Lateral erosion from arroyos undermines foundations during flash floods.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Not typically. Requires channel stabilization, erosion protection.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP E — CONSTRUCTION DEFICIENCIES -->
        <section class="section" id="group-e">
          <span class="section-num">05</span>
          <div class="section-inner">
            <div class="section-label"><span class="section-label-bar"></span><span class="section-label-text">Group E · Construction Deficiencies</span></div>
            <h2 class="section-heading reveal">Construction &amp; Design Deficiencies</h2>
            <p class="basin-tagline reveal">Not all movement is soil — some is a design or materials problem.</p>

            <div class="specimen-list reveal">
              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">E1</span>
                  <span class="warning-trigger-text">Inadequate Foundation Design</span>
                  <span class="verdict-badge verdict-strong">Often</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Foundation not matched to soil conditions — shallow footings, no geotech investigation.</p>
                    <p><span class="field-label">Where in NM</span>Statewide; many older homes designed without soil testing.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Often yes — providing deep support that should have been there.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">E2</span>
                  <span class="warning-trigger-text">Inadequate Reinforcement &amp; Structural Capacity</span>
                  <span class="verdict-badge verdict-conditional">Partial</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Concrete without enough steel cracks instead of bridging gaps. Piers on unreinforced foundation may lift one section while adjacent stays put.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Partially; structural reinforcement (carbon fiber, rebar) often needed too.</p>
                    <p><span class="field-label">Commonly missed</span>Contractors install piers assuming foundation transfers loads; if unreinforced, repair fails.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">E3</span>
                  <span class="warning-trigger-text">Post-Tension Cable Failure</span>
                  <span class="verdict-badge verdict-weak">Rarely</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Loss of tension in post-tension slab leads to cracking, settlement, or bowing.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Rarely. Forensic investigation, structural repair (carbon fiber, partial replacement).</p>
                    <p><span class="field-label">Commonly missed</span>Many PT slab cracks sold as 'settlement requiring piers' without checking cable tension.</p>
                    <p class="specimen-related"><a href="/glossary#post-tension-slab">Glossary: Post-tension slab →</a></p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">E4</span>
                  <span class="warning-trigger-text">Prior Repair Failure</span>
                  <span class="verdict-badge verdict-strong">Yes</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Previous underpinning failed — piers not deep enough, wrong bearing, etc.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>Yes, as second repair. Evaluate and install deeper piers.</p>
                    <p><span class="field-label">Commonly missed</span>Presented as 'new' problem when it's actually failure of prior repair.</p>
                  </div>
                </div>
              </div>

              <div class="specimen-card">
                <button class="warning-trigger specimen-trigger">
                  <span class="specimen-code">E5</span>
                  <span class="warning-trigger-text">Adobe &amp; Non-Standard Foundations</span>
                  <span class="verdict-badge verdict-conditional">Caution</span>
                  <span class="warning-trigger-icon">+</span>
                </button>
                <div class="warning-drawer">
                  <div class="warning-drawer-inner">
                    <p><span class="field-label">What it is</span>Adobe walls on adobe/rubble foundations; moisture causes material degradation that mimics settlement.</p>
                    <p><span class="field-label">Where in NM</span>Northern NM, Albuquerque historic neighborhoods.</p>
                    <p><span class="field-label">Underpinning appropriate?</span>With caution. Requires specialized engineering; often material repair and moisture protection better.</p>
                    <p><span class="field-label">Commonly missed</span>Degradation misread as settlement. The wall isn't sinking — the bottom of the wall is dissolving.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- GROUP F — SITE & ENVIRONMENTAL -->
        <section class="section" id="group-f">
          <span class="section-num">06</span>
