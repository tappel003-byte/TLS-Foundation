        name: 'Prior Repair Failure',
        verdict: 'Yes',
        verdictClass: 'verdict-strong',
        what: 'Previous underpinning failed — piers not deep enough, wrong bearing, etc.',
        underpinning: 'Yes, as second repair. Evaluate and install deeper piers.',
        missed: "Presented as 'new' problem when it's actually failure of prior repair.",
        homeownerAction: "If you have any paperwork from a prior foundation repair — who did it, pier depth, any warranty — dig it out. It'll save real time when someone assesses this.",
        related: [{ text: 'Glossary: Pier Selection →', href: '/glossary#pier-selection', blurb: 'The engineering decision of which pier type, spacing, depth, and capacity to specify — what likely went wrong the first time.' }],
        onset: ['gradual'],
        see: ['see-crack-diagonal', 'see-floors'],
        site: [],
        foundation: [],
      },
      {
        code: 'E5',
        name: 'Adobe & Non-Standard Foundations',
        verdict: 'Caution',
        verdictClass: 'verdict-conditional',
        what: 'Adobe walls on adobe/rubble foundations; moisture causes material degradation that mimics settlement.',
        where: 'Northern NM, Albuquerque historic neighborhoods.',
        underpinning: 'With caution. Requires specialized engineering; often material repair and moisture protection better.',
        missed: "Degradation misread as settlement. The wall isn't sinking — the bottom of the wall is dissolving.",
        homeownerAction: 'Keep water away from the base of adobe or rubble foundation walls — good grading, working downspouts, and keeping plantings back from the wall base protect adobe more than almost anything else.',
        related: [{ text: 'Glossary: Adobe Foundation →', href: '/glossary#adobe-foundation', blurb: 'Traditional New Mexico construction using sun-dried mud bricks. Requires specialized evaluation and moisture management.' }],
        onset: ['gradual', 'seasonal'],
        see: ['see-cracks-exterior'],
        site: ['site-adobe'],
        foundation: [],
      },
    ],
  },
  {
    id: 'group-f',
    label: 'Group F',
    title: 'Site & Environmental',
    tagline: 'Triggers from outside the soil itself — traffic, freeze-thaw, wildlife.',
    causes: [
      {
        code: 'F1',
        name: 'Frost Heave',
        verdict: 'Rarely',
        verdictClass: 'verdict-weak',
        what: 'Freeze-thaw cycles lift shallow footings.',
        where: 'Mountain communities — Taos, Angel Fire, Ruidoso.',
        underpinning: 'Rarely. Insulation, drainage, proper footing depth.',
        onset: ['seasonal'],
        see: ['see-cracks-exterior'],
        site: [],
        foundation: [],
      },
      {
        code: 'F2',
        name: 'Vibration-Induced Settlement',
        verdict: 'Sometimes',
        verdictClass: 'verdict-conditional',
        what: 'Traffic, construction, rail lines densify loose soils.',
        where: 'Corridors near I-25, I-40, rail lines.',
        underpinning: 'Sometimes; soil densification may be better.',
        onset: ['gradual'],
        see: ['see-floors'],
        site: [],
        foundation: [],
      },
      {
        code: 'F3',
        name: 'Burrowing Animal Activity',
        verdict: 'Rarely',
        verdictClass: 'verdict-weak',
        what: 'Prairie dogs, gophers create tunnels and voids.',
        underpinning: 'Not typically. Void filling and animal management first.',
        homeownerAction: 'Walk the foundation perimeter and look for burrow openings from prairie dogs or gophers, and get animal management started before assuming the movement is soil-related.',
        onset: ['gradual'],
        see: ['see-foundation-gap'],
        site: [],
        foundation: ['fnd-pierbeam'],
      },
    ],
  },
];

const allCauses = groups.flatMap((g) => g.causes.map((c) => ({ ...c, groupId: g.id, groupTitle: g.title })));

// The diagnostic reorganization: same 26 entries, regrouped by what the
// verdict field already meant -- when underpinning is the right call versus
// when something else needs to happen first or needs real investigation.
// Order matters: a differential diagnosis rules out the simple, cheap
// explanation before it reaches for the expensive one.
const tierOrder: Cause['verdictClass'][] = ['verdict-weak', 'verdict-conditional', 'verdict-strong'];
const tierInfo: Record<Cause['verdictClass'], { id: string; number: string; title: string; tagline: string }> = {
  'verdict-weak': {
    id: 'tier-1',
    number: '01',
    title: 'Rule This Out First',
    tagline:
      "Doctors check the simple explanation before ordering a scan. These are the New Mexico equivalents — drainage, irrigation, a slow leak, a burrow under the slab. They're the cheapest to check, the easiest to fix, and — more often than most homeowners expect — the actual answer.",
  },
  'verdict-conditional': {
    id: 'tier-2',
    number: '02',
    title: 'Needs a Closer Look',
    tagline:
      "These don't resolve from a glance at a crack. Soil testing, moisture history, or a site investigation is what actually tells you whether this is what's happening — not a guess from the pattern alone.",
  },
  'verdict-strong': {
    id: 'tier-3',
    number: '03',
    title: 'Usually Structural',
    tagline: "Once one of these is confirmed, underpinning is typically the right response — the soil or the original design genuinely can't carry the house as it sits today.",
  },
};
const causesByTier = tierOrder.map((vc) => ({
  verdictClass: vc,
  ...tierInfo[vc],
  causes: allCauses.filter((c) => c.verdictClass === vc),
}));

// Sequential DOM/flex order across tier headers + cards, used to restore the
// default tier-grouped layout once a search-and-rank pass (via CSS `order`)
// is cleared.
let orderCounter = 0;
const tierHeaderOrder: Record<string, number> = {};
const causeOrder: Record<string, number> = {};
causesByTier.forEach((tier) => {
  tierHeaderOrder[tier.id] = orderCounter++;
  tier.causes.forEach((c) => (causeOrder[c.code] = orderCounter++));
});

// Region dropdown first, city dropdown populated from that region's real
// city list once a region is picked -- identical to symptom-guide-v2's
// picker (same data, same localStorage key) so the choice carries either
// direction, same as the checkbox facets below.
const regionCities = [
  {
    region: 'Four Corners',
    url: '/four-corners',
    cities: ['Farmington', 'Aztec', 'Bloomfield', 'Kirtland', 'Gallup', 'Grants', 'Shiprock'],
  },
  {
    region: 'Northern New Mexico',
    url: '/northern-new-mexico',
    cities: [
      'Taos', 'Ranchos de Taos', 'Arroyo Seco', 'Questa', 'Red River', 'Ojo Caliente',
      'Mora', 'Wagon Mound', 'Chacon', 'Cleveland', 'Guadalupita', 'Roy',
      'Raton', 'Springer', 'Angel Fire', 'Cimarron', 'Eagle Nest', 'Maxwell',
    ],
  },
  {
    region: 'Central New Mexico',
    url: '/central-new-mexico',
    cities: [
      'Albuquerque', 'Rio Rancho', 'Corrales', 'Bernalillo', 'Los Lunas', 'Belen',
      'Santa Fe', 'Española', 'Los Alamos', 'White Rock', 'Pojoaque', 'Chimayó',
      'Estancia', 'Moriarty', 'Mountainair', 'Willard', 'McIntosh', 'Edgewood',
    ],
  },
  {
    region: 'Eastern New Mexico',
    url: '/eastern-new-mexico',
    cities: [
      'Clovis', 'Portales', 'Tucumcari', 'Fort Sumner', 'Santa Rosa', 'Clayton',
      'Roswell', 'Artesia', 'Carlsbad', 'Dexter', 'Hagerman', 'Loving',
      'Deming', 'Silver City', 'Bayard', 'Columbus', 'Hurley',
      'Lordsburg', 'Animas', 'Hachita', 'Rodeo', 'Playas',
    ],
  },
  {
    region: 'Southern New Mexico',
    url: '/southern-new-mexico',
    cities: [
      'Las Cruces', 'Mesilla', 'Doña Ana', 'Anthony', 'Sunland Park', 'Organ',
      'Hatch', 'Rincon', 'Garfield', 'Arrey', 'Derry',
      'Alamogordo', 'Tularosa', 'La Luz', 'Holloman AFB', 'Three Rivers',
      'Ruidoso', 'Cloudcroft', 'Alto', 'Capitan', 'Carrizozo',
      'Socorro', 'Truth or Consequences', 'Magdalena', 'Elephant Butte',
    ],
  },
];

// Same facet vocabulary as symptom-guide-v2.astro -- checked boxes carry
// forward through the handoff link on either page via URL params.
const onsetOptions = [
  { id: 'sudden', label: 'Started suddenly' },
  { id: 'gradual', label: 'Been happening gradually, over time' },
  { id: 'seasonal', label: 'Comes and goes with the seasons' },
];
const seeOptions = [
  { id: 'see-crack-vertical', label: 'Vertical crack in a wall or drywall' },
  { id: 'see-crack-horizontal', label: 'Horizontal crack in a wall or drywall' },
  { id: 'see-crack-diagonal', label: 'Diagonal crack near a door or window' },
  { id: 'see-crack-ceiling', label: 'Crack or gap where the wall meets the ceiling' },
  { id: 'see-cracks-exterior', label: 'Cracks in stucco, brick, or exterior walls' },
  { id: 'see-cracks-slab', label: 'Cracks in a concrete slab or garage floor' },
  { id: 'see-doors', label: "Doors that won't close, latch, or stick" },
  { id: 'see-windows', label: "Windows that won't open or close" },
  { id: 'see-floors', label: 'Sloping, uneven, dipping, or bouncy floors' },
  { id: 'see-gaps', label: 'Gaps around doors, windows, or baseboards' },
  { id: 'see-foundation-cracks', label: 'Foundation cracks or crumbling concrete' },
  { id: 'see-foundation-gap', label: 'A gap between the house and the foundation' },
  { id: 'see-chimney', label: 'Chimney leaning or separating from the house' },
  { id: 'see-drainage', label: 'Water pooling or poor drainage near the house' },
  { id: 'see-crawlspace', label: 'Wet, damp, or musty crawlspace' },
  { id: 'see-leak-signs', label: 'A warm/wet spot on the floor, or a sudden jump in your water bill' },
