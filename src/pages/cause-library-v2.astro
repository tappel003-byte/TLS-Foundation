const siteOptions = [
  { id: 'site-cutfill', label: 'Built on a cut-and-fill or hillside lot' },
  { id: 'site-clay', label: 'Known clay or "heavy" soil in the area' },
  { id: 'site-arroyo', label: 'Near an arroyo or drainage channel' },
