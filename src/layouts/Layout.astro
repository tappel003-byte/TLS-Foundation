---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MinimalFooter from '../components/MinimalFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import MobilePageFlowNav from '../components/MobilePageFlowNav.astro';
import PageSummary from '../components/PageSummary.astro';
import BackToServicesPill from '../components/BackToServicesPill.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects specific to this page (Article, FAQPage, BreadcrumbList, etc.) */
  schema?: object[];
  /**
   * 'full' = the elaborate wordmark/link-grid footer — confirmed present on Home.
   * 'minimal' = just the address line — confirmed present on Albuquerque.
   * Do NOT default this to 'full' again without checking the live page first;
   * the footer is NOT confirmed identical across every page.
   */
  footer?: 'full' | 'minimal';
  /** Only used when footer='full' -- the service-area paragraph is page-specific, not shared. */
  footerProps?: { serviceAreaLabel?: string; serviceAreaText?: string };
  /** Social share image, root-relative (e.g. '/images/contact-us-hero.jpg'). Defaults to the homepage hero. */
  ogImage?: string;
  /** Short hand-written summary shown in the "Summarize this page" popup. Omit to skip the pill entirely on this page. */
  summary?: string;
  /** Short page label shown above "The short version" in the summary popup -- helps orient someone mid-chain. Only meaningful alongside `summary`. */
  pageName?: string;
  /** Chains to the next page's summary popup (adds a "Next: X" link, auto-opens there). Only meaningful alongside `summary`. */
  nextPage?: { path: string; name: string };
  /** Shows the floating "Back to Services" pill, linking to that method's own card on /foundation-repair-methods#<backToServices> -- set on the 8 method pages only, value is the matching card's id (e.g. "helical-piers"). */
  backToServices?: string;
  /** Skips the sitewide MobilePageFlowNav render -- set on send-photos.astro, whose own compact header renders its own prev/next in the (otherwise-empty-on-landing) back-chevron slot instead, per Tim. Keeps this a one-off per-page opt-out rather than new sitewide plumbing, since only one page has a custom header to put it in. */
  hidePageFlowNav?: boolean;
}

const {
  title,
  description,
  schema = [],
  footer = 'minimal',
  footerProps = {},
  ogImage = '/images/home-hero.webp',
  summary,
  pageName,
  nextPage,
  backToServices,
  hidePageFlowNav = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Sitewide schema, present on every page — corrected from what's live:
// live site's Organization block carries a stale phone number (5057023833,
// unused everywhere else on the site) and a sameAs pointing at Squarespace's
// own LinkedIn page (clearly a leftover default, not TLS's). Both fixed here
// to the canonical number; sameAs dropped until real social profiles are given.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  legalName: 'TLS Foundations',
  address: '5048 Edith Blvd NE, Suite E, Albuquerque, NM 87107, United States',
  email: 'TLSfoundationsNM@gmail.com',
  telephone: '+15059914180',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TLS Foundations',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5048 Edith Blvd NE, Suite E',
    addressLocality: 'Albuquerque',
    addressRegion: 'NM',
    postalCode: '87107',
    addressCountry: 'US',
  },
  telephone: '+15059914180',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: 'https://www.tlsfoundations.com',
  name: 'TLS Foundations',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="TLS Foundations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schema.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!--
      Cloudflare Web Analytics -- site-wide, privacy-respecting (no cookies,
      no cross-site tracking, no consent banner required). Added via
      Account Home -> Analytics & Logs -> Web Analytics -> Add a site
      (tlsfoundations.com), token below is real as of Sep 2026.
    -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "81f20aa02f3f4ef28d36dc7ace10aa83"}'></script>

    <!--
      Google Analytics 4 -- the layer Cloudflare Web Analytics doesn't
      cover: custom events (which region or foundation type someone picks,
      print-button clicks, checkbox interactions), not just page views.
      Get the Measurement ID from analytics.google.com -> Admin -> Data
      Streams -> (this site's web stream) -> it's the "G-XXXXXXX" id at
      the top. Swap it in both places below (script src and the gtag
      config call).

      Worth knowing going in: unlike Cloudflare's beacon, GA4 does use
      cookies and cross-session identifiers, which is a different privacy
      posture than what was chosen for Cloudflare specifically to avoid a
      consent banner. For a New Mexico-based small business site this
      isn't a hard legal requirement the way it would be for an EU-facing
      site, but it's a real tradeoff worth being aware you're making, not
      something to just not think about.
    -->
    <!--
      Left disabled for now -- per Tim, Cloudflare Web Analytics only at
      launch. A live script tag pointed at a fake G-XXXXXXX id does
      nothing but make a failed request, so this stays commented out
      until there's a real Measurement ID to put in both places below.

      <script async src="https://www.googletagmanager.com/gtag/js?id=G-REPLACE_WITH_GA4_ID"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-REPLACE_WITH_GA4_ID');
      </script>
    -->
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    {footer === 'full' ? <Footer {...footerProps} /> : <MinimalFooter {...footerProps} />}
    {
      // Per Tim: the 8 method pages get just the one clear "Back to
      // Services" pill -- back-to-top and the sitewide prev/next chevrons
      // don't add anything there (their own prev/next chain through the
      // other 7 methods was never the point) and were just crowding the
      // one button that matters. backToServices is only ever set on
      // those 8 pages, so it doubles as the scoping check here.
      !backToServices && (
        <>
          <BackToTop />
          {!hidePageFlowNav && <MobilePageFlowNav />}
        </>
      )
    }
    {summary && <PageSummary summary={summary} pageName={pageName} nextPage={nextPage} />}
    {backToServices && <BackToServicesPill anchor={backToServices} />}

    <script>
      // Lightweight conversion tracking, sitewide -- writes to the EVENTS
      // D1 database via the /api/track Worker route. Exists because
      // Cloudflare Web Analytics (the beacon in <head>) only ever reports
      // page views; it has no public custom-event API, so it can't answer
      // "which pages actually turn into a call or a submitted form." No
      // PII travels here -- event type, page path, an optional short
      // detail string. window.tlsTrack is exposed so page-specific
      // scripts (form success handlers, the Crack Gauge print button)
      // can call it too, alongside the sitewide phone/text click
      // delegation below. Defined in this same script tag (rather than
      // its own) so the unified scroll handler below can call it
      // directly -- each <script> tag Astro emits is its own module
      // scope, so a plain function declared in one isn't visible from
      // another without going through window.
      function tlsTrack(eventType: string, detail?: string) {
        try {
          const payload = JSON.stringify({ event_type: eventType, page: location.pathname, detail: detail || null });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/track', { method: 'POST', headers: { 'content-type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
          }
        } catch {
          // Never let tracking break the actual interaction it's watching.
        }
      }
      (window as typeof window & { tlsTrack: typeof tlsTrack }).tlsTrack = tlsTrack;

      document.addEventListener(
        'click',
        (e) => {
          const link = (e.target as HTMLElement)?.closest('a[href^="tel:"], a[href^="sms:"]') as HTMLAnchorElement | null;
          if (!link) return;
          tlsTrack(link.href.startsWith('tel:') ? 'phone_click' : 'text_click');
        },
        { capture: true }
      );

      // One scroll handler drives everything that cares "how far down
      // this page am I" -- footer-proximity fade, the Summary/prev-next
      // handoff, and the scroll-depth tracking milestones. They all need
      // the same pct/distanceToBottom numbers, so computing those once
      // per frame (instead of three separate rAF loops each redoing the
      // same math) keeps it cheap.
      //
      // Footer fade: the floating button cluster sits at a fixed
      // bottom-corner position, which physically overlaps the footer's
      // own bottom row once someone scrolls all the way down. Previously
      // this watched the footer element itself via IntersectionObserver,
      // but that fires as soon as the footer's top edge comes into view
      // -- fine for the tall "full" footer, but on the "minimal" footer
      // (~80px, just an address line) it meant the buttons vanished
      // while there was still a stretch of plain page content above the
      // footer bar still on screen. Per Tim, these should stay up until
      // the actual bottom of the page. A scroll-distance-to-true-bottom
      // check gives that regardless of how tall a given page's footer is.
      //
      // Summary/prev-next handoff: per Tim, rather than stacking Summary
      // and prev/next as separate permanent buttons, they now share one
      // slot and hand off based on where you are on the page -- Summary
      // pill early on (that's when "here's the short version" is useful,
      // before you've read anything), prev/next the moment Summary lets
      // go of that slot (that's when "where do I go next" becomes the
      // relevant question). Back-to-top doesn't hand off -- it's useful
      // the whole time you're scrolled down, so it just uses the plain
      // y > 400 check each component already had.
      //
      // The handoff point is 25% of the page, capped at 1600px -- pure
      // 25% meant a genuinely long page (Glossary: ~31,000px scrollable)
      // kept Summary up for ~7,700px of scrolling before prev/next ever
      // appeared, which per Tim gave someone who's found what they came
      // for and wants to leave no quick way out. A flat low percentage
      // instead (10%, floated as the fix) overcorrects the other way: at
      // 10%, 16 of the site's 21 pages are short enough that the pill's
      // own y > 400 arming threshold is already past 10% of the page by
      // the time it can show at all, meaning Summary would functionally
      // never appear on most of the site just to fix one outlier page.
      // 1600px sits close to where 25% already lands on the site's
      // longer "normal" pages (Why Foundations Move: 1909px, Our
      // Approach: 1620px), so it doesn't change anything typical -- it
      // only reins in the small handful of pages whose 25% badly
      // outgrows that, Glossary most of all.
      const HANDOFF_PX_CAP = 1600;
      // The tls-scroll-early body class lets PageSummary.astro and
      // MobilePageFlowNav.astro each gate their own .show class in CSS
      // rather than this script reaching into their internals.
      //
      // Scroll-depth milestones: per Tim, before betting on "people will
      // scroll to the bottom to find prev/next," worth actually knowing
      // whether they do. Fires each of 25/50/75/100% once per page view
      // (a Set guards against re-firing on scroll-up/down past the same
      // point). 100% uses the same distance-to-bottom math as the footer
      // fade rather than a raw scrollHeight ratio, since short pages can
      // round to "100% scrolled" while still 30px shy of the literal
      // bottom.
      const scrollMilestonesFired = new Set<number>();
      let scrollTicking = false;
      function updateScrollState() {
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - window.innerHeight;
        const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 100;
        const distanceToBottom = doc.scrollHeight - (window.scrollY + window.innerHeight);

        document.body.classList.toggle('tls-footer-visible', distanceToBottom < 32);
        // A page with ~0 scrollable distance (Send Us Photos) is, by
        // definition, always within 32px of "the bottom" -- tls-footer-
        // visible would otherwise be permanently true there, which
        // would in turn permanently suppress MobilePageFlowNav.astro's
        // own "show immediately on a short page" exception (see its
        // matching comment) via the same footer-fade CSS rule that
        // correctly protects it from overlapping the footer on a long
        // page. Exposed as its own class rather than folded into the
        // footer-visible check itself, since that check still needs to
        // work unchanged for BackToTop/PageSummary.
        document.body.classList.toggle('tls-page-short', scrollable <= 400);
        const handoffPx = Math.min(scrollable * 0.25, HANDOFF_PX_CAP);
        // The scrollable > 400 guard matters on a page too short to
        // have a meaningful "early quarter" at all (Send Us Photos:
        // ~0-114px scrollable depending on device) -- without it,
        // handoffPx computes to some tiny number and y=0 < that tiny
        // number is still true at rest, so tls-scroll-early would end
        // up permanently true there. That's harmless for Summary (which
        // independently requires scrollable > 400 before showing at
        // all, see PageSummary.astro), but it would fight
        // MobilePageFlowNav.astro's own "show immediately on a short
        // page" logic, since its CSS hides .show whenever this class is
        // present. A short page just isn't "early" -- there's no
        // "later" on it to be early relative to.
        document.body.classList.toggle('tls-scroll-early', scrollable > 400 && window.scrollY < handoffPx);

        for (const milestone of [25, 50, 75]) {
          if (pct >= milestone && !scrollMilestonesFired.has(milestone)) {
            scrollMilestonesFired.add(milestone);
            tlsTrack(`scroll_depth_${milestone}`);
          }
        }
        if (distanceToBottom < 32 && !scrollMilestonesFired.has(100)) {
          scrollMilestonesFired.add(100);
          tlsTrack('scroll_depth_100');
        }
        scrollTicking = false;
      }
      window.addEventListener(
        'scroll',
        () => {
          if (!scrollTicking) {
            window.requestAnimationFrame(updateScrollState);
            scrollTicking = true;
          }
        },
        { passive: true }
      );
      window.addEventListener('resize', updateScrollState);
      updateScrollState();
    </script>
  </body>
</html>
