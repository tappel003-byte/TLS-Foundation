---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MinimalFooter from '../components/MinimalFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import PageSummary from '../components/PageSummary.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects specific to this page (Article, FAQPage, BreadcrumbList, etc.) */
  schema?: object[];
  /**
   * 'full' = the elaborate wordmark/link-grid footer — confirmed present on Home.
   * 'minimal' = just the address line — confirmed present on Albuquerque.
   * Do NOT default this to 'full' again without checking the live page first;
   * the footer is NOT confirmed identical across every page.
   */
  footer?: 'full' | 'minimal';
  /** Only used when footer='full' -- the service-area paragraph is page-specific, not shared. */
  footerProps?: { serviceAreaLabel?: string; serviceAreaText?: string };
  /** Social share image, root-relative (e.g. '/images/contact-us-hero.jpg'). Defaults to the homepage hero. */
  ogImage?: string;
  /** Short hand-written summary shown in the "Summarize this page" popup. Omit to skip the pill entirely on this page. */
  summary?: string;
  /** Short page label shown above "The short version" in the summary popup -- helps orient someone mid-chain. Only meaningful alongside `summary`. */
  pageName?: string;
  /** Chains to the next page's summary popup (adds a "Next: X" link, auto-opens there). Only meaningful alongside `summary`. */
  nextPage?: { path: string; name: string };
}

const { title, description, schema = [], footer = 'minimal', footerProps = {}, ogImage = '/images/home-hero.webp', summary, pageName, nextPage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Sitewide schema, present on every page — corrected from what's live:
// live site's Organization block carries a stale phone number (5057023833,
// unused everywhere else on the site) and a sameAs pointing at Squarespace's
// own LinkedIn page (clearly a leftover default, not TLS's). Both fixed here
// to the canonical number; sameAs dropped until real social profiles are given.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  legalName: 'TLS Foundations',
  address: '5048 Edith Blvd NE, Suite E, Albuquerque, NM 87107, United States',
  email: 'TLSfoundationsNM@gmail.com',
  telephone: '+15059914180',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TLS Foundations',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5048 Edith Blvd NE, Suite E',
    addressLocality: 'Albuquerque',
    addressRegion: 'NM',
    postalCode: '87107',
    addressCountry: 'US',
  },
  telephone: '+15059914180',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: 'https://www.tlsfoundations.com',
  name: 'TLS Foundations',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:site_name" content="TLS Foundations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {schema.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!--
      Cloudflare Web Analytics -- site-wide, privacy-respecting (no cookies,
      no cross-site tracking, no consent banner required). Get the real
      token from the Cloudflare dashboard: Account Home -> Analytics & Logs
      -> Web Analytics -> Add a site (enter this site's domain). It hands
      back a snippet identical to this one with a real token in place of
      REPLACE_WITH_CF_ANALYTICS_TOKEN -- swap it in and this starts
      reporting immediately, no redeploy-and-wait needed beyond the push.
    -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_CF_ANALYTICS_TOKEN"}'></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    {footer === 'full' ? <Footer {...footerProps} /> : <MinimalFooter {...footerProps} />}
    <BackToTop />
    {summary && <PageSummary summary={summary} pageName={pageName} nextPage={nextPage} />}
  </body>
</html>
