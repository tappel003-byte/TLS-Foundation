---
// Floating "Job Notes" pill -- only rendered on individual Job Notes
// articles (via Layout's `backToJobNotes` prop). Same left:20/bottom:28
// treatment as BackToServicesPill.astro on the method deep-dive pages,
// per Tim -- matched exactly, no mobile override, even though the
// Summary pill (PageSummary.astro) can briefly claim this same corner
// on mobile during early scroll on a longer article.
---

<a href="/job-notes" id="tls-back-to-job-notes" aria-label="Back to Job Notes">
  <span aria-hidden="true">←</span> Job Notes
</a>

<style>
  #tls-back-to-job-notes {
    position: fixed;
    bottom: 28px;
    left: 20px;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    padding: 0 20px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    transition: background 0.2s;
    /* Forces its own GPU compositing layer -- without this, iOS Safari
       can visibly detach a bottom-anchored `position: fixed` element
       from the viewport while its dynamic address-bar/toolbar is
       animating during a scroll, making it briefly render as if it
       were positioned within the page content instead of pinned to the
       corner. Harmless no-op on browsers that don't need it. */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }
  #tls-back-to-job-notes:hover {
    background: var(--gold);
  }
  /* Sitewide footer-visibility observer, see Layout.astro. */
  body.tls-footer-visible #tls-back-to-job-notes {
    opacity: 0;
    pointer-events: none;
  }

</style>
