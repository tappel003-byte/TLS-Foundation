---
// Floating "Job Notes" pill -- only rendered on individual Job Notes
// articles (via Layout's `backToJobNotes` prop), same treatment as
// BackToServicesPill.astro on the method deep-dive pages. Unlike that
// pill, Job Notes articles also carry the Summary pill (PageSummary.astro),
// which claims this same left:20/bottom:28 corner on mobile during early
// scroll -- see the mobile media query below for how this stays out of
// its way instead of colliding with it.
---

<a href="/job-notes" id="tls-back-to-job-notes" aria-label="Back to Job Notes">
  <span aria-hidden="true">←</span> Job Notes
</a>

<style>
  #tls-back-to-job-notes {
    position: fixed;
    bottom: 28px;
    left: 20px;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    padding: 0 20px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    transition: background 0.2s;
  }
  #tls-back-to-job-notes:hover {
    background: var(--gold);
  }
  /* Sitewide footer-visibility observer, see Layout.astro. */
  body.tls-footer-visible #tls-back-to-job-notes {
    opacity: 0;
    pointer-events: none;
  }
  /* Below 640px, the Summary pill (PageSummary.astro) moves to this same
     left:20/bottom:28 corner during early scroll. This pill isn't scroll-
     gated (the need to go back can hit the moment someone lands), so it
     stacks above that slot on mobile instead of fighting Summary for it. */
  @media (max-width: 640px) {
    #tls-back-to-job-notes {
      bottom: 84px;
    }
  }
</style>
