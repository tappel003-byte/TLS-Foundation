---
// Verbatim back-to-top button, confirmed identical on every page.
---

<a id="tls-btt" href="#" aria-label="Back to top">
  <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"></polyline></svg>
</a>

<style>
  #tls-btt {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 48px;
    height: 48px;
    background: var(--blue);
    border: 2px solid var(--gold);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
    text-decoration: none;
  }
  #tls-btt.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #tls-btt:hover {
    background: var(--gold);
  }
  #tls-btt svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* On mobile this is the centerpiece of a three-button row (prev / this /
     next) -- dead-centered on the viewport via calc() (half its own 48px
     width) rather than tied to the right edge, so the row reads "back, up,
     next" left to right with #tls-btt sitting at true screen-center. See
     MobilePageFlowNav.astro, which positions prev/next relative to this
     same center point. */
  @media (max-width: 640px) {
    #tls-btt {
      right: auto;
      left: calc(50% - 24px);
    }
  }
</style>

<script>
  const btn = document.getElementById('tls-btt');
  let ticking = false;
  function update() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    btn?.classList.toggle('show', y > 400);
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
