---
// Verbatim back-to-top button, confirmed identical on every page.
---

<a id="tls-btt" href="#" aria-label="Back to top">
  <svg viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"></polyline></svg>
</a>

<style>
  #tls-btt {
    position: fixed;
    bottom: 28px;
    /* Stays put and visible the whole time the page is scrolled --
       unlike the Summary pill and prev/next (PageSummary.astro /
       MobilePageFlowNav.astro), which now hand off a shared slot at
       right: 100px based on how far down the page you are (see the
       tls-scroll-early/tls-scroll-late classes in Layout.astro), this
       one doesn't have a "wrong place on the page" to be. */
    right: 20px;
    width: 48px;
    height: 48px;
    background: var(--blue);
    border: 2px solid var(--gold);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    /* Without this, the button reads fine over light sections but visually
       merges into any navy/dark card it happens to float over (e.g. the
       Methods page's process-step cards) -- the shadow keeps it legible
       as floating UI regardless of what's scrolled behind it. */
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
    text-decoration: none;
  }
  #tls-btt.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Sitewide footer-visibility observer, see Layout.astro -- avoids
     sitting on top of the footer's own bottom row once scrolled that far. */
  body.tls-footer-visible #tls-btt.show {
    opacity: 0;
    pointer-events: none;
  }
  #tls-btt:hover {
    background: var(--gold);
  }
  #tls-btt svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  const btn = document.getElementById('tls-btt');
  let ticking = false;
  function update() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    btn?.classList.toggle('show', y > 400);
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
