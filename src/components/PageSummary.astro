---
// Floating "Summarize this page" pill + popup panel. Only renders when a
// page passes a `summary` prop -- pages without one simply don't get the
// pill, so this can roll out page by page rather than all at once.
//
// Optional `nextPage` lets someone chain straight from one summary to the
// next page's summary (auto-opens there via a ?summarize=1 param) without
// having to find and click the pill again on each page.
interface Props {
  summary: string;
  pageName?: string;
  nextPage?: { path: string; name: string };
}
const { summary, pageName, nextPage } = Astro.props;
---

<button id="tls-summarize-btn" aria-haspopup="dialog" aria-controls="tls-summarize-panel">
  <span class="tls-summarize-btn-full">Summarize this page</span>
  <span class="tls-summarize-btn-short">Summary</span>
</button>

<div id="tls-summarize-overlay" role="presentation"></div>
<div id="tls-summarize-panel" role="dialog" aria-modal="true" aria-labelledby="tls-summarize-heading">
  <div class="tls-summarize-panel-inner">
    <div class="tls-summarize-header">
      <div class="tls-summarize-header-text">
        {pageName && <span class="tls-summarize-page">{pageName}</span>}
        <span id="tls-summarize-heading">The short version</span>
      </div>
      <button id="tls-summarize-close" aria-label="Close summary">×</button>
    </div>
    <p>{summary}</p>

    <div class="tls-summarize-cta">
      <span class="tls-summarize-cta-label">Questions about your own situation?</span>
      <a href="tel:5059914180" class="tls-summarize-phone">(505) 991-4180</a>
      <a href="sms:5059914180" class="tls-summarize-text-link">or text</a>
      <span class="tls-summarize-cta-sub">You reach the owner(s)</span>
    </div>

    {
      nextPage && (
        <a class="tls-summarize-next" href={`${nextPage.path}?summarize=1`}>
          Next: {nextPage.name} →
        </a>
      )
    }
  </div>
</div>

<style>
  #tls-summarize-btn {
    position: fixed;
    bottom: 28px;
    /* Sits beside the back-to-top arrow (#tls-btt: 48px wide, right: 28px)
       on desktop -- left: 28px collided with the sticky left-nav sidebar's
       own bottom contact block on the 5 regional pages. Reverts to
       bottom-left on mobile (that sidebar is hidden there anyway, and two
       fixed buttons crowd a narrow screen less if they're in opposite
       corners rather than stacked next to each other). */
    right: 88px;
    height: 48px;
    display: flex;
    align-items: center;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    padding: 0 20px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    z-index: 9999;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
  }
  #tls-summarize-btn.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #tls-summarize-btn:hover {
    background: var(--gold);
  }
  .tls-summarize-btn-short {
    display: none;
  }

  #tls-summarize-overlay {
    position: fixed;
    inset: 0;
    background: rgba(13, 34, 56, 0.55);
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }
  #tls-summarize-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  #tls-summarize-panel {
    position: fixed;
    left: 50%;
    bottom: 24px;
    top: auto;
    transform: translate(-50%, 20px);
    width: min(560px, calc(100% - 48px));
    max-height: min(78vh, 78dvh);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--cream, #fdfaf6);
    border: 2px solid var(--gold);
    border-radius: 16px;
    z-index: 10001;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, transform 0.25s;
    box-shadow: 0 12px 40px rgba(13, 34, 56, 0.3);
  }
  #tls-summarize-panel.show {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .tls-summarize-panel-inner {
    padding: 28px 32px 36px;
  }
  .tls-summarize-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(184, 134, 11, 0.3);
  }
  .tls-summarize-header-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tls-summarize-page {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-style: italic;
    color: var(--blue);
  }
  #tls-summarize-heading {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-text, #7d5c08);
  }
  #tls-summarize-close {
    background: none;
    border: none;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 26px;
    line-height: 1;
    color: var(--blue);
    cursor: pointer;
    padding: 0;
  }
  #tls-summarize-close:hover {
    color: var(--gold-text, #7d5c08);
  }
  .tls-summarize-panel-inner p {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 17px;
    line-height: 1.75;
    color: #1a1a1a;
    margin: 0;
  }
  .tls-summarize-cta {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(184, 134, 11, 0.3);
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tls-summarize-cta-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted, #54626f);
  }
  .tls-summarize-phone {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    color: var(--blue);
    text-decoration: none;
    letter-spacing: 0.2px;
  }
  .tls-summarize-phone:hover {
    color: var(--gold-text, #7d5c08);
  }
  .tls-summarize-text-link {
    font-family: 'Source Serif 4', Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: var(--muted, #54626f);
    text-decoration: underline;
    text-decoration-color: rgba(184, 134, 11, 0.4);
    text-underline-offset: 3px;
  }
  .tls-summarize-text-link:hover {
    color: var(--gold-text, #7d5c08);
  }
  .tls-summarize-cta-sub {
    display: block;
    width: 100%;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted, #54626f);
    opacity: 0.7;
  }
  .tls-summarize-next {
    display: inline-block;
    margin-top: 20px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
  }
  .tls-summarize-next:hover {
    color: var(--gold-text, #7d5c08);
  }

  @media (max-width: 640px) {
    #tls-summarize-btn {
      left: 20px;
      right: auto;
      /* Same 48px height as the round buttons already; the mismatch was
         width -- "Summary" in tight 16px padding at 10px font read as a
         cramped stub next to a full 48px circle. Roomier padding and a
         font-size matching desktop's give it comparable visual weight. */
      padding: 0 26px;
      font-size: 11px;
    }
    .tls-summarize-btn-full {
      display: none;
    }
    .tls-summarize-btn-short {
      display: inline;
    }
    .tls-summarize-panel-inner {
      padding: 22px 22px 28px;
    }
  }
</style>

<script>
  const btn = document.getElementById('tls-summarize-btn');
  const overlay = document.getElementById('tls-summarize-overlay');
  const panel = document.getElementById('tls-summarize-panel');
  const closeBtn = document.getElementById('tls-summarize-close');

  let ticking = false;
  function updateVisibility() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    btn?.classList.toggle('show', y > 400);
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateVisibility);
        ticking = true;
      }
    },
    { passive: true }
  );

  function openPanel() {
    btn?.classList.add('show');
    overlay?.classList.add('show');
    panel?.classList.add('show');
  }
  function closePanel() {
    overlay?.classList.remove('show');
    panel?.classList.remove('show');
  }

  btn?.addEventListener('click', openPanel);
  closeBtn?.addEventListener('click', closePanel);
  overlay?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });

  // Arriving from another page's "Next" link -- open straight away and
  // strip the param so a refresh or share of the URL doesn't re-trigger it.
  const params = new URLSearchParams(window.location.search);
  if (params.get('summarize') === '1') {
    openPanel();
    params.delete('summarize');
    const cleanUrl = window.location.pathname + (params.toString() ? `?${params}` : '') + window.location.hash;
    window.history.replaceState(null, '', cleanUrl);
  }
</script>
