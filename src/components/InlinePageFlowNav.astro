---
// Prototype: named "Previous / Next" links inline at the bottom of the
// page content, replacing the floating prev/next chevrons
// (MobilePageFlowNav.astro). Per Tim: a bare arrow icon reads as
// "browser back" to a lot of people, and there's no visible menu on
// most pages that explains what "next" even means -- showing the real
// destination name removes that ambiguity, which a small floating
// circle button doesn't have room for. Living inline (not floating)
// means it never competes with back-to-top/Summary for space, and can
// show the full name without truncating.
//
// Same shape as the deep-dive pages' own closing-link row ("<- Back to
// Foundation Repair Methods . Glossary: X ->") -- this is that same
// pattern applied to the sitewide pageFlow order instead.
//
// PROTOTYPE on /why-foundations-move only for now -- see pageFlow.ts
// for the shared prev/next order. Once reviewed, this replaces
// MobilePageFlowNav.astro sitewide rather than living alongside it.
import { pageFlow } from '../data/pageFlow';

const { currentPath } = Astro.props as { currentPath: string };
const idx = pageFlow.findIndex((p) => p.path === currentPath);
const prev = idx > 0 ? pageFlow[idx - 1] : null;
const next = idx >= 0 && idx < pageFlow.length - 1 ? pageFlow[idx + 1] : null;
---

{
  (prev || next) && (
    <nav class="tls-inline-pageflow" aria-label="Page navigation">
      {prev ? (
        <a href={prev.path} class="tls-inline-pageflow-link tls-inline-pageflow-prev">
          <span aria-hidden="true">←</span> Previous: {prev.name}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={next.path} class="tls-inline-pageflow-link tls-inline-pageflow-next">
          Next: {next.name} <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .tls-inline-pageflow {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px 24px;
    max-width: var(--col, 900px);
    margin: 56px auto 0;
    padding: 24px var(--gutter, 40px) 0;
    border-top: 1px solid var(--stone, #e0d5c5);
  }
  .tls-inline-pageflow-link {
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.3px;
    color: var(--blue, #1b3a5c);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
  }
  .tls-inline-pageflow-link:hover {
    color: var(--gold-text, #7d5c08);
  }
  .tls-inline-pageflow-next {
    margin-left: auto;
    text-align: right;
  }
  @media (max-width: 640px) {
    .tls-inline-pageflow {
      margin-top: 40px;
      padding-top: 20px;
    }
    .tls-inline-pageflow-link {
      font-size: 12px;
    }
  }
</style>
