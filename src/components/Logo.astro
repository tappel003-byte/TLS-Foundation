---
// TLS Foundations wordmark — pure CSS/text, per Tim's "Logo Design Standard"
// reference doc (March 2026). Reference size is TLS 72px / Foundations 54px
// (1.33:1, maintained at every scale) with word-gap 20px, padding 28px equal
// on all sides, and a 4px border -- all "scale proportionally" per the doc.
// header (TLS 21px) and footer (TLS 28px) below are scaled off that 72px
// reference (scale factors 0.2917 and 0.3889), not independently eyeballed
// numbers, so gap/padding/border stay in the doc's proportions instead of
// drifting at different sizes.
interface Props {
  size?: 'header' | 'footer';
}
const { size = 'header' } = Astro.props;
---

<a href="/" class:list={['wordmark', size]} aria-label="TLS Foundations — home">
  <span class="wm-tls">TLS</span>
  <span class="wm-foundations">Foundations</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    /* Baseline, not center -- "TLS" and "Foundations" sit at different font
       sizes and weights, so centering their boxes let "Foundations" drift
       off "TLS"'s actual text baseline. The doc calls for "both words on a
       single baseline," which is what flex's own baseline alignment gives
       for free. */
    align-items: baseline;
    background: var(--blue-dark);
    text-decoration: none;
    line-height: 1;
  }
  .wordmark.header {
    gap: 5.83px;
    padding: 8.17px;
    border: 1.17px solid var(--gold);
  }
  .wordmark.footer {
    gap: 7.78px;
    padding: 10.89px;
    border: 1.56px solid var(--gold);
    margin-bottom: 20px;
  }
  .wm-tls {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #ffffff;
  }
  .wordmark.header .wm-tls {
    font-size: 21px;
  }
  .wordmark.footer .wm-tls {
    font-size: 28px;
  }
  .wm-foundations {
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    color: var(--gold);
  }
  .wordmark.header .wm-foundations {
    font-size: 15.75px;
  }
  .wordmark.footer .wm-foundations {
    font-size: 21px;
  }
</style>
