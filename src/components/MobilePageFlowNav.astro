---
// Small "prev / next" chevron pair, next to the existing back-to-top
// circle, at every viewport width -- per Tim, easy wayfinding shouldn't be
// a mobile-only convenience; a mouse click is just as easy as a tap. (File
// name is a holdover from when this was mobile-only; not worth a rename
// churn on its own.)
import { pageFlow } from '../data/pageFlow';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const idx = pageFlow.findIndex((p) => p.path === currentPath);
const prev = idx > 0 ? pageFlow[idx - 1] : null;
const next = idx >= 0 && idx < pageFlow.length - 1 ? pageFlow[idx + 1] : null;
---

{
  (prev || next) && (
    <>
      {prev && (
        <a id="tls-pagenav-prev" class="tls-pagenav-btn" href={prev.path} aria-label={`Previous: ${prev.name}`}>
          <svg viewBox="0 0 24 24">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </a>
      )}
      {next && (
        <a id="tls-pagenav-next" class="tls-pagenav-btn" href={next.path} aria-label={`Next: ${next.name}`}>
          <svg viewBox="0 0 24 24">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}
    </>
  )
}

<style>
  .tls-pagenav-btn {
    display: flex;
    position: fixed;
    bottom: 28px;
    width: 44px;
    height: 44px;
    background: var(--blue);
    border: 2px solid var(--gold);
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
    text-decoration: none;
  }
  .tls-pagenav-btn.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Sitewide footer-visibility observer, see Layout.astro -- avoids
     sitting on top of the footer's own bottom row once scrolled that far. */
  body.tls-footer-visible .tls-pagenav-btn.show {
    opacity: 0;
    pointer-events: none;
  }
  .tls-pagenav-btn:hover {
    background: var(--gold);
  }
  .tls-pagenav-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Reads "back, up, next" left to right: prev leftmost, #tls-btt
     (back-to-top, 48px wide) takes the middle 80px slot itself, next
     claims the rightmost slot -- same three positions at every viewport
     width now. #tls-btt is 4px wider than these 44px buttons, so matching
     "right" offsets by the same 8px step (28/80/136) keeps an even 8px gap
     on both sides. PageSummary's pill sits further out past prev (see its
     own right: 192px on desktop / left: 20px on mobile). */
  #tls-pagenav-next {
    right: 28px;
  }
  #tls-pagenav-prev {
    right: 136px;
  }
</style>

<script>
  let ticking = false;
  function update() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    document.querySelectorAll('.tls-pagenav-btn').forEach((btn) => btn.classList.toggle('show', y > 400));
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
