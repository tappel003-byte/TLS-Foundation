---
// "Previous page / next page" pair, at every viewport width -- per Tim,
// easy wayfinding shouldn't be a mobile-only convenience; a mouse click
// is just as easy as a tap. (File name is a holdover from when this was
// mobile-only; not worth a rename churn on its own.)
//
// Shows the actual destination name, not a generic "Previous Page" --
// an earlier attempt at naming was rejected, but per Tim that was about
// where it lived on the page (an inline row at the bottom of the
// content, which read as bolted-on/an afterthought), not about naming
// itself; brought back here inside the same floating-pill treatment as
// everything else in this cluster, it doesn't have that problem.
//
// No arrow icon: originally these paired a bare "<-"/"->" with generic
// "Previous Page"/"Next Page" text specifically because the icon alone
// reads as browser-back to a lot of people. Once the label became the
// real destination name, that job was already done by the content --
// left/right position plus a specific page name is unambiguous without
// an icon doing extra work. Dropping it also earns back real space:
// per Tim, this is a mobile-first feature (desktop was never cramped),
// and the arrow was eating a full line inside the stacked mobile
// layout below -- removing it let most names fit on one line instead
// of wrapping to two, and let the pill height come back down to match
// back-to-top's 48px directly instead of needing a separate offset to
// center a taller box against it.
//
// Per Tim, this shares its screen slot with the Summary pill
// (PageSummary.astro) rather than sitting beside it permanently: Summary
// owns that spot in the top quarter of the page (useful before you've
// read anything), this one takes over the moment Summary lets go of it.
// That was originally two separate thresholds -- Summary out at the
// 25%-of-page mark, this one in at the halfway mark -- leaving a dead
// stretch in between where the slot just sat empty. Per Tim, once the
// slot opens up there's no reason to make someone keep scrolling before
// "where do I go next" becomes available, so it's now one handoff at
// the same point Summary disappears. The tls-scroll-early body class
// that gates it is set in Layout.astro's scroll handler.
import { pageFlow } from '../data/pageFlow';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const idx = pageFlow.findIndex((p) => p.path === currentPath);
const prev = idx > 0 ? pageFlow[idx - 1] : null;
const next = idx >= 0 && idx < pageFlow.length - 1 ? pageFlow[idx + 1] : null;
---

{
  (prev || next) && (
    <div class="tls-pagenav-group">
      {prev && (
        <a id="tls-pagenav-prev" class="tls-pagenav-btn" href={prev.path} aria-label={`Previous page: ${prev.name}`}>
          <span class="tls-pagenav-label">{prev.name}</span>
        </a>
      )}
      {next && (
        <a id="tls-pagenav-next" class="tls-pagenav-btn" href={next.path} aria-label={`Next page: ${next.name}`}>
          <span class="tls-pagenav-label">{next.name}</span>
        </a>
      )}
    </div>
  )
}

<style>
  /* Same slot as the Summary pill (#tls-summarize-btn in
     PageSummary.astro, right: 100px) -- only one of the two is ever
     visible at a time, see the .show gating below, so they can safely
     occupy the identical position rather than needing to be offset from
     each other. One flex container for the pair instead of two
     independently-positioned buttons: these are variable-width text
     pills rather than fixed circles, so letting flex handle the gap
     between them is more robust than hardcoding a second "right" offset
     that assumed a fixed width. */
  .tls-pagenav-group {
    position: fixed;
    bottom: 28px;
    right: 100px;
    display: flex;
    gap: 10px;
    z-index: 9999;
  }
  .tls-pagenav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Matches back-to-top's 48px circle (BackToTop.astro) and the
       Summary pill this replaces (PageSummary.astro, also 48px) -- at
       40px these sat with the same bottom edge but a shorter top, so
       the taller circle stuck up above the row and broke the skyline.
       Same height across the whole cluster keeps the row reading as one
       clean line instead of an uneven stack. Fixed (not auto) so a
       longer name wrapping to two lines on mobile doesn't grow the box
       and break that alignment again. */
    height: 48px;
    padding: 0 16px;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
  }
  .tls-pagenav-label {
    /* Real page names vary a lot in length ("Home" vs "Compaction
       Grouting & Mud Jacking") -- capping width and ellipsizing keeps
       every pill a predictable size instead of some runs blowing out
       the row or wrapping to a second line. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }
  .tls-pagenav-btn.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Sitewide footer-visibility observer, see Layout.astro -- avoids
     sitting on top of the footer's own bottom row once scrolled that far. */
  body.tls-footer-visible .tls-pagenav-btn.show {
    opacity: 0;
    pointer-events: none;
  }
  /* Per Tim: this takes over the shared slot the moment Summary lets go
     of it -- see PageSummary.astro's matching tls-scroll-early rule and
     the header comment above for why that's now one threshold instead
     of two. Back-to-top isn't part of this handoff; it's unaffected. */
  body.tls-scroll-early .tls-pagenav-btn.show {
    opacity: 0;
    pointer-events: none;
  }
  .tls-pagenav-btn:hover {
    background: var(--gold);
  }
  @media (max-width: 480px) {
    /* Per Tim: a single truncated line ("SYMPTOM GUI...") read as broken
       rather than custom -- a phone has more room to spare vertically
       than horizontally, so this wraps to two lines instead of cutting
       the name short. Without an arrow taking its own line (see the
       header comment), most names fit on one line and stay inside the
       same 48px height as back-to-top and desktop; only the longest
       names wrap to a second line, still inside that fixed height. */
    .tls-pagenav-btn {
      padding: 4px 12px;
      font-size: 10px;
    }
    .tls-pagenav-label {
      /* Base rule ellipsizes to one line for desktop's fixed-width
         layout -- wrapping needs that undone, not just a wider cap. */
      max-width: 110px;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
      text-align: center;
      line-height: 1.15;
    }
  }
</style>

<script>
  let ticking = false;
  function update() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    document.querySelectorAll('.tls-pagenav-btn').forEach((btn) => btn.classList.toggle('show', y > 400));
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
