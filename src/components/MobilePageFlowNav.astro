---
// "Previous page / next page" pair, at every viewport width -- per Tim,
// easy wayfinding shouldn't be a mobile-only convenience; a mouse click
// is just as easy as a tap. (File name is a holdover from when this was
// mobile-only; not worth a rename churn on its own.)
//
// Words, not bare arrow icons: a plain "<-" reads as browser-back to a
// lot of people, easy to mistake for "return to wherever I came from"
// rather than "go to the next item in this site's own reading order" --
// especially since most inner pages get reached from search or a
// shared link, not by clicking through the nav in order.
//
// Shows the actual destination name, not a generic "Previous Page" --
// an earlier attempt at naming was rejected, but per Tim that was about
// where it lived on the page (an inline row at the bottom of the
// content, which read as bolted-on/an afterthought), not about naming
// itself; brought back here inside the same floating-pill treatment as
// everything else in this cluster, it doesn't have that problem. Long
// names (e.g. "Compaction Grouting & Mud Jacking") are the tradeoff --
// .tls-pagenav-label caps width and ellipsizes rather than letting the
// pill balloon or wrap, which Tim signed off on as the acceptable cost.
//
// Per Tim, this shares its screen slot with the Summary pill
// (PageSummary.astro) rather than sitting beside it permanently: Summary
// owns that spot in the top quarter of the page (useful before you've
// read anything), this one takes over once you're past the halfway
// point (useful once "where do I go next" is the live question). The
// tls-scroll-early/tls-scroll-late body classes that gate the handoff
// are set in Layout.astro's scroll handler.
import { pageFlow } from '../data/pageFlow';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const idx = pageFlow.findIndex((p) => p.path === currentPath);
const prev = idx > 0 ? pageFlow[idx - 1] : null;
const next = idx >= 0 && idx < pageFlow.length - 1 ? pageFlow[idx + 1] : null;
---

{
  (prev || next) && (
    <div class="tls-pagenav-group">
      {prev && (
        <a id="tls-pagenav-prev" class="tls-pagenav-btn" href={prev.path} aria-label={`Previous page: ${prev.name}`}>
          <span class="tls-pagenav-arrow">←</span>
          <span class="tls-pagenav-label">{prev.name}</span>
        </a>
      )}
      {next && (
        <a id="tls-pagenav-next" class="tls-pagenav-btn tls-pagenav-next" href={next.path} aria-label={`Next page: ${next.name}`}>
          <span class="tls-pagenav-label">{next.name}</span>
          <span class="tls-pagenav-arrow">→</span>
        </a>
      )}
    </div>
  )
}

<style>
  /* Same slot as the Summary pill (#tls-summarize-btn in
     PageSummary.astro, right: 100px) -- only one of the two is ever
     visible at a time, see the .show gating below, so they can safely
     occupy the identical position rather than needing to be offset from
     each other. One flex container for the pair instead of two
     independently-positioned buttons: these are variable-width text
     pills rather than fixed circles, so letting flex handle the gap
     between them is more robust than hardcoding a second "right" offset
     that assumed a fixed width. */
  .tls-pagenav-group {
    position: fixed;
    bottom: 28px;
    right: 100px;
    display: flex;
    gap: 10px;
    z-index: 9999;
  }
  .tls-pagenav-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    /* Matches back-to-top's 48px circle (BackToTop.astro) and the
       Summary pill this replaces (PageSummary.astro, also 48px) -- at
       40px these sat with the same bottom edge but a shorter top, so
       the taller circle stuck up above the row and broke the skyline.
       Same height across the whole cluster keeps the row reading as one
       clean line instead of an uneven stack. */
    height: 48px;
    padding: 0 16px;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s, transform 0.3s, background 0.2s;
    pointer-events: none;
  }
  .tls-pagenav-next {
    /* Prev reads arrow-then-name (leading toward where you came from);
       next reads name-then-arrow (leading toward where you're going) --
       the arrow stays on the outside edge of the pair either way. */
    flex-direction: row;
  }
  .tls-pagenav-arrow {
    flex: none;
  }
  .tls-pagenav-label {
    /* Real page names vary a lot in length ("Home" vs "Compaction
       Grouting & Mud Jacking") -- capping width and ellipsizing keeps
       every pill a predictable size instead of some runs blowing out
       the row or wrapping to a second line. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }
  .tls-pagenav-btn.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Sitewide footer-visibility observer, see Layout.astro -- avoids
     sitting on top of the footer's own bottom row once scrolled that far. */
  body.tls-footer-visible .tls-pagenav-btn.show {
    opacity: 0;
    pointer-events: none;
  }
  /* Per Tim: this only takes over the shared slot once you're past the
     halfway point of the page -- before that it's Summary's turn (see
     PageSummary.astro's matching tls-scroll-early rule). Between the
     25%-of-page mark and the halfway mark, neither pill shows; just
     back-to-top, which isn't part of this handoff. */
  body:not(.tls-scroll-late) .tls-pagenav-btn.show {
    opacity: 0;
    pointer-events: none;
  }
  .tls-pagenav-btn:hover {
    background: var(--gold);
  }
  @media (max-width: 480px) {
    /* Per Tim: a single truncated line ("SYMPTOM GUI...") read as broken
       rather than custom -- a phone has more room to spare vertically
       than horizontally, so stacking the arrow above the name and
       letting it wrap to two lines uses that instead of cutting the
       name short. Fixed height (not auto) so both pills -- and the
       back-to-top circle they sit next to -- stay a predictable size
       regardless of how long any one name runs. */
    .tls-pagenav-btn {
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      height: 58px;
      padding: 6px 10px;
      font-size: 10px;
    }
    .tls-pagenav-arrow {
      font-size: 12px;
      /* Source order puts the arrow after the name on the "next" button
         (so it trails the name on desktop's single-line layout) -- in
         the stacked layout that would put the arrow on top for "prev"
         but the name on top for "next". Forcing the arrow first for
         both keeps the stack reading the same way on each button. */
      order: 1;
    }
    .tls-pagenav-label {
      order: 2;
    }
    .tls-pagenav-label {
      /* Base rule ellipsizes to one line for desktop's side-by-side
         layout -- wrapping to two lines needs that undone, not just a
         wider cap. */
      max-width: 92px;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
      text-align: center;
      line-height: 1.2;
    }
    /* Circle stays 48px/bottom:28 (BackToTop.astro); these stacked
       pills are taller (58px) -- centering this group on the circle's
       midpoint instead of sharing its bottom edge keeps the row reading
       as one aligned unit rather than the pills sticking down below it. */
    .tls-pagenav-group {
      bottom: 23px;
    }
  }
</style>

<script>
  let ticking = false;
  function update() {
    const y = window.pageYOffset || document.documentElement.scrollTop || 0;
    document.querySelectorAll('.tls-pagenav-btn').forEach((btn) => btn.classList.toggle('show', y > 400));
    ticking = false;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
