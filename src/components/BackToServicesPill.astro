---
// Floating "Back to Services" pill -- only rendered on the 8 method
// pages linked from /foundation-repair-methods (via Layout's
// `backToServices` prop). Exists because the sitewide prev/next
// chevrons (MobilePageFlowNav) chain straight through all 8 method pages
// in nav order, so from the middle of that chain "prev" steps to the
// previous method page, not back to Services -- not what someone who
// followed a "Read the full technical breakdown" link actually wants.
// Unlike the other floating buttons this isn't scroll-gated: the need to
// back out can hit the moment someone lands, not just after scrolling.
//
// `anchor` is the id of the matching card on /foundation-repair-methods
// (e.g. "helical-piers") -- per Tim, this should land back on the actual
// card that sent someone here, not just the top of Services.
interface Props {
  anchor: string;
}
const { anchor } = Astro.props;
---

<a href={`/foundation-repair-methods#${anchor}`} id="tls-back-to-services" aria-label="Back to Foundation Repair Methods">
  <span aria-hidden="true">←</span> Services
</a>

<style>
  #tls-back-to-services {
    position: fixed;
    bottom: 28px;
    left: 20px;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--blue);
    color: #fff;
    border: 2px solid var(--gold);
    border-radius: 999px;
    padding: 0 20px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 6px 18px rgba(13, 34, 56, 0.45);
    transition: background 0.2s;
  }
  #tls-back-to-services:hover {
    background: var(--gold);
  }
  /* Sitewide footer-visibility observer, see Layout.astro. */
  body.tls-footer-visible #tls-back-to-services {
    opacity: 0;
    pointer-events: none;
  }
  /* No mobile bottom-offset override -- this pill only renders on the 8
     method pages, and those pages don't get the Summary pill (removed
     per Tim, see foundation-repair-methods.astro history), so there's
     nothing at mobile's left:20/bottom:28 slot to stack above anymore.
     A leftover bottom:84px here left this floating over page content
     with nothing below it, well short of the actual bottom row where
     back-to-top/prev/next sit. */
</style>
